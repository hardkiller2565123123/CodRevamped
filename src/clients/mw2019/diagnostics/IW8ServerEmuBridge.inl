    }


    // V40: one-shot bounded graph explorer for the already-proven Demonware/source3
    // failure topology.  This replaces the repeated one-off static scans with a
    // bidirectional graph walk: known seeds -> outgoing direct edges/RIP tables ->
    // pointer-table targets -> incoming direct owners -> repeat.  It also records
    // simple Windows-x64 argument provenance (ECX/EDX/R8D/R9D) near callsites.
    // Diagnostic only: no discovered function is invoked or detoured and no game
    // state is written.
    struct DwGraphNodeV40
    {
        std::uintptr_t rva = 0;
        std::uintptr_t beginRva = 0;
        std::uintptr_t endRva = 0;
        unsigned depth = 0;
        unsigned origin = 0;
        bool expanded = false;
    };

    struct DwGraphEdgeV40
    {
        std::uintptr_t fromRva = 0;
        std::uintptr_t siteRva = 0;
        std::uintptr_t toRva = 0;
        const char* kind = nullptr;
        unsigned depth = 0;
    };

    struct DwGraphRangeV40
    {
        std::uintptr_t beginRva;
        std::uintptr_t endRva;
        const char* label;
    };

    static constexpr DwGraphRangeV40 kDwGraphRangesV40[] = {
        {0x1800000u, 0x2200000u, "constructor_parents"},
        {0x2B00000u, 0x2E50000u, "task_async"},
