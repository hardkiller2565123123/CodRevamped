    static void AnalyzeDwSource3WriterCandidateV54(
        std::uintptr_t taskObject,
        unsigned char flagD,
        unsigned char flagE,
        unsigned fetchCallsAtE1,
        int fetchStatusAtE1) noexcept
    {
        static std::atomic_bool once{false};
        bool expected = false;
        if (!once.compare_exchange_strong(expected, true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        auto readBytes = [&](std::uintptr_t rva, void* out, std::size_t bytes) -> bool {
            return rva < size && bytes <= size - rva &&
                ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + rva), out, bytes);
        };

        // Writer A exact branch semantics.  These are the only three conditional
        // branches in the bounded 0x2B59C40..0x2B59CAE function found by V53.
        unsigned char dPath[8]{};
        unsigned char gatePath[8]{};
        unsigned char fetchPath[8]{};
        unsigned char fetchStatusPath[8]{};
        unsigned char falseEpilogue[16]{};
        const bool dPathReadable = readBytes(0x2B59C5Eu, dPath, sizeof(dPath));
        const bool gatePathReadable = readBytes(0x2B59C68u, gatePath, sizeof(gatePath));
        const bool fetchPathReadable = readBytes(0x2B59C91u, fetchPath, sizeof(fetchPath));
        const bool fetchStatusReadable = readBytes(0x3D5E151u, fetchStatusPath, sizeof(fetchStatusPath));
        const bool falseEpilogueReadable = readBytes(0x3D5E1B0u, falseEpilogue, sizeof(falseEpilogue));

        // D <- AL; TEST AL,AL; JNZ 0x2B59CA1.
        const bool dStoreExact = dPathReadable &&
            dPath[0] == 0x88u && dPath[1] == 0x43u && dPath[2] == 0x0Du;
        bool dJnzExact = false;
        std::uintptr_t dJnzTarget = 0;
        for (unsigned i = 0; dPathReadable && i + 2u <= sizeof(dPath); ++i)
        {
            if (dPath[i] == 0x75u)
            {
                dJnzTarget = static_cast<std::uintptr_t>(
                    static_cast<std::intptr_t>(0x2B59C5Eu + i + 2u) +
                    static_cast<std::int8_t>(dPath[i + 1u]));
                dJnzExact = dJnzTarget == 0x2B59CA1u;
