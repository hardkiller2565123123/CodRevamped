    // unchanged. This distinguishes "not scheduled" from "ran but gate failed".
    struct V104LiveSlot7Target144
    {
        std::uintptr_t objectOffset = 0;
        std::uintptr_t vtable = 0;
        std::uintptr_t vtableRva = 0;
        std::uintptr_t slot7 = 0;
        std::uintptr_t slot7Rva = 0;
