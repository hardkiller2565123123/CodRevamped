        g_dwSource3AltRouteDepthV22 = true;
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const bool callerInGame = base && size && caller >= base && caller < base + size;
        const auto callerRva = callerInGame ? caller - base : 0u;
        const unsigned call = g_dwSource3AltRouteCallsV22.fetch_add(1, std::memory_order_acq_rel) + 1u;
