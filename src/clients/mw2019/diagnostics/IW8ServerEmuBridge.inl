                "WRITER_BRANCH_PROOF_PARTIAL";
        const char* next =
            (writerAStaticExact && a2Eliminated && writerAHits && !writerBHits) ?
                "trace_A_RESULT_GATE_return_and_backend_field_then_update_server_response" :
                "trace_exact_live_dispatch_selection_between_writer_A_and_writer_B";

        InternalLog(
            "[DW-SOURCE3-V54] SUMMARY staticWriterAExact=%s taskFlags={D:0x%02X,E:0x%02X} lastFetchStatus=%d "
            "a2PostFetchE1Eliminated=%s liveTaskTableHits={known:%u,A:%u,B:%u,C:%u} "
            "writerCells={A:%s,B:%s} interpretation=%s next=%s stateWrites=off\r\n",
