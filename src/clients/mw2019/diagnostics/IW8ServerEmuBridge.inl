                    memcpy(&materialized, bytes + i + 2u, sizeof(materialized));
                    reg = (bytes[i + 1u] - 0xB8u) | ((bytes[i] & 0x01u) ? 8u : 0u);
                    kind = "MOV_IMM64_CALLBACK";
