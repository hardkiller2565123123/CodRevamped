        InternalLog("[DW-NATIVE-LOGIN-V50] ANCHOR index=%u label=%s codeRva=0x%llX ownerRva=%s0x%llX ownerEndRva=%s0x%llX target=native_bdLogin_transition\r\n",
            xrefIndex, anchorLabel ? anchorLabel : "?", static_cast<unsigned long long>(xref - base),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerBegin - base : 0),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerEnd - base : 0));

