    // V101: remember threads that participate in client :443 work. Wait hooks
    // only report activity from these threads, keeping the process-wide hooks
    // useful without flooding unrelated render/audio/worker waits.
    SRWLOCK g_v101TlsThreadLock = SRWLOCK_INIT;
    DWORD g_v101TlsThreads[32]{};
    unsigned g_v101TlsThreadCount = 0;
    thread_local bool g_v101WaitTraceDepth = false;

    // V102: correlate every meaningful wait on a TLS worker with the most
    // recent :443 operation executed by that same thread. This keeps the
    // diagnostic semantic/read-only while exposing the exact IW8 callsite
    // that owns long post-auth waits.
    thread_local ULONGLONG g_v102LastTlsEventMs = 0;
    thread_local SOCKET g_v102LastTlsSocket = INVALID_SOCKET;
    thread_local std::uintptr_t g_v102LastTlsCaller = 0;
    thread_local const char* g_v102LastTlsApi = "-";
    thread_local const char* g_v102LastTlsPhase = "-";

    void V101RememberTlsThread(DWORD tid) noexcept
    {
        if (!tid) return;
        AcquireSRWLockExclusive(&g_v101TlsThreadLock);
        for (unsigned i = 0; i < g_v101TlsThreadCount; ++i)
        {
            if (g_v101TlsThreads[i] == tid)
            {
                ReleaseSRWLockExclusive(&g_v101TlsThreadLock);
                return;
            }
        }
        if (g_v101TlsThreadCount < ArrayCount(g_v101TlsThreads))
            g_v101TlsThreads[g_v101TlsThreadCount++] = tid;
        ReleaseSRWLockExclusive(&g_v101TlsThreadLock);
    }

    bool V101IsTlsThread(DWORD tid) noexcept
    {
        bool found = false;
        AcquireSRWLockShared(&g_v101TlsThreadLock);
        for (unsigned i = 0; i < g_v101TlsThreadCount; ++i)
        {
            if (g_v101TlsThreads[i] == tid)
            {
                found = true;
                break;
            }
        }
        ReleaseSRWLockShared(&g_v101TlsThreadLock);
        return found;
    }

    void V100TlsTimingLog(const char* api, const char* phase, SOCKET socket,
        unsigned short port, std::uintptr_t caller, ULONGLONG startedMs,
        long long result, int error, const char* detail = nullptr) noexcept
    {
        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        const ULONGLONG now = GetTickCount64();
        const ULONGLONG elapsed = startedMs ? (now - startedMs) : 0ull;
        const DWORD tid = GetCurrentThreadId();
        if (port == 443u)
        {
            V101RememberTlsThread(tid);
            g_v102LastTlsEventMs = now;
            g_v102LastTlsSocket = socket;
            g_v102LastTlsCaller = caller;
            g_v102LastTlsApi = api ? api : "<api>";
            g_v102LastTlsPhase = phase ? phase : "<phase>";
        }
        // V101/V102: every targeted client TLS/socket event is printed directly to
        // CMD. No v100_tls_stall.log / v101 file is created.
        InternalLog("[V101-NET] t=%llu api=%s phase=%s tid=%lu socket=%llu port=%u caller=%s elapsedMs=%llu result=%lld error=%d detail=%s stateWrites=off\r\n",
            static_cast<unsigned long long>(now), api ? api : "<api>", phase ? phase : "<phase>",
            static_cast<unsigned long>(tid), static_cast<unsigned long long>(socket),
            static_cast<unsigned>(port), where, static_cast<unsigned long long>(elapsed),
            result, error, detail ? detail : "-");
    }


    std::string LowerAscii(const char* text)
    {
        std::string out = text ? text : "";
        std::transform(out.begin(), out.end(), out.begin(), [](unsigned char c) { return static_cast<char>(c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c); });
        return out;
    }

    bool ShouldRedirectHostA(const char* host) noexcept
    {
        if (!host || !*host)
            return false;
        const std::string lower = LowerAscii(host);
        const auto& cfg = ServerEmuSettings();
        if (cfg.redirectDemonware &&
            (lower.find("demonware.net") != std::string::npos || lower.find("demonware.com") != std::string::npos))
            return true;
        if (cfg.redirectBattleNet &&
            (lower.find("battle.net") != std::string::npos || lower.find("blizzard.com") != std::string::npos || lower.find("blizzard.net") != std::string::npos))
            return true;
        return false;
    }

    bool ShouldRedirectHostW(const wchar_t* host) noexcept
    {
        if (!host || !*host)
            return false;
        char utf8[1024]{};
        WideToUtf8(host, utf8, static_cast<int>(ArrayCount(utf8)));
        return ShouldRedirectHostA(utf8);
    }

