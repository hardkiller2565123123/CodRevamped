            bool hasEdx1 = false;
            std::uintptr_t edx1Site = 0;
            const std::uintptr_t backBegin = pRva > 0x30u ? pRva - 0x30u : localBeginRva;
            for (std::uintptr_t qRva = backBegin; qRva + 5u <= pRva; ++qRva)
            {
                unsigned char q[5]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + qRva), q, sizeof(q))) continue;
                if (q[0] == 0xBAu)
                {
                    std::uint32_t imm = 0; memcpy(&imm, q + 1u, sizeof(imm));
                    if (imm == 1u) { hasEdx1 = true; edx1Site = qRva; }
