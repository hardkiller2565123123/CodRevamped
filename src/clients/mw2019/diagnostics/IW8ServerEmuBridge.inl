    // V36: V35 proved the A_RESULT_FETCH branch is failure handling: while
    // dwGetLogOnStatus returns CONNECTING (1), it exits; after the status set
    // acquires entry 1 and dwGetLogOnStatus becomes FAILURE (0), it enters the
    // terminal result path.  Decode the exact 13-function status-mutator family
    // statically and trace its indirect dispatch ownership.  This is read-only:
    // no family member is hooked or invoked and no status/source3 value is changed.
    struct DwStatusFamilyMemberV36
    {
        std::uintptr_t beginRva;
        std::uintptr_t endRva;
    };

    static constexpr DwStatusFamilyMemberV36 kDwStatusFamilyV36[] = {
        {0x452F810u, 0x452F900u}, {0x452F900u, 0x452F9C7u},
        {0x452FA70u, 0x452FB26u}, {0x452FB30u, 0x452FC03u},
        {0x452FCA0u, 0x452FE48u}, {0x452FE50u, 0x452FF58u},
        {0x452FF60u, 0x4530019u}, {0x4530020u, 0x45300D9u},
        {0x45300E0u, 0x45301E7u}, {0x45301F0u, 0x45302A9u},
        {0x45302B0u, 0x4530369u}, {0x4530370u, 0x45304A3u},
        {0x45304B0u, 0x453058Fu}
    };

    static bool DwStatusV36InterestingImmediate(std::uint32_t v) noexcept
    {
        return v == 0u || v == 1u || v == 2u || v == 3u || v == 5u ||
            v == 6u || v == 0xAu || v == 0xBu || v == 0x21u;
    }

    DWORD WINAPI DwSource3StatusFamilyWorkerV36(LPVOID) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const auto module = GetModuleHandleW(nullptr);
        if (!base || !size || !module)
        {
            InternalLog("[DW-SOURCE3-V36] ERROR invalid_context stateWrites=off\r\n");
            return 0;
        }

        ImageSectionView textSec{};
        ImageSectionView rdata{};
        ImageSectionView data{};
        if (!GetImageSection(module, ".text", textSec) || !textSec.begin || !textSec.size)
        {
            InternalLog("[DW-SOURCE3-V36] ERROR missing_text stateWrites=off\r\n");
            return 0;
        }
        const bool haveRdata = GetImageSection(module, ".rdata", rdata) && rdata.begin && rdata.size;
        const bool haveData = GetImageSection(module, ".data", data) && data.begin && data.size;

        InternalLog(
            "[DW-SOURCE3-V36] BEGIN familyMembers=%zu purpose=identify_status_code1_failure_set_builder_and_dispatch "
            "mode=BACKGROUND_STATIC_READ_ONLY stateWrites=off\r\n", ArrayCount(kDwStatusFamilyV36));
        ServerEmuAppend(L"dw_source3_v36.log",
            "\r\n[DW-SOURCE3-V36] BEGIN familyMembers=%zu mode=BACKGROUND_STATIC_READ_ONLY stateWrites=off\r\n",
            ArrayCount(kDwStatusFamilyV36));

        struct MemberScore
        {
            unsigned immediates = 0;
            unsigned stores = 0;
            unsigned edges = 0;
            unsigned branches = 0;
            bool has1 = false;
            bool has2 = false;
            bool has3 = false;
            bool has21 = false;
        } scores[ArrayCount(kDwStatusFamilyV36)]{};

        unsigned totalImms = 0, totalStores = 0, totalEdges = 0, totalBranches = 0;
        for (unsigned mi = 0; mi < ArrayCount(kDwStatusFamilyV36); ++mi)
        {
            const auto& m = kDwStatusFamilyV36[mi];
            if (m.endRva <= m.beginRva || m.endRva > size)
                continue;
            const std::size_t n = static_cast<std::size_t>(m.endRva - m.beginRva);
            if (!n || n > 0x400u)
                continue;
            unsigned char code[0x400]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + m.beginRva), code, n))
                continue;

            InternalLog("[DW-SOURCE3-V36] MEMBER index=%u rva=0x%llX..0x%llX bytes=%zu\r\n",
                mi, static_cast<unsigned long long>(m.beginRva),
                static_cast<unsigned long long>(m.endRva), n);
            AppendCodeBytes144(L"dw_source3_v36.log", "[DW-SOURCE3-V36-CODE]", base + m.beginRva, 0, n);

            // Exact MOV reg,imm32 constants.
            for (std::size_t i = 0; i + 5u <= n; ++i)
            {
                if (code[i] >= 0xB8u && code[i] <= 0xBFu)
                {
                    std::uint32_t imm = 0;
                    memcpy(&imm, code + i + 1u, sizeof(imm));
                    if (DwStatusV36InterestingImmediate(imm))
                    {
                        ++scores[mi].immediates; ++totalImms;
                        scores[mi].has1 |= imm == 1u; scores[mi].has2 |= imm == 2u;
                        scores[mi].has3 |= imm == 3u; scores[mi].has21 |= imm == 0x21u;
                        InternalLog("[DW-SOURCE3-V36] IMM index=%u member=%u siteRva=0x%llX kind=MOV_REG_IMM value=0x%X\r\n",
                            totalImms, mi, static_cast<unsigned long long>(m.beginRva + i), imm);
                    }
                }

                // Common C7 /0 memory,imm32 forms (no SIB): mod=01 disp8 or mod=10 disp32.
                if (code[i] == 0xC7u && i + 7u <= n && ((code[i + 1u] >> 3) & 7u) == 0u)
                {
                    const unsigned mod = code[i + 1u] >> 6;
                    const unsigned rm = code[i + 1u] & 7u;
                    if (rm != 4u && (mod == 1u || mod == 2u))
                    {
                        const std::size_t immOff = i + (mod == 1u ? 3u : 6u);
                        if (immOff + 4u <= n)
                        {
                            std::uint32_t imm = 0;
                            memcpy(&imm, code + immOff, sizeof(imm));
                            if (DwStatusV36InterestingImmediate(imm))
                            {
                                std::int32_t disp = 0;
                                if (mod == 1u) disp = static_cast<std::int8_t>(code[i + 2u]);
                                else memcpy(&disp, code + i + 2u, sizeof(disp));
                                ++scores[mi].stores; ++totalStores;
                                scores[mi].has1 |= imm == 1u; scores[mi].has2 |= imm == 2u;
                                scores[mi].has3 |= imm == 3u; scores[mi].has21 |= imm == 0x21u;
                                InternalLog(
                                    "[DW-SOURCE3-V36] STORE index=%u member=%u siteRva=0x%llX disp=%d imm=0x%X\r\n",
                                    totalStores, mi, static_cast<unsigned long long>(m.beginRva + i), disp, imm);
                            }
                        }
                    }
                }

                if (code[i] == 0xE8u || code[i] == 0xE9u)
                {
                    std::int32_t rel = 0; memcpy(&rel, code + i + 1u, sizeof(rel));
                    const std::uintptr_t target = base + m.beginRva + i + 5u + static_cast<std::intptr_t>(rel);
                    if (target >= base && target < base + size)
                    {
                        ++scores[mi].edges; ++totalEdges;
                        InternalLog("[DW-SOURCE3-V36] EDGE index=%u member=%u kind=%s siteRva=0x%llX targetRva=0x%llX\r\n",
                            totalEdges, mi, code[i] == 0xE8u ? "CALL_REL32" : "JMP_REL32",
