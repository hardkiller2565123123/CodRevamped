        }

        // V55 correction: do not scan a fixed +0x500 past a vtable entry here.
        // That crosses function boundaries and can falsely attribute neighboring
        // +0x80 writers to the fence-id 1 virtual method. V55 performs bounded
        // owner/caller provenance instead.
