    void AnalyzeDwAuthFailurePredicate144() noexcept
    {
        bool expected = false;
        if (!g_dwAuthFailurePredicateAnalysisDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || kDwAuthFailurePredicateRva144 >= size)
        {
            InternalLog("[DW-AUTH-FAIL-PRED144] SKIP missing image/predicate stateWrites=off\r\n");
            return;
        }

        // Verify the exact caller sequence that V23 exposed:
        //   call predicate ; test al,al ; je skip-reset
        // A zero result branches over the reset path; a nonzero result falls
        // through and eventually calls the stock 0x3C1DF30 reset-latch setter.
        unsigned char caller[16]{};
        bool callOk = false;
        bool testOk = false;
        bool skipOk = false;
        std::uintptr_t callTarget = 0;
        std::uintptr_t skipTarget = 0;
        if (kDwAuthFailurePredicateCallsiteRva144 + sizeof(caller) < size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + kDwAuthFailurePredicateCallsiteRva144), caller, sizeof(caller)))
        {
            if (caller[0] == 0xE8u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, caller + 1u, sizeof(rel));
                callTarget = base + kDwAuthFailurePredicateCallsiteRva144 + 5u + static_cast<std::intptr_t>(rel);
                callOk = callTarget == base + kDwAuthFailurePredicateRva144;
            }
            testOk = caller[5] == 0x84u && caller[6] == 0xC0u;
            if (caller[7] == 0x74u)
            {
                const auto rel8 = static_cast<std::int8_t>(caller[8]);
                skipTarget = base + kDwAuthFailurePredicateCallsiteRva144 + 9u + rel8;
                skipOk = skipTarget == base + kDwAuthFailurePredicateSkipTargetRva144;
            }
        }

        InternalLog(
            "[DW-AUTH-FAIL-PRED144] CALLER_VERIFY callRva=0x%llX targetRva=%s0x%llX callMatch=%s testAl=%s jeRva=0x%llX jeTarget=%s0x%llX skipMatch=%s setterCallRva=0x%llX semantics={AL==0:skip_reset,AL!=0:enter_reset_path} mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateCallsiteRva144), callTarget ? "" : "n/a-",
            static_cast<unsigned long long>(callTarget ? callTarget - base : 0), callOk ? "YES" : "no",
            testOk ? "YES" : "no", static_cast<unsigned long long>(kDwAuthFailurePredicateSkipJccRva144),
            skipTarget ? "" : "n/a-", static_cast<unsigned long long>(skipTarget ? skipTarget - base : 0),
            skipOk ? "YES" : "no", static_cast<unsigned long long>(kDwAuthResetSetterCallsiteRva144));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-FAIL-PRED144] CALLER_VERIFY callRva=0x%llX targetRva=%s0x%llX callMatch=%s testAl=%s jeRva=0x%llX jeTarget=%s0x%llX skipMatch=%s setterCallRva=0x%llX semantics={AL==0:skip_reset,AL!=0:enter_reset_path} mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateCallsiteRva144), callTarget ? "" : "n/a-",
            static_cast<unsigned long long>(callTarget ? callTarget - base : 0), callOk ? "YES" : "no",
            testOk ? "YES" : "no", static_cast<unsigned long long>(kDwAuthFailurePredicateSkipJccRva144),
            skipTarget ? "" : "n/a-", static_cast<unsigned long long>(skipTarget ? skipTarget - base : 0),
            skipOk ? "YES" : "no", static_cast<unsigned long long>(kDwAuthResetSetterCallsiteRva144));

        const auto target = base + kDwAuthFailurePredicateRva144;
        std::uintptr_t functionBegin = 0;
        std::uintptr_t functionEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(target, functionBegin, functionEnd);
        if (!bounded || functionEnd <= functionBegin)
        {
            functionBegin = target;
            functionEnd = (std::min)(base + size, target + static_cast<std::uintptr_t>(0x400));
        }
        const auto scanEnd = (std::min)(functionEnd, functionBegin + static_cast<std::uintptr_t>(0x1000));

        InternalLog(
            "[DW-AUTH-FAIL-PRED144] BEGIN predicateRva=0x%llX function=%s0x%llX..%s0x%llX bytes=0x%llX scope=EXACT_PREDICATE_ONLY no_full_image_scan=yes mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), bounded ? "" : "fallback-",
            static_cast<unsigned long long>(functionBegin - base), bounded ? "" : "fallback-",
            static_cast<unsigned long long>(functionEnd - base), static_cast<unsigned long long>(functionEnd - functionBegin));
        ServerEmuAppend(L"dw_auth_result.log",
            "\r\n[DW-AUTH-FAIL-PRED144] BEGIN predicateRva=0x%llX function=%s0x%llX..%s0x%llX bytes=0x%llX scope=EXACT_PREDICATE_ONLY no_full_image_scan=yes mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), bounded ? "" : "fallback-",
            static_cast<unsigned long long>(functionBegin - base), bounded ? "" : "fallback-",
            static_cast<unsigned long long>(functionEnd - base), static_cast<unsigned long long>(functionEnd - functionBegin));
        AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-FAIL-PRED-CODE144]", target, 64,
            static_cast<std::size_t>((std::min)(scanEnd - functionBegin, static_cast<std::uintptr_t>(512))));

        unsigned calls = 0;
        unsigned ripRefs = 0;
        unsigned printableRefs = 0;
        unsigned compares = 0;
        unsigned branches = 0;
        for (std::uintptr_t cursor = functionBegin; cursor + 11u <= scanEnd; ++cursor)
        {
            unsigned char b[11]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && calls < 48u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1u, sizeof(rel));
                const auto callee = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (callee >= base && callee < base + size)
                {
                    ++calls;
                    InternalLog("[DW-AUTH-FAIL-PRED144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        calls, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(callee - base));
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-FAIL-PRED144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        calls, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(callee - base));
                }
            }

            if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Du || b[1] == 0x8Bu) && (b[2] & 0xC7u) == 0x05u && ripRefs < 48u)
            {
                std::int32_t displacement = 0;
                memcpy(&displacement, b + 3u, sizeof(displacement));
                const auto ref = cursor + 7u + static_cast<std::intptr_t>(displacement);
                if (ref >= base && ref < base + size)
                {
                    ++ripRefs;
                    char text[192]{};
                    const char* encoding = "?";
                    const bool printable = TryReadDwTlsPrintable144(ref, text, ArrayCount(text), encoding);
                    if (printable)
                        ++printableRefs;
                    InternalLog(
                        "[DW-AUTH-FAIL-PRED144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX printable=%s%s%s%s\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(ref - base), printable ? "yes" : "no",
                        printable ? " encoding=" : "", printable ? encoding : "", printable ? " text=SEE_dw_auth_result.log" : "");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-FAIL-PRED144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX printable=%s encoding=%s text='%s'\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(ref - base), printable ? "yes" : "no",
                        printable ? encoding : "n/a", printable ? text : "");
                }
            }

            bool isCompare = false;
            unsigned compareBytes = 0;
            unsigned long long immediate = 0;
            if (b[0] == 0x3Du)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 1u, sizeof(imm));
                immediate = imm; compareBytes = 5u; isCompare = true;
            }
            else if (b[0] == 0x83u && ((b[1] >> 3u) & 7u) == 7u)
            {
                immediate = b[2]; compareBytes = 3u; isCompare = true;
            }
            else if (b[0] == 0x81u && ((b[1] >> 3u) & 7u) == 7u)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 2u, sizeof(imm));
                immediate = imm; compareBytes = 6u; isCompare = true;
            }
            if (isCompare && compares < 48u)
            {
                ++compares;
                InternalLog("[DW-AUTH-FAIL-PRED144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-FAIL-PRED144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
            }

            unsigned branchBytes = 0;
            unsigned branchOpcode = 0;
            std::uintptr_t branchTarget = 0;
            if (b[0] >= 0x70u && b[0] <= 0x7Fu)
            {
                const auto rel8 = static_cast<std::int8_t>(b[1]);
                branchBytes = 2u; branchOpcode = b[0]; branchTarget = cursor + 2u + rel8;
            }
            else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu)
            {
                std::int32_t rel = 0; memcpy(&rel, b + 2u, sizeof(rel));
                branchBytes = 6u; branchOpcode = 0xF00u | b[1]; branchTarget = cursor + 6u + static_cast<std::intptr_t>(rel);
            }
            if (branchBytes && branchTarget >= functionBegin && branchTarget <= functionEnd && branches < 64u)
            {
                ++branches;
                InternalLog("[DW-AUTH-FAIL-PRED144] JCC index=%u instructionRva=0x%llX bytes=%u opcode=0x%X targetRva=0x%llX\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchBytes, branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base));
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-FAIL-PRED144] JCC index=%u instructionRva=0x%llX bytes=%u opcode=0x%X targetRva=0x%llX\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchBytes, branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base));
            }
        }

        InternalLog(
            "[DW-AUTH-FAIL-PRED144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u callerSemantics=NONZERO_ENTERS_RESET next=map_predicate_to_server_protocol_state stateWrites=off\r\n",
            calls, ripRefs, printableRefs, compares, branches);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-FAIL-PRED144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u callerSemantics=NONZERO_ENTERS_RESET next=map_predicate_to_server_protocol_state stateWrites=off\r\n",
            calls, ripRefs, printableRefs, compares, branches);
    }

    void AnalyzeDwAuthResetLivePath144(void* const* frames, USHORT captured) noexcept
    {
        bool expected = false;
        if (!g_dwAuthResetLivePathAnalysisDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !frames || !captured)
        {
            InternalLog("[DW-AUTH-RESET-PATH144] SKIP missing image/stack stateWrites=off\r\n");
            return;
        }

        struct LiveFrame144
        {
            std::uintptr_t address = 0;
            std::uintptr_t begin = 0;
            std::uintptr_t end = 0;
            bool bounded = false;
        };

        LiveFrame144 game[8]{};
        unsigned gameCount = 0;
        std::uintptr_t previous = 0;
        for (USHORT i = 0; i < captured && gameCount < ArrayCount(game); ++i)
        {
            const auto address = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (address < base || address >= base + size || address == previous)
                continue;
            previous = address;
            game[gameCount].address = address;
            game[gameCount].bounded = RuntimeFunctionBounds144(address, game[gameCount].begin, game[gameCount].end);
            ++gameCount;
        }

        if (!gameCount)
        {
            InternalLog("[DW-AUTH-RESET-PATH144] SKIP no game frames stateWrites=off\r\n");
            return;
        }

        AnalyzeDwAuthFailurePredicate144();

        InternalLog("[DW-AUTH-RESET-PATH144] BEGIN gameFrames=%u setterRva=0x%llX scope=LIVE_STACK_PLUS_LOCAL_CALLSITE no_full_image_scan=yes mode=READ_ONLY\r\n",
            gameCount, static_cast<unsigned long long>(kDwAuthResetWriterRva144));
