        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        constexpr std::size_t kChunk = 0x4000u;
        unsigned directHits = 0, branchHits = 0, ripHits = 0, totalHits = 0;

        ServerEmuAppend(L"ai_research.log",
            "\r\n[AI-XREF144] BEGIN targetRva=0x%llX textRva=0x%llX textSize=0x%llX filter=%s mode=STATIC_READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(targetRva), static_cast<unsigned long long>(text.rva),
            static_cast<unsigned long long>(text.size), accessFilter && *accessFilter ? accessFilter : "ALL");

        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd && totalHits < 256u; chunkVa += kChunk)
        {
            const std::size_t readSize = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(kChunk + 16u), textEnd - chunkVa));
            std::vector<unsigned char> bytes(readSize);
            if (!readSize || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes.data(), readSize))
                continue;

            const std::size_t scanSize = (std::min)(static_cast<std::size_t>(kChunk), readSize);
            for (std::size_t i = 0; i < scanSize && totalHits < 256u; ++i)
            {
                const std::uintptr_t sourceVa = chunkVa + i;
                const unsigned char* b = bytes.data() + i;
                const std::size_t available = readSize - i;
                const char* kind = nullptr;
                const char* access = "EXECUTE";

                if (available >= 5u && (b[0] == 0xE8u || b[0] == 0xE9u))
                {
                    std::int32_t rel = 0; memcpy(&rel, b + 1u, sizeof(rel));
                    if (sourceVa + 5u + static_cast<std::intptr_t>(rel) == targetVa)
                    {
                        kind = b[0] == 0xE8u ? "CALL_REL32" : "JMP_REL32";
                        ++directHits;
                    }
                }
                else if (available >= 6u && b[0] == 0x0Fu && (b[1] & 0xF0u) == 0x80u)
                {
                    std::int32_t rel = 0; memcpy(&rel, b + 2u, sizeof(rel));
                    if (sourceVa + 6u + static_cast<std::intptr_t>(rel) == targetVa)
                    {
                        kind = "JCC_REL32";
                        ++branchHits;
                    }
                }
                else if (available >= 2u && (b[0] == 0xEBu || (b[0] >= 0x70u && b[0] <= 0x7Fu)))
                {
                    const auto rel = static_cast<std::int8_t>(b[1]);
                    if (sourceVa + 2u + static_cast<std::intptr_t>(rel) == targetVa)
                    {
                        kind = b[0] == 0xEBu ? "JMP_REL8" : "JCC_REL8";
                        ++branchHits;
                    }
                }

                SimpleRipRef144 decoded{};
                if (!kind && DecodeSimpleRipRef144(b, available, decoded))
                {
                    std::int32_t displacement = 0;
                    memcpy(&displacement, b + decoded.displacementOffset, sizeof(displacement));
                    if (sourceVa + decoded.instructionLength + static_cast<std::intptr_t>(displacement) == targetVa)
                    {
                        kind = decoded.op ? decoded.op : "RIP_REF";
                        access = decoded.access ? decoded.access : "?";
                        ++ripHits;
                    }
                }

                if (!kind)
                    continue;

                if (accessFilter && *accessFilter)
                {
                    const bool readMatch = _stricmp(accessFilter, "READ") == 0 &&
                        (_stricmp(access, "READ") == 0 || _stricmp(access, "READWRITE") == 0);
                    const bool writeMatch = _stricmp(accessFilter, "WRITE") == 0 &&
                        (_stricmp(access, "WRITE") == 0 || _stricmp(access, "READWRITE") == 0);
                    const bool exactMatch = _stricmp(accessFilter, access) == 0;
                    if (!readMatch && !writeMatch && !exactMatch)
                        continue;
                }

                ++totalHits;
                std::uintptr_t ownerBegin = 0, ownerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(sourceVa, ownerBegin, ownerEnd);
                ServerEmuAppend(L"ai_research.log",
                    "[AI-XREF144-HIT] index=%u kind=%s access=%s sourceRva=0x%llX owner=%s0x%llX..%s0x%llX\r\n",
                    totalHits, kind, access, static_cast<unsigned long long>(sourceVa - base),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerEnd - base : 0u));
            }
            Sleep(0);
        }

        ServerEmuAppend(L"ai_research.log",
            "[AI-XREF144] COMPLETE targetRva=0x%llX filter=%s total=%u direct=%u branches=%u rip=%u truncated=%s read_only=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(targetRva), accessFilter && *accessFilter ? accessFilter : "ALL",
            totalHits, directHits, branchHits, ripHits, totalHits >= 256u ? "yes" : "no");
    }

    void ProbeBNetEarlyGateState144() noexcept
