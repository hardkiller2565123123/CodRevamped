                    const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                    const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                    for (std::size_t i = 0; i + length <= regionSize && hits.size() < 128u; ++i)
