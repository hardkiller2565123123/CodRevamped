    void DumpDwSource3TailJumpConditionsV20() noexcept
    {
        bool expected = false;
        if (!g_dwSource3TailJumpMapDoneV20.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        // V19's exact static xref result: these are the 16 stock JMP rel32
        // sites that target the primary source3 completion route 0x3D1E300.
        static constexpr std::uintptr_t kSites[] = {
            0x3C1E822ull, 0x3C1E837ull,
            0x3C3A8B5ull, 0x3C3A8C7ull,
            0x3C56955ull, 0x3C56967ull,
            0x3C729F5ull, 0x3C72A07ull,
            0x3C8EA95ull, 0x3C8EAA7ull,
            0x3CAAB35ull, 0x3CAAB47ull,
            0x3CC6BD5ull, 0x3CC6BE7ull,
            0x3CE2C75ull, 0x3CE2C87ull,
        };
        constexpr std::uintptr_t kExpectedTargetRva = 0x3D1E300ull;

        InternalLog("[DW-SOURCE3-V20] TAILMAP BEGIN sites=%zu expectedTarget=0x%llX mode=STATIC_READ_ONLY stateWrites=off\r\n",
            ArrayCount(kSites), static_cast<unsigned long long>(kExpectedTargetRva));
        ServerEmuAppend(L"dw_source3_v20.log",
            "[DW-SOURCE3-V20] TAILMAP BEGIN sites=%zu expectedTarget=0x%llX mode=STATIC_READ_ONLY stateWrites=off\r\n",
            ArrayCount(kSites), static_cast<unsigned long long>(kExpectedTargetRva));

        for (std::size_t i = 0; i < ArrayCount(kSites); ++i)
        {
            const auto siteRva = kSites[i];
            if (siteRva + 5u > size)
                continue;

            unsigned char jump[5]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + siteRva), jump, sizeof(jump)))
                continue;

            bool isJmpRel32 = jump[0] == 0xE9u;
            std::uintptr_t targetRva = 0;
            if (isJmpRel32)
            {
                std::int32_t rel = 0;
                memcpy(&rel, jump + 1, sizeof(rel));
                const auto target = static_cast<std::intptr_t>(siteRva + 5u) + static_cast<std::intptr_t>(rel);
                if (target >= 0)
                    targetRva = static_cast<std::uintptr_t>(target);
            }

            // Decode the closest conventional Jcc in the 48 bytes before the
            // tail-jump. This is intentionally bounded and conservative; it is
            // only provenance for the next network-response correlation.
            std::uintptr_t bestJccRva = 0;
            std::uintptr_t bestJccTargetRva = 0;
            unsigned bestCc = 0xFFu;
            const std::uintptr_t scanStart = siteRva > 48u ? siteRva - 48u : 0u;
            for (std::uintptr_t rva = scanStart; rva < siteRva; ++rva)
            {
                unsigned char b[6]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + rva), b, sizeof(b)))
                    continue;
                if (b[0] >= 0x70u && b[0] <= 0x7Fu)
                {
                    const auto rel = static_cast<signed char>(b[1]);
                    const auto target = static_cast<std::intptr_t>(rva + 2u) + static_cast<std::intptr_t>(rel);
                    if (target >= 0)
                    {
                        bestJccRva = rva;
                        bestJccTargetRva = static_cast<std::uintptr_t>(target);
                        bestCc = static_cast<unsigned>(b[0] & 0x0Fu);
                    }
                }
                else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, b + 2, sizeof(rel));
                    const auto target = static_cast<std::intptr_t>(rva + 6u) + static_cast<std::intptr_t>(rel);
                    if (target >= 0)
                    {
                        bestJccRva = rva;
                        bestJccTargetRva = static_cast<std::uintptr_t>(target);
                        bestCc = static_cast<unsigned>(b[1] & 0x0Fu);
                    }
                }
            }

            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(base + siteRva, functionBegin, functionEnd);
            InternalLog(
                "[DW-SOURCE3-V20] SITE index=%zu siteRva=0x%llX op=%s targetRva=%s0x%llX targetMatch=%s "
                "nearestJcc={rva:%s0x%llX cc:%s0x%X target:%s0x%llX} owner=%s0x%llX..%s0x%llX unwind=%s read_only=yes\r\n",
                i + 1u, static_cast<unsigned long long>(siteRva), isJmpRel32 ? "JMP_REL32" : "OTHER",
                targetRva ? "" : "n/a-", static_cast<unsigned long long>(targetRva),
                targetRva == kExpectedTargetRva ? "YES" : "no",
                bestJccRva ? "" : "n/a-", static_cast<unsigned long long>(bestJccRva),
                bestCc == 0xFFu ? "n/a-" : "", bestCc == 0xFFu ? 0u : bestCc,
                bestJccTargetRva ? "" : "n/a-", static_cast<unsigned long long>(bestJccTargetRva),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");
            ServerEmuAppend(L"dw_source3_v20.log",
                "[DW-SOURCE3-V20] SITE index=%zu siteRva=0x%llX op=%s targetRva=%s0x%llX targetMatch=%s "
                "nearestJcc={rva:%s0x%llX cc:%s0x%X target:%s0x%llX} owner=%s0x%llX..%s0x%llX unwind=%s read_only=yes\r\n",
                i + 1u, static_cast<unsigned long long>(siteRva), isJmpRel32 ? "JMP_REL32" : "OTHER",
                targetRva ? "" : "n/a-", static_cast<unsigned long long>(targetRva),
                targetRva == kExpectedTargetRva ? "YES" : "no",
                bestJccRva ? "" : "n/a-", static_cast<unsigned long long>(bestJccRva),
                bestCc == 0xFFu ? "n/a-" : "", bestCc == 0xFFu ? 0u : bestCc,
                bestJccTargetRva ? "" : "n/a-", static_cast<unsigned long long>(bestJccTargetRva),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");

            AppendCodeBytes144(L"dw_source3_v20.log", "[DW-SOURCE3-V20-CODE]", base + siteRva, 48u, 24u);
        }

        InternalLog("[DW-SOURCE3-V20] TAILMAP COMPLETE next=live_terminal_stack_correlation stateWrites=off\r\n");
        ServerEmuAppend(L"dw_source3_v20.log",
            "[DW-SOURCE3-V20] TAILMAP COMPLETE next=live_terminal_stack_correlation stateWrites=off\r\n");
    }

    void CaptureDwSource3TerminalStackV20(std::uint32_t controller, int stateMapResult) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        unsigned bitIndex = 0;
        std::uintptr_t object = 0;
        unsigned char flagD = 0xFFu;
        unsigned char flagE = 0xFFu;
        const bool flagsOk = ReadDwIngressMaskFlagsV38(controller, 0x80u, bitIndex, object, flagD, flagE);

        // Capture only the exact V19 failure signature. Earlier/nonterminal
        // state-map reads must not consume the one-shot stack slot.
        if (!flagsOk || flagE == 0u || stateMapResult != 0)
            return;

        bool expected = false;
        if (!g_dwSource3TerminalStackCapturedV20.compare_exchange_strong(expected, true))
            return;

        void* frames[48]{};
        const USHORT captured = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        InternalLog(
            "[DW-SOURCE3-V20] TERMINAL_STACK controller=%u stateMapResult=%d flags={readable:%s D:0x%02X E:0x%02X} "
            "setterCalls=%u captured=%u interpretation=%s mode=READ_ONLY stateWrites=off\r\n",
            controller, stateMapResult, flagsOk ? "yes" : "no", static_cast<unsigned>(flagD),
            static_cast<unsigned>(flagE), g_dwSource3StateSetterCalls144.load(std::memory_order_acquire),
            static_cast<unsigned>(captured),
            flagsOk && flagE != 0u ? "TASK_TERMINAL_BUT_COMPLETION_ROUTE_MISSED" : "NONTERMINAL_OR_FLAGS_UNREADABLE");
        ServerEmuAppend(L"dw_source3_v20.log",
            "\r\n[DW-SOURCE3-V20] TERMINAL_STACK controller=%u stateMapResult=%d flags={readable:%s D:0x%02X E:0x%02X} "
            "setterCalls=%u captured=%u interpretation=%s mode=READ_ONLY stateWrites=off\r\n",
            controller, stateMapResult, flagsOk ? "yes" : "no", static_cast<unsigned>(flagD),
            static_cast<unsigned>(flagE), g_dwSource3StateSetterCalls144.load(std::memory_order_acquire),
            static_cast<unsigned>(captured),
            flagsOk && flagE != 0u ? "TASK_TERMINAL_BUT_COMPLETION_ROUTE_MISSED" : "NONTERMINAL_OR_FLAGS_UNREADABLE");

        unsigned gameFrames = 0;
        for (USHORT i = 0; i < captured && gameFrames < 24u; ++i)
        {
            const auto frame = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (frame < base || frame >= base + size)
                continue;
            ++gameFrames;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
            const auto frameRva = frame - base;
            const bool inPrimaryRoute = frameRva >= 0x3D1E300ull && frameRva < 0x3D1E3B2ull;
            const bool inAltRoute = frameRva >= 0x3D5B570ull && frameRva < 0x3D5B594ull;
            ServerEmuAppend(L"dw_source3_v20.log",
                "[DW-SOURCE3-V20-FRAME] index=%u frameRva=0x%llX owner=%s0x%llX..%s0x%llX unwind=%s "
                "completionRoute=%s\r\n",
                gameFrames, static_cast<unsigned long long>(frameRva),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no",
                inPrimaryRoute ? "PRIMARY_0x3D1E300" : (inAltRoute ? "ALT_0x3D5B570" : "no"));
            AppendCodeBytes144(L"dw_source3_v20.log", "[DW-SOURCE3-V20-FRAME-CODE]", frame, 24u, 40u);
        }

        InternalLog("[DW-SOURCE3-V20] TERMINAL_STACK gameFrames=%u output=dw_source3_v20.log stateWrites=off\r\n", gameFrames);
        ServerEmuAppend(L"dw_source3_v20.log",
            "[DW-SOURCE3-V20] TERMINAL_STACK COMPLETE gameFrames=%u next=match_live_parent_to_tailmap_then_fix_server_task_result stateWrites=off\r\n",
            gameFrames);
    }

