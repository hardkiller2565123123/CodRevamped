            std::uintptr_t directObject = 0;
            std::uintptr_t pointerSlot = 0;
            if (FindDwStatusCallerRcxSourceV47(cursor, directObject, pointerSlot))
                score += 8u;

            std::uintptr_t getterBegin = 0;
            std::uintptr_t getterEnd = 0;
            const bool getterBounded = RuntimeFunctionBounds144(resolvedTarget, getterBegin, getterEnd);
            if (getterBounded && getterBegin == resolvedTarget && getterEnd > getterBegin && getterEnd - getterBegin <= 0x80u)
