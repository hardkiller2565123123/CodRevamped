        unsigned char flagD,
        unsigned char flagE,
        std::uint32_t source3State) noexcept
    {
        // This proof is only meaningful on the exact terminal A_RESULT_FETCH
        // observation: task completed (E=1) but stock still reports CONNECTING.
        if (controller < 0 || controller >= 8 || flagE != 1u || logonStatus != 1)
            return;

        bool expected = false;
        if (!g_dwSource3ConnectingBlocksDispatchProofV52.compare_exchange_strong(
                expected, true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        const bool writerToFetch = VerifyDwIngressDirectCall144(0x2B59C87u, 0x3D5E090u);
        const bool fetchToStatus = VerifyDwIngressDirectCall144(0x3D5E151u, kDwGetLogOnStatusRva144);

        unsigned char statusBranch[4]{};
        const bool branchReadable = 0x3D5E156u + sizeof(statusBranch) <= size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + 0x3D5E156u), statusBranch, sizeof(statusBranch));
        const bool branchExact = branchReadable && statusBranch[0] == 0x85u && statusBranch[1] == 0xC0u &&
            statusBranch[2] == 0x75u;
        const std::int8_t rel8 = branchExact ? static_cast<std::int8_t>(statusBranch[3]) : 0;
        const std::uintptr_t branchTargetRva = branchExact ?
            static_cast<std::uintptr_t>(0x3D5E15Au + static_cast<std::intptr_t>(rel8)) : 0u;

        unsigned char falseEpilogue[16]{};
        const bool epilogueReadable = 0x3D5E1B0u + sizeof(falseEpilogue) <= size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + 0x3D5E1B0u), falseEpilogue, sizeof(falseEpilogue));
        // 48 8B 5C 24 30 33 C0 ... => restore RBX then XOR EAX,EAX.
        const bool falseReturnExact = epilogueReadable &&
            falseEpilogue[0] == 0x48u && falseEpilogue[1] == 0x8Bu &&
            falseEpilogue[5] == 0x33u && falseEpilogue[6] == 0xC0u;

        unsigned char writerAfterFetch[16]{};
        const bool writerAfterReadable = 0x2B59C8Cu + sizeof(writerAfterFetch) <= size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + 0x2B59C8Cu), writerAfterFetch, sizeof(writerAfterFetch));

        std::uint32_t statusCount = 0;
        std::uint32_t entries[16]{};
        bool statusReadable = false;
        bool has21 = false;
        bool has1 = false;
        const std::uintptr_t statusObjectRva = kDwControllerStateBaseRva144 +
            static_cast<std::uintptr_t>(controller) * kDwControllerStateStride144;
        if (statusObjectRva + 0x84u <= size)
        {
            statusReadable = ServerEmuSafeReadU32(
                reinterpret_cast<const void*>(base + statusObjectRva + 0x80u), statusCount);
            if (statusReadable)
            {
                statusCount = (std::min)(statusCount, static_cast<std::uint32_t>(ArrayCount(entries)));
                for (std::uint32_t i = 0; i < statusCount; ++i)
                {
                    if (!ServerEmuSafeReadU32(
                            reinterpret_cast<const void*>(base + statusObjectRva + 0x0Cu + i * sizeof(std::uint32_t)),
                            entries[i]))
                    {
                        statusReadable = false;
                        break;
                    }
                    has21 = has21 || entries[i] == 0x21u;
                    has1 = has1 || entries[i] == 0x1u;
                }
            }
        }

        char entryText[256]{};
        std::size_t used = 0;
        if (statusReadable)
        {
            for (std::uint32_t i = 0; i < statusCount && used + 16u < sizeof(entryText); ++i)
            {
                const int wrote = _snprintf_s(entryText + used, sizeof(entryText) - used, _TRUNCATE,
                    "%s0x%X", i ? "," : "", entries[i]);
                if (wrote <= 0)
                    break;
                used += static_cast<std::size_t>(wrote);
            }
