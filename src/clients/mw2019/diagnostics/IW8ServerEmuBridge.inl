        const bool slot7V58Ready = InstallDwSlot7DecisionObserversV58();
        InternalLog("[DW-SLOT7-V58] sampler armResult=%s goal=bind_live_slot7_completion_to_backend_result fullV57Retained=yes stateWrites=off\r\n",
            slot7V58Ready ? "READY" : "PARTIAL");

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return 0;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        std::vector<DwAuthTrackedGlobal144> globals;
        globals.reserve(384u);

        ServerEmuAppend(L"dw_auth_result.log",
            "\r\n[DW-AUTH-RESULT144] START trigger=first_demonware_path intervalMs=10 durationMs=45000 sources={DW_AUTH_BRIDGE,DW_AUTH_PUMP,DW_GET_LOGON_STATUS,DW_STATUS_PREDICATE,FIRST_LEVEL_CALLEES,CONTROLLER_STATE_DIFF} mode=RAW_MEMORY_READ_ONLY no_game_function_calls no_state_writes\r\n");
        InternalLog("[DW-AUTH-RESULT144] START sources={DW_AUTH_BRIDGE,DW_AUTH_PUMP,DW_GET_LOGON_STATUS,DW_STATUS_PREDICATE,FIRST_LEVEL_CALLEES,CONTROLLER_STATE_DIFF} decode={MOV,LEA,CMP,MOVSS,MOVSD,INC_DEC} mode=RAW_MEMORY_READ_ONLY\r\n");
        LogDwStatusTopology144(base);
        ScanDwStatusSetWriters144(base);
        CollectDwAuthTrackedGlobals144("DW_AUTH_BRIDGE", d.DwTlsAuthBridgeFunction, globals);
      CollectDwAuthTrackedGlobals144("DW_AUTH_PUMP", d.DwTlsDemonwareAuthPumpFunction, globals);
      CollectDwAuthTrackedGlobals144("DW_GET_LOGON_STATUS", kDwGetLogOnStatusRva144, globals);
      CollectDwAuthTrackedGlobals144("DW_STATUS_PREDICATE", kDwStatusPredicateRva144, globals);

    // Auth3 helper range monitoring
    CollectDwAuthTrackedGlobals144("DW_AUTH3_HELPER", kDwAuth3HelperStartRva144, globals);
        CollectDwAuthDirectCalleeGlobals144("DW_AUTH_BRIDGE", "DW_AUTH_BRIDGE_CALLEE", d.DwTlsAuthBridgeFunction, globals);
        CollectDwAuthDirectCalleeGlobals144("DW_AUTH_PUMP", "DW_AUTH_PUMP_CALLEE", d.DwTlsDemonwareAuthPumpFunction, globals);
        CollectDwAuthDirectCalleeGlobals144("DW_GET_LOGON_STATUS", "DW_GET_LOGON_STATUS_CALLEE", kDwGetLogOnStatusRva144, globals);
        CollectDwAuthDirectCalleeGlobals144("DW_STATUS_PREDICATE", "DW_STATUS_PREDICATE_CALLEE", kDwStatusPredicateRva144, globals);

        InternalLog("[DW-AUTH-RESULT144] sampler START candidates=%llu output=dw_auth_result.log intervalMs=10 durationMs=45000 stateWrites=off\r\n",
            static_cast<unsigned long long>(globals.size()));

        for (std::size_t i = 0; i < globals.size(); ++i)
        {
            auto& item = globals[i];
            std::uint64_t initial = 0;
            item.lastValid = DwAuthReadTrackedValue144(item.address, item.width, initial);
            item.lastValue = initial;
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-CANDIDATE144] index=%llu owner=%s instructionRva=0x%llX dataRva=0x%llX width=%u writeRef=%s initial=%s0x%016llX\r\n",
                static_cast<unsigned long long>(i + 1u), item.owner ? item.owner : "?",
                static_cast<unsigned long long>(item.instruction - base),
                static_cast<unsigned long long>(item.address - base), item.width,
                item.writeReference ? "yes" : "no", item.lastValid ? "" : "UNREADABLE/",
                static_cast<unsigned long long>(item.lastValid ? item.lastValue : 0ull));
            if (i < 96u)
                InternalLog("[DW-AUTH-CANDIDATE144] index=%llu owner=%s instructionRva=0x%llX dataRva=0x%llX width=%u writeRef=%s initial=%s0x%llX\r\n",
                    static_cast<unsigned long long>(i + 1u), item.owner ? item.owner : "?",
                    static_cast<unsigned long long>(item.instruction - base),
                    static_cast<unsigned long long>(item.address - base), item.width,
                    item.writeReference ? "yes" : "no", item.lastValid ? "" : "UNREADABLE/",
                    static_cast<unsigned long long>(item.lastValid ? item.lastValue : 0ull));
        }

        std::vector<std::vector<unsigned char>> controllerPrevious(kDwControllerStateCount144);
        std::vector<bool> controllerValid(kDwControllerStateCount144, false);
        std::vector<DwStatusSetSnapshot144> controllerStatusPrevious(kDwControllerStateCount144);
        for (unsigned controller = 0; controller < kDwControllerStateCount144; ++controller)
        {
            controllerPrevious[controller].resize(kDwControllerStateStride144);
            const std::uintptr_t objectAddress = base + kDwControllerStateBaseRva144 +
                static_cast<std::uintptr_t>(controller) * kDwControllerStateStride144;
            controllerValid[controller] = ReadDwControllerStateBlock144(objectAddress, controllerPrevious[controller].data(), controllerPrevious[controller].size());
            InternalLog("[DW-AUTH-OBJECT144] baseline controller=%u objectRva=0x%llX bytes=0x%llX readable=%s mode=RAW_MEMORY_READ_ONLY\r\n",
                controller, static_cast<unsigned long long>(objectAddress - base),
                static_cast<unsigned long long>(kDwControllerStateStride144), controllerValid[controller] ? "yes" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-OBJECT144] baseline controller=%u objectRva=0x%llX bytes=0x%llX readable=%s mode=RAW_MEMORY_READ_ONLY\r\n",
                controller, static_cast<unsigned long long>(objectAddress - base),
                static_cast<unsigned long long>(kDwControllerStateStride144), controllerValid[controller] ? "yes" : "no");

            if (controllerValid[controller])
            {
                controllerStatusPrevious[controller] = ReadDwStatusSetSnapshot144(controllerPrevious[controller].data(), controllerPrevious[controller].size());
                char entries[512]{};
                FormatDwStatusEntries144(controllerStatusPrevious[controller], entries, ArrayCount(entries));
                InternalLog("[DW-AUTH-SET144] baseline controller=%u count=%u entries=%s has21=%s has1=%s derivedStatus=%u semantics={count:+0x80 entries:+0x0C} mode=READ_ONLY\r\n",
                    controller, controllerStatusPrevious[controller].count, entries,
                    controllerStatusPrevious[controller].hasSuccess21 ? "yes" : "no",
                    controllerStatusPrevious[controller].hasState1 ? "yes" : "no",
                    controllerStatusPrevious[controller].derivedStatus);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-SET144] baseline controller=%u count=%u entries=%s has21=%s has1=%s derivedStatus=%u semantics={count:+0x80 entries:+0x0C} mode=READ_ONLY\r\n",
                    controller, controllerStatusPrevious[controller].count, entries,
                    controllerStatusPrevious[controller].hasSuccess21 ? "yes" : "no",
                    controllerStatusPrevious[controller].hasState1 ? "yes" : "no",
                    controllerStatusPrevious[controller].derivedStatus);
            }
        }

        const ULONGLONG started = GetTickCount64();
        ULONGLONG nextHeartbeat = 5000ull;
        ULONGLONG nextObjectSample = 0ull;
        unsigned changes = 0;
        unsigned objectChanges = 0;
        unsigned connectionFailureCandidateChanges = 0;
        while (GetTickCount64() - started < 45000ull)
        {
            std::uint32_t firstState = 0;
            unsigned char prereq = 0;
            std::uintptr_t postFencePtr = 0;
            std::uint32_t postFence10 = 0;
            const bool firstOk = d.BNetFirstStateValue < size &&
                ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetFirstStateValue), firstState);
            const bool prereqOk = d.BNetPrereqBoolValue < size &&
                ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqBoolValue), prereq);
            const bool postPtrOk = d.BNetPostFenceObjectPtr < size &&
                ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetPostFenceObjectPtr), postFencePtr);
            const bool post10Ok = postPtrOk && postFencePtr &&
                ServerEmuSafeReadU32(reinterpret_cast<const void*>(postFencePtr + 0x10u), postFence10);

            for (std::size_t i = 0; i < globals.size(); ++i)
            {
                auto& item = globals[i];
                std::uint64_t now = 0;
                const bool valid = DwAuthReadTrackedValue144(item.address, item.width, now);
                if (!valid)
                    continue;
                if (item.lastValid && now == item.lastValue)
                    continue;

                const std::uint64_t old = item.lastValid ? item.lastValue : 0ull;
                item.lastValue = now;
                item.lastValid = true;
                ++changes;
                const auto elapsed = GetTickCount64() - started;
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-CHANGE144] change=%u t=%llums index=%llu owner=%s instructionRva=0x%llX dataRva=0x%llX width=%u writeRef=%s old=0x%016llX new=0x%016llX firstState=%s%u prereq=%d postFence+0x10=%s0x%08X mode=RAW_MEMORY_READ_ONLY\r\n",
                    changes, static_cast<unsigned long long>(elapsed), static_cast<unsigned long long>(i + 1u),
                    item.owner ? item.owner : "?", static_cast<unsigned long long>(item.instruction - base),
                    static_cast<unsigned long long>(item.address - base), item.width,
                    item.writeReference ? "yes" : "no",
                    static_cast<unsigned long long>(old), static_cast<unsigned long long>(now),
                    firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                    prereqOk ? static_cast<int>(prereq) : -1,
                    post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);

                if (changes <= 48u)
                    InternalLog("[DW-AUTH-RESULT144] change=%u t=%llums owner=%s dataRva=0x%llX width=%u old=0x%llX new=0x%llX firstState=%u prereq=%d postFence10=%s0x%X\r\n",
                        changes, static_cast<unsigned long long>(elapsed), item.owner ? item.owner : "?",
                        static_cast<unsigned long long>(item.address - base), item.width,
                        static_cast<unsigned long long>(old), static_cast<unsigned long long>(now),
                        firstOk ? firstState : 0u, prereqOk ? static_cast<int>(prereq) : -1,
                        post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);

                if (item.address == base + kDwAuthResetFlagRva144 && old == 0ull && now == 1ull)
                {
                    const unsigned liveSetterCalls = g_dwAuthResetSetterObserverCalls144.load(std::memory_order_acquire);
                    const bool liveObserverReady = g_dwAuthResetSetterObserverInstalled144.load(std::memory_order_acquire);
                    InternalLog("[DW-AUTH-RESET-LATCH144] OBSERVED change=%u t=%llums flagRva=0x%llX 0->1 firstState=%u prereq=%d postFence10=%s0x%X "
                        "liveSetterObserver=%s liveSetterCalls=%u next=use_exact_setter_call_stack stateWrites=off\r\n",
                        changes, static_cast<unsigned long long>(elapsed),
                        static_cast<unsigned long long>(kDwAuthResetFlagRva144),
                        firstOk ? firstState : 0u, prereqOk ? static_cast<int>(prereq) : -1,
                        post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u,
                        liveObserverReady ? "ready" : "NOT_READY", liveSetterCalls);
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-LATCH144] OBSERVED change=%u t=%llums flagRva=0x%llX old=0x%llX new=0x%llX firstState=%u prereq=%d postFence10=%s0x%X "
                        "liveSetterObserver=%s liveSetterCalls=%u stateWrites=off\r\n",
                        changes, static_cast<unsigned long long>(elapsed),
                        static_cast<unsigned long long>(kDwAuthResetFlagRva144),
                        static_cast<unsigned long long>(old), static_cast<unsigned long long>(now),
                        firstOk ? firstState : 0u, prereqOk ? static_cast<int>(prereq) : -1,
                        post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u,
                        liveObserverReady ? "ready" : "NOT_READY", liveSetterCalls);
                    if (!liveObserverReady || liveSetterCalls == 0u)
                    {
                        InternalLog("[DW-AUTH-RESET-LATCH144] WARNING exact setter observer missed the write; static broad writer scan intentionally skipped in V22 to avoid false instruction-boundary edges\r\n");
                    }
                }

                if (item.address == base + kDwConnectionFailureCandidateRva144)
                {
                    ++connectionFailureCandidateChanges;
                    const bool observedPopupWindow = connectionFailureCandidateChanges >= 3u &&
                        connectionFailureCandidateChanges <= 8u;
                    LogDwConnectionFailureCorrelation144(item, changes, connectionFailureCandidateChanges,
                        elapsed, old, now, observedPopupWindow);
                }
            }

            const auto objectElapsed = GetTickCount64() - started;
            if (objectElapsed >= nextObjectSample)
            {
                nextObjectSample = objectElapsed + 20ull;
                for (unsigned controller = 0; controller < kDwControllerStateCount144; ++controller)
                {
                    const std::uintptr_t objectAddress = base + kDwControllerStateBaseRva144 +
                        static_cast<std::uintptr_t>(controller) * kDwControllerStateStride144;
                    std::vector<unsigned char> now(kDwControllerStateStride144);
                    const bool valid = ReadDwControllerStateBlock144(objectAddress, now.data(), now.size());
                    if (!valid)
                    {
                        controllerValid[controller] = false;
                        continue;
                    }
                    if (!controllerValid[controller])
                    {
                        controllerPrevious[controller] = now;
                        controllerStatusPrevious[controller] = ReadDwStatusSetSnapshot144(now.data(), now.size());
                        controllerValid[controller] = true;
                        continue;
                    }

                    const auto statusNow = ReadDwStatusSetSnapshot144(now.data(), now.size());
                    if (!SameDwStatusSet144(controllerStatusPrevious[controller], statusNow))
                    {
                        char oldEntries[512]{};
                        char newEntries[512]{};
                        FormatDwStatusEntries144(controllerStatusPrevious[controller], oldEntries, ArrayCount(oldEntries));
                        FormatDwStatusEntries144(statusNow, newEntries, ArrayCount(newEntries));
                        InternalLog("[DW-AUTH-SET144] change t=%llums controller=%u count=%u->%u entries=%s->%s has21=%s->%s has1=%s->%s derivedStatus=%u->%u firstState=%u prereq=%d postFence10=%s0x%X mode=READ_ONLY\r\n",
                            static_cast<unsigned long long>(objectElapsed), controller,
                            controllerStatusPrevious[controller].count, statusNow.count, oldEntries, newEntries,
                            controllerStatusPrevious[controller].hasSuccess21 ? "yes" : "no", statusNow.hasSuccess21 ? "yes" : "no",
                            controllerStatusPrevious[controller].hasState1 ? "yes" : "no", statusNow.hasState1 ? "yes" : "no",
                            controllerStatusPrevious[controller].derivedStatus, statusNow.derivedStatus,
                            firstOk ? firstState : 0u, prereqOk ? static_cast<int>(prereq) : -1,
                            post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
                        ServerEmuAppend(L"dw_auth_result.log",
                            "[DW-AUTH-SET144] change t=%llums controller=%u count=%u->%u entries=%s->%s has21=%s->%s has1=%s->%s derivedStatus=%u->%u firstState=%s%u prereq=%d postFence+0x10=%s0x%08X mode=READ_ONLY\r\n",
                            static_cast<unsigned long long>(objectElapsed), controller,
                            controllerStatusPrevious[controller].count, statusNow.count, oldEntries, newEntries,
                            controllerStatusPrevious[controller].hasSuccess21 ? "yes" : "no", statusNow.hasSuccess21 ? "yes" : "no",
                            controllerStatusPrevious[controller].hasState1 ? "yes" : "no", statusNow.hasState1 ? "yes" : "no",
                            controllerStatusPrevious[controller].derivedStatus, statusNow.derivedStatus,
                            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                            prereqOk ? static_cast<int>(prereq) : -1,
                            post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
                        controllerStatusPrevious[controller] = statusNow;
                    }

                    for (std::size_t offset = 0; offset + 4u <= now.size(); offset += 4u)
                    {
                        std::uint32_t oldValue = 0;
                        std::uint32_t newValue = 0;
                        memcpy(&oldValue, controllerPrevious[controller].data() + offset, sizeof(oldValue));
                        memcpy(&newValue, now.data() + offset, sizeof(newValue));
                        if (oldValue == newValue)
                            continue;
                        ++objectChanges;
                        if (objectChanges <= 384u)
                        {
                            ServerEmuAppend(L"dw_auth_result.log",
                                "[DW-AUTH-OBJECT144] change=%u t=%llums controller=%u offset=+0x%04llX old=0x%08X new=0x%08X firstState=%s%u prereq=%d postFence+0x10=%s0x%08X mode=RAW_MEMORY_READ_ONLY\r\n",
                                objectChanges, static_cast<unsigned long long>(objectElapsed), controller,
                                static_cast<unsigned long long>(offset), oldValue, newValue,
                                firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                                prereqOk ? static_cast<int>(prereq) : -1,
                                post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
                            if (objectChanges <= 96u)
                                InternalLog("[DW-AUTH-OBJECT144] change=%u t=%llums controller=%u offset=+0x%04llX old=0x%08X new=0x%08X firstState=%u prereq=%d postFence10=%s0x%X\r\n",
                                    objectChanges, static_cast<unsigned long long>(objectElapsed), controller,
                                    static_cast<unsigned long long>(offset), oldValue, newValue,
                                    firstOk ? firstState : 0u, prereqOk ? static_cast<int>(prereq) : -1,
                                    post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
                        }
                    }
                    controllerPrevious[controller].swap(now);
                }
            }

            const auto heartbeatElapsed = GetTickCount64() - started;
            if (heartbeatElapsed >= nextHeartbeat)
            {
                InternalLog("[DW-AUTH-RESULT144] heartbeat t=%llums candidates=%llu changes=%u objectChanges=%u firstState=%s%u prereq=%d postFence10=%s0x%X stateWrites=off\r\n",
                    static_cast<unsigned long long>(heartbeatElapsed),
                    static_cast<unsigned long long>(globals.size()), changes, objectChanges,
                    firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                    prereqOk ? static_cast<int>(prereq) : -1,
                    post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
                nextHeartbeat += 5000ull;
            }
            Sleep(10);
        }

        DisarmDwStatusMutatorProbe144("sampler_complete");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESULT144] COMPLETE candidates=%llu changes=%u objectChanges=%u elapsedMs=%llu mode=RAW_MEMORY_READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(globals.size()), changes, objectChanges,
            static_cast<unsigned long long>(GetTickCount64() - started));
        InternalLog("[DW-AUTH-RESULT144] sampler COMPLETE candidates=%llu changes=%u objectChanges=%u output=dw_auth_result.log stateWrites=off\r\n",
            static_cast<unsigned long long>(globals.size()), changes, objectChanges);
        return 0;
    }

    void QueueDwAuthResultSampler144(const char* reason) noexcept
    {
        if (kServerEmuProductionRuntimeV92)
            return;
        if (g_dwAuthResultSamplerQueued.exchange(true, std::memory_order_acq_rel))
            return;

        InternalLog("[DW-AUTH-RESULT144] QUEUED reason=%s sources={DW_AUTH_BRIDGE,DW_AUTH_PUMP} mode=RAW_MEMORY_READ_ONLY stateWrites=off\r\n",
            reason && *reason ? reason : "unknown");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESULT144] QUEUED reason=%s mode=RAW_MEMORY_READ_ONLY stateWrites=off\r\n",
            reason && *reason ? reason : "unknown");

        HANDLE thread = CreateThread(nullptr, 0, DwAuthResultSamplerThread144, nullptr, 0, nullptr);
        if (thread)
            CloseHandle(thread);
        else
        {
            const DWORD error = GetLastError();
            g_dwAuthResultSamplerQueued.store(false, std::memory_order_release);
            InternalLog("[DW-AUTH-RESULT144] ERROR CreateThread failed error=%lu\r\n", static_cast<unsigned long>(error));
        }
    }

