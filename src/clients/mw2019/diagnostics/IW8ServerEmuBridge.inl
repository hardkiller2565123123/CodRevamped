            std::uint32_t firstState = 0;
            std::uint32_t snapshotState = 0;
            unsigned char snapshotInit = 0;
            unsigned char prereq = 0;
            unsigned char prereqInit = 0;
            std::uintptr_t postFencePtr = 0;
