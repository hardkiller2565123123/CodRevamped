    const sockaddr* RedirectServerEmuSockaddr(const sockaddr* original, int originalLen,
        sockaddr_storage& storage, int& redirectedLen, bool& redirected) noexcept
    {
        redirected = false;
        redirectedLen = originalLen;
        if (!original || originalLen <= 0 || !ServerEmuSettings().redirectBattleNet)
            return original;

        const unsigned short port = SockaddrPort(original, originalLen);
        // The BGS SDK may reuse cached/direct IPs and skip our DNS hooks entirely.
        // Keep the known plaintext bootstrap HTTP (:80) and BGS TLS (:1119) on the
        // local preservation backend even in that case. No client auth state is changed.
        if (port != 80 && port != 1119)
            return original;

        ZeroMemory(&storage, sizeof(storage));

        if (original->sa_family == AF_INET && originalLen >= static_cast<int>(sizeof(sockaddr_in)))
        {
            auto* out = reinterpret_cast<sockaddr_in*>(&storage);
            *out = *reinterpret_cast<const sockaddr_in*>(original);

            in_addr target{};
            if (InetPtonA(AF_INET, ServerEmuSettings().host, &target) != 1)
                target.S_un.S_addr = htonl(INADDR_LOOPBACK);

            out->sin_addr = target;
            out->sin_port = htons(port);
            redirectedLen = static_cast<int>(sizeof(sockaddr_in));
            redirected = true;
            return reinterpret_cast<const sockaddr*>(out);
        }

        if (original->sa_family == AF_INET6 && originalLen >= static_cast<int>(sizeof(sockaddr_in6)))
        {
            auto* out = reinterpret_cast<sockaddr_in6*>(&storage);
            *out = *reinterpret_cast<const sockaddr_in6*>(original);

            IN6_ADDR target6{};
            if (InetPtonA(AF_INET6, ServerEmuSettings().host, &target6) != 1)
            {
                ZeroMemory(&target6, sizeof(target6));
                target6.u.Byte[15] = 1; // ::1
            }

            out->sin6_addr = target6;
            out->sin6_port = htons(port);
            redirectedLen = static_cast<int>(sizeof(sockaddr_in6));
            redirected = true;
            return reinterpret_cast<const sockaddr*>(out);
        }

        return original;
    }

    int WSAAPI ServerEmuConnect(SOCKET socket, const sockaddr* name, int nameLen) noexcept
    {
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        RecordServerEmuCaller("connect", caller);
        const unsigned index = ++g_serverEmuConnectCalls;
        char endpoint[128]{};
        SockaddrToText(name, nameLen, endpoint, ArrayCount(endpoint));
        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        const unsigned short originalPort = SockaddrPort(name, nameLen);
        EnsureBgsTrustBeforeBootstrapNetwork(originalPort);
        const bool bgs1119 = originalPort == 1119;
        const bool bootstrapHttp80 = originalPort == 80;
        const bool rawTls443 = originalPort == 443;
        const bool lsgCandidatePortV60 = originalPort == 3074 || originalPort == 3075;
        const bool lsgSentinelV61 = lsgCandidatePortV60 && name && name->sa_family == AF_INET &&
            nameLen >= static_cast<int>(sizeof(sockaddr_in)) &&
            ntohl(reinterpret_cast<const sockaddr_in*>(name)->sin_addr.S_un.S_addr) == 0x00FF00FFu;
        const bool lsgDirectLoopbackV61 = lsgCandidatePortV60 && name && name->sa_family == AF_INET &&
            nameLen >= static_cast<int>(sizeof(sockaddr_in)) &&
            (ntohl(reinterpret_cast<const sockaddr_in*>(name)->sin_addr.S_un.S_addr) >> 24) == 127u;
        int socketTypeV60 = 0; int socketTypeLenV60 = sizeof(socketTypeV60);
        if (lsgCandidatePortV60) getsockopt(socket, SOL_SOCKET, SO_TYPE, reinterpret_cast<char*>(&socketTypeV60), &socketTypeLenV60);
        if (rawTls443 && !kServerEmuProductionRuntimeV92)
        {
            CaptureRawTlsGameStack144("TLS443-CONNECT", caller);
            QueueRawDemonwareTlsScan144("port443-connect");
        }
        sockaddr_storage redirectStorage{};
        int targetLen = nameLen;
        bool forcedLocal = false;
        const sockaddr* targetName = RedirectServerEmuSockaddr(name, nameLen, redirectStorage, targetLen, forcedLocal);
        // V60 route repair/probe: 0.255.0.255 is not a usable remote endpoint.
        // Redirect only this exact sentinel when the socket is STREAM and the
        // port is an LSG candidate; connected UDP/STUN/game traffic is untouched.
        if (!forcedLocal && lsgCandidatePortV60 && socketTypeV60 == SOCK_STREAM && name && name->sa_family == AF_INET && nameLen >= static_cast<int>(sizeof(sockaddr_in)))
        {
            const auto* in = reinterpret_cast<const sockaddr_in*>(name);
            if (ntohl(in->sin_addr.S_un.S_addr) == 0x00FF00FFu)
            {
                auto* out = reinterpret_cast<sockaddr_in*>(&redirectStorage);
                *out = *in;
                out->sin_addr.S_un.S_addr = htonl(INADDR_LOOPBACK);
                targetName = reinterpret_cast<const sockaddr*>(out);
                targetLen = sizeof(sockaddr_in);
                forcedLocal = true;
                InternalLog("[DW-LSG-V61] SENTINEL_STREAM_REDIRECT original=%s port=%u socketType=STREAM target=127.0.0.1:%u reason=invalid_0.255.0.255_endpoint server_protocol_route_only=yes stateWrites=off\r\n",endpoint,originalPort,originalPort);
            }
        }
        if (lsgCandidatePortV60)
            ServerEmuAppend(L"dw_pretimeout_v60.log","[DW-LSG-V61] CONNECT_CANDIDATE socket=%llu endpoint=%s port=%u socketType=%s caller=%s sentinel=%s routeRepair=%s stateWrites=off\r\n",static_cast<unsigned long long>(socket),endpoint,originalPort,socketTypeV60==SOCK_STREAM?"STREAM":(socketTypeV60==SOCK_DGRAM?"DGRAM":"OTHER"),where,(name && name->sa_family==AF_INET && nameLen>=static_cast<int>(sizeof(sockaddr_in)) && ntohl(reinterpret_cast<const sockaddr_in*>(name)->sin_addr.S_un.S_addr)==0x00FF00FFu)?"YES":"no",forcedLocal?"local":"none");
        if (lsgCandidatePortV60)
            ServerEmuAppend(L"dw_lsg_v61.log","[DW-LSG-V61] CONNECT_CANDIDATE socket=%llu endpoint=%s port=%u socketType=%s caller=%s sentinel=%s routeRepair=%s stateWrites=off\r\n",static_cast<unsigned long long>(socket),endpoint,originalPort,socketTypeV60==SOCK_STREAM?"STREAM":(socketTypeV60==SOCK_DGRAM?"DGRAM":"OTHER"),where,lsgSentinelV61?"YES":"no",forcedLocal?"local":"none");
        char targetEndpoint[128]{};
        SockaddrToText(targetName, targetLen, targetEndpoint, ArrayCount(targetEndpoint));
        CorrelateDemonwareTransport144("connect", socket, name, nameLen, caller);

        if (bgs1119)
            InternalLog("[BGS1119] connect socket=%llu original=%s target=%s forcedLocal=%s caller=%s\r\n",
                static_cast<unsigned long long>(socket), endpoint, targetEndpoint, forcedLocal ? "yes" : "no", where);
        else if (bootstrapHttp80)
            InternalLog("[HTTP80] connect socket=%llu original=%s target=%s forcedLocal=%s caller=%s\r\n",
                static_cast<unsigned long long>(socket), endpoint, targetEndpoint, forcedLocal ? "yes" : "no", where);
        else if (rawTls443)
            InternalLog("[DW-TLS-SCAN] live connect socket=%llu original=%s target=%s caller=%s read_only=yes\r\n",
                static_cast<unsigned long long>(socket), endpoint, targetEndpoint, where);

        const ULONGLONG v100Started = GetTickCount64();
        if (rawTls443)
            V100TlsTimingLog("connect", "BEGIN", socket, originalPort, caller, v100Started, 0, 0, targetEndpoint);
        const int result = g_connectOriginal ? g_connectOriginal(socket, targetName, targetLen) : SOCKET_ERROR;
        const int error = result == SOCKET_ERROR ? WSAGetLastError() : 0;
        if (rawTls443)
            V100TlsTimingLog("connect", "END", socket, originalPort, caller, v100Started, result, error, targetEndpoint);
        ServerEmuAppend(L"network_trace.log", "[CONNECT #%u] socket=%llu original=%s target=%s forcedLocal=%s result=%d wsa=%d caller=%s%s\r\n",
            index, static_cast<unsigned long long>(socket), endpoint, targetEndpoint, forcedLocal ? "yes" : "no",
            result, error, where, bgs1119 ? " BGS1119" : "");
        if (bgs1119)
            InternalLog("[BGS1119] connect result=%d wsa=%d socket=%llu\r\n",
                result, error, static_cast<unsigned long long>(socket));
        if (lsgCandidatePortV60 && socketTypeV60 == SOCK_STREAM)
        {
            g_dwLsgCandidateSocketV61.store(static_cast<std::uintptr_t>(socket));
            g_dwLsgCandidatePortV61.store(originalPort);
            g_dwLsgCandidateWasSentinelV61.store(lsgSentinelV61);
            const char* parseClass = lsgDirectLoopbackV61 ? "ENDPOINT_ACCEPTED_DIRECT" : (lsgSentinelV61 ? "SENTINEL_FALLBACK" : "OTHER_ENDPOINT");
            InternalLog("[DW-LSG-V61] CONNECT_RESULT socket=%llu original=%s target=%s result=%d wsa=%d endpointClass=%s routeRepair=%s caller=%s stateWrites=off\r\n",
                static_cast<unsigned long long>(socket), endpoint, targetEndpoint, result, error, parseClass, forcedLocal ? "local" : "none", where);
            ServerEmuAppend(L"dw_lsg_v61.log",
                "[DW-LSG-V61] CONNECT_RESULT socket=%llu original=%s target=%s result=%d wsa=%d endpointClass=%s routeRepair=%s caller=%s stateWrites=off\r\n",
                static_cast<unsigned long long>(socket), endpoint, targetEndpoint, result, error, parseClass, forcedLocal ? "local" : "none", where);
        }
        if (result == SOCKET_ERROR) WSASetLastError(error);
        return result;
    }

    int WSAAPI ServerEmuWSAConnect(SOCKET socket, const sockaddr* name, int nameLen, LPWSABUF callerData, LPWSABUF calleeData, LPQOS sqos, LPQOS gqos) noexcept
