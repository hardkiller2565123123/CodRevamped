                bytes[i + 3u] == 0x00u && bytes[i + 4u] == 0x00u && bytes[i + 5u] == 0x00u)
                r8One = true; // mov r8d,1
            if (i + 6u <= count && bytes[i] == 0x41u && bytes[i + 1u] == 0xB9u && bytes[i + 2u] == 0x01u &&
                bytes[i + 3u] == 0x00u && bytes[i + 4u] == 0x00u && bytes[i + 5u] == 0x00u)
                r9One = true; // mov r9d,1
        }
        return rcxOne || rdxOne || r8One || r9One;
    }

    void LogBNetFenceEventPathCodeV62(const char* label, std::uintptr_t beginVa, std::uintptr_t endVa) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || beginVa < base || endVa <= beginVa || beginVa >= base + size)
            return;
        const std::size_t count = static_cast<std::size_t>((std::min)(
            static_cast<std::uintptr_t>(0x240u), (std::min)(endVa - beginVa, base + size - beginVa)));
        unsigned char bytes[0x240]{};
        const bool readable = count && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(beginVa), bytes, count);
        char hex[0x240 * 3u + 1u]{};
        if (readable)
        {
            std::size_t pos = 0;
            for (std::size_t i = 0; i < count && pos + 4u < sizeof(hex); ++i)
            {
                const int wrote = snprintf(hex + pos, sizeof(hex) - pos, "%02X%s", bytes[i], (i + 1u == count) ? "" : " ");
                if (wrote <= 0)
                    break;
                pos += static_cast<std::size_t>(wrote);
            }
        }
        ServerEmuAppend(L"bnet_fence_event_path_v62.log",
            "[BNET-FENCE-PATH-V62] CODE label=%s beginRva=0x%llX endRva=0x%llX readable=%s bytes={%s}\r\n",
            label ? label : "?", static_cast<unsigned long long>(beginVa - base),
            static_cast<unsigned long long>(endVa - base), readable ? "yes" : "no", readable ? hex : "");
    }

    DWORD WINAPI BNetFenceEventPathWorkerV62(LPVOID) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return 0;
        HMODULE module = reinterpret_cast<HMODULE>(base);
        ImageSectionView text{};
        if (!GetImageSection(module, ".text", text) || !text.begin || !text.size)
            return 0;

        struct TargetV62 { const char* label; std::uintptr_t rva; };
        const TargetV62 targets[] = {
            { "event_method_A", 0x6ABA10ull },
            { "event_method_B", 0x6ABA80ull },
            { "event_method_C", 0x6ABC00ull }
        };
        constexpr std::uintptr_t kBnetBegin = 0x4600000ull;
        constexpr std::uintptr_t kBnetEnd = 0x4680000ull;

        struct OwnerV62 { std::uintptr_t beginRva; std::uintptr_t endRva; unsigned targetIndex; };
        OwnerV62 level1[96]{};
        unsigned level1Count = 0;
        unsigned exactTargets = 0;
        unsigned level1Edges = 0;
        unsigned level1Bnet = 0;
        unsigned level2Edges = 0;
        unsigned level2Bnet = 0;
        unsigned immediateOneEdges = 0;

        ServerEmuAppend(L"bnet_fence_event_path_v62.log",
            "\r\n[BNET-FENCE-PATH-V62] BEGIN exactEventKey=%s0x%08X exactRegistration=%s adapterCallsV57=%u strategy=bounded_event_bus_sibling_ancestry depth=2 mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            g_bnetFenceExactEventKeySeenV60.load(std::memory_order_acquire) ? "" : "pending/",
            g_bnetFenceExactEventKeyV60.load(std::memory_order_acquire),
            g_bnetFenceExactRegistrationCompleteV60.load(std::memory_order_acquire) ? "YES" : "no",
            g_bnetFenceAdapterCallsV57.load(std::memory_order_acquire));

        for (unsigned ti = 0; ti < static_cast<unsigned>(sizeof(targets) / sizeof(targets[0])); ++ti)
        {
            std::uintptr_t fnBegin = 0, fnEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(base + targets[ti].rva, fnBegin, fnEnd);
            const bool exact = bounded && fnBegin == base + targets[ti].rva;
            if (exact)
                ++exactTargets;
            ServerEmuAppend(L"bnet_fence_event_path_v62.log",
                "[BNET-FENCE-PATH-V62] TARGET label=%s rva=0x%llX bounded=%s exactBegin=%s owner=%s0x%llX..%s0x%llX\r\n",
                targets[ti].label, static_cast<unsigned long long>(targets[ti].rva), bounded ? "yes" : "no", exact ? "YES" : "no",
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnEnd - base : 0u));
            if (bounded)
                LogBNetFenceEventPathCodeV62(targets[ti].label, fnBegin, fnEnd);
        }

        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        constexpr std::size_t kChunk = 0x4000u;

        // First level: direct CALL/JMP edges into the three bounded event-bus siblings.
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += kChunk)
        {
            const std::size_t bytesToRead = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(kChunk), textEnd - chunkVa));
            unsigned char bytes[kChunk]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, bytesToRead))
                continue;
            for (std::size_t i = 0; i + 5u <= bytesToRead; ++i)
            {
                if (bytes[i] != 0xE8u && bytes[i] != 0xE9u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, bytes + i + 1u, sizeof(rel));
                const std::uintptr_t sourceVa = chunkVa + i;
                const std::uintptr_t targetVa = sourceVa + 5u + static_cast<std::intptr_t>(rel);
                unsigned ti = 999u;
                for (unsigned t = 0; t < static_cast<unsigned>(sizeof(targets) / sizeof(targets[0])); ++t)
                    if (targetVa == base + targets[t].rva) { ti = t; break; }
                if (ti == 999u)
                    continue;

                std::uintptr_t ownerBegin = 0, ownerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(sourceVa, ownerBegin, ownerEnd);
                const std::uintptr_t ownerRva = bounded ? ownerBegin - base : 0u;
                const bool bnet = bounded && ownerRva >= kBnetBegin && ownerRva < kBnetEnd;
                unsigned char pre[0x30]{};
                const std::uintptr_t preVa = sourceVa > base + 0x30u ? sourceVa - 0x30u : base;
                const std::size_t preCount = static_cast<std::size_t>(sourceVa - preVa);
                const bool preOk = preCount && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(preVa), pre, preCount);
                bool rcxOne=false, rdxOne=false, r8One=false, r9One=false;
                const bool anyOne = preOk && BNetV62HasImmediateOneBefore(pre, preCount, rcxOne, rdxOne, r8One, r9One);
                if (anyOne) ++immediateOneEdges;
                ++level1Edges;
                if (bnet) ++level1Bnet;
                ServerEmuAppend(L"bnet_fence_event_path_v62.log",
                    "[BNET-FENCE-PATH-V62] EDGE depth=1 target=%s kind=%s callRva=0x%llX owner=%s0x%llX..%s0x%llX bnetCluster=%s imm1={rcx:%s rdx:%s r8:%s r9:%s}\r\n",
                    targets[ti].label, bytes[i] == 0xE8u ? "CALL" : "JMP", static_cast<unsigned long long>(sourceVa - base),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerEnd - base : 0u), bnet ? "YES" : "no",
                    rcxOne?"1":"-", rdxOne?"1":"-", r8One?"1":"-", r9One?"1":"-");

                if (bounded && level1Count < static_cast<unsigned>(sizeof(level1)/sizeof(level1[0])))
                {
                    bool duplicate = false;
                    for (unsigned n=0;n<level1Count;++n) if (level1[n].beginRva == ownerRva) { duplicate=true; break; }
                    if (!duplicate)
                    {
                        level1[level1Count].beginRva = ownerRva;
                        level1[level1Count].endRva = ownerEnd - base;
                        level1[level1Count].targetIndex = ti;
                        ++level1Count;
                    }
                }
            }
        }

        // Second level: who calls the first-level owners? This is the important
        // bridge back toward the BGS/auth cluster if event emission is wrapped.
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += kChunk)
        {
            const std::size_t bytesToRead = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(kChunk), textEnd - chunkVa));
            unsigned char bytes[kChunk]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, bytesToRead))
                continue;
            for (std::size_t i = 0; i + 5u <= bytesToRead; ++i)
            {
                if (bytes[i] != 0xE8u && bytes[i] != 0xE9u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, bytes + i + 1u, sizeof(rel));
                const std::uintptr_t sourceVa = chunkVa + i;
                const std::uintptr_t targetVa = sourceVa + 5u + static_cast<std::intptr_t>(rel);
                unsigned ownerIndex = 999u;
                for (unsigned n=0;n<level1Count;++n)
                    if (targetVa == base + level1[n].beginRva) { ownerIndex=n; break; }
                if (ownerIndex == 999u)
                    continue;

                std::uintptr_t sourceBegin = 0, sourceEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(sourceVa, sourceBegin, sourceEnd);
                const std::uintptr_t sourceOwnerRva = bounded ? sourceBegin - base : 0u;
                const bool bnet = bounded && sourceOwnerRva >= kBnetBegin && sourceOwnerRva < kBnetEnd;
                unsigned char pre[0x30]{};
                const std::uintptr_t preVa = sourceVa > base + 0x30u ? sourceVa - 0x30u : base;
                const std::size_t preCount = static_cast<std::size_t>(sourceVa - preVa);
                const bool preOk = preCount && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(preVa), pre, preCount);
                bool rcxOne=false, rdxOne=false, r8One=false, r9One=false;
                const bool anyOne = preOk && BNetV62HasImmediateOneBefore(pre, preCount, rcxOne, rdxOne, r8One, r9One);
                if (anyOne) ++immediateOneEdges;
                ++level2Edges;
                if (bnet) ++level2Bnet;
                ServerEmuAppend(L"bnet_fence_event_path_v62.log",
                    "[BNET-FENCE-PATH-V62] EDGE depth=2 viaOwner=0x%llX target=%s kind=%s callRva=0x%llX owner=%s0x%llX..%s0x%llX bnetCluster=%s imm1={rcx:%s rdx:%s r8:%s r9:%s}\r\n",
                    static_cast<unsigned long long>(level1[ownerIndex].beginRva), targets[level1[ownerIndex].targetIndex].label,
                    bytes[i] == 0xE8u ? "CALL" : "JMP", static_cast<unsigned long long>(sourceVa - base),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? sourceBegin - base : 0u),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? sourceEnd - base : 0u), bnet ? "YES" : "no",
                    rcxOne?"1":"-", rdxOne?"1":"-", r8One?"1":"-", r9One?"1":"-");
                if (bnet)
                    LogBNetFenceEventPathCodeV62("bnet_ancestor", sourceBegin, sourceEnd);
            }
        }

        InternalLog("[BNET-FENCE-PATH-V62] SUMMARY exactTargets=%u level1Owners=%u level1Edges=%u level1Bnet=%u level2Edges=%u level2Bnet=%u immOneEdges=%u exactEventKey=0x%08X exactRegistration=%s next=%s output=bnet_fence_event_path_v62.log no_hooks=yes no_state_writes=yes\r\n",
            exactTargets, level1Count, level1Edges, level1Bnet, level2Edges, level2Bnet, immediateOneEdges,
            g_bnetFenceExactEventKeyV60.load(std::memory_order_acquire),
            g_bnetFenceExactRegistrationCompleteV60.load(std::memory_order_acquire) ? "YES" : "no",
            level1Bnet || level2Bnet ? "decode_BGS_ancestor_and_map_success_message_to_event1" : "extend_ancestry_from_bounded_event_methods_only");
        ServerEmuAppend(L"bnet_fence_event_path_v62.log",
            "[BNET-FENCE-PATH-V62] SUMMARY exactTargets=%u level1Owners=%u level1Edges=%u level1Bnet=%u level2Edges=%u level2Bnet=%u immOneEdges=%u exactEventKey=0x%08X exactRegistration=%s next=%s no_hooks=yes no_state_writes=yes\r\n",
            exactTargets, level1Count, level1Edges, level1Bnet, level2Edges, level2Bnet, immediateOneEdges,
            g_bnetFenceExactEventKeyV60.load(std::memory_order_acquire),
            g_bnetFenceExactRegistrationCompleteV60.load(std::memory_order_acquire) ? "YES" : "no",
            level1Bnet || level2Bnet ? "decode_BGS_ancestor_and_map_success_message_to_event1" : "extend_ancestry_from_bounded_event_methods_only");
        return 0;
    }

