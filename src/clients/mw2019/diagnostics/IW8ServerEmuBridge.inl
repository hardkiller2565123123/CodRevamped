    const char* CurlOptionName144(unsigned value) noexcept
    {
        switch (value)
        {
        case 64u: return "CURLOPT_SSL_VERIFYPEER";
        case 81u: return "CURLOPT_SSL_VERIFYHOST";
        case 10065u: return "CURLOPT_CAINFO";
        case 10097u: return "CURLOPT_CAPATH";
        case 10109u: return "CURLOPT_SSL_CTX_DATA";
        case 10230u: return "CURLOPT_PINNEDPUBLICKEY";
        case 20108u: return "CURLOPT_SSL_CTX_FUNCTION";
        default: return nullptr;
        }
    }

    bool TryReadDwTlsPrintable144(std::uintptr_t address, char* out, std::size_t outCount,
        const char*& encoding) noexcept
    {
        if (!out || outCount < 8u)
            return false;
        out[0] = '\0';
        encoding = "?";
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || address < base || address >= base + size)
            return false;

        __try
        {
            std::size_t len = 0;
            for (; len + 1 < outCount && address + len < base + size; ++len)
            {
                const unsigned char c = *reinterpret_cast<const unsigned char*>(address + len);
                if (!c)
                    break;
                if (c < 0x20 || c > 0x7E)
                {
                    len = 0;
                    break;
                }
                out[len] = static_cast<char>(c);
            }
            if (len >= 4u)
            {
                out[len] = '\0';
                encoding = "A";
                return true;
            }

            len = 0;
            for (; len + 1 < outCount && address + (len + 1u) * sizeof(wchar_t) <= base + size; ++len)
            {
                const wchar_t c = *reinterpret_cast<const wchar_t*>(address + len * sizeof(wchar_t));
                if (!c)
                    break;
                if (c < 0x20 || c > 0x7E)
                {
                    len = 0;
                    break;
                }
                out[len] = static_cast<char>(c);
            }
            if (len >= 4u)
            {
                out[len] = '\0';
                encoding = "W";
                return true;
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            out[0] = '\0';
        }
        return false;
    }

    void AnalyzeDwTlsFunction144(const char* label, std::uintptr_t rva) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !rva || rva >= size)
            return;

        const std::uintptr_t address = base + rva;
        std::uintptr_t begin = 0;
        std::uintptr_t end = 0;
        const bool bounded = RuntimeFunctionBounds144(address, begin, end);
        if (!bounded)
        {
            begin = address;
            end = (std::min)(base + size, address + static_cast<std::uintptr_t>(0x400));
        }
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x4000));

        ServerEmuAppend(L"dw_tls_chain.log",
            "\r\n[DW-TLS-CHAIN] FUNCTION label=%s seedRva=0x%llX beginRva=0x%llX endRva=0x%llX bytes=0x%llX unwind=%s read_only=yes\r\n",
            label ? label : "?",
            static_cast<unsigned long long>(rva),
            static_cast<unsigned long long>(begin - base),
            static_cast<unsigned long long>(end - base),
            static_cast<unsigned long long>(end > begin ? end - begin : 0),
            bounded ? "yes" : "no");
        AppendCodeBytes144(L"dw_tls_chain.log", "[DW-TLS-CHAIN-CODE]", begin, 0,
            static_cast<std::size_t>((std::min)(scanEnd - begin, static_cast<std::uintptr_t>(256))));

        unsigned directCalls = 0;
        unsigned stringRefs = 0;
        unsigned curlOptions = 0;
        unsigned againCompares = 0;
        __try
        {
            for (std::uintptr_t cursor = begin; cursor + 7 <= scanEnd; ++cursor)
            {
                const auto* b = reinterpret_cast<const unsigned char*>(cursor);

                if (b[0] == 0xE8 && directCalls < 96u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, b + 1, sizeof(rel));
                    const std::uintptr_t target = cursor + 5 + static_cast<std::intptr_t>(rel);
                    if (target >= base && target < base + size)
                    {
                        ++directCalls;
                        ServerEmuAppend(L"dw_tls_chain.log",
                            "[DW-TLS-CHAIN-CALL] function=%s callRva=0x%llX targetRva=0x%llX\r\n",
                            label ? label : "?",
                            static_cast<unsigned long long>(cursor - base),
                            static_cast<unsigned long long>(target - base));
                    }
                }

                if ((b[0] & 0xF0) == 0x40 && (b[1] == 0x8D || b[1] == 0x8B) && (b[2] & 0xC7) == 0x05 && stringRefs < 48u)
                {
                    std::int32_t displacement = 0;
                    memcpy(&displacement, b + 3, sizeof(displacement));
                    const std::uintptr_t target = cursor + 7 + static_cast<std::intptr_t>(displacement);
                    char text[192]{};
                    const char* encoding = "?";
                    if (TryReadDwTlsPrintable144(target, text, ArrayCount(text), encoding))
                    {
                        ++stringRefs;
                        ServerEmuAppend(L"dw_tls_chain.log",
                            "[DW-TLS-CHAIN-STRING] function=%s instructionRva=0x%llX targetRva=0x%llX encoding=%s text='%s'\r\n",
                            label ? label : "?",
                            static_cast<unsigned long long>(cursor - base),
                            static_cast<unsigned long long>(target - base), encoding, text);
                    }
                }

                // x64 curl_easy_setopt commonly materializes the CURLoption in EDX.
                // Also accept ECX/R8D/R9D so wrappers are not missed.
                unsigned option = 0;
                unsigned instructionBytes = 0;
                const char* registerName = nullptr;
                if (b[0] == 0xBA) { memcpy(&option, b + 1, sizeof(option)); instructionBytes = 5; registerName = "EDX"; }
                else if (b[0] == 0xB9) { memcpy(&option, b + 1, sizeof(option)); instructionBytes = 5; registerName = "ECX"; }
                else if (b[0] == 0x41 && b[1] == 0xB8) { memcpy(&option, b + 2, sizeof(option)); instructionBytes = 6; registerName = "R8D"; }
                else if (b[0] == 0x41 && b[1] == 0xB9) { memcpy(&option, b + 2, sizeof(option)); instructionBytes = 6; registerName = "R9D"; }

                const char* optionName = instructionBytes ? CurlOptionName144(option) : nullptr;
                if (optionName && curlOptions < 32u)
                {
                    ++curlOptions;
                    std::uintptr_t nextCall = 0;
                    for (std::uintptr_t look = cursor + instructionBytes; look + 5 <= scanEnd && look < cursor + instructionBytes + 48u; ++look)
                    {
                        if (*reinterpret_cast<const unsigned char*>(look) != 0xE8)
                            continue;
                        std::int32_t rel = 0;
                        memcpy(&rel, reinterpret_cast<const void*>(look + 1), sizeof(rel));
                        const std::uintptr_t target = look + 5 + static_cast<std::intptr_t>(rel);
                        if (target >= base && target < base + size)
                        {
                            nextCall = target;
                            break;
                        }
                    }
                    ServerEmuAppend(L"dw_tls_chain.log",
                        "[DW-TLS-CURL-OPTION] function=%s instructionRva=0x%llX register=%s value=%u name=%s nextDirectCallRva=%s0x%llX read_only=yes\r\n",
                        label ? label : "?",
                        static_cast<unsigned long long>(cursor - base), registerName,
                        option, optionName,
                        nextCall ? "" : "n/a-",
                        static_cast<unsigned long long>(nextCall ? nextCall - base : 0));
                }

                // V35 proved the raw recv wrapper maps WSAEWOULDBLOCK to 0x51.
                // 0x51 == libcurl CURLE_AGAIN; record every compare in this chain.
                if (b[0] == 0x83 && (b[1] & 0xF8) == 0xF8 && b[2] == 0x51 && againCompares < 16u)
                {
                    ++againCompares;
                    ServerEmuAppend(L"dw_tls_chain.log",
                        "[DW-TLS-CURLE-AGAIN] function=%s compareRva=0x%llX bytes=%02X %02X %02X\r\n",
                        label ? label : "?",
                        static_cast<unsigned long long>(cursor - base), b[0], b[1], b[2]);
                }
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            ServerEmuAppend(L"dw_tls_chain.log", "[DW-TLS-CHAIN] function=%s scan exception\r\n", label ? label : "?");
        }

        ServerEmuAppend(L"dw_tls_chain.log",
            "[DW-TLS-CHAIN] SUMMARY function=%s calls=%u strings=%u curlOptions=%u curleAgainCompares=%u\r\n",
            label ? label : "?", directCalls, stringRefs, curlOptions, againCompares);
    }

    void ScanDwTlsLibraryStrings144(HMODULE module) noexcept
    {
        ImageSectionView rdata{};
        ImageSectionView text{};
        if (!GetImageSection(module, ".rdata", rdata) || !GetImageSection(module, ".text", text))
            return;

        const auto base = reinterpret_cast<std::uintptr_t>(module);
        const auto imageSize = MainImageSize();
        if (!base || !imageSize)
            return;

        struct Needle { const char* label; const char* text; };
        static const Needle needles[] = {
            {"LIBCURL", "libcurl"},
            {"CURL_EASY_SETOPT", "curl_easy_setopt"},
            {"SSL_CERT_PROBLEM", "SSL certificate problem"},
            {"SSL_PEER_CERT", "SSL peer certificate"},
            {"PINNED_PUBLIC_KEY", "pinned public key"},
            {"CAFILE", "CAfile"},
            {"CAPATH", "CApath"},
            {"OPENSSL", "OpenSSL"},
            {"SCHANNEL", "schannel"},
            {"WOLFSSL", "wolfSSL"},
            {"MBEDTLS", "mbedTLS"},
            {"BORINGSSL", "BoringSSL"}
        };

        struct Hit { std::uintptr_t address; const char* label; const char* text; };
        std::vector<Hit> hits;
        const auto rBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const auto rEnd = rBegin + rdata.size;
        // rdata/text were resolved through GetImageSection above, so keep SEH out
        // of this function: hits is a std::vector and MSVC rejects __try in a
        // function that requires C++ object unwinding (C2712).
        for (const auto& needle : needles)
        {
            const std::size_t len = strlen(needle.text);
            for (std::uintptr_t cursor = rBegin; cursor + len <= rEnd && hits.size() < 128u; ++cursor)
            {
                if (memcmp(reinterpret_cast<const void*>(cursor), needle.text, len) != 0)
                    continue;
                hits.push_back({cursor, needle.label, needle.text});
                ServerEmuAppend(L"dw_tls_chain.log",
                    "[DW-TLS-LIB-STRING] label=%s rva=0x%llX text='%s'\r\n",
                    needle.label,
                    static_cast<unsigned long long>(cursor - base), needle.text);
            }
        }

        if (hits.empty())
        {
            ServerEmuAppend(L"dw_tls_chain.log", "[DW-TLS-LIB] no known curl/SSL backend strings found\r\n");
            return;
        }

        // Only sweep the live TLS/library neighborhood proven by V35. This is a
        // tiny fraction of .text and avoids bringing back the old startup hitch.
        const std::uintptr_t clusterBegin = base + 0x6E50000ull;
        const std::uintptr_t clusterEnd = (std::min)(base + imageSize, base + 0x6E90000ull);
        unsigned xrefs = 0;
        for (std::uintptr_t cursor = clusterBegin; cursor + 7 <= clusterEnd; ++cursor)
        {
            const auto* b = reinterpret_cast<const unsigned char*>(cursor);
            if ((b[0] & 0xF0) != 0x40 || (b[1] != 0x8D && b[1] != 0x8B) || (b[2] & 0xC7) != 0x05)
                continue;
            std::int32_t displacement = 0;
            memcpy(&displacement, b + 3, sizeof(displacement));
            const std::uintptr_t target = cursor + 7 + static_cast<std::intptr_t>(displacement);
            for (const auto& hit : hits)
            {
                if (target != hit.address)
                    continue;
                ++xrefs;
                std::uintptr_t functionBegin = 0, functionEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(cursor, functionBegin, functionEnd);
                ServerEmuAppend(L"dw_tls_chain.log",
                    "[DW-TLS-LIB-XREF] index=%u label=%s instructionRva=0x%llX ownerRva=%s0x%llX targetRva=0x%llX\r\n",
                    xrefs, hit.label,
                    static_cast<unsigned long long>(cursor - base),
                    bounded ? "" : "n/a-",
                    static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                    static_cast<unsigned long long>(target - base));
            }
        }
        ServerEmuAppend(L"dw_tls_chain.log", "[DW-TLS-LIB] COMPLETE strings=%llu clusterXrefs=%u\r\n",
            static_cast<unsigned long long>(hits.size()), xrefs);
    }

