    bool EnvBool(const char* name, bool defaultValue) noexcept
    {
        char value[32]{};
        const DWORD length = GetEnvironmentVariableA(name, value, static_cast<DWORD>(ArrayCount(value)));
        if (!length || length >= ArrayCount(value))
            return defaultValue;
        if (_stricmp(value, "0") == 0 || _stricmp(value, "false") == 0 || _stricmp(value, "off") == 0 || _stricmp(value, "no") == 0)
            return false;
        if (_stricmp(value, "1") == 0 || _stricmp(value, "true") == 0 || _stricmp(value, "on") == 0 || _stricmp(value, "yes") == 0)
            return true;
        return defaultValue;
    }

    BOOL CALLBACK InitServerEmuConfigOnce(PINIT_ONCE, PVOID, PVOID*) noexcept
    {
        // Set this explicitly here instead of relying only on the aggregate
        // member initializer.  The server-emulation bridge can be included in
        // a DLL with several global initialization paths, and an empty host
        // makes redirected getaddrinfo calls fail before connect() is reached.
        strcpy_s(g_serverEmuConfig.host, ArrayCount(g_serverEmuConfig.host), "127.0.0.1");

        char host[256]{};
        const DWORD length = GetEnvironmentVariableA("REVAMPED_IW8_SERVER", host, static_cast<DWORD>(ArrayCount(host)));
        if (length && length < ArrayCount(host) && host[0] != '\0')
            strncpy_s(g_serverEmuConfig.host, ArrayCount(g_serverEmuConfig.host), host, _TRUNCATE);

        if (g_serverEmuConfig.host[0] == '\0')
            strcpy_s(g_serverEmuConfig.host, ArrayCount(g_serverEmuConfig.host), "127.0.0.1");

        g_serverEmuConfig.redirectDemonware = EnvBool("REVAMPED_IW8_REDIRECT_DW", true);
        g_serverEmuConfig.redirectBattleNet = EnvBool("REVAMPED_IW8_REDIRECT_BNET", true);
        g_serverEmuConfig.tracePayloads = kServerEmuProductionRuntimeV92 ? false : EnvBool("REVAMPED_IW8_TRACE_PAYLOADS", true);
        g_serverEmuConfig.syntheticLocalWebToken = EnvBool("REVAMPED_IW8_SYNTH_WEB_TOKEN", true);
        g_serverEmuConfig.forceFirstPartyReady = false; // V51 native-only: never force bdLogin status.
        return TRUE;
    }

