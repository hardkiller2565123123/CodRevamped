    DWORD WINAPI DwSource3WriterCellOwnershipWorkerV55(LPVOID parameter) noexcept
    {
        const std::uintptr_t taskObject = reinterpret_cast<std::uintptr_t>(parameter);
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const auto module = GetModuleHandleW(nullptr);
        if (!taskObject || !base || !size || !module)
