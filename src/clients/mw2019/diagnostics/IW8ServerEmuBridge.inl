        unsigned char lastPrereq = 0xFFu;
        unsigned char lastPrereqInit = 0xFFu;
        int lastFenceFound = -1;
        int lastFenceState = -10000;
        std::uintptr_t lastPostFencePtr = static_cast<std::uintptr_t>(-1);
        std::uint32_t lastPostFenceDwords[33]{}; // +0x00 .. +0x80
        bool lastPostFenceSnapshotValid = false;
        bool firstSample = true;
        unsigned changes = 0;
        unsigned postFenceChanges = 0;

        while (GetTickCount64() - started < 75000ull)
