                sequence, static_cast<unsigned long long>(age), current.signInState, current.bnetSignedIn,
                current.bnetFailReason, current.demonwareSignedIn, current.dwLogOnStatus,
                current.firstStateReadable ? "" : "UNREADABLE/", current.firstStateReadable ? current.firstState : 0u,
                current.postFenceReadable ? "" : "UNREADABLE/", current.postFenceReadable ? current.postFenceState10 : 0u,
                current.source3Readable ? "" : "UNREADABLE/", current.source3Readable ? current.source3State : 0u,
                wait);
            return;
        }

        const ULONGLONG unchangedMs = uptimeMs >= lastChangeUptimeMs ? uptimeMs - lastChangeUptimeMs : 0;
        if (unchangedMs >= 5000u &&
            (lastStallLogUptimeMs == 0 || uptimeMs - lastStallLogUptimeMs >= 5000u))
        {
