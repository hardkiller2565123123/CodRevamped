    unsigned short ParseNumericServicePort144(const char* service) noexcept
    {
        if (!service || !*service) return 0;
        unsigned long value = 0;
        for (const unsigned char* p = reinterpret_cast<const unsigned char*>(service); *p; ++p)
        {
            if (*p < '0' || *p > '9') return 0;
            value = value * 10u + static_cast<unsigned long>(*p - '0');
            if (value > 65535u) return 0;
        }
        return static_cast<unsigned short>(value);
    }

    const char* DemonwareRouteRole144(const char* host) noexcept
    {
        const std::string lower = LowerAscii(host);
        if (lower.find("lobby") != std::string::npos) return "LOBBY";
        if (lower.find("stun") != std::string::npos) return "STUN";
        if (lower.find("umbrella") != std::string::npos) return "UMBRELLA";
        if (lower.find("auth3") != std::string::npos) return "AUTH3";
        if (lower.find("loginqueue") != std::string::npos) return "LOGINQUEUE";
        return "DEMONWARE";
    }

    void RememberDemonwareRouteResolution144(const char* api, const char* host, const char* service, bool redirected) noexcept
    {
        if (!redirected || !host || !*host) return;
        const std::string lower = LowerAscii(host);
        if (lower.find("demonware.net") == std::string::npos && lower.find("demonware.com") == std::string::npos)
            return;

        DemonwareRouteResolution144 entry{};
        entry.tickMs = GetTickCount64();
        entry.threadId = GetCurrentThreadId();
        entry.servicePort = ParseNumericServicePort144(service);
        strncpy_s(entry.host, host, _TRUNCATE);
        strncpy_s(entry.api, api ? api : "?", _TRUNCATE);
        strncpy_s(entry.role, DemonwareRouteRole144(host), _TRUNCATE);

        AcquireSRWLockExclusive(&g_dwRouteCorrelationLock144);
        g_dwRouteResolutions144[g_dwRouteResolutionWrite144] = entry;
        g_dwRouteResolutionWrite144 = (g_dwRouteResolutionWrite144 + 1u) % ArrayCount(g_dwRouteResolutions144);
        if (g_dwRouteResolutionCount144 < ArrayCount(g_dwRouteResolutions144)) ++g_dwRouteResolutionCount144;
        ReleaseSRWLockExclusive(&g_dwRouteCorrelationLock144);

        ServerEmuAppend(L"network_trace.log",
            "[DW-ROUTE-DNS144] api=%s host='%s' role=%s service='%s' servicePort=%u thread=%lu redirect=yes target='%s' stateWrites=off\r\n",
            entry.api, entry.host, entry.role, service ? service : "", static_cast<unsigned>(entry.servicePort),
            static_cast<unsigned long>(entry.threadId), ServerEmuSettings().host);
    }

