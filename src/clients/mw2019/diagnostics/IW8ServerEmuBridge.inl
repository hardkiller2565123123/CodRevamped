                if (target < base || target >= base + size)
                    continue;
                ++calleeRipRefs;
                char printable[192]{};
                const char* encoding = nullptr;
                const bool printableOk = TryReadDwTlsPrintable144(target, printable, ArrayCount(printable), encoding);
