            }
            if (hasEdx1) ++incomingEvent1;
            InternalLog("[DW-SOURCE3-V39] OWNER_INCOMING index=%u siteRva=0x%llX targetRva=0x%llX kind=%s edx1Nearby=%s edx1Site=%s0x%llX\r\n",
                incomingEdges, static_cast<unsigned long long>(pRva),
                static_cast<unsigned long long>(targetRva), b[0] == 0xE8u ? "CALL" : "JMP",
                hasEdx1 ? "YES" : "no", edx1Site ? "" : "n/a-",
                static_cast<unsigned long long>(edx1Site));
        }

        LogDwSource3V39Hex("MEMBER0_SWITCH", 0x452F810u, 0xF0u);
        const bool exactStatus1 = mapOk && targetsOk && commandMap[1] < ArrayCount(caseTargets) &&
            static_cast<std::uintptr_t>(caseTargets[commandMap[1]]) == kStatus1CaseRva;
        const char* interpretation = hardcodedEvent1 ? "STATUS1_EVENT1_INDIRECT_SITE_FOUND" :
            incomingEvent1 ? "STATUS1_EVENT1_OWNER_CALLER_FOUND" :
            exactStatus1 ? "STATUS1_COMMAND1_PROVEN_NEED_DYNAMIC_EDX_PROVENANCE" :
            "STATUS1_SWITCH_MAPPING_UNRESOLVED";

        InternalLog("[DW-SOURCE3-V39] SUMMARY mapOk=%s targetsOk=%s status1Commands=%u status3Commands=%u owner0Loop=%s edxSources=%u hardcodedEvent1=%u inheritedOrDynamic=%u incomingEdges=%u incomingEvent1=%u status1CallRva=0x%llX interpretation=%s next=trace_event1_origin_to_backend_failure stateWrites=off\r\n",
            mapOk ? "YES" : "no", targetsOk ? "YES" : "no", status1Commands, status3Commands,
            owner0Loop ? "YES" : "no", edxSources, hardcodedEvent1, inheritedOrDynamic,
            incomingEdges, incomingEvent1, static_cast<unsigned long long>(kStatus1CallRva), interpretation);
        ServerEmuAppend(L"dw_source3_v39_status1.log",
            "[DW-SOURCE3-V39] SUMMARY mapOk=%s targetsOk=%s status1Commands=%u status3Commands=%u owner0Loop=%s edxSources=%u hardcodedEvent1=%u inheritedOrDynamic=%u incomingEdges=%u incomingEvent1=%u status1CallRva=0x%llX interpretation=%s next=trace_event1_origin_to_backend_failure stateWrites=off\r\n",
            mapOk ? "YES" : "no", targetsOk ? "YES" : "no", status1Commands, status3Commands,
            owner0Loop ? "YES" : "no", edxSources, hardcodedEvent1, inheritedOrDynamic,
            incomingEdges, incomingEvent1, static_cast<unsigned long long>(kStatus1CallRva), interpretation);
        InternalLog("[DW-GRAPH-V51] SKIPPED reason=runtime_terminal_state_writer_proof_supersedes_broad_graph next=wait_for_E1_then_snapshot_missing_callback_dispatch stateWrites=off\r\n");
