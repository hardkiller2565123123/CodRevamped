        if (memcmp(target, localKey, sizeof(localKey)) != 0)
        {
            InternalLog("[AUTH3-TRUST] public-key write did not persist; refusing to mark ready\r\n");
            return false;
        }

        char pathUtf8[32768]{};
        if (keyPath[0]) WideToUtf8(keyPath, pathUtf8, static_cast<int>(ArrayCount(pathUtf8)));
        g_auth3SigningTrustPatched.store(true);
        InternalLog("[AUTH3-TRUST] PATCHED response verifier public key rva=0x%llX bytes=294 format=DER source=%s\r\n",
            static_cast<unsigned long long>(keyRva), pathUtf8[0] ? pathUtf8 : "<loaded>");
        InternalLog("[AUTH3-TRUST] scope=RSA-PSS response authenticity ONLY; .text untouched clientStateHooks=0 auth/fence/LUI state remains server-driven\r\n");
        ServerEmuAppend(L"network_trace.log",
