            std::uintptr_t tableRva;
            std::uintptr_t objectOffset;
            const char* label;
        };
        static constexpr Materializer mats[] = {
            {0x2B5B057u, 0x6F1A158u, 0x00u, "TASK_TABLE_00"},
            {0x2B5B097u, 0x6F1A230u, 0x50u, "TASK_TABLE_50"},
            {0x2B5B1D7u, 0x6F1A2F0u, 0xA0u, "TASK_TABLE_A0"},
            {0x2B5B297u, 0x6F1A248u, 0xF0u, "TASK_TABLE_F0"},
        };

        struct Span
        {
            std::uintptr_t begin{};
            std::uintptr_t end{};
            bool runtimeBounds{};
        };
        Span spans[ArrayCount(mats)]{};

        auto findSpan = [&](std::uintptr_t siteVa) -> Span {
            Span out{};
            if (RuntimeFunctionBounds144(siteVa, out.begin, out.end) && out.end > out.begin)
            {
                out.runtimeBounds = true;
                return out;
            }

            constexpr std::size_t kBack = 0x80u;
            constexpr std::size_t kForward = 0x180u;
            const std::uintptr_t windowBegin = siteVa > base + kBack ? siteVa - kBack : base;
            const std::size_t windowBytes = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(kBack + kForward), base + size - windowBegin));
            unsigned char bytes[kBack + kForward]{};
            if (!windowBytes || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(windowBegin), bytes, windowBytes))
                return out;

            const std::size_t siteIndex = static_cast<std::size_t>(siteVa - windowBegin);
            std::size_t startIndex = siteIndex;
            for (std::size_t j = siteIndex; j > 1u; --j)
            {
                if ((bytes[j - 1u] == 0xCCu && bytes[j - 2u] == 0xCCu) || bytes[j - 1u] == 0xC3u)
                {
                    startIndex = j;
                    while (startIndex < siteIndex && bytes[startIndex] == 0xCCu)
                        ++startIndex;
                    break;
                }
            }

            std::size_t endIndex = siteIndex;
            for (std::size_t j = siteIndex; j < windowBytes; ++j)
            {
                if (bytes[j] == 0xC3u)
                {
                    endIndex = j + 1u;
                    break;
                }
                if (j + 5u <= windowBytes && bytes[j] == 0xE9u)
                {
                    endIndex = j + 5u;
                    break;
                }
            }
            if (endIndex <= startIndex)
                endIndex = (std::min)(windowBytes, siteIndex + 0x80u);

            out.begin = windowBegin + startIndex;
            out.end = windowBegin + endIndex;
            return out;
        };

        InternalLog(
            "[DW-SOURCE3-V32] BEGIN object=%p purpose=decode_exact_task_table_materializers_and_callers "
            "sites={0x2B5B057,0x2B5B097,0x2B5B1D7,0x2B5B297} mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(object));
        ServerEmuAppend(L"dw_source3_v32.log",
            "\r\n[DW-SOURCE3-V32] BEGIN object=%p purpose=decode_exact_task_table_materializers_and_callers "
            "sites={0x2B5B057,0x2B5B097,0x2B5B1D7,0x2B5B297} mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(object));

        unsigned materializers = 0;
        unsigned storesAfterTableLoad = 0;
        unsigned outgoingCalls = 0;
        unsigned outgoingTailJumps = 0;
        unsigned branches = 0;

        for (unsigned mi = 0; mi < ArrayCount(mats); ++mi)
        {
            const auto& mat = mats[mi];
            const std::uintptr_t siteVa = base + mat.siteRva;
            spans[mi] = findSpan(siteVa);
            const auto& span = spans[mi];
            ++materializers;

            InternalLog(
                "[DW-SOURCE3-V32] MATERIALIZER index=%u label=%s siteRva=0x%llX tableRva=0x%llX taskOff=+0x%02llX "
                "span=%s0x%llX..%s0x%llX bounds=%s\r\n",
                mi + 1u, mat.label,
                static_cast<unsigned long long>(mat.siteRva),
                static_cast<unsigned long long>(mat.tableRva),
                static_cast<unsigned long long>(mat.objectOffset),
                span.begin ? "" : "n/a-", static_cast<unsigned long long>(span.begin ? span.begin - base : 0u),
                span.end ? "" : "n/a-", static_cast<unsigned long long>(span.end ? span.end - base : 0u),
                span.runtimeBounds ? "UNWIND" : "PADDING_HEURISTIC");
            AppendCodeBytes144(L"dw_source3_v32.log", "[DW-SOURCE3-V32-MATERIALIZER-CODE]", siteVa, 64u, 128u);

            unsigned char after[64]{};
            if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(siteVa), after, sizeof(after)))
            {
                // The V31 sites are RIP-relative table materializations. Decode the
                // stores immediately following them so we can see which object field
                // receives each table pointer without executing or modifying anything.
                for (std::size_t i = 0; i + 3u <= sizeof(after); ++i)
                {
                    if ((after[i] == 0x48u || after[i] == 0x49u) && after[i + 1u] == 0x89u)
                    {
                        const unsigned modrm = after[i + 2u];
                        const unsigned mod = (modrm >> 6u) & 3u;
                        const unsigned reg = (modrm >> 3u) & 7u;
                        const unsigned rm = modrm & 7u;
                        if (mod != 3u && reg == 0u)
                        {
                            long long disp = 0;
                            std::size_t len = 3u;
                            if (mod == 1u && i + 4u <= sizeof(after))
                            {
                                disp = static_cast<signed char>(after[i + 3u]);
                                len = 4u;
                            }
                            else if (mod == 2u && i + 7u <= sizeof(after))
                            {
                                std::int32_t d32 = 0;
                                memcpy(&d32, after + i + 3u, sizeof(d32));
                                disp = d32;
                                len = 7u;
                            }
                            else if (mod == 0u && rm == 5u)
                            {
                                continue; // RIP-relative store, not object-field store.
                            }
                            ++storesAfterTableLoad;
                            InternalLog(
                                "[DW-SOURCE3-V32] STORE_AFTER_TABLE index=%u label=%s siteRva=0x%llX storeRva=0x%llX "
                                "rex=0x%02X modrm=0x%02X baseRm=%u disp=%lld bytes=%llu source=RAX_candidate\r\n",
                                storesAfterTableLoad, mat.label,
                                static_cast<unsigned long long>(mat.siteRva),
                                static_cast<unsigned long long>(mat.siteRva + i),
                                static_cast<unsigned>(after[i]), modrm, rm, disp,
                                static_cast<unsigned long long>(len));
                        }
                    }
                }
            }

            if (!span.begin || !span.end || span.end <= span.begin)
                continue;
            const std::size_t spanSize = static_cast<std::size_t>((std::min)(
                span.end - span.begin, static_cast<std::uintptr_t>(0x300u)));
            unsigned char code[0x300]{};
            if (!spanSize || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(span.begin), code, spanSize))
                continue;

            for (std::size_t i = 0; i < spanSize; ++i)
            {
                const std::uintptr_t sourceVa = span.begin + i;
                if (i + 5u <= spanSize && (code[i] == 0xE8u || code[i] == 0xE9u))
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, code + i + 1u, sizeof(rel));
                    const std::uintptr_t dest = sourceVa + 5u + static_cast<std::intptr_t>(rel);
                    const bool inImage = dest >= base && dest < base + size;
                    if (code[i] == 0xE8u)
                        ++outgoingCalls;
                    else
                        ++outgoingTailJumps;
                    InternalLog(
                        "[DW-SOURCE3-V32] OUT_EDGE label=%s kind=%s siteRva=0x%llX targetRva=%s0x%llX\r\n",
                        mat.label, code[i] == 0xE8u ? "CALL_REL32" : "JMP_REL32",
                        static_cast<unsigned long long>(sourceVa - base),
                        inImage ? "" : "n/a-",
                        static_cast<unsigned long long>(inImage ? dest - base : 0u));
                }
                else if (i + 2u <= spanSize && code[i] >= 0x70u && code[i] <= 0x7Fu)
                {
                    const std::int8_t rel = static_cast<std::int8_t>(code[i + 1u]);
                    ++branches;
                    InternalLog(
                        "[DW-SOURCE3-V32] BRANCH label=%s kind=JCC8 siteRva=0x%llX opcode=0x%02X targetRva=0x%llX\r\n",
                        mat.label, static_cast<unsigned long long>(sourceVa - base),
                        static_cast<unsigned>(code[i]),
                        static_cast<unsigned long long>(sourceVa + 2u + rel - base));
                }
                else if (i + 6u <= spanSize && code[i] == 0x0Fu && code[i + 1u] >= 0x80u && code[i + 1u] <= 0x8Fu)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, code + i + 2u, sizeof(rel));
                    ++branches;
                    InternalLog(
                        "[DW-SOURCE3-V32] BRANCH label=%s kind=JCC32 siteRva=0x%llX opcode=0x0F%02X targetRva=0x%llX\r\n",
                        mat.label, static_cast<unsigned long long>(sourceVa - base),
                        static_cast<unsigned>(code[i + 1u]),
                        static_cast<unsigned long long>(sourceVa + 6u + rel - base));
                }
            }
        }

        // Find callers of the materializer function entries. V31's four LEAs had
        // no unwind owner, so scan direct edges to both the inferred span start and
        // the exact LEA site. This tells us which parent creates/configures the task.
        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        unsigned incomingEdges = 0;
        unsigned incomingCallers = 0;
        unsigned char textChunk[0x8000]{};
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += sizeof(textChunk))
        {
            const std::size_t bytesToRead = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(sizeof(textChunk)), textEnd - chunkVa));
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), textChunk, bytesToRead))
                continue;

            for (std::size_t i = 0; i + 5u <= bytesToRead; ++i)
            {
                if (textChunk[i] != 0xE8u && textChunk[i] != 0xE9u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, textChunk + i + 1u, sizeof(rel));
                const std::uintptr_t sourceVa = chunkVa + i;
                const std::uintptr_t dest = sourceVa + 5u + static_cast<std::intptr_t>(rel);

                int matched = -1;
                const char* targetClass = nullptr;
                for (unsigned mi = 0; mi < ArrayCount(mats); ++mi)
                {
                    if (spans[mi].begin && dest == spans[mi].begin)
                    {
                        matched = static_cast<int>(mi);
                        targetClass = "FUNCTION_START";
                        break;
                    }
                    if (dest == base + mats[mi].siteRva)
                    {
                        matched = static_cast<int>(mi);
                        targetClass = "EXACT_LEA_SITE";
                        break;
                    }
                }
                if (matched < 0)
                    continue;

                ++incomingEdges;
                std::uintptr_t ownerBegin = 0;
                std::uintptr_t ownerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(sourceVa, ownerBegin, ownerEnd) && ownerEnd > ownerBegin;
                if (bounded)
                    ++incomingCallers;
                InternalLog(
                    "[DW-SOURCE3-V32] INCOMING index=%u label=%s kind=%s callRva=0x%llX targetClass=%s targetRva=0x%llX "
                    "caller=%s0x%llX..%s0x%llX\r\n",
                    incomingEdges, mats[static_cast<unsigned>(matched)].label,
                    textChunk[i] == 0xE8u ? "CALL_REL32" : "JMP_REL32",
                    static_cast<unsigned long long>(sourceVa - base), targetClass,
                    static_cast<unsigned long long>(dest - base),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerEnd - base : 0u));
                AppendCodeBytes144(L"dw_source3_v32.log", "[DW-SOURCE3-V32-INCOMING-CALLER]", sourceVa, 64u, 128u);
            }
        }

        // Also find exact .rdata cells that point at the inferred materializer
        // entries. If present, these are constructor/registration tables rather than
        // normal direct calls and give us the next dispatch object to follow.
        const std::uintptr_t rdataBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const std::uintptr_t rdataEnd = rdataBegin + rdata.size;
        unsigned materializerPtrCells = 0;
        for (std::uintptr_t cell = rdataBegin; cell + sizeof(std::uintptr_t) <= rdataEnd; cell += sizeof(std::uintptr_t))
        {
            std::uintptr_t value = 0;
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cell), &value, sizeof(value)))
                continue;
            for (unsigned mi = 0; mi < ArrayCount(mats); ++mi)
            {
                if ((!spans[mi].begin || value != spans[mi].begin) && value != base + mats[mi].siteRva)
                    continue;
                ++materializerPtrCells;
                InternalLog(
                    "[DW-SOURCE3-V32] MATERIALIZER_PTR index=%u label=%s cellRva=0x%llX targetRva=0x%llX targetClass=%s\r\n",
                    materializerPtrCells, mats[mi].label,
                    static_cast<unsigned long long>(cell - base),
                    static_cast<unsigned long long>(value - base),
                    spans[mi].begin && value == spans[mi].begin ? "FUNCTION_START" : "EXACT_LEA_SITE");
            }
        }

        const char* interpretation =
            incomingEdges ? "TASK_TABLE_MATERIALIZER_CALLER_FOUND" :
            materializerPtrCells ? "TASK_TABLE_MATERIALIZER_REGISTERED_INDIRECTLY" :
            storesAfterTableLoad ? "TASK_TABLE_CONSTRUCTOR_RECIPE_FOUND_NO_DIRECT_CALLER" :
            "TASK_TABLE_MATERIALIZER_DECODED_NO_OWNER";

        InternalLog(
            "[DW-SOURCE3-V32] SUMMARY materializers=%u storesAfterLoad=%u outgoingCalls=%u outgoingTailJumps=%u "
            "branches=%u incomingEdges=%u incomingCallers=%u materializerPtrCells=%u interpretation=%s "
            "next=trace_constructor_parent_arguments_to_slot7_task stateWrites=off\r\n",
            materializers, storesAfterTableLoad, outgoingCalls, outgoingTailJumps, branches,
            incomingEdges, incomingCallers, materializerPtrCells, interpretation);
        ServerEmuAppend(L"dw_source3_v32.log",
            "[DW-SOURCE3-V32] SUMMARY materializers=%u storesAfterLoad=%u outgoingCalls=%u outgoingTailJumps=%u "
            "branches=%u incomingEdges=%u incomingCallers=%u materializerPtrCells=%u interpretation=%s "
            "next=trace_constructor_parent_arguments_to_slot7_task stateWrites=off\r\n",
            materializers, storesAfterTableLoad, outgoingCalls, outgoingTailJumps, branches,
            incomingEdges, incomingCallers, materializerPtrCells, interpretation);
        return 0;
    }

    void QueueDwSource3MaterializerOwnerScanV32(std::uintptr_t object) noexcept
    {
        static std::atomic_bool queued{false};
        if (queued.exchange(true, std::memory_order_acq_rel))
            return;
        HANDLE thread = CreateThread(nullptr, 0, &DwSource3MaterializerOwnerWorkerV32,
            reinterpret_cast<LPVOID>(object), 0, nullptr);
        if (!thread)
        {
            InternalLog("[DW-SOURCE3-V32] QUEUE_FAILED error=%lu object=%p stateWrites=off\r\n",
                static_cast<unsigned long>(GetLastError()), reinterpret_cast<void*>(object));
            return;
        }
        CloseHandle(thread);
        InternalLog(
            "[DW-SOURCE3-V32] QUEUED object=%p scan=exact_task_table_materializer_owner mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(object));
    }


    void LogDwSource3V35HexWindow(const char* label, std::uintptr_t rva, std::size_t bytes) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || rva >= size || !bytes)
            return;
        const std::size_t capped = (std::min)(bytes, static_cast<std::size_t>(0x100u));
        unsigned char raw[0x100]{};
        if (rva + capped > size || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + rva), raw, capped))
        {
            InternalLog("[DW-SOURCE3-V35] CODE label=%s rva=0x%llX readable=no\r\n",
                label, static_cast<unsigned long long>(rva));
            return;
        }
        for (std::size_t off = 0; off < capped; off += 32u)
        {
            const std::size_t n = (std::min)(static_cast<std::size_t>(32u), capped - off);
            char hex[32u * 3u + 1u]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < n && used + 4u < ArrayCount(hex); ++i)
                used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", raw[off + i]));
            InternalLog("[DW-SOURCE3-V35] CODE label=%s rva=0x%llX bytes={%s}\r\n",
                label, static_cast<unsigned long long>(rva + off), hex);
            ServerEmuAppend(L"dw_source3_v35.log",
                "[DW-SOURCE3-V35] CODE label=%s rva=0x%llX bytes={%s}\r\n",
                label, static_cast<unsigned long long>(rva + off), hex);
        }
    }


