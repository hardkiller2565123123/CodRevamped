        installBootstrap("WSAIoctl", reinterpret_cast<void*>(&ServerEmuWSAIoctl), g_wsaIoctlOriginal);

        // V101: keep peer-443 receive timing and add wait-correlation hooks.
        // No payload bytes are inspected or modified.
        const bool v100RecvHook = installWs2("recv", reinterpret_cast<void*>(&V100RecvTiming), g_recvOriginal);
        const bool v100WsaRecvHook = installWs2("WSARecv", reinterpret_cast<void*>(&V100WSARecvTiming), g_wsaRecvOriginal);
        const bool v101SelectHook = installWs2("select", reinterpret_cast<void*>(&V101SelectTiming), g_selectOriginal);
        const bool v101PollHook = installWs2("WSAPoll", reinterpret_cast<void*>(&V101WSAPollTiming), g_wsaPollOriginal);
        const bool v101WaitEventsHook = installWs2("WSAWaitForMultipleEvents", reinterpret_cast<void*>(&V101WSAWaitForMultipleEventsTiming), g_wsaWaitForMultipleEventsOriginal);
        InternalLog("[V101-NET] hooks recv=%s WSARecv=%s select=%s WSAPoll=%s WSAWaitForMultipleEvents=%s scope=443-worker-threads payloadCapture=off CMD_ONLY\r\n",
            v100RecvHook ? "ready" : "FAILED", v100WsaRecvHook ? "ready" : "FAILED",
            v101SelectHook ? "ready" : "FAILED", v101PollHook ? "ready" : "FAILED", v101WaitEventsHook ? "ready" : "FAILED");

        // Game-IAT-only kernel wait hooks. They emit only when the current thread
        // has already participated in :443 client work.
        const bool v101Sleep = PatchImport(game, "KERNEL32.dll", "Sleep", reinterpret_cast<void*>(&V101SleepTiming), g_sleepOriginalV101);
        const bool v101SleepEx = PatchImport(game, "KERNEL32.dll", "SleepEx", reinterpret_cast<void*>(&V101SleepExTiming), g_sleepExOriginalV101);
        const bool v101WaitOne = PatchImport(game, "KERNEL32.dll", "WaitForSingleObject", reinterpret_cast<void*>(&V101WaitForSingleObjectTiming), g_waitForSingleObjectOriginalV101);
        const bool v101WaitOneEx = PatchImport(game, "KERNEL32.dll", "WaitForSingleObjectEx", reinterpret_cast<void*>(&V101WaitForSingleObjectExTiming), g_waitForSingleObjectExOriginalV101);
        InternalLog("[V101-WAIT] game-IAT hooks Sleep=%s SleepEx=%s WaitForSingleObject=%s WaitForSingleObjectEx=%s TLS-thread-filter=ON CMD_ONLY\r\n",
            v101Sleep ? "ready" : "n/a", v101SleepEx ? "ready" : "n/a",
            v101WaitOne ? "ready" : "n/a", v101WaitOneEx ? "ready" : "n/a");

        iatInstalled += PatchImport(game, "WINHTTP.dll", "WinHttpConnect", reinterpret_cast<void*>(&ServerEmuWinHttpConnect), g_winHttpConnectOriginal) ? 1u : 0u;
        iatInstalled += PatchImport(game, "WINHTTP.dll", "WinHttpOpenRequest", reinterpret_cast<void*>(&ServerEmuWinHttpOpenRequest), g_winHttpOpenRequestOriginal) ? 1u : 0u;
        iatInstalled += PatchImport(game, "WINHTTP.dll", "WinHttpSendRequest", reinterpret_cast<void*>(&ServerEmuWinHttpSendRequest), g_winHttpSendRequestOriginal) ? 1u : 0u;
