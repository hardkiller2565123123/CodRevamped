            {
                const std::uintptr_t site = chunkVa + i;
                std::uintptr_t targetCell = 0;
                const char* kind = nullptr;
                bool directInvoke = false;

                if (i + 7u <= n && bytes[i] >= 0x48u && bytes[i] <= 0x4Fu &&
                    (bytes[i + 1u] == 0x8Bu || bytes[i + 1u] == 0x8Du) &&
                    (bytes[i + 2u] & 0xC7u) == 0x05u)
                {
                    std::int32_t disp = 0;
                    memcpy(&disp, bytes + i + 3u, sizeof(disp));
                    targetCell = site + 7u + static_cast<std::intptr_t>(disp);
                    kind = bytes[i + 1u] == 0x8Bu ? "MOV_RIP" : "LEA_RIP";
                }
                else if (i + 6u <= n && bytes[i] == 0xFFu &&
                    (bytes[i + 1u] == 0x15u || bytes[i + 1u] == 0x25u))
                {
                    std::int32_t disp = 0;
                    memcpy(&disp, bytes + i + 2u, sizeof(disp));
                    targetCell = site + 6u + static_cast<std::intptr_t>(disp);
                    kind = bytes[i + 1u] == 0x15u ? "CALL_RIP" : "JMP_RIP";
                    directInvoke = true;
                }
                if (!kind)
                    continue;

                int which = -1;
                for (unsigned wi = 0; wi < ArrayCount(writers); ++wi)
                    if (targetCell == base + writers[wi].cellRva) { which = static_cast<int>(wi); break; }
                if (which < 0)
                    continue;

                if (which == 0) { ++refsA; if (directInvoke) ++directA; }
                else { ++refsB; if (directInvoke) ++directB; }

                std::uintptr_t ownerBegin = 0, ownerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(site, ownerBegin, ownerEnd) && ownerEnd > ownerBegin;
                if (bounded) { if (which == 0) ++ownersA; else ++ownersB; }

                InternalLog(
                    "[DW-SOURCE3-V55] CELL_REF writer=%s kind=%s siteRva=0x%llX cellRva=0x%llX "
                    "owner=%s0x%llX..%s0x%llX directInvoke=%s stateWrites=off\r\n",
                    writers[which].label, kind, static_cast<unsigned long long>(site - base),
                    static_cast<unsigned long long>(writers[which].cellRva),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
