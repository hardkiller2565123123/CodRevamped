                InternalLog(
                    "[DW-SOURCE3-V55] TABLE_REL taskOff=+0x%02llX tableRva=0x%llX relSlot=%d cellRva=0x%llX "
                    "fnRva=0x%llX label=%s relation=PROXIMITY_ONLY stateWrites=off\r\n",
                    static_cast<unsigned long long>(off), static_cast<unsigned long long>(tableRva), rel,
                    static_cast<unsigned long long>(cell - base), static_cast<unsigned long long>(valueRva), label);
                ServerEmuAppend(L"dw_source3_v55_writer_cell_ownership.log",
                    "[DW-SOURCE3-V55] TABLE_REL taskOff=+0x%02llX tableRva=0x%llX relSlot=%d cellRva=0x%llX "
                    "fnRva=0x%llX label=%s relation=PROXIMITY_ONLY stateWrites=off\r\n",
                    static_cast<unsigned long long>(off), static_cast<unsigned long long>(tableRva), rel,
                    static_cast<unsigned long long>(cell - base), static_cast<unsigned long long>(valueRva), label);
            }
        }

        ImageSectionView text{};
        if (!GetImageSection(module, ".text", text) || !text.begin || !text.size)
        {
            InternalLog("[DW-SOURCE3-V55] ERROR missing_text stateWrites=off\r\n");
            return 0;
        }

        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        unsigned refsA = 0, refsB = 0, directA = 0, directB = 0;
        unsigned ownersA = 0, ownersB = 0;
        constexpr std::size_t kChunk = 0x8000u;
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += kChunk)
        {
            const std::size_t n = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(kChunk), textEnd - chunkVa));
            unsigned char bytes[kChunk]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, n))
                continue;

