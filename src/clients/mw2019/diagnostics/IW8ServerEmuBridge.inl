    void LogBNetFenceField80V55Window(const char* label, std::uintptr_t rva,
        std::size_t before, std::size_t after) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || !rva || rva >= size)
            return;

        const std::uintptr_t start = rva > before ? rva - before : 0u;
        const std::uintptr_t end = (std::min)(static_cast<std::uintptr_t>(size), rva + after);
        char hex[4096]{};
        std::size_t used = 0;
        bool readable = true;
        for (std::uintptr_t cur = start; cur < end && used + 5u < ArrayCount(hex); ++cur)
        {
            unsigned char b = 0;
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + cur), b))
            {
                readable = false;
                used += static_cast<std::size_t>(_snprintf_s(
                    hex + used, ArrayCount(hex) - used, _TRUNCATE, "?? "));
                continue;
            }
            used += static_cast<std::size_t>(_snprintf_s(
                hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", static_cast<unsigned>(b)));
        }

        InternalLog("[BNET-FENCE-FIELD80-V55] CODE label=%s rva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label, static_cast<unsigned long long>(rva), static_cast<unsigned long long>(start),
            readable ? "yes" : "partial", hex);
        ServerEmuAppend(L"bnet_fence_field80_v55.log",
            "[BNET-FENCE-FIELD80-V55] CODE label=%s rva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label, static_cast<unsigned long long>(rva), static_cast<unsigned long long>(start),
            readable ? "yes" : "partial", hex);
    }

    bool BNetFunctionHasDirectCallV55(std::uintptr_t begin, std::uintptr_t end,
        std::uintptr_t targetRva, std::uintptr_t& callRva) noexcept
    {
        callRva = 0;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !targetRva || begin < base || end <= begin || end > base + size)
            return false;

        for (std::uintptr_t p = begin; p + 5u <= end; ++p)
        {
            unsigned char op = 0;
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(p), op) || op != 0xE8u)
                continue;
            std::int32_t rel = 0;
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(p + 1u), &rel, sizeof(rel)))
                continue;
            const std::intptr_t target = static_cast<std::intptr_t>(p - base) + 5 +
                static_cast<std::intptr_t>(rel);
            if (target >= 0 && static_cast<std::uintptr_t>(target) == targetRva)
            {
                callRva = p - base;
                return true;
            }
        }
        return false;
    }

    void TraceBNetFenceField80ProducerV55() noexcept
    {
        static std::atomic_bool traced{ false };
        bool expected = false;
        if (!traced.compare_exchange_strong(expected, true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        std::uintptr_t postFencePtr = 0;
        std::uint32_t postFenceField80 = 0;
        const bool postPtrOk = d.BNetPostFenceObjectPtr < size &&
            ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetPostFenceObjectPtr), postFencePtr) &&
            postFencePtr != 0;
        const bool field80Ok = postPtrOk &&
            ServerEmuSafeReadU32(reinterpret_cast<const void*>(postFencePtr + 0x80u), postFenceField80);

        // V54's exact bounded family scan found these two real functions that
        // contain non-zero writes to +0x80. Do not assume either owns fence-id 1:
        // prove ownership/call provenance below.
        const std::uintptr_t producerRvas[] = { 0x463F3A0ull, 0x463FC70ull };
        const std::uintptr_t knownMutationRvas[] = { 0x463F3DAull, 0x463F427ull, 0x463FE0Aull };

        InternalLog("[BNET-FENCE-FIELD80-V55] BEGIN postFencePtr=%p field80=%s%u producers={0x463F3A0,0x463FC70} goal=prove_which_native_producer_can_touch_fence_id1_then_trace_its_caller_condition mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            reinterpret_cast<void*>(postFencePtr),
            field80Ok ? "" : "UNREADABLE/", field80Ok ? postFenceField80 : 0u);
        ServerEmuAppend(L"bnet_fence_field80_v55.log",
            "\r\n[BNET-FENCE-FIELD80-V55] BEGIN postFencePtr=%p field80=%s%u producers={0x463F3A0,0x463FC70} goal=prove_which_native_producer_can_touch_fence_id1_then_trace_its_caller_condition mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            reinterpret_cast<void*>(postFencePtr),
            field80Ok ? "" : "UNREADABLE/", field80Ok ? postFenceField80 : 0u);

        // First correct the V54 attribution. It scanned +0x500 from each vtable
        // entry, which can cross function boundaries. For each mutation, use
        // unwind bounds and explicitly test whether the fence-id 1 slot entry is
        // actually inside that writer function.
        std::uintptr_t postVtable = 0;
        bool postVtableOk = postPtrOk &&
            ServerEmuSafeReadPointer(reinterpret_cast<const void*>(postFencePtr), postVtable) &&
            postVtable != 0;

        unsigned sameFunctionAsPostSlot = 0;
        for (unsigned i = 0; i < ArrayCount(knownMutationRvas); ++i)
        {
            const std::uintptr_t site = base + knownMutationRvas[i];
            std::uintptr_t ownerBegin = 0, ownerEnd = 0;
            const bool ownerBounded = RuntimeFunctionBounds144(site, ownerBegin, ownerEnd);

            bool anyPostSlotSameOwner = false;
            int matchingSlot = -1;
            if (postVtableOk && ownerBounded)
            {
                for (unsigned slot = 0; slot < 7u; ++slot)
                {
                    std::uintptr_t fn = 0;
                    if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(
                        postVtable + slot * sizeof(std::uintptr_t)), fn))
                        continue;
                    if (fn >= ownerBegin && fn < ownerEnd)
                    {
                        anyPostSlotSameOwner = true;
                        matchingSlot = static_cast<int>(slot);
                        ++sameFunctionAsPostSlot;
                        break;
                    }
                }
            }

            InternalLog("[BNET-FENCE-FIELD80-V55] PROVENANCE mutationRva=0x%llX owner=%s0x%llX..%s0x%llX postFenceVtableSlotOwner=%s slot=%d correction=%s\r\n",
                static_cast<unsigned long long>(knownMutationRvas[i]),
                ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerBegin - base : 0u),
                ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerEnd - base : 0u),
                anyPostSlotSameOwner ? "YES" : "no", matchingSlot,
                anyPostSlotSameOwner ? "DIRECT_VTABLE_OWNER_POSSIBLE" :
                    "V54_VTABLE_HIT_WAS_NEIGHBOR_FUNCTION_SPILLOVER_NOT_PROOF");
            ServerEmuAppend(L"bnet_fence_field80_v55.log",
                "[BNET-FENCE-FIELD80-V55] PROVENANCE mutationRva=0x%llX owner=%s0x%llX..%s0x%llX postFenceVtableSlotOwner=%s slot=%d correction=%s\r\n",
                static_cast<unsigned long long>(knownMutationRvas[i]),
                ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerBegin - base : 0u),
                ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerEnd - base : 0u),
                anyPostSlotSameOwner ? "YES" : "no", matchingSlot,
                anyPostSlotSameOwner ? "DIRECT_VTABLE_OWNER_POSSIBLE" :
                    "V54_VTABLE_HIT_WAS_NEIGHBOR_FUNCTION_SPILLOVER_NOT_PROOF");
        }

        // Enumerate every registered BNet fence and its first seven virtual
        // entries. If a producer is a real virtual method, this identifies the
        // owning fence id directly.
        unsigned registeredProducerOwners = 0;
        std::uintptr_t fenceCount = 0;
        const bool fenceCountOk = d.BNetFenceObject < size &&
            ServerEmuSafeReadPointer(reinterpret_cast<const void*>(
                base + d.BNetFenceObject + 0xB8u), fenceCount);
        if (fenceCountOk)
        {
            const std::uintptr_t boundedCount =
                (std::min)(fenceCount, static_cast<std::uintptr_t>(64u));
            for (std::uintptr_t i = 0; i < boundedCount; ++i)
            {
                std::uintptr_t entry = 0;
                if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(
                    base + d.BNetFenceObject + 0x40u + i * sizeof(std::uintptr_t)), entry) || !entry)
                    continue;

                std::uint32_t id = 0, state = 0, field80 = 0;
                std::uintptr_t vt = 0;
                if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(entry + 0x14u), id) ||
                    !ServerEmuSafeReadU32(reinterpret_cast<const void*>(entry + 0x10u), state) ||
                    !ServerEmuSafeReadPointer(reinterpret_cast<const void*>(entry), vt) || !vt)
                    continue;
                const bool f80Ok = ServerEmuSafeReadU32(
                    reinterpret_cast<const void*>(entry + 0x80u), field80);

                for (unsigned slot = 0; slot < 7u; ++slot)
                {
                    std::uintptr_t fn = 0;
                    if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(
                        vt + slot * sizeof(std::uintptr_t)), fn))
                        continue;
                    for (unsigned pi = 0; pi < ArrayCount(producerRvas); ++pi)
                    {
                        if (fn != base + producerRvas[pi])
                            continue;
                        ++registeredProducerOwners;
                        InternalLog("[BNET-FENCE-FIELD80-V55] REGISTERED_OWNER producer=0x%llX fenceIndex=%llu fenceId=%u fenceState=%u field80=%s%u slot=%u entry=%p sameAsPostFence=%s\r\n",
                            static_cast<unsigned long long>(producerRvas[pi]),
                            static_cast<unsigned long long>(i), id, state,
                            f80Ok ? "" : "UNREADABLE/", f80Ok ? field80 : 0u, slot,
                            reinterpret_cast<void*>(entry),
                            entry == postFencePtr ? "YES" : "no");
                        ServerEmuAppend(L"bnet_fence_field80_v55.log",
                            "[BNET-FENCE-FIELD80-V55] REGISTERED_OWNER producer=0x%llX fenceIndex=%llu fenceId=%u fenceState=%u field80=%s%u slot=%u entry=%p sameAsPostFence=%s\r\n",
                            static_cast<unsigned long long>(producerRvas[pi]),
                            static_cast<unsigned long long>(i), id, state,
                            f80Ok ? "" : "UNREADABLE/", f80Ok ? field80 : 0u, slot,
                            reinterpret_cast<void*>(entry),
                            entry == postFencePtr ? "YES" : "no");
                    }
                }
            }
        }

        // Decode each exact producer function. Log only within its unwind bounds,
        // then find direct callers/tail-jumps in the local BNet cluster. Also
        // tell us whether the caller itself obtains the exact post-fence object.
        unsigned producerCallers = 0;
        unsigned postFenceGetterCallers = 0;
        const std::uintptr_t clusterBegin = base + 0x463E000ull;
        const std::uintptr_t clusterEnd = (std::min)(base + size, base + 0x4641000ull);

        for (unsigned pi = 0; pi < ArrayCount(producerRvas); ++pi)
        {
            const std::uintptr_t producer = base + producerRvas[pi];
            std::uintptr_t fnBegin = 0, fnEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(producer, fnBegin, fnEnd);
            if (!bounded)
            {
                fnBegin = producer;
                fnEnd = (std::min)(base + size, producer + 0x400u);
            }

            unsigned mutations = 0;
            for (std::uintptr_t q = fnBegin; q + 16u <= fnEnd; ++q)
            {
                unsigned char bytes[16]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(q), bytes, sizeof(bytes)))
                    continue;
                BNetFenceField80MutationV54 m{};
                if (!DecodeFenceField80MutationV54(bytes, sizeof(bytes), m))
                    continue;
                ++mutations;
                InternalLog("[BNET-FENCE-FIELD80-V55] PRODUCER_MUTATION producer=0x%llX siteRva=0x%llX kind=%s immediate=%s%d baseRm=%u boundedOwner=0x%llX..0x%llX\r\n",
                    static_cast<unsigned long long>(producerRvas[pi]),
                    static_cast<unsigned long long>(q - base),
                    BNetFenceField80MutationNameV54(m.kind),
                    m.hasImmediate ? "" : "n/a/", m.hasImmediate ? m.immediate : 0,
                    m.baseRm,
                    static_cast<unsigned long long>(fnBegin - base),
                    static_cast<unsigned long long>(fnEnd - base));
                ServerEmuAppend(L"bnet_fence_field80_v55.log",
                    "[BNET-FENCE-FIELD80-V55] PRODUCER_MUTATION producer=0x%llX siteRva=0x%llX kind=%s immediate=%s%d baseRm=%u boundedOwner=0x%llX..0x%llX\r\n",
                    static_cast<unsigned long long>(producerRvas[pi]),
                    static_cast<unsigned long long>(q - base),
                    BNetFenceField80MutationNameV54(m.kind),
                    m.hasImmediate ? "" : "n/a/", m.hasImmediate ? m.immediate : 0,
                    m.baseRm,
                    static_cast<unsigned long long>(fnBegin - base),
                    static_cast<unsigned long long>(fnEnd - base));
                LogBNetFenceField80V55Window("producer_mutation_guard", q - base, 64u, 96u);
            }

            InternalLog("[BNET-FENCE-FIELD80-V55] PRODUCER index=%u rva=0x%llX bounds=%s0x%llX..%s0x%llX mutations=%u\r\n",
                pi + 1u, static_cast<unsigned long long>(producerRvas[pi]),
                bounded ? "" : "fallback-", static_cast<unsigned long long>(fnBegin - base),
                bounded ? "" : "fallback-", static_cast<unsigned long long>(fnEnd - base),
                mutations);
            ServerEmuAppend(L"bnet_fence_field80_v55.log",
                "[BNET-FENCE-FIELD80-V55] PRODUCER index=%u rva=0x%llX bounds=%s0x%llX..%s0x%llX mutations=%u\r\n",
                pi + 1u, static_cast<unsigned long long>(producerRvas[pi]),
                bounded ? "" : "fallback-", static_cast<unsigned long long>(fnBegin - base),
                bounded ? "" : "fallback-", static_cast<unsigned long long>(fnEnd - base),
                mutations);

            for (std::uintptr_t chunk = fnBegin; chunk < fnEnd; chunk += 0x60u)
                LogBNetFenceField80V55Window("producer_function", chunk - base, 0u,
                    static_cast<std::size_t>((std::min)(fnEnd - chunk, static_cast<std::uintptr_t>(0x60u))));

            for (std::uintptr_t p = clusterBegin; p + 5u <= clusterEnd; ++p)
            {
                unsigned char op = 0;
                if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(p), op) ||
                    (op != 0xE8u && op != 0xE9u))
                    continue;
                std::int32_t rel = 0;
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(p + 1u), &rel, sizeof(rel)))
                    continue;
                const std::intptr_t target = static_cast<std::intptr_t>(p - base) + 5 +
                    static_cast<std::intptr_t>(rel);
                if (target < 0 || static_cast<std::uintptr_t>(target) != producerRvas[pi])
                    continue;

                ++producerCallers;
                std::uintptr_t callerBegin = 0, callerEnd = 0;
                const bool callerBounded = RuntimeFunctionBounds144(p, callerBegin, callerEnd);
                std::uintptr_t getterCall = 0;
                const bool hasGetter = callerBounded &&
                    BNetFunctionHasDirectCallV55(callerBegin, callerEnd,
                        d.BNetSignInPostFenceObjectGetter, getterCall);
                if (hasGetter)
                    ++postFenceGetterCallers;

                InternalLog("[BNET-FENCE-FIELD80-V55] PRODUCER_CALLER producer=0x%llX edge=%s callRva=0x%llX caller=%s0x%llX..%s0x%llX postFenceGetter=%s getterCallRva=%s0x%llX\r\n",
                    static_cast<unsigned long long>(producerRvas[pi]),
                    op == 0xE8u ? "CALL" : "TAIL_JMP",
                    static_cast<unsigned long long>(p - base),
                    callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0u),
                    callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0u),
                    hasGetter ? "YES" : "no",
                    hasGetter ? "" : "n/a-", static_cast<unsigned long long>(hasGetter ? getterCall : 0u));
                ServerEmuAppend(L"bnet_fence_field80_v55.log",
                    "[BNET-FENCE-FIELD80-V55] PRODUCER_CALLER producer=0x%llX edge=%s callRva=0x%llX caller=%s0x%llX..%s0x%llX postFenceGetter=%s getterCallRva=%s0x%llX\r\n",
                    static_cast<unsigned long long>(producerRvas[pi]),
                    op == 0xE8u ? "CALL" : "TAIL_JMP",
                    static_cast<unsigned long long>(p - base),
                    callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0u),
                    callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0u),
                    hasGetter ? "YES" : "no",
                    hasGetter ? "" : "n/a-", static_cast<unsigned long long>(hasGetter ? getterCall : 0u));
                LogBNetFenceField80V55Window("producer_caller", p - base, 96u, 96u);
            }
        }

        InternalLog("[BNET-FENCE-FIELD80-V55] SUMMARY currentField80=%s%u sameFunctionAsPostVtableSlot=%u registeredProducerOwners=%u producerDirectEdges=%u callersWithExactPostFenceGetter=%u correction=%s next=%s output=bnet_fence_field80_v55.log no_hooks=yes no_state_writes=yes\r\n",
            field80Ok ? "" : "UNREADABLE/", field80Ok ? postFenceField80 : 0u,
            sameFunctionAsPostSlot, registeredProducerOwners, producerCallers, postFenceGetterCallers,
            sameFunctionAsPostSlot == 0u ? "V54_UNBOUNDED_VTABLE_SCAN_SPILLOVER_CONFIRMED" : "DIRECT_VTABLE_RELATION_EXISTS",
            (registeredProducerOwners || postFenceGetterCallers) ?
                "follow_proven_owner_or_caller_condition_backward_to_BGS_callback" :
                "trace_indirect_dispatch_or_object_provenance_into_field80_producer");
        ServerEmuAppend(L"bnet_fence_field80_v55.log",
            "[BNET-FENCE-FIELD80-V55] SUMMARY currentField80=%s%u sameFunctionAsPostVtableSlot=%u registeredProducerOwners=%u producerDirectEdges=%u callersWithExactPostFenceGetter=%u correction=%s next=%s no_hooks=yes no_state_writes=yes\r\n",
            field80Ok ? "" : "UNREADABLE/", field80Ok ? postFenceField80 : 0u,
            sameFunctionAsPostSlot, registeredProducerOwners, producerCallers, postFenceGetterCallers,
            sameFunctionAsPostSlot == 0u ? "V54_UNBOUNDED_VTABLE_SCAN_SPILLOVER_CONFIRMED" : "DIRECT_VTABLE_RELATION_EXISTS",
            (registeredProducerOwners || postFenceGetterCallers) ?
                "follow_proven_owner_or_caller_condition_backward_to_BGS_callback" :
