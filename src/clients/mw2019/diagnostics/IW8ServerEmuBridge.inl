        constexpr std::uintptr_t kProducerBRva = 0x463FC70ull;
        constexpr std::uintptr_t kProducerARva = 0x463F3A0ull;
        const std::uintptr_t targets[] = { base + kAdapterRva, base + kProducerBRva, base + kProducerARva };
        const char* targetLabels[] = { "adapter_463EED0", "producerB_463FC70", "producerA_463F3A0" };

