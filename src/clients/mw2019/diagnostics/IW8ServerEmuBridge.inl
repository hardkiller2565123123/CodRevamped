        if (kDwSource3AltRouteRvaV22 < size)
        {
            const auto target = reinterpret_cast<void*>(base + kDwSource3AltRouteRvaV22);
            const MH_STATUS createRoute = MH_CreateHook(
                target, reinterpret_cast<void*>(&DwSource3AltRouteObserverV22),
                reinterpret_cast<void**>(&g_dwSource3AltRouteOriginalV22));
            if (createRoute == MH_OK || createRoute == MH_ERROR_ALREADY_CREATED)
            {
                const MH_STATUS enableRoute = MH_EnableHook(target);
