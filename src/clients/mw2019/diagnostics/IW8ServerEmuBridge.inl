                if (!label)
                    continue;
                ++knownHits;
                const auto entryRva = entry - base;
                if (entryRva == 0x2B59C40u) ++writerAHits;
                if (entryRva == 0x2B59CB0u) ++writerBHits;
                if (entryRva == 0x2B59D51u) ++writerCHits;
                InternalLog(
                    "[DW-SOURCE3-V54] TASK_TABLE_KNOWN off=+0x%02llX slot=%u cellRva=0x%llX fnRva=0x%llX label=%s stateWrites=off\r\n",
