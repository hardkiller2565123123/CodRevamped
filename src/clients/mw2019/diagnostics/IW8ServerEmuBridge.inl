            const bool setterEdge = i == 0u && direct && directTarget == base + kDwAuthResetWriterRva144;
            InternalLog(
                "[DW-AUTH-RESET-PATH144] FRAME index=%u returnRva=0x%llX function=%s0x%llX..%s0x%llX directCall=%s callRva=%s0x%llX targetRva=%s0x%llX setterEdge=%s\r\n",
                i, static_cast<unsigned long long>(returnRva),
                game[i].bounded ? "" : "n/a-", static_cast<unsigned long long>(game[i].bounded ? game[i].begin - base : 0),
                game[i].bounded ? "" : "n/a-", static_cast<unsigned long long>(game[i].bounded ? game[i].end - base : 0),
                direct ? "yes" : "no", direct ? "" : "n/a-",
                static_cast<unsigned long long>(direct ? directCallSite - base : 0), direct ? "" : "n/a-",
                static_cast<unsigned long long>(direct ? directTarget - base : 0), setterEdge ? "YES" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-PATH144] FRAME index=%u returnRva=0x%llX function=%s0x%llX..%s0x%llX directCall=%s callRva=%s0x%llX targetRva=%s0x%llX setterEdge=%s\r\n",
                i, static_cast<unsigned long long>(returnRva),
                game[i].bounded ? "" : "n/a-", static_cast<unsigned long long>(game[i].bounded ? game[i].begin - base : 0),
                game[i].bounded ? "" : "n/a-", static_cast<unsigned long long>(game[i].bounded ? game[i].end - base : 0),
                direct ? "yes" : "no", direct ? "" : "n/a-",
                static_cast<unsigned long long>(direct ? directCallSite - base : 0), direct ? "" : "n/a-",
                static_cast<unsigned long long>(direct ? directTarget - base : 0), setterEdge ? "YES" : "no");

            if (i < 4u)
            {
                unsigned char bytes[80]{};
                const std::uintptr_t start = game[i].address > base + 48u ? game[i].address - 48u : base;
                const std::size_t wanted = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(sizeof(bytes)), base + size - start));
                char hex[sizeof(bytes) * 3u + 1u]{};
                if (wanted && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(start), bytes, wanted))
                {
                    std::size_t used = 0;
                    for (std::size_t b = 0; b < wanted && used + 4u < ArrayCount(hex); ++b)
                        used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", bytes[b]));
                }
                InternalLog("[DW-AUTH-RESET-PATH144] CODE index=%u returnRva=0x%llX startRva=0x%llX bytes=%s\r\n",
                    i, static_cast<unsigned long long>(returnRva), static_cast<unsigned long long>(start - base),
                    hex[0] ? hex : "UNREADABLE");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-PATH144] CODE index=%u returnRva=0x%llX startRva=0x%llX bytes=%s\r\n",
                    i, static_cast<unsigned long long>(returnRva), static_cast<unsigned long long>(start - base),
                    hex[0] ? hex : "UNREADABLE");
            }
        }

        // Reconstruct direct parent->child edges from the actual return addresses.
        for (unsigned child = 0; child + 1u < gameCount; ++child)
        {
            const unsigned parent = child + 1u;
            if (!game[child].bounded || game[parent].address < base + 5u)
                continue;
            unsigned char call[5]{};
            const auto callSite = game[parent].address - 5u;
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(callSite), call, sizeof(call)) || call[0] != 0xE8u)
                continue;
            std::int32_t rel = 0;
            memcpy(&rel, call + 1u, sizeof(rel));
            const auto target = callSite + 5u + static_cast<std::intptr_t>(rel);
            const bool matchesChild = target >= game[child].begin && target < game[child].end;
            InternalLog("[DW-AUTH-RESET-PATH144] EDGE parentFrame=%u childFrame=%u callRva=0x%llX targetRva=0x%llX targetInChild=%s\r\n",
                parent, child, static_cast<unsigned long long>(callSite - base),
                static_cast<unsigned long long>(target >= base && target < base + size ? target - base : 0),
                matchesChild ? "YES" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-PATH144] EDGE parentFrame=%u childFrame=%u callRva=0x%llX targetRva=0x%llX targetInChild=%s\r\n",
                parent, child, static_cast<unsigned long long>(callSite - base),
                static_cast<unsigned long long>(target >= base && target < base + size ? target - base : 0),
                matchesChild ? "YES" : "no");
        }

        // The first return address is the exact stock callsite that invoked the
        // reset setter. Inspect only a bounded neighborhood before that call.
        const auto firstReturn = game[0].address;
        const auto localBegin = game[0].bounded
            ? (std::max)(game[0].begin, firstReturn > base + 0x240u ? firstReturn - 0x240u : base)
            : (firstReturn > base + 0x240u ? firstReturn - 0x240u : base);
        const auto localEnd = game[0].bounded
            ? (std::min)(game[0].end, firstReturn + 0x40u)
            : (std::min)(base + size, firstReturn + 0x40u);
        unsigned calls = 0;
        unsigned ripRefs = 0;
        unsigned printableRefs = 0;
        unsigned compares = 0;
        unsigned branches = 0;
        unsigned branchesTowardSetter = 0;
        const auto setterCallSite = firstReturn >= base + 5u ? firstReturn - 5u : firstReturn;

        for (std::uintptr_t cursor = localBegin; cursor + 11u <= localEnd; ++cursor)
        {
            unsigned char b[16]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && calls < 32u)
            {
                std::int32_t rel = 0; memcpy(&rel, b + 1u, sizeof(rel));
                const auto target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size)
                {
                    ++calls;
                    const bool setter = target == base + kDwAuthResetWriterRva144;
                    InternalLog("[DW-AUTH-RESET-PATH144] CALL index=%u callRva=0x%llX targetRva=0x%llX setter=%s\r\n",
                        calls, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base), setter ? "YES" : "no");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-PATH144] CALL index=%u callRva=0x%llX targetRva=0x%llX setter=%s\r\n",
                        calls, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base), setter ? "YES" : "no");
                }
            }

            if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Du || b[1] == 0x8Bu) && (b[2] & 0xC7u) == 0x05u && ripRefs < 24u)
            {
                std::int32_t displacement = 0; memcpy(&displacement, b + 3u, sizeof(displacement));
                const auto target = cursor + 7u + static_cast<std::intptr_t>(displacement);
                if (target >= base && target < base + size)
                {
                    ++ripRefs;
                    char text[160]{};
                    const char* encoding = "?";
                    const bool printable = TryReadDwTlsPrintable144(target, text, ArrayCount(text), encoding);
                    if (printable) ++printableRefs;
                    InternalLog("[DW-AUTH-RESET-PATH144] RIP index=%u instructionRva=0x%llX targetRva=0x%llX printable=%s%s%s%s\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                        printable ? "yes" : "no", printable ? " encoding=" : "", printable ? encoding : "",
                        printable ? " text=SEE_dw_auth_result.log" : "");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-PATH144] RIP index=%u instructionRva=0x%llX targetRva=0x%llX printable=%s encoding=%s text='%s'\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                        printable ? "yes" : "no", printable ? encoding : "n/a", printable ? text : "");
                }
            }

            bool isCompare = false;
            unsigned compareBytes = 0;
            unsigned long long immediate = 0;
            if (b[0] == 0x3Du)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 1u, sizeof(imm));
                immediate = imm; compareBytes = 5u; isCompare = true;
            }
            else if (b[0] == 0x83u && ((b[1] >> 3u) & 7u) == 7u)
            {
                immediate = b[2]; compareBytes = 3u; isCompare = true;
            }
            else if (b[0] == 0x81u && ((b[1] >> 3u) & 7u) == 7u)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 2u, sizeof(imm));
                immediate = imm; compareBytes = 6u; isCompare = true;
            }
            if (isCompare && compares < 24u)
            {
                ++compares;
                InternalLog("[DW-AUTH-RESET-PATH144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-PATH144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
            }

            std::uintptr_t branchTarget = 0;
            unsigned branchBytes = 0;
            unsigned branchOpcode = 0;
            if (b[0] >= 0x70u && b[0] <= 0x7Fu)
            {
                branchTarget = cursor + 2u + static_cast<std::int8_t>(b[1]);
                branchBytes = 2u; branchOpcode = b[0];
            }
            else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu)
            {
                std::int32_t rel = 0; memcpy(&rel, b + 2u, sizeof(rel));
                branchTarget = cursor + 6u + static_cast<std::intptr_t>(rel);
                branchBytes = 6u; branchOpcode = 0xF00u | b[1];
            }
            if (branchBytes && branches < 32u && branchTarget >= base && branchTarget < base + size)
            {
                ++branches;
                const bool towardSetter = branchTarget >= setterCallSite - 24u && branchTarget <= setterCallSite + 8u;
                if (towardSetter) ++branchesTowardSetter;
                InternalLog("[DW-AUTH-RESET-PATH144] JCC index=%u instructionRva=0x%llX opcode=0x%X targetRva=0x%llX towardSetterCall=%s\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base), towardSetter ? "YES" : "no");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-PATH144] JCC index=%u instructionRva=0x%llX opcode=0x%X targetRva=0x%llX towardSetterCall=%s\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base), towardSetter ? "YES" : "no");
            }
        }

        InternalLog("[DW-AUTH-RESET-PATH144] SUMMARY localRange=0x%llX..0x%llX calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u towardSetter=%u next=classify_exact_failure_condition_before_server_change stateWrites=off\r\n",
            static_cast<unsigned long long>(localBegin - base), static_cast<unsigned long long>(localEnd - base),
            calls, ripRefs, printableRefs, compares, branches, branchesTowardSetter);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-PATH144] SUMMARY localRange=0x%llX..0x%llX calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u towardSetter=%u next=classify_exact_failure_condition_before_server_change stateWrites=off\r\n",
            static_cast<unsigned long long>(localBegin - base), static_cast<unsigned long long>(localEnd - base),
            calls, ripRefs, printableRefs, compares, branches, branchesTowardSetter);
    }

    int ClassifyDwAuthFailurePredicateHookIntegrity144(unsigned setterCall) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size ||
            kDwAuthFailurePredicateRva144 + sizeof(g_dwAuthFailurePredicateOriginalBytes144) >= size ||
            kDwAuthFailurePredicateCallsiteRva144 + 9u >= size)
        {
            InternalLog("[DW-AUTH-PRED-HOOK144] setterCall=%u status=UNKNOWN reason=image_or_bounds_unavailable stateWrites=off\r\n",
                setterCall);
            return -1;
        }

        unsigned char current[16]{};
        unsigned char callsite[9]{};
        const bool currentOk = ServerEmuSafeReadBytes(
            reinterpret_cast<const void*>(base + kDwAuthFailurePredicateRva144), current, sizeof(current));
        const bool callsiteOk = ServerEmuSafeReadBytes(
            reinterpret_cast<const void*>(base + kDwAuthFailurePredicateCallsiteRva144), callsite, sizeof(callsite));

        bool originalMatch = false;
        if (currentOk && g_dwAuthFailurePredicateOriginalBytesReady144.load(std::memory_order_acquire))
            originalMatch = memcmp(current, g_dwAuthFailurePredicateOriginalBytes144, sizeof(current)) == 0;

        const bool detourLike = currentOk &&
            (current[0] == 0xE9u || (current[0] == 0xFFu && current[1] == 0x25u));

        bool callsiteDirect = false;
        bool callsiteTargetMatch = false;
        std::uintptr_t callsiteTargetRva = 0;
        if (callsiteOk && callsite[0] == 0xE8u)
        {
            callsiteDirect = true;
            std::int32_t rel = 0;
            memcpy(&rel, callsite + 1u, sizeof(rel));
            const auto target = base + kDwAuthFailurePredicateCallsiteRva144 + 5u +
                static_cast<std::intptr_t>(rel);
            if (target >= base && target < base + size)
                callsiteTargetRva = target - base;
            callsiteTargetMatch = target == base + kDwAuthFailurePredicateRva144;
        }

        char currentHex[16u * 3u + 8u]{};
        char callsiteHex[9u * 3u + 8u]{};
        if (currentOk)
        {
            std::size_t used = 0;
            for (std::size_t i = 0; i < sizeof(current) && used + 4u < ArrayCount(currentHex); ++i)
            {
                const int wrote = _snprintf_s(currentHex + used, ArrayCount(currentHex) - used, _TRUNCATE,
                    "%02X%s", current[i], (i + 1u) == sizeof(current) ? "" : " ");
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
        }
        if (callsiteOk)
        {
            std::size_t used = 0;
            for (std::size_t i = 0; i < sizeof(callsite) && used + 4u < ArrayCount(callsiteHex); ++i)
            {
                const int wrote = _snprintf_s(callsiteHex + used, ArrayCount(callsiteHex) - used, _TRUNCATE,
                    "%02X%s", callsite[i], (i + 1u) == sizeof(callsite) ? "" : " ");
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
        }

        const char* status = detourLike ? "DETOUR_PRESENT" :
            (originalMatch ? "ORIGINAL_RESTORED" : "UNKNOWN_BYTES");
        const int classification = detourLike ? 1 : (originalMatch ? 0 : -1);
        InternalLog(
            "[DW-AUTH-PRED-HOOK144] setterCall=%u status=%s currentBytes={%s} originalMatch=%s "
            "callsiteDirect=%s callsiteTarget=%s0x%llX targetMatchesPredicate=%s callsiteBytes={%s} "
            "predicateTotalCalls=%u predicateExactCalls=%u stateWrites=off\r\n",
            setterCall, status, currentOk ? currentHex : "UNREADABLE", originalMatch ? "YES" : "no",
            callsiteDirect ? "YES" : "no", callsiteTargetRva ? "" : "n/a-",
            static_cast<unsigned long long>(callsiteTargetRva),
            callsiteTargetMatch ? "YES" : "no", callsiteOk ? callsiteHex : "UNREADABLE",
            g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire),
            g_dwAuthFailurePredicateObserverCalls144.load(std::memory_order_acquire));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-PRED-HOOK144] setterCall=%u status=%s currentBytes={%s} originalMatch=%s "
            "callsiteDirect=%s callsiteTarget=%s0x%llX targetMatchesPredicate=%s callsiteBytes={%s} "
            "predicateTotalCalls=%u predicateExactCalls=%u stateWrites=off\r\n",
            setterCall, status, currentOk ? currentHex : "UNREADABLE", originalMatch ? "YES" : "no",
            callsiteDirect ? "YES" : "no", callsiteTargetRva ? "" : "n/a-",
            static_cast<unsigned long long>(callsiteTargetRva),
            callsiteTargetMatch ? "YES" : "no", callsiteOk ? callsiteHex : "UNREADABLE",
            g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire),
            g_dwAuthFailurePredicateObserverCalls144.load(std::memory_order_acquire));
        return classification;
    }

    void DwAuthResetSetterObserver144() noexcept
    {
        if (g_dwAuthResetSetterObserverDepth144)
        {
            if (g_dwAuthResetSetterOriginal144)
                g_dwAuthResetSetterOriginal144();
            return;
        }

        g_dwAuthResetSetterObserverDepth144 = true;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        unsigned char before = 0xFFu;
        const bool beforeOk = base && size && kDwAuthResetFlagRva144 < size &&
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + kDwAuthResetFlagRva144), before);

        void* frames[32]{};
        USHORT captured = 0;
        __try
        {
            captured = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            captured = 0;
        }

        if (g_dwAuthResetSetterOriginal144)
            g_dwAuthResetSetterOriginal144();

        unsigned char after = 0xFFu;
        const bool afterOk = base && size && kDwAuthResetFlagRva144 < size &&
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + kDwAuthResetFlagRva144), after);

        const unsigned call = ++g_dwAuthResetSetterObserverCalls144;
        char summary[1536]{};
        std::size_t used = 0;
        unsigned gameFrames = 0;
        std::uintptr_t firstGameCaller = 0;
        std::uintptr_t previous = 0;
        for (USHORT i = 0; i < captured && gameFrames < 12u; ++i)
        {
            const auto address = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (!base || !size || address < base || address >= base + size || address == previous)
                continue;
            previous = address;
            if (!firstGameCaller)
                firstGameCaller = address;
            if (used + 96u < ArrayCount(summary))
            {
                const int wrote = _snprintf_s(summary + used, ArrayCount(summary) - used, _TRUNCATE,
                    "%s#%u=game+0x%llX", gameFrames ? " -> " : "", gameFrames,
                    static_cast<unsigned long long>(address - base));
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
            ++gameFrames;
        }

        InternalLog(
            "[DW-AUTH-RESET-LIVE144] call=%u setterRva=0x%llX flagBefore=%s0x%02X flagAfter=%s0x%02X "
            "capturedFrames=%u gameFrames=%u firstGameCaller=%s0x%llX originalCalled=%s mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
            call, static_cast<unsigned long long>(kDwAuthResetWriterRva144),
            beforeOk ? "" : "UNREADABLE/", beforeOk ? before : 0u,
            afterOk ? "" : "UNREADABLE/", afterOk ? after : 0u,
            static_cast<unsigned>(captured), gameFrames, firstGameCaller ? "" : "n/a-",
            static_cast<unsigned long long>(firstGameCaller ? firstGameCaller - base : 0),
            g_dwAuthResetSetterOriginal144 ? "yes" : "NO");
        InternalLog("[DW-AUTH-RESET-LIVE144] STACK call=%u chain=%s\r\n", call, summary[0] ? summary : "<no-game-frames>");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-LIVE144] call=%u setterRva=0x%llX flagBefore=%s0x%02X flagAfter=%s0x%02X capturedFrames=%u gameFrames=%u "
            "firstGameCaller=%s0x%llX originalCalled=%s mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
            call, static_cast<unsigned long long>(kDwAuthResetWriterRva144),
            beforeOk ? "" : "UNREADABLE/", beforeOk ? before : 0u,
            afterOk ? "" : "UNREADABLE/", afterOk ? after : 0u,
            static_cast<unsigned>(captured), gameFrames, firstGameCaller ? "" : "n/a-",
            static_cast<unsigned long long>(firstGameCaller ? firstGameCaller - base : 0),
            g_dwAuthResetSetterOriginal144 ? "yes" : "NO");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-LIVE144] STACK call=%u chain=%s\r\n", call, summary[0] ? summary : "<no-game-frames>");

        AnalyzeDwAuthResetLivePath144(frames, captured);

        const unsigned predicateTotalCalls = g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire);
        const unsigned predicateExactCalls = g_dwAuthFailurePredicateObserverCalls144.load(std::memory_order_acquire);
        const int predicateHookIntegrity = ClassifyDwAuthFailurePredicateHookIntegrity144(call);
        const char* predicateHookState = predicateHookIntegrity > 0 ? "detour-present" :
            (predicateHookIntegrity == 0 ? "original-restored" : "unknown");
        const char* routeConclusion = predicateExactCalls ? "predicate_observed_on_reset_path" :
            (predicateHookIntegrity > 0 ? "predicate_detour_intact_but_no_hit_possible_internal_bypass" :
             (predicateHookIntegrity == 0 ? "predicate_detour_was_restored_cannot_infer_bypass" :
              "predicate_integrity_unknown_cannot_infer_bypass"));
        InternalLog(
            "[DW-AUTH-ROUTE144] RESET_CORRELATION setterCall=%u predicateObserver=%s predicateHookState=%s "
            "predicateTotalCalls=%u predicateExactResetCalls=%u conclusion=%s next=trust_runtime_hook_only_if_detour_present stateWrites=off\r\n",
            call,
            g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire) ? "armed" : "not-armed",
            predicateHookState, predicateTotalCalls, predicateExactCalls, routeConclusion);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-ROUTE144] RESET_CORRELATION setterCall=%u predicateObserver=%s predicateHookState=%s "
            "predicateTotalCalls=%u predicateExactResetCalls=%u conclusion=%s next=trust_runtime_hook_only_if_detour_present stateWrites=off\r\n",
            call,
            g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire) ? "armed" : "not-armed",
            predicateHookState, predicateTotalCalls, predicateExactCalls, routeConclusion);
        DumpDwAuthResetRouteWindow144();
        ScanDwAuthResetFailureIngress144();
        ClassifyDwAuthResetFailureIngressSources144();

        if (firstGameCaller)
        {
            std::uintptr_t callerBegin = 0;
            std::uintptr_t callerEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(firstGameCaller, callerBegin, callerEnd);
            InternalLog(
                "[DW-AUTH-RESET-LIVE144] CALLER call=%u returnRva=0x%llX function=%s0x%llX..%s0x%llX read_only=yes\r\n",
                call, static_cast<unsigned long long>(firstGameCaller - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerEnd - base : 0));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-LIVE144] CALLER call=%u returnRva=0x%llX function=%s0x%llX..%s0x%llX read_only=yes\r\n",
                call, static_cast<unsigned long long>(firstGameCaller - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerEnd - base : 0));
            AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-LIVE-CALLER-CODE144]", firstGameCaller, 64, 128);
        }

        g_dwAuthResetSetterObserverDepth144 = false;
    }

    bool InstallDwAuthResetSetterObserver144() noexcept
    {
        if (g_dwAuthResetSetterObserverInstalled144.load(std::memory_order_acquire))
            return true;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || kDwAuthResetWriterRva144 + 8u >= size)
            return false;

        const auto target = base + kDwAuthResetWriterRva144;
        unsigned char bytes[16]{};
        char hex[sizeof(bytes) * 3u + 1u]{};
        const bool bytesReadable = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(target), bytes, sizeof(bytes));
        if (bytesReadable)
        {
            std::size_t used = 0;
            for (std::size_t i = 0; i < sizeof(bytes) && used + 4u < ArrayCount(hex); ++i)
                used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", bytes[i]));
        }
        const bool exactSetterSignature = bytesReadable && bytes[0] == 0xC6u && bytes[1] == 0x05u &&
            bytes[6] == 0x01u && bytes[7] == 0xC3u;
        if (!exactSetterSignature)
        {
            InternalLog(
                "[DW-AUTH-RESET-LIVE144] ARM deferred setterRva=0x%llX signature=%s bytes=%s reason=exact_setter_not_materialized stateWrites=off\r\n",
                static_cast<unsigned long long>(kDwAuthResetWriterRva144), exactSetterSignature ? "MATCH" : "NO_MATCH",
                hex[0] ? hex : "UNREADABLE");
            return false;
        }

        const MH_STATUS init = MH_Initialize();
        if (init != MH_OK && init != MH_ERROR_ALREADY_INITIALIZED)
        {
