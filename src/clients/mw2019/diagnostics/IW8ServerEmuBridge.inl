    void QueueDwSource3ResultBackendTraceV34(std::uintptr_t object) noexcept
    {
        if (!object)
            return;
        static std::atomic_bool queued{false};
        if (queued.exchange(true, std::memory_order_acq_rel))
            return;
        HANDLE thread = CreateThread(nullptr, 0, &DwSource3ResultBackendWorkerV34,
            reinterpret_cast<LPVOID>(object), 0, nullptr);
        if (!thread)
        {
            InternalLog("[DW-SOURCE3-V34] QUEUE_FAILED error=%lu object=%p stateWrites=off\r\n",
                static_cast<unsigned long>(GetLastError()), reinterpret_cast<void*>(object));
            return;
        }
        CloseHandle(thread);
        InternalLog(
            "[DW-SOURCE3-V34] QUEUED object=%p scan=result_helper_backend_condition mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(object));
    }


