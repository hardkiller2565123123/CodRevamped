    void LogBNetLauncherContextSnapshot() noexcept
    {
        const wchar_t* cmd = GetCommandLineW();
        const unsigned long cmdChars = cmd ? static_cast<unsigned long>(wcslen(cmd)) : 0ul;
        const bool cmdMentionsBnet = cmd && (WideContainsNoCase(cmd, L"battle") || WideContainsNoCase(cmd, L"bnet"));
        const bool cmdMentionsToken = cmd && (WideContainsNoCase(cmd, L"token") || WideContainsNoCase(cmd, L"session"));
        const bool cmdMentionsLaunch = cmd && WideContainsNoCase(cmd, L"launch");
        InternalLog("[BNET-LAUNCH] command-line snapshot chars=%lu bnetLike=%s tokenLike=%s launchLike=%s contents=REDACTED\r\n",
            cmdChars, cmdMentionsBnet ? "yes" : "no", cmdMentionsToken ? "yes" : "no", cmdMentionsLaunch ? "yes" : "no");
        ServerEmuAppend(L"auth_surface.log",
            "[BNET-LAUNCH] command-line chars=%lu bnetLike=%s tokenLike=%s launchLike=%s contents=REDACTED\r\n",
            cmdChars, cmdMentionsBnet ? "yes" : "no", cmdMentionsToken ? "yes" : "no", cmdMentionsLaunch ? "yes" : "no");

        HKEY fore = nullptr;
        DWORD subKeys = 0;
        DWORD values = 0;
        const LSTATUS foreStatus = RegOpenKeyExW(HKEY_CURRENT_USER,
            L"SOFTWARE\\Blizzard Entertainment\\Battle.net\\Launch Options\\FORE", 0, KEY_READ, &fore);
        if (foreStatus == ERROR_SUCCESS && fore)
        {
            RegQueryInfoKeyW(fore, nullptr, nullptr, nullptr, &subKeys, nullptr, nullptr, &values, nullptr, nullptr, nullptr, nullptr);
            RegCloseKey(fore);
        }
        InternalLog("[BNET-LAUNCH] HKCU Battle.net Launch Options\\\\FORE present=%s status=%ld subKeys=%lu values=%lu; values are never dumped\r\n",
            foreStatus == ERROR_SUCCESS ? "yes" : "no", static_cast<long>(foreStatus),
            static_cast<unsigned long>(subKeys), static_cast<unsigned long>(values));
        ServerEmuAppend(L"auth_surface.log",
            "[BNET-LAUNCH] FORE present=%s status=%ld subKeys=%lu values=%lu contents=REDACTED\r\n",
            foreStatus == ERROR_SUCCESS ? "yes" : "no", static_cast<long>(foreStatus),
            static_cast<unsigned long>(subKeys), static_cast<unsigned long>(values));

        unsigned launcherEnvNames = 0;
        LPWCH env = GetEnvironmentStringsW();
        if (env)
        {
            for (const wchar_t* item = env; *item; item += wcslen(item) + 1)
            {
                const wchar_t* equals = wcschr(item, L'=');
                const std::size_t nameLen = equals ? static_cast<std::size_t>(equals - item) : wcslen(item);
                wchar_t name[256]{};
                const std::size_t copy = (std::min)(nameLen, ArrayCount(name) - 1);
                wmemcpy(name, item, copy);
                name[copy] = L'\0';
                if (WideContainsNoCase(name, L"BATTLE") || WideContainsNoCase(name, L"BLIZZARD") || WideContainsNoCase(name, L"BNET"))
                {
                    ++launcherEnvNames;
                    InternalLog("[BNET-LAUNCH] environment name='%ls' value=REDACTED\r\n", name);
                    ServerEmuAppend(L"auth_surface.log", "[BNET-LAUNCH] environment name='%ls' value=REDACTED\r\n", name);
                }
            }
            FreeEnvironmentStringsW(env);
        }
        InternalLog("[BNET-LAUNCH] launcher-context snapshot complete matchingEnvNames=%u; next step traces actual Battle.net registry reads without logging secret values\r\n",
            launcherEnvNames);
    }

    void InstallBNetLauncherTraceHooks() noexcept
    {
        HMODULE advapi = GetModuleHandleW(L"ADVAPI32.dll");
        if (!advapi) advapi = LoadLibraryW(L"ADVAPI32.dll");
        if (!advapi)
        {
            InternalLog("[BNET-LAUNCH] ADVAPI32 unavailable; registry read tracing disabled\r\n");
            return;
        }

        unsigned installed = 0;
        if (kServerEmuProductionRuntimeV92)
        {
            // Production never MinHooks ADVAPI32 process-wide. The BGS launcher
            // registry consumer is statically linked into ModernWarfare.exe and
            // reaches these APIs through the game's import table, so local IAT
            // interception is sufficient for ACCOUNT_STATE/WEB_TOKEN bootstrap
            // and avoids another loader-wide patching race.
            HMODULE game = GetModuleHandleW(nullptr);
            if (!game)
            {
                InternalLog("[V94-PRODUCTION] game module unavailable; launcher registry bootstrap hooks not installed\r\n");
                return;
            }
            installed += PatchImport(game, "ADVAPI32.dll", "RegOpenKeyExW", reinterpret_cast<void*>(&ServerEmuRegOpenKeyExW), g_regOpenKeyExWOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegOpenKeyExA", reinterpret_cast<void*>(&ServerEmuRegOpenKeyExA), g_regOpenKeyExAOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegQueryValueExW", reinterpret_cast<void*>(&ServerEmuRegQueryValueExW), g_regQueryValueExWOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegQueryValueExA", reinterpret_cast<void*>(&ServerEmuRegQueryValueExA), g_regQueryValueExAOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegGetValueW", reinterpret_cast<void*>(&ServerEmuRegGetValueW), g_regGetValueWOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegGetValueA", reinterpret_cast<void*>(&ServerEmuRegGetValueA), g_regGetValueAOriginal) ? 1u : 0u;
            installed += PatchImport(game, "ADVAPI32.dll", "RegCloseKey", reinterpret_cast<void*>(&ServerEmuRegCloseKey), g_regCloseKeyOriginal) ? 1u : 0u;
            InternalLog("[V94-PRODUCTION] launcher registry bootstrap hooks=IAT-local active=%u/7 process-wide=OFF stack/code dumps=OFF\r\n", installed);
            return;
        }

        installed += InstallProcessWideHook(advapi, "RegOpenKeyExW", reinterpret_cast<void*>(&ServerEmuRegOpenKeyExW), g_regOpenKeyExWOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegOpenKeyExA", reinterpret_cast<void*>(&ServerEmuRegOpenKeyExA), g_regOpenKeyExAOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegQueryValueExW", reinterpret_cast<void*>(&ServerEmuRegQueryValueExW), g_regQueryValueExWOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegQueryValueExA", reinterpret_cast<void*>(&ServerEmuRegQueryValueExA), g_regQueryValueExAOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegGetValueW", reinterpret_cast<void*>(&ServerEmuRegGetValueW), g_regGetValueWOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegGetValueA", reinterpret_cast<void*>(&ServerEmuRegGetValueA), g_regGetValueAOriginal) ? 1u : 0u;
        installed += InstallProcessWideHook(advapi, "RegCloseKey", reinterpret_cast<void*>(&ServerEmuRegCloseKey), g_regCloseKeyOriginal) ? 1u : 0u;

        InternalLog("[BNET-LAUNCH] passive Battle.net launcher registry hooks active=%u/7; paths/types/sizes/caller-RVAs only, value contents REDACTED\r\n", installed);
        InternalLog("[BNET-LAUNCH] successful launcher-value reads dump caller code to bnet_launcher_trace.log; sensitive WEB_TOKEN/ACCOUNT_STATE reads also capture the game-only call stack above the shared registry helper; contents remain REDACTED\r\n");
        InternalLog("[AUTH-GATE-RUNTIME144] ACCOUNT_STATE will arm stock guard/pump observers for pump=0x4641D40 and WEB_TOKEN guard=0x4647550; guard/pump return/state are not forced; local loopback mode may replace only the invalid dummy WEB_TOKEN DPAPI envelope\r\n");
        ServerEmuAppend(L"auth_surface.log",
            "[BNET-LAUNCH] passive registry hooks active=%u/7 caller-context=enabled contents=REDACTED\r\n", installed);
    }

