        };
        const bool umbrellaTokenPresent144 = hasFocusedLabel144("UMBRELLA_TOKEN_FIELD");
        const bool umbrellaLegacyIdPresent144 = hasFocusedLabel144("UMBRELLA_LEGACY_ID_FIELD");
        const bool umbrellaAccessTokenPresent144 = hasFocusedLabel144("UMBRELLA_ACCESS_TOKEN_FIELD");
        const bool umbrellaLegacyExpiresPresent144 = hasFocusedLabel144("UMBRELLA_EXPIRES_FIELD");
        const bool umbrellaAccountsPresent144 = hasFocusedLabel144("UMBRELLA_ACCOUNTS_FIELD");
        const bool umbrellaCamelEndpointPresent144 = hasFocusedLabel144("UMBRELLA_LSG_ENDPOINT_CAMEL_FIELD");
        const bool umbrellaExpiresPresent144 = hasFocusedLabel144("UMBRELLA_EXPIRES_IN_FIELD");
        const bool umbrellaEndpointPresent144 = hasFocusedLabel144("UMBRELLA_LSG_ENDPOINT_FIELD");
        const bool umbrellaLobbyHostPresent144 = hasFocusedLabel144("UMBRELLA_LOBBY_HOST");
        const bool umbrellaPathPresent144 = hasFocusedLabel144("UMBRELLA_LSG_PATH") || hasFocusedLabel144("UMBRELLA_LSG_PATH_SLASH");
        InternalLog("[DW-UMBRELLA-SCHEMA144] exactStockStrings path=%s token=%s legacy={umbrellaID:%s accessToken:%s expires:%s accounts:%s} endpointCamel=%s expires_in=%s lsg_endpoint=%s lobbyHost=%s interpretation=READ_ONLY_SCHEMA_CORRELATION stateWrites=off\r\n",
            umbrellaPathPresent144 ? "yes" : "no", umbrellaTokenPresent144 ? "yes" : "no",
            umbrellaLegacyIdPresent144 ? "yes" : "no", umbrellaAccessTokenPresent144 ? "yes" : "no",
            umbrellaLegacyExpiresPresent144 ? "yes" : "no", umbrellaAccountsPresent144 ? "yes" : "no",
            umbrellaCamelEndpointPresent144 ? "yes" : "no", umbrellaExpiresPresent144 ? "yes" : "no",
            umbrellaEndpointPresent144 ? "yes" : "no", umbrellaLobbyHostPresent144 ? "yes" : "no");
        ServerEmuAppend(L"dw_tls_scan.log",
            "[DW-UMBRELLA-SCHEMA144] exactStockStrings path=%s token=%s legacy={umbrellaID:%s accessToken:%s expires:%s accounts:%s} endpointCamel=%s expires_in=%s lsg_endpoint=%s lobbyHost=%s interpretation=READ_ONLY_SCHEMA_CORRELATION stateWrites=off\r\n",
            umbrellaPathPresent144 ? "yes" : "no", umbrellaTokenPresent144 ? "yes" : "no",
            umbrellaLegacyIdPresent144 ? "yes" : "no", umbrellaAccessTokenPresent144 ? "yes" : "no",
            umbrellaLegacyExpiresPresent144 ? "yes" : "no", umbrellaAccountsPresent144 ? "yes" : "no",
            umbrellaCamelEndpointPresent144 ? "yes" : "no", umbrellaExpiresPresent144 ? "yes" : "no",
            umbrellaEndpointPresent144 ? "yes" : "no", umbrellaLobbyHostPresent144 ? "yes" : "no");

        // The Umbrella LSG request is now proven on the wire, but the exact stock
        // response schema is still unknown.  For Umbrella-only anchors, record the
        // nearby printable .rdata strings so the next run can expose parser field
        // names/error text without guessing or altering any client state.
        // Keep this in the file log only to avoid flooding the visible console.
        std::vector<std::uintptr_t> umbrellaNeighborhoodStrings;
        umbrellaNeighborhoodStrings.reserve(128);
        const auto isUmbrellaLabel = [](const char* label) noexcept {
            return label && strncmp(label, "UMBRELLA_", 9) == 0;
        };
        for (const auto& anchor : hits)
        {
            if (!isUmbrellaLabel(anchor.label) || strcmp(anchor.encoding, "A") != 0)
                continue;

            const std::uintptr_t windowBegin = (std::max)(rdataBegin, anchor.address > 0x1800u ? anchor.address - 0x1800u : rdataBegin);
            const std::uintptr_t windowEnd = (std::min)(rdataEnd, anchor.address + 0x1800u);
            ServerEmuAppend(L"dw_tls_scan.log",
                "[DW-UMBRELLA-SCHEMA144] anchor=%s anchorRva=0x%llX neighborhood=0x%llX..0x%llX mode=STATIC_READ_ONLY\r\n",
                anchor.label ? anchor.label : "?",
                static_cast<unsigned long long>(anchor.address - base),
                static_cast<unsigned long long>(windowBegin - base),
                static_cast<unsigned long long>(windowEnd - base));

            for (std::uintptr_t cursor = windowBegin; cursor < windowEnd && umbrellaNeighborhoodStrings.size() < 128u; ++cursor)
            {
                unsigned char first = 0;
                if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(cursor), first) || first < 0x20 || first > 0x7E)
                    continue;
                if (cursor > windowBegin)
                {
                    unsigned char previous = 0;
                    if (ServerEmuSafeReadU8(reinterpret_cast<const void*>(cursor - 1), previous) && previous >= 0x20 && previous <= 0x7E)
                        continue;
                }

                char textBuffer[97]{};
                std::size_t length = 0;
                for (; length < 96 && cursor + length < windowEnd; ++length)
                {
                    unsigned char ch = 0;
                    if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(cursor + length), ch) || ch == 0)
                        break;
                    if (ch < 0x20 || ch > 0x7E)
                    {
                        length = 0;
                        break;
                    }
                    textBuffer[length] = static_cast<char>(ch);
                }
                if (length < 3 || length > 96)
                    continue;

                if (std::find(umbrellaNeighborhoodStrings.begin(), umbrellaNeighborhoodStrings.end(), cursor) != umbrellaNeighborhoodStrings.end())
                    continue;
                umbrellaNeighborhoodStrings.push_back(cursor);
                textBuffer[length] = '\0';
                ServerEmuAppend(L"dw_tls_scan.log",
                    "[DW-UMBRELLA-NEARBY144] anchor=%s stringRva=0x%llX delta=%+lld len=%llu value='%s' read_only=yes\r\n",
                    anchor.label ? anchor.label : "?",
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<long long>(cursor) - static_cast<long long>(anchor.address),
                    static_cast<unsigned long long>(length), textBuffer);

                static unsigned visibleUmbrellaNearby144 = 0;
                const std::string nearbyLower144 = LowerAscii(textBuffer);
                const bool schemaRelevant144 =
                    nearbyLower144.find("token") != std::string::npos || nearbyLower144.find("lsg") != std::string::npos ||
                    nearbyLower144.find("lobby") != std::string::npos || nearbyLower144.find("endpoint") != std::string::npos ||
                    nearbyLower144.find("umbrella") != std::string::npos || nearbyLower144.find("account") != std::string::npos ||
                    nearbyLower144.find("server") != std::string::npos || nearbyLower144.find("address") != std::string::npos ||
                    nearbyLower144.find("expire") != std::string::npos || nearbyLower144.find("auth") != std::string::npos ||
                    nearbyLower144.find("service") != std::string::npos || nearbyLower144.find("host") != std::string::npos ||
                    nearbyLower144.find("url") != std::string::npos;
                if (schemaRelevant144 && visibleUmbrellaNearby144 < 16u)
                {
                    ++visibleUmbrellaNearby144;
                    InternalLog("[DW-UMBRELLA-NEARBY144] anchor=%s delta=%+lld value='%s' read_only=yes\r\n",
                        anchor.label ? anchor.label : "?",
                        static_cast<long long>(cursor) - static_cast<long long>(anchor.address), textBuffer);
                }
            }
        }

        if (hits.empty())
        {
            InternalLog("[DW-TLS-SCAN] no focused strings found; live stack capture remains active\r\n");
            ServerEmuAppend(L"dw_tls_scan.log", "[DW-TLS-SCAN] COMPLETE strings=0 xrefs=0 stateWrites=off\r\n");
            return;
        }

        auto findTarget = [&](std::uintptr_t target) -> DwTlsFocusedString144* {
            auto it = std::lower_bound(hits.begin(), hits.end(), target,
                [](const DwTlsFocusedString144& h, std::uintptr_t value) { return h.address < value; });
            return (it != hits.end() && it->address == target) ? &*it : nullptr;
        };

        // Auth3 response fields live next to one another in .rdata, but the stock
        // parser can reach them through a relocated pointer/schema table instead
        // of a direct RIP-relative string reference.  Record those pointer slots
        // and then resolve code references to the slots during the .text sweep.
        // This is diagnostic-only: no table or target is modified.
        struct PointerSlot
        {
            std::uintptr_t address = 0;
            std::size_t hitIndex = 0;
            unsigned xrefs = 0;
        };
        std::vector<PointerSlot> pointerSlots;
        pointerSlots.reserve(128);
        const auto scanPointerSection = [&](const char* sectionName, const ImageSectionView& section) noexcept
        {
            const auto sectionBegin = reinterpret_cast<std::uintptr_t>(section.begin);
            const auto sectionEnd = sectionBegin + section.size;
            for (std::uintptr_t cursor = sectionBegin; cursor + sizeof(std::uintptr_t) <= sectionEnd;
                cursor += sizeof(std::uintptr_t))
            {
                std::uintptr_t value = 0;
                if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(cursor), value))
                    continue;
                auto it = std::lower_bound(hits.begin(), hits.end(), value,
                    [](const DwTlsFocusedString144& h, std::uintptr_t address) { return h.address < address; });
                if (it == hits.end() || it->address != value)
                    continue;
                const std::size_t hitIndex = static_cast<std::size_t>(it - hits.begin());
                pointerSlots.push_back({cursor, hitIndex, 0u});
                ServerEmuAppend(L"dw_tls_scan.log",
                    "[DW-TLS-PTR] label=%s section=%s slotRva=0x%llX stringRva=0x%llX relocated=yes read_only=yes\r\n",
                    it->label ? it->label : "?", sectionName,
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(value - base));
            }
        };
        scanPointerSection(".rdata", rdata);
        std::sort(pointerSlots.begin(), pointerSlots.end(), [](const PointerSlot& a, const PointerSlot& b) {
            return a.address < b.address;
        });
        pointerSlots.erase(std::unique(pointerSlots.begin(), pointerSlots.end(), [](const PointerSlot& a, const PointerSlot& b) {
            return a.address == b.address;
        }), pointerSlots.end());
        const auto findPointerSlot = [&](std::uintptr_t target) -> PointerSlot* {
            auto it = std::lower_bound(pointerSlots.begin(), pointerSlots.end(), target,
                [](const PointerSlot& slot, std::uintptr_t address) { return slot.address < address; });
            return (it != pointerSlots.end() && it->address == target) ? &*it : nullptr;
        };

        struct UmbrellaSchemaOwner144
        {
            std::uintptr_t begin = 0;
            std::uintptr_t end = 0;
            unsigned fieldMask = 0;
            unsigned xrefs = 0;
        };
        std::vector<UmbrellaSchemaOwner144> umbrellaSchemaOwners;
        umbrellaSchemaOwners.reserve(16);

        struct LoginFlowOwner144
        {
            std::uintptr_t begin = 0;
            std::uintptr_t end = 0;
            unsigned markerMask = 0;
            unsigned xrefs = 0;
        };
        std::vector<LoginFlowOwner144> loginFlowOwners;
        loginFlowOwners.reserve(8);

        const auto umbrellaResponseFieldBit144 = [](const char* label) noexcept -> unsigned {
            if (!label) return 0u;
            if (strcmp(label, "UMBRELLA_TOKEN_FIELD") == 0) return 1u << 0;
            if (strcmp(label, "UMBRELLA_LEGACY_ID_FIELD") == 0) return 1u << 1;
            if (strcmp(label, "UMBRELLA_ACCESS_TOKEN_FIELD") == 0) return 1u << 2;
            if (strcmp(label, "UMBRELLA_EXPIRES_FIELD") == 0) return 1u << 3;
            if (strcmp(label, "UMBRELLA_ACCOUNTS_FIELD") == 0) return 1u << 4;
            if (strcmp(label, "UMBRELLA_LSG_ENDPOINT_CAMEL_FIELD") == 0) return 1u << 5;
            if (strcmp(label, "UMBRELLA_EXPIRES_IN_FIELD") == 0) return 1u << 6;
            if (strcmp(label, "UMBRELLA_LSG_ENDPOINT_FIELD") == 0) return 1u << 7;
            return 0u;
        };
        const auto loginFlowMarkerBit144 = [](const char* label) noexcept -> unsigned {
            if (!label) return 0u;
            if (strcmp(label, "DW_LOGIN_FLOW_START_LEGACY") == 0) return 1u << 0;
            if (strcmp(label, "DW_LOGIN_FLOW_CONNECTING_LSG") == 0) return 1u << 1;
            if (strcmp(label, "DW_LOGIN_FLOW_CONNECTED_LSG") == 0) return 1u << 2;
            if (strcmp(label, "DW_LOGIN_FLOW_EXTENDED_AUTH") == 0) return 1u << 3;
            if (strcmp(label, "DW_LOGIN_FLOW_LOGIN_COMPLETE") == 0) return 1u << 4;
            return 0u;
        };

        unsigned totalXrefs = 0;
        unsigned indirectXrefs = 0;
        std::size_t bytesSinceYield = 0;
        for (std::size_t textIndex = 0; textIndex < textSectionCount; ++textIndex)
        {
            const auto textBegin = reinterpret_cast<std::uintptr_t>(textSections[textIndex].begin);
            const auto textEnd = textBegin + textSections[textIndex].size;
            for (std::uintptr_t cursor = textBegin; cursor < textEnd; )
            {
                MEMORY_BASIC_INFORMATION mbi{};
                if (!VirtualQuery(reinterpret_cast<void*>(cursor), &mbi, sizeof(mbi)))
                    break;
                const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
                const auto regionEnd = (std::min)(textEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
                if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
                {
                    const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                    const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                    for (std::size_t i = 0; i + 7 <= regionSize; ++i)
                    {
                        // x64 RIP-relative LEA/MOV: REX + 8D/8B + modrm(mod=00,r/m=101) + rel32.
                        if ((bytes[i] & 0xF0) != 0x40 || (bytes[i + 1] != 0x8D && bytes[i + 1] != 0x8B) || (bytes[i + 2] & 0xC7) != 0x05)
                            continue;
                        std::int32_t displacement = 0;
                        memcpy(&displacement, bytes + i + 3, sizeof(displacement));
                        const auto instruction = regionBegin + i;
                        const auto target = instruction + 7 + static_cast<std::intptr_t>(displacement);
                        DwTlsFocusedString144* hit = findTarget(target);
                        PointerSlot* pointerSlot = nullptr;
                        if (!hit)
                        {
                            pointerSlot = findPointerSlot(target);
                            if (pointerSlot && pointerSlot->hitIndex < hits.size())
                                hit = &hits[pointerSlot->hitIndex];
                        }
                        if (!hit || hit->xrefs >= 24u)
                            continue;

                        ++hit->xrefs;
                        ++totalXrefs;
                        if (pointerSlot)
                        {
                            ++pointerSlot->xrefs;
                            ++indirectXrefs;
                        }
                        std::uintptr_t functionBegin = 0;
                        std::uintptr_t functionEnd = 0;
                        const bool bounded = RuntimeFunctionBounds144(instruction, functionBegin, functionEnd);
                        const char* op = bytes[i + 1] == 0x8D ? "LEA" : "MOV";
                        InternalLog("[DW-TLS-SCAN] XREF #%u label=%s codeRva=0x%llX stringRva=0x%llX op=%s ownerRva=%s0x%llX\r\n",
                            totalXrefs, hit->label ? hit->label : "?",
                            static_cast<unsigned long long>(instruction - base),
                            static_cast<unsigned long long>(hit->address - base), op,
                            bounded ? "" : "n/a-",
                            static_cast<unsigned long long>(bounded ? functionBegin - base : 0));
                        ServerEmuAppend(L"dw_tls_scan.log",
                            "[DW-TLS-XREF] index=%u label=%s codeRva=0x%llX stringRva=0x%llX op=%s via=%s pointerSlotRva=%s0x%llX functionBeginRva=%s0x%llX functionEndRva=%s0x%llX unwind=%s\r\n",
                            totalXrefs, hit->label ? hit->label : "?",
                            static_cast<unsigned long long>(instruction - base),
                            static_cast<unsigned long long>(hit->address - base), op,
                            pointerSlot ? "relocated-pointer" : "direct",
                            pointerSlot ? "" : "n/a-",
                            static_cast<unsigned long long>(pointerSlot ? pointerSlot->address - base : 0),
                            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                            bounded ? "yes" : "no");

                        // V50 native-path trace: correlate all stock login-flow
                        // anchors. DW_AUTH_DELAY is especially useful because its 1.44
                        // xref resolves to a bounded native owner. No status values or
                        // return values are changed.
                        if (hit->label &&
                            (strcmp(hit->label, "DW_FIRST_PARTY_READY") == 0 ||
                             strcmp(hit->label, "DW_AUTH_DELAY") == 0 ||
                             strcmp(hit->label, "DW_LOGIN_FLOW_START_LEGACY") == 0 ||
                             strcmp(hit->label, "DW_LOGIN_FLOW_CONNECTING_LSG") == 0 ||
                             strcmp(hit->label, "DW_LOGIN_FLOW_CONNECTED_LSG") == 0 ||
                             strcmp(hit->label, "DW_LOGIN_FLOW_EXTENDED_AUTH") == 0 ||
                             strcmp(hit->label, "DW_LOGIN_FLOW_LOGIN_COMPLETE") == 0))
                        {
                            AnalyzeDwFirstPartyStatusAnchorV48(hit->label, instruction);
                        }

                        // V14: correlate response-field xrefs by bounded function owner.
                        // A function that references multiple exact Umbrella field names is
                        // much stronger parser evidence than a generic "token" xref.
                        const unsigned umbrellaFieldBit = umbrellaResponseFieldBit144(hit->label);
                        if (bounded && umbrellaFieldBit)
                        {
                            auto ownerIt = std::find_if(umbrellaSchemaOwners.begin(), umbrellaSchemaOwners.end(),
                                [functionBegin](const UmbrellaSchemaOwner144& owner) { return owner.begin == functionBegin; });
                            if (ownerIt == umbrellaSchemaOwners.end())
                            {
                                UmbrellaSchemaOwner144 owner{};
                                owner.begin = functionBegin;
                                owner.end = functionEnd;
                                owner.fieldMask = umbrellaFieldBit;
                                owner.xrefs = 1u;
                                umbrellaSchemaOwners.push_back(owner);
                            }
                            else
                            {
                                ownerIt->fieldMask |= umbrellaFieldBit;
                                ++ownerIt->xrefs;
                            }
                        }

                        const unsigned loginFlowMarkerBit = loginFlowMarkerBit144(hit->label);
                        if (bounded && loginFlowMarkerBit)
                        {
                            auto ownerIt = std::find_if(loginFlowOwners.begin(), loginFlowOwners.end(),
                                [functionBegin](const LoginFlowOwner144& owner) { return owner.begin == functionBegin; });
                            if (ownerIt == loginFlowOwners.end())
                            {
                                LoginFlowOwner144 owner{};
                                owner.begin = functionBegin;
                                owner.end = functionEnd;
                                owner.markerMask = loginFlowMarkerBit;
                                owner.xrefs = 1u;
                                loginFlowOwners.push_back(owner);
                            }
                            else
                            {
                                ownerIt->markerMask |= loginFlowMarkerBit;
                                ++ownerIt->xrefs;
                            }
                        }

                        AppendCodeBytes144(L"dw_tls_scan.log", "[DW-TLS-XREF-CODE]", instruction, 48, 96);
                        if (bounded)
                            LogDwTlsDirectCalls144(functionBegin, functionEnd, instruction);
                    }
                }

                bytesSinceYield += static_cast<std::size_t>(regionEnd > regionBegin ? regionEnd - regionBegin : 0);
                if (bytesSinceYield >= 4u * 1024u * 1024u)
                {
                    // Background scan should not recreate the long intro/render stalls from
                    // the old all-purpose scanner. Yield periodically while sweeping .text.
                    Sleep(1);
                    bytesSinceYield = 0;
                }
                if (regionEnd <= cursor) break;
                cursor = regionEnd;
            }
        }

        unsigned stringsWithXrefs = 0;
        for (const auto& hit : hits)
            if (hit.xrefs) ++stringsWithXrefs;

        for (const auto& owner : umbrellaSchemaOwners)
        {
            unsigned distinctFields = 0;
            for (unsigned bit = 0; bit < 8u; ++bit)
                if (owner.fieldMask & (1u << bit)) ++distinctFields;
            if (distinctFields < 2u)
                continue;

            InternalLog("[DW-UMBRELLA-PARSER-CANDIDATE144] ownerRva=0x%llX endRva=0x%llX distinctFields=%u xrefs=%u mask=0x%02X read_only=yes\r\n",
                static_cast<unsigned long long>(owner.begin - base),
                static_cast<unsigned long long>(owner.end - base),
                distinctFields, owner.xrefs, owner.fieldMask);
            ServerEmuAppend(L"dw_tls_scan.log",
                "[DW-UMBRELLA-PARSER-CANDIDATE144] ownerRva=0x%llX endRva=0x%llX distinctFields=%u xrefs=%u mask=0x%02X fields={token:%s umbrellaID:%s accessToken:%s expires:%s accounts:%s lsgEndpoint:%s expires_in:%s lsg_endpoint:%s} read_only=yes\r\n",
                static_cast<unsigned long long>(owner.begin - base),
                static_cast<unsigned long long>(owner.end - base),
                distinctFields, owner.xrefs, owner.fieldMask,
                (owner.fieldMask & (1u << 0)) ? "yes" : "no",
                (owner.fieldMask & (1u << 1)) ? "yes" : "no",
                (owner.fieldMask & (1u << 2)) ? "yes" : "no",
                (owner.fieldMask & (1u << 3)) ? "yes" : "no",
                (owner.fieldMask & (1u << 4)) ? "yes" : "no",
                (owner.fieldMask & (1u << 5)) ? "yes" : "no",
                (owner.fieldMask & (1u << 6)) ? "yes" : "no",
                (owner.fieldMask & (1u << 7)) ? "yes" : "no");
            AppendCodeBytes144(L"dw_tls_scan.log", "[DW-UMBRELLA-PARSER-CODE144]", owner.begin, 256, 512);
        }

        // V15: status-message ownership is a cleaner route to the actual 1.44
        // bdLoginFlow::pump than generic response-field xrefs. Report every
        // bounded owner, and rank owners that contain multiple transition markers.
        for (const auto& owner : loginFlowOwners)
        {
            unsigned distinctMarkers = 0;
            for (unsigned bit = 0; bit < 5u; ++bit)
                if (owner.markerMask & (1u << bit)) ++distinctMarkers;

            InternalLog("[DW-LOGIN-FLOW-CANDIDATE144] ownerRva=0x%llX endRva=0x%llX distinctMarkers=%u xrefs=%u mask=0x%02X read_only=yes\r\n",
                static_cast<unsigned long long>(owner.begin - base),
                static_cast<unsigned long long>(owner.end - base),
                distinctMarkers, owner.xrefs, owner.markerMask);
            ServerEmuAppend(L"dw_tls_scan.log",
                "[DW-LOGIN-FLOW-CANDIDATE144] ownerRva=0x%llX endRva=0x%llX distinctMarkers=%u xrefs=%u mask=0x%02X markers={startLegacy:%s connectingLSG:%s connectedLSG:%s extendedAuth:%s loginComplete:%s} read_only=yes\r\n",
                static_cast<unsigned long long>(owner.begin - base),
                static_cast<unsigned long long>(owner.end - base),
                distinctMarkers, owner.xrefs, owner.markerMask,
                (owner.markerMask & (1u << 0)) ? "yes" : "no",
                (owner.markerMask & (1u << 1)) ? "yes" : "no",
                (owner.markerMask & (1u << 2)) ? "yes" : "no",
                (owner.markerMask & (1u << 3)) ? "yes" : "no",
                (owner.markerMask & (1u << 4)) ? "yes" : "no");
            AppendCodeBytes144(L"dw_tls_scan.log", "[DW-LOGIN-FLOW-CODE144]", owner.begin, 768, 1536);
        }

        AnalyzeDwLsgConnectTransitionV44();
        AnalyzeRawDemonwareTlsCurlChain144(module);

        InternalLog("[DW-TLS-SCAN] COMPLETE strings=%llu pointerSlots=%llu stringsWithXrefs=%u xrefs=%u indirectXrefs=%u output=dw_tls_scan.log stateWrites=off\r\n",
            static_cast<unsigned long long>(hits.size()), static_cast<unsigned long long>(pointerSlots.size()),
            stringsWithXrefs, totalXrefs, indirectXrefs);
        ServerEmuAppend(L"dw_tls_scan.log",
            "[DW-TLS-SCAN] COMPLETE strings=%llu pointerSlots=%llu stringsWithXrefs=%u xrefs=%u indirectXrefs=%u stateWrites=off\r\n",
            static_cast<unsigned long long>(hits.size()), static_cast<unsigned long long>(pointerSlots.size()),
            stringsWithXrefs, totalXrefs, indirectXrefs);
        InternalLog("[DW-TLS-SCAN] ============================================================\r\n\r\n");
    }

    struct DwAuthTrackedGlobal144
    {
        std::uintptr_t address = 0;
        std::uintptr_t instruction = 0;
        const char* owner = nullptr;
        unsigned width = 0;
        bool writeReference = false;
        bool lastValid = false;
        std::uint64_t lastValue = 0;
    };

    bool DwAuthReadTrackedValue144(std::uintptr_t address, unsigned width, std::uint64_t& value) noexcept
    {
        value = 0;
        if (width == 1u)
        {
            unsigned char v = 0;
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(address), v))
                return false;
            value = v;
            return true;
        }
        if (width == 4u)
        {
            std::uint32_t v = 0;
            if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(address), v))
                return false;
            value = v;
            return true;
        }
        if (width == 8u)
        {
            std::uintptr_t v = 0;
            if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(address), v))
                return false;
            value = static_cast<std::uint64_t>(v);
            return true;
        }
        return false;
    }

    bool DwAuthIsWritableImageData144(std::uintptr_t address) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || address < base || address >= base + size)
            return false;

        MEMORY_BASIC_INFORMATION mbi{};
        if (!VirtualQuery(reinterpret_cast<const void*>(address), &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT)
            return false;
        if (!ServerEmuReadableRegion(mbi) || (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)))
            return false;

        const DWORD protection = mbi.Protect & 0xFFu;
        return protection == PAGE_READWRITE || protection == PAGE_WRITECOPY ||
            protection == PAGE_EXECUTE_READWRITE || protection == PAGE_EXECUTE_WRITECOPY;
    }

    void AddDwAuthTrackedGlobal144(std::vector<DwAuthTrackedGlobal144>& out,
        std::uintptr_t address, std::uintptr_t instruction, const char* owner,
        unsigned width, bool writeReference) noexcept
    {
        if (!address || (width != 1u && width != 4u && width != 8u) || !DwAuthIsWritableImageData144(address))
            return;

        for (auto& existing : out)
        {
            if (existing.address != address)
                continue;
            existing.writeReference = existing.writeReference || writeReference;
            if (width > existing.width)
                existing.width = width;
            return;
        }

        if (out.size() >= 384u)
            return;
        DwAuthTrackedGlobal144 item{};
        item.address = address;
        item.instruction = instruction;
        item.owner = owner;
        item.width = width;
        item.writeReference = writeReference;
        out.push_back(item);
    }

    void CollectDwAuthTrackedGlobals144(const char* label, std::uintptr_t seedRva,
        std::vector<DwAuthTrackedGlobal144>& out) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !seedRva || seedRva >= size)
            return;

        const std::uintptr_t seed = base + seedRva;
        std::uintptr_t begin = 0;
        std::uintptr_t end = 0;
        const bool bounded = RuntimeFunctionBounds144(seed, begin, end);
        if (!bounded)
        {
            begin = seed;
            end = (std::min)(base + size, seed + static_cast<std::uintptr_t>(0x800));
        }
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x4000));

        unsigned refs = 0;
        for (std::uintptr_t cursor = begin; cursor + 10u <= scanEnd; ++cursor)
        {
            unsigned char instructionBytes[10]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), instructionBytes, sizeof(instructionBytes)))
                continue;
            const auto* b = instructionBytes;
            std::size_t dispOffset = 0;
            std::size_t instructionLength = 0;
            unsigned width = 0;
            bool writeReference = false;

            // REX + LEA r,[rip+rel32]. The referenced writable object itself can
            // carry auth state even when the function never loads it directly.
            if ((b[0] & 0xF0u) == 0x40u && b[1] == 0x8Du && (b[2] & 0xC7u) == 0x05u)
            {
                dispOffset = 3u;
                instructionLength = 7u;
                width = 8u;
            }
            // LEA r32,[rip+rel32].
            else if (b[0] == 0x8Du && (b[1] & 0xC7u) == 0x05u)
            {
                dispOffset = 2u;
                instructionLength = 6u;
                width = 8u;
            }
            // REX + MOV r,[rip+rel32] / MOV [rip+rel32],r.
            else if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Bu || b[1] == 0x89u) && (b[2] & 0xC7u) == 0x05u)
            {
                dispOffset = 3u;
                instructionLength = 7u;
                width = (b[0] & 0x08u) ? 8u : 4u;
                writeReference = b[1] == 0x89u;
            }
            // MOV r32,[rip+rel32] / MOV [rip+rel32],r32.
            else if ((b[0] == 0x8Bu || b[0] == 0x89u) && (b[1] & 0xC7u) == 0x05u)
            {
                dispOffset = 2u;
                instructionLength = 6u;
                width = 4u;
                writeReference = b[0] == 0x89u;
            }
            // REX + CMP byte/dword/qword ptr [rip+rel32], imm8.
            else if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x80u || b[1] == 0x83u) && b[2] == 0x3Du)
            {
                dispOffset = 3u;
                instructionLength = 8u;
                width = b[1] == 0x80u ? 1u : ((b[0] & 0x08u) ? 8u : 4u);
            }
            // MOVSS/MOVSD xmm,[rip+rel32] and stores back to [rip+rel32].
            else if ((b[0] == 0xF3u || b[0] == 0xF2u) && b[1] == 0x0Fu &&
                (b[2] == 0x10u || b[2] == 0x11u) && (b[3] & 0xC7u) == 0x05u)
            {
                dispOffset = 4u;
                instructionLength = 8u;
                width = b[0] == 0xF2u ? 8u : 4u;
                writeReference = b[2] == 0x11u;
            }
            // INC/DEC dword ptr [rip+rel32].
            else if (b[0] == 0xFFu && (b[1] & 0xC7u) == 0x05u)
            {
                dispOffset = 2u;
                instructionLength = 6u;
                width = 4u;
                writeReference = true;
            }
            // REX.W + INC/DEC qword ptr [rip+rel32].
            else if ((b[0] & 0xF8u) == 0x48u && b[1] == 0xFFu && (b[2] & 0xC7u) == 0x05u)
            {
                dispOffset = 3u;
                instructionLength = 7u;
                width = (b[0] & 0x08u) ? 8u : 4u;
                writeReference = true;
            }
            // CMP byte/dword ptr [rip+rel32], imm8.
            else if ((b[0] == 0x80u || b[0] == 0x83u) && b[1] == 0x3Du)
            {
                dispOffset = 2u;
                instructionLength = 7u;
                width = b[0] == 0x80u ? 1u : 4u;
            }
            // MOV byte/dword ptr [rip+rel32], immediate.
            else if ((b[0] == 0xC6u || b[0] == 0xC7u) && b[1] == 0x05u)
            {
                dispOffset = 2u;
                instructionLength = b[0] == 0xC6u ? 7u : 10u;
                width = b[0] == 0xC6u ? 1u : 4u;
                writeReference = true;
            }
            // MOVZX r32, byte ptr [rip+rel32].
            else if (b[0] == 0x0Fu && b[1] == 0xB6u && (b[2] & 0xC7u) == 0x05u)
            {
                dispOffset = 3u;
                instructionLength = 7u;
                width = 1u;
            }
            else
            {
                continue;
            }

            std::int32_t displacement = 0;
            memcpy(&displacement, b + dispOffset, sizeof(displacement));
            const std::uintptr_t target = cursor + instructionLength + static_cast<std::intptr_t>(displacement);
            if (!DwAuthIsWritableImageData144(target))
                continue;

            const std::size_t before = out.size();
            AddDwAuthTrackedGlobal144(out, target, cursor, label, width, writeReference);
            if (out.size() != before)
                ++refs;
        }

        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESULT144] owner=%s seedRva=0x%llX beginRva=0x%llX endRva=0x%llX unwind=%s newWritableGlobals=%u totalCandidates=%llu mode=RAW_MEMORY_READ_ONLY\r\n",
            label ? label : "?", static_cast<unsigned long long>(seedRva),
            static_cast<unsigned long long>(begin - base), static_cast<unsigned long long>(end - base),
            bounded ? "yes" : "no", refs, static_cast<unsigned long long>(out.size()));
        InternalLog("[DW-AUTH-RESULT144] owner=%s seedRva=0x%llX beginRva=0x%llX endRva=0x%llX unwind=%s newWritableGlobals=%u totalCandidates=%llu\r\n",
            label ? label : "?", static_cast<unsigned long long>(seedRva),
            static_cast<unsigned long long>(begin - base), static_cast<unsigned long long>(end - base),
            bounded ? "yes" : "no", refs, static_cast<unsigned long long>(out.size()));
    }

    void CollectDwAuthDirectCalleeGlobals144(const char* ownerLabel, const char* calleeLabel,
        std::uintptr_t seedRva, std::vector<DwAuthTrackedGlobal144>& out) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !seedRva || seedRva >= size)
            return;

        const std::uintptr_t seed = base + seedRva;
        std::uintptr_t begin = 0;
        std::uintptr_t end = 0;
        const bool bounded = RuntimeFunctionBounds144(seed, begin, end);
        if (!bounded)
        {
            begin = seed;
            end = (std::min)(base + size, seed + static_cast<std::uintptr_t>(0x800));
        }
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x4000));

        std::vector<std::uintptr_t> seen;
        seen.reserve(32u);
        unsigned directCalls = 0;
        unsigned scannedCallees = 0;

        for (std::uintptr_t cursor = begin; cursor + 5u <= scanEnd && scannedCallees < 32u; ++cursor)
        {
            unsigned char instructionBytes[5]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), instructionBytes, sizeof(instructionBytes)))
                continue;
            const auto* b = instructionBytes;
            if (b[0] != 0xE8u)
                continue;

            std::int32_t rel = 0;
            memcpy(&rel, b + 1u, sizeof(rel));
            const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
            if (target < base || target >= base + size)
                continue;
            ++directCalls;

            bool duplicate = false;
            for (const auto existing : seen)
            {
                if (existing == target)
                {
                    duplicate = true;
                    break;
                }
            }
            if (duplicate)
                continue;

            seen.push_back(target);
            ++scannedCallees;
            CollectDwAuthTrackedGlobals144(calleeLabel, target - base, out);
        }

        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESULT144] calleeScan owner=%s seedRva=0x%llX directCalls=%u uniqueCallees=%u totalCandidates=%llu mode=FIRST_LEVEL_READ_ONLY\r\n",
            ownerLabel ? ownerLabel : "?", static_cast<unsigned long long>(seedRva),
            directCalls, scannedCallees, static_cast<unsigned long long>(out.size()));
        InternalLog("[DW-AUTH-RESULT144] calleeScan owner=%s seedRva=0x%llX directCalls=%u uniqueCallees=%u totalCandidates=%llu\r\n",
            ownerLabel ? ownerLabel : "?", static_cast<unsigned long long>(seedRva),
            directCalls, scannedCallees, static_cast<unsigned long long>(out.size()));
    }

