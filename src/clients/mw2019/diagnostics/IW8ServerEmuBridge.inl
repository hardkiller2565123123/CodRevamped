                }

                // RIP-relative LEA/MOV gives us the globals / response labels used
                // by the helper.  Console output does not expose string contents.
                if (i + 7u <= scanBytes && code[i] >= 0x48u && code[i] <= 0x4Fu &&
                    (code[i + 1u] == 0x8Du || code[i + 1u] == 0x8Bu) &&
