    }

    static void DwSource3V37DumpFunction(const char* label, std::uintptr_t rva,
        std::size_t fallbackBytes, std::uintptr_t& outBegin, std::uintptr_t& outEnd) noexcept
    {
        outBegin = outEnd = 0;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || rva >= size) return;

        std::uintptr_t begin = 0, end = 0;
        const bool bounded = RuntimeFunctionBounds144(base + rva, begin, end) &&
            begin >= base && end > begin && end <= base + size;
        if (!bounded)
        {
            begin = base + rva;
            end = (std::min)(base + size, begin + fallbackBytes);
        }
        outBegin = begin;
        outEnd = end;
        const std::size_t n = static_cast<std::size_t>((std::min)(
            static_cast<std::uintptr_t>(0x400u), end - begin));
        InternalLog(
            "[DW-SOURCE3-V37] FUNCTION label=%s anchorRva=0x%llX beginRva=0x%llX endRva=0x%llX bounded=%s bytes=%zu read_only=yes\r\n",
            label, static_cast<unsigned long long>(rva),
            static_cast<unsigned long long>(begin - base),
            static_cast<unsigned long long>(end - base),
            bounded ? "YES" : "no", n);
        if (n)
            AppendCodeBytes144(L"dw_source3_v37.log", "[DW-SOURCE3-V37-CODE]", begin, 0, n);
    }

