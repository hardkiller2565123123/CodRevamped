    const char* DwAuthIngressBranchName144(unsigned opcode, bool nearForm) noexcept
    {
        const unsigned cc = nearForm ? (opcode & 0x0Fu) : (opcode & 0x0Fu);
        static const char* names[16] = {
            "JO","JNO","JB","JAE","JE","JNE","JBE","JA",
            "JS","JNS","JP","JNP","JL","JGE","JLE","JG"
        };
        return cc < 16u ? names[cc] : "JCC";
    }

    void ScanDwAuthResetFailureIngress144() noexcept
    {
        bool expected = false;
        if (!g_dwAuthFailureIngressScanDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
        {
            InternalLog("[DW-AUTH-INGRESS144] unavailable reason=image_not_ready stateWrites=off\r\n");
            return;
        }

        // The reset stack repeatedly identifies this parent function, and the
        // live code window proves the normal predicate call is 0x2D2128E while
        // the failure block begins at 0x2D21297. V27 showed the predicate
        // detour was intact with zero hits, so find only branches that can enter
        // after that callsite.
        constexpr std::uintptr_t kKnownReturnRva = 0x2D212BAu;
        constexpr std::uintptr_t kFallbackBeginRva = 0x2D1F900u;
        constexpr std::uintptr_t kFallbackEndRva = 0x2D212DAu;
        constexpr std::uintptr_t kFailureBeginRva = 0x2D21297u;
        constexpr std::uintptr_t kFailureSetterCallRva = 0x2D212B5u;
        constexpr std::uintptr_t kFailureEndRva = 0x2D212BAu;

        std::uintptr_t functionBegin = 0;
        std::uintptr_t functionEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(base + kKnownReturnRva, functionBegin, functionEnd);
        if (!bounded || functionBegin < base || functionEnd <= functionBegin ||
            functionEnd > base + size || functionEnd - functionBegin > 0x4000u)
        {
            functionBegin = base + kFallbackBeginRva;
            functionEnd = base + kFallbackEndRva;
        }

        const auto failureBegin = base + kFailureBeginRva;
        const auto failureEnd = base + kFailureEndRva;
        const auto setterCall = base + kFailureSetterCallRva;

        InternalLog(
            "[DW-AUTH-INGRESS144] BEGIN function=0x%llX..0x%llX bounds=%s failureBlock=0x%llX..0x%llX "
            "setterCall=0x%llX scope=EXACT_PARENT_FUNCTION_ONLY mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(functionBegin - base),
            static_cast<unsigned long long>(functionEnd - base),
            bounded ? "UNWIND" : "FALLBACK",
            static_cast<unsigned long long>(kFailureBeginRva),
            static_cast<unsigned long long>(kFailureEndRva),
            static_cast<unsigned long long>(kFailureSetterCallRva));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-INGRESS144] BEGIN function=0x%llX..0x%llX bounds=%s failureBlock=0x%llX..0x%llX "
            "setterCall=0x%llX scope=EXACT_PARENT_FUNCTION_ONLY mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(functionBegin - base),
            static_cast<unsigned long long>(functionEnd - base),
            bounded ? "UNWIND" : "FALLBACK",
            static_cast<unsigned long long>(kFailureBeginRva),
            static_cast<unsigned long long>(kFailureEndRva),
            static_cast<unsigned long long>(kFailureSetterCallRva));

        unsigned incomingEdges = 0;
        unsigned directBranches = 0;
        unsigned indirectJumpsNearBlock = 0;

        for (std::uintptr_t cursor = functionBegin; cursor + 6u <= functionEnd; ++cursor)
        {
            unsigned char b[8]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            std::uintptr_t target = 0;
            unsigned instructionBytes = 0;
            unsigned opcode = 0;
            const char* kind = nullptr;

            if (b[0] >= 0x70u && b[0] <= 0x7Fu)
            {
                target = cursor + 2u + static_cast<std::int8_t>(b[1]);
                instructionBytes = 2u;
                opcode = b[0];
                kind = DwAuthIngressBranchName144(opcode, false);
            }
            else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 2u, sizeof(rel));
                target = cursor + 6u + static_cast<std::intptr_t>(rel);
                instructionBytes = 6u;
                opcode = b[1];
                kind = DwAuthIngressBranchName144(opcode, true);
            }
            else if (b[0] == 0xEBu)
            {
                target = cursor + 2u + static_cast<std::int8_t>(b[1]);
                instructionBytes = 2u;
                opcode = b[0];
                kind = "JMP8";
            }
            else if (b[0] == 0xE9u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1u, sizeof(rel));
                target = cursor + 5u + static_cast<std::intptr_t>(rel);
                instructionBytes = 5u;
                opcode = b[0];
                kind = "JMP32";
            }
            else if (b[0] >= 0xE0u && b[0] <= 0xE3u)
            {
                target = cursor + 2u + static_cast<std::int8_t>(b[1]);
                instructionBytes = 2u;
                opcode = b[0];
                kind = b[0] == 0xE3u ? "JRCXZ" : "LOOP";
            }

            if (instructionBytes && target >= base && target < base + size)
            {
                ++directBranches;
                if (target >= failureBegin && target <= failureEnd && cursor < failureBegin)
                {
                    ++incomingEdges;
                    const bool skipsPredicate = target > base + kDwAuthFailurePredicateCallsiteRva144;
                    const bool reachesSetter = target <= setterCall;

                    unsigned char context[24]{};
                    const auto contextStart = cursor >= base + 8u ? cursor - 8u : cursor;
                    const bool contextOk = ServerEmuSafeReadBytes(
                        reinterpret_cast<const void*>(contextStart), context, sizeof(context));
                    char hex[24u * 3u + 8u]{};
                    if (contextOk)
                    {
                        std::size_t used = 0;
                        for (std::size_t i = 0; i < sizeof(context) && used + 4u < ArrayCount(hex); ++i)
                        {
                            const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                                "%02X%s", context[i], (i + 1u) == sizeof(context) ? "" : " ");
                            if (wrote > 0)
                                used += static_cast<std::size_t>(wrote);
                        }
                    }

                    InternalLog(
                        "[DW-AUTH-INGRESS144] EDGE index=%u kind=%s sourceRva=0x%llX bytes=%u targetRva=0x%llX "
                        "skipsPredicate=%s reachesSetterBlock=%s contextStartRva=0x%llX context={%s}\r\n",
                        incomingEdges, kind ? kind : "?", static_cast<unsigned long long>(cursor - base),
                        instructionBytes, static_cast<unsigned long long>(target - base),
                        skipsPredicate ? "YES" : "no", reachesSetter ? "YES" : "no",
                        static_cast<unsigned long long>(contextStart - base),
                        contextOk ? hex : "UNREADABLE");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-INGRESS144] EDGE index=%u kind=%s sourceRva=0x%llX bytes=%u targetRva=0x%llX "
                        "skipsPredicate=%s reachesSetterBlock=%s contextStartRva=0x%llX context={%s}\r\n",
                        incomingEdges, kind ? kind : "?", static_cast<unsigned long long>(cursor - base),
                        instructionBytes, static_cast<unsigned long long>(target - base),
                        skipsPredicate ? "YES" : "no", reachesSetter ? "YES" : "no",
                        static_cast<unsigned long long>(contextStart - base),
                        contextOk ? hex : "UNREADABLE");
                }
            }

            // If the exact-function direct scan finds nothing, an indirect JMP
            // is the next plausible way to enter an interior block. Record only
            // FF /4 forms near the final 0x800 bytes; do not hook or alter them.
            if (cursor + 2u <= functionEnd && cursor + 0x800u >= failureBegin &&
                b[0] == 0xFFu && ((b[1] >> 3u) & 7u) == 4u)
            {
                ++indirectJumpsNearBlock;
                InternalLog(
                    "[DW-AUTH-INGRESS144] INDIRECT_JMP index=%u instructionRva=0x%llX modrm=0x%02X "
                    "candidateOnly=yes targetRuntimeUnknown=yes\r\n",
                    indirectJumpsNearBlock, static_cast<unsigned long long>(cursor - base), b[1]);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-INGRESS144] INDIRECT_JMP index=%u instructionRva=0x%llX modrm=0x%02X "
                    "candidateOnly=yes targetRuntimeUnknown=yes\r\n",
                    indirectJumpsNearBlock, static_cast<unsigned long long>(cursor - base), b[1]);
            }
        }

        const char* conclusion = incomingEdges ?
            "direct_internal_ingress_found_classify_source_condition_next" :
            (indirectJumpsNearBlock ? "no_direct_ingress_check_indirect_dispatch_next" :
             "no_local_ingress_edge_found_revisit_function_bounds_or_external_entry");
        InternalLog(
            "[DW-AUTH-INGRESS144] SUMMARY directBranches=%u incomingFailureEdges=%u indirectJumpCandidates=%u "
            "conclusion=%s stateWrites=off\r\n",
            directBranches, incomingEdges, indirectJumpsNearBlock, conclusion);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-INGRESS144] SUMMARY directBranches=%u incomingFailureEdges=%u indirectJumpCandidates=%u "
            "conclusion=%s stateWrites=off\r\n",
            directBranches, incomingEdges, indirectJumpsNearBlock, conclusion);
    }

    void ClassifyDwAuthResetFailureIngressSources144() noexcept
    {
        bool expected = false;
        if (!g_dwAuthFailureIngressSourcesDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
        {
            InternalLog("[DW-AUTH-INGRESS-SOURCE144] unavailable reason=image_not_ready stateWrites=off\r\n");
            return;
        }

        struct Source
        {
            std::uintptr_t rva;
            std::uintptr_t targetRva;
            const char* kind;
            const char* classification;
        };

        // V28 returned six byte-pattern edges. Five are instruction-aligned.
        // 0x2D2127F is byte 2 of the rel32 displacement belonging to the CALL
        // at 0x2D2127B and is therefore not a branch instruction.
        const Source sources[] = {
            {0x2D1FB72u, 0x2D212B5u, "JMP32", "unconditional_direct_to_setter_call"},
            {0x2D1FBAFu, 0x2D212B3u, "JMP32", "guarded_else_to_reset_block"},
            {0x2D1FC1Au, 0x2D212B3u, "JMP32", "unconditional_direct_to_reset_block"},
            {0x2D206F5u, 0x2D21297u, "JNE",   "predicate_conditioned_edge"},
            {0x2D2073Fu, 0x2D212B3u, "JMP32", "guarded_else_to_reset_block"},
        };

        InternalLog(
            "[DW-AUTH-INGRESS-SOURCE144] BEGIN sources=%zu excludedFalsePositive=0x2D2127F "
            "reason=inside_rel32_call_displacement predicateTotalCalls=%u predicateExactCalls=%u "
            "scope=FIVE_VERIFIED_SOURCE_WINDOWS mode=STATIC_READ_ONLY\r\n",
            ArrayCount(sources),
            g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire),
            g_dwAuthFailurePredicateObserverCalls144.load(std::memory_order_acquire));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-INGRESS-SOURCE144] BEGIN sources=%zu excludedFalsePositive=0x2D2127F "
            "reason=inside_rel32_call_displacement predicateTotalCalls=%u predicateExactCalls=%u "
            "scope=FIVE_VERIFIED_SOURCE_WINDOWS mode=STATIC_READ_ONLY\r\n",
            ArrayCount(sources),
            g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire),
            g_dwAuthFailurePredicateObserverCalls144.load(std::memory_order_acquire));

        unsigned viable = 0;
        for (std::size_t index = 0; index < ArrayCount(sources); ++index)
        {
            const auto& source = sources[index];
            if (source.rva >= size || source.targetRva >= size)
                continue;

            unsigned char edge[6]{};
            const bool edgeOk = ServerEmuSafeReadBytes(
                reinterpret_cast<const void*>(base + source.rva), edge, sizeof(edge));

            bool targetMatch = false;
            if (edgeOk)
            {
                std::uintptr_t decoded = 0;
                if (edge[0] == 0xE9u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, edge + 1u, sizeof(rel));
                    decoded = source.rva + 5u + static_cast<std::intptr_t>(rel);
                }
                else if (edge[0] == 0x0Fu && edge[1] >= 0x80u && edge[1] <= 0x8Fu)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, edge + 2u, sizeof(rel));
                    decoded = source.rva + 6u + static_cast<std::intptr_t>(rel);
                }
                targetMatch = decoded == source.targetRva;
            }

            bool hasImmediateGuard = false;
            std::uintptr_t guardRva = 0;
            std::uintptr_t guardTargetRva = 0;
            unsigned char guard[6]{};
            if (source.rva >= 6u &&
                ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + source.rva - 6u), guard, sizeof(guard)) &&
                guard[0] == 0x0Fu && guard[1] >= 0x80u && guard[1] <= 0x8Fu)
            {
                std::int32_t rel = 0;
                memcpy(&rel, guard + 2u, sizeof(rel));
                guardRva = source.rva - 6u;
                guardTargetRva = guardRva + 6u + static_cast<std::intptr_t>(rel);
                hasImmediateGuard = true;
            }

            constexpr std::size_t kBefore = 0x70u;
            constexpr std::size_t kAfter = 0x30u;
            unsigned char window[kBefore + kAfter]{};
            const std::uintptr_t windowStartRva = source.rva > kBefore ? source.rva - kBefore : 0;
            const bool windowOk = windowStartRva + sizeof(window) < size &&
                ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + windowStartRva), window, sizeof(window));

            const bool predicateRuledOut =
                source.rva == 0x2D206F5u &&
                g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire) == 0u &&
                g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire);

            const bool sourceViable = targetMatch && !predicateRuledOut;
            if (sourceViable)
                ++viable;

            InternalLog(
                "[DW-AUTH-INGRESS-SOURCE144] SOURCE index=%zu rva=0x%llX kind=%s expectedTarget=0x%llX "
                "targetMatch=%s class=%s runtimeViable=%s%s%s guard=%s guardRva=%s0x%llX guardTarget=%s0x%llX\r\n",
                index + 1u, static_cast<unsigned long long>(source.rva), source.kind,
                static_cast<unsigned long long>(source.targetRva), targetMatch ? "YES" : "no",
                source.classification, sourceViable ? "YES" : "no",
                predicateRuledOut ? " ruledOutReason=" : "",
                predicateRuledOut ? "predicate_detour_intact_totalCalls_0" : "",
                hasImmediateGuard ? "YES" : "no",
                hasImmediateGuard ? "" : "n/a-", static_cast<unsigned long long>(guardRva),
                hasImmediateGuard ? "" : "n/a-", static_cast<unsigned long long>(guardTargetRva));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-INGRESS-SOURCE144] SOURCE index=%zu rva=0x%llX kind=%s expectedTarget=0x%llX "
                "targetMatch=%s class=%s runtimeViable=%s%s%s guard=%s guardRva=%s0x%llX guardTarget=%s0x%llX\r\n",
                index + 1u, static_cast<unsigned long long>(source.rva), source.kind,
                static_cast<unsigned long long>(source.targetRva), targetMatch ? "YES" : "no",
                source.classification, sourceViable ? "YES" : "no",
                predicateRuledOut ? " ruledOutReason=" : "",
                predicateRuledOut ? "predicate_detour_intact_totalCalls_0" : "",
                hasImmediateGuard ? "YES" : "no",
                hasImmediateGuard ? "" : "n/a-", static_cast<unsigned long long>(guardRva),
                hasImmediateGuard ? "" : "n/a-", static_cast<unsigned long long>(guardTargetRva));

            if (!windowOk)
                continue;

            for (std::size_t off = 0; off < sizeof(window); off += 0x20u)
            {
                const std::size_t lineBytes = (std::min)(static_cast<std::size_t>(0x20u), sizeof(window) - off);
                char hex[0x20u * 3u + 8u]{};
                std::size_t used = 0;
                for (std::size_t i = 0; i < lineBytes && used + 4u < ArrayCount(hex); ++i)
                {
                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                        "%02X%s", window[off + i], (i + 1u) == lineBytes ? "" : " ");
                    if (wrote > 0)
                        used += static_cast<std::size_t>(wrote);
                }
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-INGRESS-SOURCE144] CODE sourceIndex=%zu rva=0x%llX bytes={%s}\r\n",
                    index + 1u, static_cast<unsigned long long>(windowStartRva + off), hex);
            }

            unsigned callCandidates = 0;
            for (std::size_t off = 0; off + 5u <= kBefore; ++off)
            {
                if (window[off] != 0xE8u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, window + off + 1u, sizeof(rel));
                const auto callRva = windowStartRva + off;
                const auto targetRva = callRva + 5u + static_cast<std::intptr_t>(rel);
                if (targetRva >= size)
                    continue;

                ++callCandidates;
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-INGRESS-SOURCE144] CALL_CANDIDATE sourceIndex=%zu callRva=0x%llX targetRva=0x%llX "
                    "deltaToEdge=-0x%llX instructionAlignment=UNVERIFIED\r\n",
                    index + 1u, static_cast<unsigned long long>(callRva),
                    static_cast<unsigned long long>(targetRva),
                    static_cast<unsigned long long>(source.rva - callRva));
            }

            InternalLog(
                "[DW-AUTH-INGRESS-SOURCE144] SOURCE_SUMMARY index=%zu callCandidates=%u codeWindow=0x%llX..0x%llX "
                "details=dw_auth_result.log\r\n",
                index + 1u, callCandidates,
                static_cast<unsigned long long>(windowStartRva),
                static_cast<unsigned long long>(windowStartRva + sizeof(window)));
        }

        InternalLog(
            "[DW-AUTH-INGRESS-SOURCE144] SUMMARY viableSources=%u ruledOutPredicateEdge=%s "
            "falsePositiveExcluded=0x2D2127F next=identify_condition_or_helper_immediately_before_viable_source stateWrites=off\r\n",
            viable,
            g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire) &&
                g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire) == 0u ? "YES" : "no");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-INGRESS-SOURCE144] SUMMARY viableSources=%u ruledOutPredicateEdge=%s "
            "falsePositiveExcluded=0x2D2127F next=identify_condition_or_helper_immediately_before_viable_source stateWrites=off\r\n",
            viable,
            g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire) &&
                g_dwAuthFailurePredicateObserverTotalCalls144.load(std::memory_order_acquire) == 0u ? "YES" : "no");
    }

    bool VerifyDwIngressDirectCall144(std::uintptr_t callRva, std::uintptr_t targetRva) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || callRva + 5u >= size || targetRva >= size)
            return false;

        unsigned char call[5]{};
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + callRva), call, sizeof(call)) ||
            call[0] != 0xE8u)
            return false;

        std::int32_t rel = 0;
        memcpy(&rel, call + 1u, sizeof(rel));
        const auto decoded = callRva + 5u + static_cast<std::intptr_t>(rel);
        return decoded == targetRva;
    }

    void LogDwIngressLive144(
        const char* helper,
        std::uintptr_t helperRva,
        std::uintptr_t caller,
        std::uint32_t arg0,
        std::uint32_t arg1,
        std::uint64_t result,
        const char* route) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const bool callerInGame = base && size && caller >= base && caller < base + size;
        const auto callerRva = callerInGame ? caller - base : 0;
        const unsigned hit = ++g_dwAuthIngressRuntimeHits144;

        InternalLog(
            "[DW-AUTH-INGRESS-LIVE144] hit=%u helper=%s helperRva=0x%llX callerRva=%s0x%llX "
            "arg0=%u arg1=0x%X result=0x%llX route=%s originalResultUnchanged=yes stateWrites=off\r\n",
            hit, helper ? helper : "?",
            static_cast<unsigned long long>(helperRva),
            callerInGame ? "" : "n/a-",
            static_cast<unsigned long long>(callerRva),
            arg0, arg1, static_cast<unsigned long long>(result),
            route ? route : "unclassified");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-INGRESS-LIVE144] hit=%u helper=%s helperRva=0x%llX callerRva=%s0x%llX "
            "arg0=%u arg1=0x%X result=0x%llX route=%s originalResultUnchanged=yes stateWrites=off\r\n",
            hit, helper ? helper : "?",
            static_cast<unsigned long long>(helperRva),
            callerInGame ? "" : "n/a-",
            static_cast<unsigned long long>(callerRva),
            arg0, arg1, static_cast<unsigned long long>(result),
            route ? route : "unclassified");
    }

    int MapDwSource3ParentError144(int stateMapResult) noexcept
    {
        // Exact parent mapping decoded from 0x2D1FBDA..0x2D1FC1A:
        // default/other -> 9, 1 -> 0x10, 2 -> 0x11, 3/4 -> 0x0F.
        if (stateMapResult == 1)
            return 0x10;
        if (stateMapResult == 2)
            return 0x11;
        if (stateMapResult == 3 || stateMapResult == 4)
            return 0x0F;
        return 0x09;
    }

    void DumpDwSource3HelperBodies144() noexcept
    {
        bool expected = false;
        if (!g_dwSource3HelperDumpDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
        {
            InternalLog("[DW-AUTH-SOURCE3-HELPER144] unavailable reason=image_not_ready stateWrites=off\r\n");
            return;
        }

        struct Helper
        {
            const char* label;
            std::uintptr_t rva;
        };
        const Helper helpers[] = {
            {"mask80_pre", kDwIngressMask80Rva144},
            {"mask_test", kDwIngressMaskTestRva144},
            {"state_map", kDwIngressStateMapRva144},
        };

        InternalLog(
            "[DW-AUTH-SOURCE3-HELPER144] BEGIN helpers=%zu scope=SOURCE3_ONLY mode=STATIC_READ_ONLY stateWrites=off\r\n",
            ArrayCount(helpers));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SOURCE3-HELPER144] BEGIN helpers=%zu scope=SOURCE3_ONLY mode=STATIC_READ_ONLY stateWrites=off\r\n",
            ArrayCount(helpers));

        for (const auto& helper : helpers)
        {
            if (helper.rva >= size)
                continue;

            std::uintptr_t begin = 0;
            std::uintptr_t end = 0;
            const bool unwind = RuntimeFunctionBounds144(base + helper.rva, begin, end);
            if (!unwind || begin < base || end <= begin || end > base + size ||
                begin > base + helper.rva || end - begin > 0x800u)
            {
                begin = base + helper.rva;
                end = (std::min)(base + size, begin + 0x180u);
            }

            const std::size_t total = static_cast<std::size_t>(end - begin);
            const std::size_t dumpBytes = (std::min)(total, static_cast<std::size_t>(0x300u));

            InternalLog(
                "[DW-AUTH-SOURCE3-HELPER144] FUNCTION label=%s targetRva=0x%llX beginRva=0x%llX endRva=0x%llX "
                "unwind=%s bytes=%zu dumpBytes=%zu read_only=yes\r\n",
                helper.label,
                static_cast<unsigned long long>(helper.rva),
                static_cast<unsigned long long>(begin - base),
                static_cast<unsigned long long>(end - base),
                unwind ? "yes" : "no", total, dumpBytes);
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-SOURCE3-HELPER144] FUNCTION label=%s targetRva=0x%llX beginRva=0x%llX endRva=0x%llX "
                "unwind=%s bytes=%zu dumpBytes=%zu read_only=yes\r\n",
                helper.label,
                static_cast<unsigned long long>(helper.rva),
                static_cast<unsigned long long>(begin - base),
                static_cast<unsigned long long>(end - base),
                unwind ? "yes" : "no", total, dumpBytes);

            constexpr std::size_t kChunk = 0x20u;
            for (std::size_t off = 0; off < dumpBytes; off += kChunk)
            {
                const std::size_t count = (std::min)(kChunk, dumpBytes - off);
                unsigned char bytes[kChunk]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(begin + off), bytes, count))
                {
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-SOURCE3-HELPER144] CODE label=%s rva=0x%llX unreadable=yes\r\n",
                        helper.label, static_cast<unsigned long long>((begin - base) + off));
                    continue;
                }

                char hex[kChunk * 3u + 8u]{};
                std::size_t used = 0;
                for (std::size_t i = 0; i < count && used + 4u < ArrayCount(hex); ++i)
                {
                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                        "%02X%s", bytes[i], (i + 1u) == count ? "" : " ");
                    if (wrote > 0)
                        used += static_cast<std::size_t>(wrote);
                }

                InternalLog(
                    "[DW-AUTH-SOURCE3-V34] HELPER_CODE label=%s rva=0x%llX bytes={%s} read_only=yes\r\n",
                    helper.label, static_cast<unsigned long long>((begin - base) + off), hex);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-SOURCE3-HELPER144] CODE label=%s rva=0x%llX bytes={%s}\r\n",
                    helper.label, static_cast<unsigned long long>((begin - base) + off), hex);
            }
        }

        InternalLog(
            "[DW-AUTH-SOURCE3-HELPER144] SUMMARY decodedStateGetterArrayRva=0x%llX setterRva=0x%llX "
            "next=trace_setter_caller_to_server_reply stateWrites=off\r\n",
            static_cast<unsigned long long>(kDwSource3StateArrayRva144),
            static_cast<unsigned long long>(kDwSource3StateSetterRva144));
        InternalLog(
            "[DW-AUTH-SOURCE3-V36] COMPLETE stateMapDecoded=yes setterObserver=%s xrefScan=on_terminal_failure "
            "next=trace_setter_caller_to_server_reply stateWrites=off\r\n",
            g_dwSource3StateSetterObserverInstalled144.load(std::memory_order_acquire) ? "ready" : "not_ready");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SOURCE3-HELPER144] SUMMARY decodedStateGetterArrayRva=0x%llX setterRva=0x%llX "
            "next=trace_setter_caller_to_server_reply stateWrites=off\r\n",
            static_cast<unsigned long long>(kDwSource3StateArrayRva144),
            static_cast<unsigned long long>(kDwSource3StateSetterRva144));
    }

    void ScanDwSource3StateSetterXrefs144() noexcept
    {
        if (g_dwSource3StateSetterXrefScanDone144.exchange(true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView text{};
        if (!base || !module || !GetImageSection(module, ".text", text) || !text.begin || !text.size)
        {
            InternalLog("[DW-AUTH-SOURCE3-XREF-V36] unavailable reason=no_text_section stateWrites=off\r\n");
            return;
        }

        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        const std::uintptr_t setter = base + kDwSource3StateSetterRva144;

        struct Range144
        {
            std::uintptr_t firstRva;
            std::uintptr_t lastRva;
            const char* label;
        };
        static constexpr Range144 ranges[] = {
            { 0x02C00000u, 0x02E00000u, "dw_auth_bridge" },
            { 0x03C00000u, 0x03E00000u, "dw_auth_pump" },
            { 0x04500000u, 0x04600000u, "status_helpers" },
            { 0x06180000u, 0x06200000u, "dw_login_flow" },
            { 0x06B00000u, 0x06D80000u, "dw_transport_auth" },
        };

        unsigned calls = 0;
        unsigned tailJumps = 0;
        unsigned addressRefs = 0;
        std::uintptr_t routeFunctions[8]{};
        unsigned routeFunctionCount = 0;
        InternalLog(
            "[DW-AUTH-SOURCE3-XREF-V36] BEGIN setterRva=0x%llX stateArrayRva=0x%llX ranges=%llu "
            "mode=STATIC_READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(kDwSource3StateSetterRva144),
            static_cast<unsigned long long>(kDwSource3StateArrayRva144),
            static_cast<unsigned long long>(ArrayCount(ranges)));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SOURCE3-XREF-V36] BEGIN setterRva=0x%llX stateArrayRva=0x%llX ranges=%llu "
            "mode=STATIC_READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(kDwSource3StateSetterRva144),
            static_cast<unsigned long long>(kDwSource3StateArrayRva144),
            static_cast<unsigned long long>(ArrayCount(ranges)));

        auto record = [&](const char* kind, const char* rangeLabel, std::uintptr_t site, std::uintptr_t target)
        {
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(site, functionBegin, functionEnd);
            InternalLog(
                "[DW-AUTH-SOURCE3-XREF-V36] hit kind=%s range=%s siteRva=0x%llX targetRva=0x%llX "
                "function=%s0x%llX..%s0x%llX unwind=%s read_only=yes\r\n",
                kind, rangeLabel,
                static_cast<unsigned long long>(site - base),
                static_cast<unsigned long long>(target - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-SOURCE3-XREF-V36] hit kind=%s range=%s siteRva=0x%llX targetRva=0x%llX "
                "function=%s0x%llX..%s0x%llX unwind=%s mode=STATIC_READ_ONLY stateWrites=off\r\n",
                kind, rangeLabel,
                static_cast<unsigned long long>(site - base),
                static_cast<unsigned long long>(target - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");

            if (bounded && routeFunctionCount < ArrayCount(routeFunctions))
            {
                bool seen = false;
                for (unsigned i = 0; i < routeFunctionCount; ++i)
                    seen = seen || routeFunctions[i] == functionBegin;
                if (!seen)
                    routeFunctions[routeFunctionCount++] = functionBegin;
            }

            AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-SOURCE3-XREF-V36-CODE]", site, 96, 144);

            // V37: the V36 site dump lived only in dw_auth_result.log. Echo the
            // complete bounded callback body to the normal log after the real
            // source3 failure so we can classify the missing LSG/ExtendedAuth
            // completion route without adding another live hook.
            if (bounded && functionEnd > functionBegin && functionEnd - functionBegin <= 0x300u)
            {
                constexpr std::size_t kChunk = 0x20u;
                const std::size_t total = static_cast<std::size_t>(functionEnd - functionBegin);
                for (std::size_t off = 0; off < total; off += kChunk)
                {
                    const std::size_t count = (std::min)(kChunk, total - off);
                    unsigned char bytes[kChunk]{};
                    if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(functionBegin + off), bytes, count))
                    {
                        InternalLog(
                            "[DW-AUTH-SOURCE3-XREF-V37-CODE] functionRva=0x%llX rva=0x%llX unreadable=yes read_only=yes\r\n",
                            static_cast<unsigned long long>(functionBegin - base),
                            static_cast<unsigned long long>((functionBegin - base) + off));
                        continue;
                    }

                    char hex[kChunk * 3u + 8u]{};
                    std::size_t used = 0;
                    for (std::size_t i = 0; i < count && used + 4u < ArrayCount(hex); ++i)
                    {
                        const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                            "%02X%s", bytes[i], (i + 1u) == count ? "" : " ");
                        if (wrote > 0)
                            used += static_cast<std::size_t>(wrote);
                    }
                    InternalLog(
                        "[DW-AUTH-SOURCE3-XREF-V37-CODE] functionRva=0x%llX rva=0x%llX bytes={%s} read_only=yes\r\n",
                        static_cast<unsigned long long>(functionBegin - base),
                        static_cast<unsigned long long>((functionBegin - base) + off), hex);
                }
            }
        };

        for (const auto& range : ranges)
        {
            const std::uintptr_t begin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t end = (std::min)(textEnd, base + range.lastRva);
            if (end <= begin)
                continue;

            for (std::uintptr_t cursor = begin; cursor + 7u <= end; ++cursor)
            {
                const auto* op = reinterpret_cast<const unsigned char*>(cursor);

                if ((op[0] == 0xE8u || op[0] == 0xE9u) && cursor + 5u <= end)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, op + 1u, sizeof(rel));
                    const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                    if (target == setter)
                    {
                        if (op[0] == 0xE8u) ++calls; else ++tailJumps;
                        record(op[0] == 0xE8u ? "CALL_REL32" : "JMP_REL32", range.label, cursor, target);
                    }
                }

                // Common x64 RIP-relative LEA encodings used when a function is
                // registered/stored as a callback: REX + 8D + modrm(rip+disp32).
                if ((op[0] == 0x48u || op[0] == 0x4Cu) && op[1] == 0x8Du && (op[2] & 0xC7u) == 0x05u)
                {
                    std::int32_t disp = 0;
                    memcpy(&disp, op + 3u, sizeof(disp));
                    const std::uintptr_t target = cursor + 7u + static_cast<std::intptr_t>(disp);
                    if (target == setter)
                    {
                        ++addressRefs;
                        record("LEA_RIP_ADDRESS", range.label, cursor, target);
                    }
                }
            }
        }

        // V37: walk one level upward from each function that calls the state
        // setter. This remains a bounded static read after the terminal failure.
        unsigned parentCalls = 0;
        unsigned parentTailJumps = 0;
        for (unsigned routeIndex = 0; routeIndex < routeFunctionCount; ++routeIndex)
        {
            const std::uintptr_t routeTarget = routeFunctions[routeIndex];
            for (const auto& range : ranges)
            {
                const std::uintptr_t begin = (std::max)(textBegin, base + range.firstRva);
                const std::uintptr_t end = (std::min)(textEnd, base + range.lastRva);
                if (end <= begin)
                    continue;

                for (std::uintptr_t cursor = begin; cursor + 5u <= end; ++cursor)
                {
                    unsigned char op[5]{};
                    if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), op, sizeof(op)))
                        continue;
                    if (op[0] != 0xE8u && op[0] != 0xE9u)
                        continue;

                    std::int32_t rel = 0;
                    memcpy(&rel, op + 1u, sizeof(rel));
                    const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                    if (target != routeTarget)
                        continue;

                    if (op[0] == 0xE8u) ++parentCalls; else ++parentTailJumps;
                    std::uintptr_t parentBegin = 0;
                    std::uintptr_t parentEnd = 0;
                    const bool parentBounded = RuntimeFunctionBounds144(cursor, parentBegin, parentEnd);
                    InternalLog(
                        "[DW-AUTH-SOURCE3-XREF-V37-PARENT] kind=%s range=%s siteRva=0x%llX routeFunctionRva=0x%llX "
                        "parentFunction=%s0x%llX..%s0x%llX unwind=%s read_only=yes\r\n",
                        op[0] == 0xE8u ? "CALL_REL32" : "JMP_REL32", range.label,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(routeTarget - base),
                        parentBounded ? "" : "n/a-", static_cast<unsigned long long>(parentBounded ? parentBegin - base : 0),
                        parentBounded ? "" : "n/a-", static_cast<unsigned long long>(parentBounded ? parentEnd - base : 0),
                        parentBounded ? "yes" : "no");
                }
            }
        }

        InternalLog(
            "[DW-AUTH-SOURCE3-XREF-V37] COMPLETE routeFunctions=%u parentCalls=%u parentTailJumps=%u "
            "next=decode_missing_route_condition_then_fix_LSG_ExtendedAuth stateWrites=off\r\n",
            routeFunctionCount, parentCalls, parentTailJumps);

        const unsigned runtimeSets = g_dwSource3StateSetterCalls144.load(std::memory_order_acquire);
        InternalLog(
            "[DW-AUTH-SOURCE3-XREF-V36] COMPLETE calls=%u tailJumps=%u addressRefs=%u runtimeSetterCalls=%u "
            "interpretation=%s next=map_missing_callback_to_LSG_ExtendedAuth_response stateWrites=off\r\n",
            calls, tailJumps, addressRefs, runtimeSets,
            (calls || tailJumps || addressRefs) ? "STATIC_ROUTE_FOUND_BUT_NOT_EXECUTED" : "NO_ROUTE_IN_FOCUSED_RANGES");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SOURCE3-XREF-V36] COMPLETE calls=%u tailJumps=%u addressRefs=%u runtimeSetterCalls=%u "
            "interpretation=%s next=map_missing_callback_to_LSG_ExtendedAuth_response stateWrites=off\r\n",
            calls, tailJumps, addressRefs, runtimeSets,
