    BOOL WINAPI BNetCryptUnprotectDataObserver144(BNetDataBlob144* dataIn, LPWSTR* description,
        BNetDataBlob144* optionalEntropy, PVOID reserved, PVOID prompt, DWORD flags, BNetDataBlob144* dataOut) noexcept
    {
        const bool relevant = g_bnetFirstStateGuardActive;
        const unsigned call = relevant ? ++g_bnetCryptUnprotectCalls : 0u;
        const DWORD inputBytes = dataIn ? dataIn->cbData : 0u;
        const DWORD entropyBytes = optionalEntropy ? optionalEntropy->cbData : 0u;
        const DWORD outputBefore = dataOut ? dataOut->cbData : 0u;

        BOOL result = FALSE;
        DWORD lastError = ERROR_PROC_NOT_FOUND;
        if (g_bnetCryptUnprotectDataOriginal)
        {
            result = g_bnetCryptUnprotectDataOriginal(dataIn, description, optionalEntropy, reserved, prompt, flags, dataOut);
            lastError = result ? ERROR_SUCCESS : GetLastError();
        }

        const DWORD firstOutputAfter = dataOut ? dataOut->cbData : 0u;
        bool syntheticAttempted = false;
        bool syntheticProtected = false;
        bool syntheticRetrySucceeded = false;
        DWORD syntheticProtectedBytes = 0u;

        // The captured ODIN WEB_TOKEN is the known 262-byte dummy template and
        // fails stock DPAPI with ERROR_INVALID_DATA. In pure local emulation only,
        // create a harmless local launcher token, protect it with the exact entropy
        // supplied by the stock game, then hand that DPAPI envelope back through
        // the original CryptUnprotectData path. We do not force the guard result:
        // the stock guard/parser still decides whether this plaintext is acceptable.
        const bool exactDummyWebToken = relevant && !result &&
            g_bnetFirstStateGuardActiveArg0 == 0u && inputBytes == 262u &&
            g_bnetWebTokenTemplateSeen.load(std::memory_order_acquire) &&
            g_bnetWebTokenTemplateMatch.load(std::memory_order_acquire);

        if (exactDummyWebToken && BNetSyntheticWebTokenLocalOnly144() &&
            g_bnetCryptProtectData && g_bnetCryptUnprotectDataOriginal &&
            optionalEntropy && optionalEntropy->cbData != 0u && dataOut)
        {
            syntheticAttempted = true;
            static const unsigned char kLocalWebToken[] = "revamped-local-web-token";
            BNetDataBlob144 plain{};
            plain.cbData = static_cast<DWORD>(sizeof(kLocalWebToken) - 1u);
            plain.pbData = const_cast<BYTE*>(reinterpret_cast<const BYTE*>(kLocalWebToken));

            BNetDataBlob144 protectedBlob{};
            syntheticProtected = g_bnetCryptProtectData(&plain, L"CodRevamped local WEB_TOKEN",
                optionalEntropy, reserved, prompt, flags, &protectedBlob) != FALSE;
            const DWORD protectError = syntheticProtected ? ERROR_SUCCESS : GetLastError();
            syntheticProtectedBytes = protectedBlob.cbData;

            if (syntheticProtected && protectedBlob.pbData && protectedBlob.cbData)
            {
                dataOut->cbData = 0u;
                dataOut->pbData = nullptr;
                result = g_bnetCryptUnprotectDataOriginal(&protectedBlob, description, optionalEntropy,
                    reserved, prompt, flags, dataOut);
                lastError = result ? ERROR_SUCCESS : GetLastError();
                syntheticRetrySucceeded = result != FALSE;
                LocalFree(protectedBlob.pbData);
            }
            else
            {
                lastError = protectError;
            }
        }

        const DWORD outputAfter = dataOut ? dataOut->cbData : 0u;
        if (relevant)
        {
            const char* classification = nullptr;
            if (syntheticAttempted)
            {
                if (!syntheticProtected)
                    classification = "LOCAL_SYNTH_PROTECT_FAILED";
                else if (syntheticRetrySucceeded && outputAfter)
                    classification = "LOCAL_SYNTH_DPAPI_OK_NONEMPTY";
                else if (syntheticRetrySucceeded)
                    classification = "LOCAL_SYNTH_DPAPI_OK_EMPTY";
                else
                    classification = "LOCAL_SYNTH_UNPROTECT_FAILED";
            }
            else
            {
                classification = result ?
                    (outputAfter ? "DPAPI_OK_NONEMPTY" : "DPAPI_OK_EMPTY") : "DPAPI_FAILED";
            }

            InternalLog("[AUTH-GATE-DPAPI144] call=%u guardCall=%u arg0=0x%llX result=%s class=%s inputBytes=%u entropyBytes=%u outputBefore=%u firstOutputAfter=%u outputAfter=%u syntheticAttempted=%s syntheticProtectedBytes=%u lastError=%lu flags=0x%08lX contents=REDACTED; local-only synthetic envelope=%s\r\n",
                call, g_bnetFirstStateGuardActiveCall,
                static_cast<unsigned long long>(g_bnetFirstStateGuardActiveArg0),
                result ? "TRUE" : "FALSE", classification,
                static_cast<unsigned>(inputBytes), static_cast<unsigned>(entropyBytes),
                static_cast<unsigned>(outputBefore), static_cast<unsigned>(firstOutputAfter),
                static_cast<unsigned>(outputAfter), syntheticAttempted ? "yes" : "no",
                static_cast<unsigned>(syntheticProtectedBytes),
                static_cast<unsigned long>(lastError), static_cast<unsigned long>(flags),
                BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled");
            ServerEmuAppend(L"auth_gate_runtime.log",
                "[AUTH-GATE-DPAPI144] call=%u guardCall=%u arg0=0x%llX result=%s class=%s inputBytes=%u entropyBytes=%u outputBefore=%u firstOutputAfter=%u outputAfter=%u syntheticAttempted=%s syntheticProtectedBytes=%u lastError=%lu flags=0x%08lX contents=REDACTED local_only=yes\r\n",
                call, g_bnetFirstStateGuardActiveCall,
                static_cast<unsigned long long>(g_bnetFirstStateGuardActiveArg0),
                result ? "TRUE" : "FALSE", classification,
                static_cast<unsigned>(inputBytes), static_cast<unsigned>(entropyBytes),
                static_cast<unsigned>(outputBefore), static_cast<unsigned>(firstOutputAfter),
                static_cast<unsigned>(outputAfter), syntheticAttempted ? "yes" : "no",
                static_cast<unsigned>(syntheticProtectedBytes),
                static_cast<unsigned long>(lastError), static_cast<unsigned long>(flags));
        }

        SetLastError(lastError);
        return result;
    }

    bool InstallBNetCryptUnprotectObserver144() noexcept
    {
        if (g_bnetCryptUnprotectObserverInstalled.load(std::memory_order_acquire))
            return true;

        HMODULE crypt32 = GetModuleHandleW(L"crypt32.dll");
        if (!crypt32)
            crypt32 = LoadLibraryW(L"crypt32.dll");
        if (!crypt32)
        {
            InternalLog("[AUTH-GATE-DPAPI144] crypt32.dll unavailable; DPAPI observer not installed\r\n");
            return false;
        }

        void* target = reinterpret_cast<void*>(GetProcAddress(crypt32, "CryptUnprotectData"));
        g_bnetCryptProtectData = reinterpret_cast<CryptProtectDataFn144>(GetProcAddress(crypt32, "CryptProtectData"));
        if (!target)
        {
            InternalLog("[AUTH-GATE-DPAPI144] CryptUnprotectData export unavailable; observer not installed\r\n");
            return false;
        }

        const MH_STATUS init = MH_Initialize();
        if (init != MH_OK && init != MH_ERROR_ALREADY_INITIALIZED)
        {
            InternalLog("[AUTH-GATE-DPAPI144] MH_Initialize failed status=%d\r\n", static_cast<int>(init));
            return false;
        }

        void* trampoline = reinterpret_cast<void*>(g_bnetCryptUnprotectDataOriginal);
        const MH_STATUS create = MH_CreateHook(target, reinterpret_cast<void*>(&BNetCryptUnprotectDataObserver144), &trampoline);
        if (create == MH_OK)
        {
            g_bnetCryptUnprotectDataOriginal = reinterpret_cast<CryptUnprotectDataFn144>(trampoline);
        }
        else if (create != MH_ERROR_ALREADY_CREATED || !g_bnetCryptUnprotectDataOriginal)
        {
            InternalLog("[AUTH-GATE-DPAPI144] MH_CreateHook failed status=%d\r\n", static_cast<int>(create));
            return false;
        }

        const MH_STATUS enable = MH_EnableHook(target);
        if (enable != MH_OK && enable != MH_ERROR_ENABLED)
        {
            InternalLog("[AUTH-GATE-DPAPI144] MH_EnableHook failed status=%d\r\n", static_cast<int>(enable));
            if (create == MH_OK)
            {
                MH_RemoveHook(target);
                g_bnetCryptUnprotectDataOriginal = nullptr;
            }
            return false;
        }

        g_bnetCryptUnprotectObserverInstalled.store(true, std::memory_order_release);
        InternalLog("[AUTH-GATE-DPAPI144] observer active target=%p original=%p protect=%p; sizes/status only, contents REDACTED; local synthetic WEB_TOKEN=%s host=%s\r\n",
            target, reinterpret_cast<void*>(g_bnetCryptUnprotectDataOriginal),
            reinterpret_cast<void*>(g_bnetCryptProtectData),
            BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled", ServerEmuSettings().host);
        ServerEmuAppend(L"auth_gate_runtime.log",
            "[AUTH-GATE-DPAPI144] observer active target=%p original=%p protect=%p contents=REDACTED mode=LOCAL_SYNTHETIC_DPAPI_ENVELOPE_THEN_STOCK_GUARD localSynthetic=%s host=%s\r\n",
            target, reinterpret_cast<void*>(g_bnetCryptUnprotectDataOriginal),
            reinterpret_cast<void*>(g_bnetCryptProtectData),
            BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled", ServerEmuSettings().host);
        return true;
    }

