    bool ServerEmuSafeReadBytes(const void* source, void* destination, std::size_t length) noexcept
    {
        if (!source || !destination || !length)
            return false;
        __try
        {
            memcpy(destination, source, length);
            return true;
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            memset(destination, 0, length);
            return false;
        }
    }


