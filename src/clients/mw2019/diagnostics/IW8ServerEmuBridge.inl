    static V104LiveSlot7Target144 V104ResolveLiveSlot7Target144(std::uintptr_t task, std::uintptr_t objectOffset) noexcept
    {
        V104LiveSlot7Target144 out{};
        out.objectOffset = objectOffset;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!task || !base || !size)
            return out;

        out.vtableReadable = ServerEmuSafeReadPointer(reinterpret_cast<const void*>(task + objectOffset), out.vtable);
        if (!out.vtableReadable || !out.vtable)
            return out;
        if (out.vtable >= base && out.vtable < base + size)
            out.vtableRva = out.vtable - base;

        out.slotReadable = ServerEmuSafeReadPointer(
            reinterpret_cast<const void*>(out.vtable + 7ull * sizeof(std::uintptr_t)), out.slot7);
        if (!out.slotReadable || !out.slot7)
            return out;
        if (out.slot7 >= base && out.slot7 < base + size)
            out.slot7Rva = out.slot7 - base;
        else
            return out;

        std::uintptr_t begin = 0, end = 0;
        out.bounded = RuntimeFunctionBounds144(out.slot7, begin, end) && end > begin;
        if (out.bounded)
        {
            if (begin >= base && begin < base + size) out.functionBeginRva = begin - base;
            if (end > base && end <= base + size) out.functionEndRva = end - base;
        }
        return out;
    }

    // V106: crash-safe Source3 +0x50 dispatch research.
    //
    // V105 temporarily rewrote the shared 0x6F1A230 vtable slot. Even though the
    // pointer was restored before forwarding, another game thread can observe the
    // temporary entry and race the one-shot observer. V106 removes that mechanism
    // completely: no VirtualProtect, no vtable writes, no code patches, and no new
    // detours are installed by this probe.
    //
    // After the stock CONNECTED commit, V106 performs a one-time READ-ONLY scan of
    // executable pages in the main image for RIP-relative references to the exact
    // ingress slot that owns Source3 task #7. For each bounded owner it then looks
    // for the x64 virtual-dispatch shape used by slot 7: an indirect CALL through
    // vtable offset 7*sizeof(void*) == 0x38. It also records nearby +0x50 object
    // adjustment instructions because the Source3 subobject lives at task+0x50.
    // This gives us safe callsite candidates without modifying a live object.
    static std::atomic_bool g_v106ReadOnlyScanDone{false};
    static std::atomic_bool g_v106ReadOnlyScanQueued{false};
    static std::atomic_bool g_v106ConnectedSnapshotLogged{false};
    static std::atomic_bool g_v106OneSecondSnapshotLogged{false};
    static std::atomic_bool g_v106ThreeSecondSnapshotLogged{false};
    static std::atomic_uint g_v106IngressXrefs{0};
    static std::atomic_uint g_v106Slot7CallCandidates{0};

    static bool V106IsExecutableProtection144(DWORD protection) noexcept
    {
        const DWORD p = protection & 0xFFu;
        return p == PAGE_EXECUTE || p == PAGE_EXECUTE_READ ||
               p == PAGE_EXECUTE_READWRITE || p == PAGE_EXECUTE_WRITECOPY;
    }

    static bool V106DecodeRipRelativeTarget144(const unsigned char* bytes, std::size_t available,
        std::uintptr_t instruction, std::uintptr_t& target) noexcept
    {
        target = 0;
        if (!bytes || available < 7u)
            return false;
        // x64: REX + LEA/MOV + modrm(mod=00,r/m=101) + rel32.
        if ((bytes[0] & 0xF0u) != 0x40u ||
            (bytes[1] != 0x8Du && bytes[1] != 0x8Bu) ||
            (bytes[2] & 0xC7u) != 0x05u)
            return false;
        std::int32_t displacement = 0;
        memcpy(&displacement, bytes + 3u, sizeof(displacement));
        target = instruction + 7u + static_cast<std::intptr_t>(displacement);
        return true;
    }

    static bool V106DecodeIndirectCallDisp144(const unsigned char* bytes, std::size_t available,
        std::size_t& length, std::uint32_t& displacement, unsigned& modrmOut) noexcept
    {
        length = 0;
        displacement = 0;
        modrmOut = 0;
        if (!bytes || available < 3u || bytes[0] != 0xFFu)
            return false;
        const unsigned modrm = bytes[1];
        if (((modrm >> 3u) & 7u) != 2u) // FF /2 = CALL r/m64
            return false;
        const unsigned mod = (modrm >> 6u) & 3u;
        const unsigned rm = modrm & 7u;
        if (mod == 1u)
        {
            // disp8. SIB adds one byte before the displacement when r/m == 4.
            const std::size_t dispIndex = rm == 4u ? 3u : 2u;
            if (available <= dispIndex)
                return false;
            displacement = static_cast<std::uint8_t>(bytes[dispIndex]);
            length = dispIndex + 1u;
            modrmOut = modrm;
            return true;
        }
        if (mod == 2u)
        {
            const std::size_t dispIndex = rm == 4u ? 3u : 2u;
            if (available < dispIndex + 4u)
                return false;
            std::uint32_t d = 0;
            memcpy(&d, bytes + dispIndex, sizeof(d));
            displacement = d;
            length = dispIndex + 4u;
            modrmOut = modrm;
            return true;
        }
        return false;
    }

    static void V106DescribeCandidate144(std::uintptr_t ownerBegin, std::uintptr_t ownerEnd,
        std::uintptr_t ingressXref, std::uintptr_t callSite, unsigned modrm, unsigned candidateIndex) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !ownerBegin || !ownerEnd || ownerEnd <= ownerBegin || !callSite)
            return;

        std::uintptr_t nearestJcc = 0, nearestJccTarget = 0;
        unsigned nearestJccOpcode = 0;
        const auto scanBegin = (std::max)(ownerBegin, callSite > 96u ? callSite - 96u : ownerBegin);
        unsigned char window[128]{};
        const std::size_t windowBytes = static_cast<std::size_t>((std::min)(callSite - scanBegin, sizeof(window)));
        if (windowBytes && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(scanBegin), window, windowBytes))
        {
            for (std::size_t i = 0; i < windowBytes; ++i)
            {
                if (window[i] >= 0x70u && window[i] <= 0x7Fu && i + 1u < windowBytes)
                {
                    const auto rel = static_cast<std::int8_t>(window[i + 1u]);
                    nearestJcc = scanBegin + i;
                    nearestJccTarget = nearestJcc + 2u + static_cast<std::intptr_t>(rel);
                    nearestJccOpcode = window[i];
                }
                else if (window[i] == 0x0Fu && i + 5u < windowBytes &&
                         window[i + 1u] >= 0x80u && window[i + 1u] <= 0x8Fu)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, window + i + 2u, sizeof(rel));
                    nearestJcc = scanBegin + i;
                    nearestJccTarget = nearestJcc + 6u + static_cast<std::intptr_t>(rel);
                    nearestJccOpcode = 0x0F00u | window[i + 1u];
                }
            }
        }

        // Also report whether this owner contains an obvious task+0x50 adjustment.
        bool hasPlus50Adjust = false;
        const std::size_t ownerBytes = static_cast<std::size_t>((std::min)(ownerEnd - ownerBegin, static_cast<std::uintptr_t>(0x2000u)));
        unsigned char ownerWindow[0x2000]{};
        if (ownerBytes && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(ownerBegin), ownerWindow, ownerBytes))
        {
            for (std::size_t i = 0; i + 4u <= ownerBytes; ++i)
            {
                // LEA r64,[r/m64+0x50] commonly appears as REX 8D modrm disp8=0x50.
                if ((ownerWindow[i] & 0xF0u) == 0x40u && ownerWindow[i + 1u] == 0x8Du)
                {
                    const unsigned m = ownerWindow[i + 2u];
                    const unsigned mod = (m >> 6u) & 3u;
                    const unsigned rm = m & 7u;
                    if (mod == 1u)
                    {
                        const std::size_t di = i + (rm == 4u ? 4u : 3u);
                        if (di < ownerBytes && ownerWindow[di] == 0x50u)
                        {
                            hasPlus50Adjust = true;
                            break;
                        }
                    }
                }
            }
        }

        ServerEmuTargetedAppend(L"v106_slot50_readonly.log",
            "[V106-CALLSITE] candidate=%u ingressSlotXrefRva=0x%llX owner=0x%llX..0x%llX "
            "indirectCallRva=0x%llX modrm=0x%02X vtableDisp=0x38 taskPlus50Adjust=%s "
            "nearestJcc=%s0x%llX opcode=0x%X target=%s0x%llX mode=READ_ONLY stateWrites=off\r\n",
            candidateIndex,
            static_cast<unsigned long long>(ingressXref - base),
            static_cast<unsigned long long>(ownerBegin - base),
            static_cast<unsigned long long>(ownerEnd - base),
            static_cast<unsigned long long>(callSite - base), modrm,
            hasPlus50Adjust ? "yes" : "no",
            nearestJcc ? "" : "n/a-", static_cast<unsigned long long>(nearestJcc ? nearestJcc - base : 0u), nearestJccOpcode,
            nearestJccTarget >= base && nearestJccTarget < base + size ? "" : "n/a-",
            static_cast<unsigned long long>(nearestJccTarget >= base && nearestJccTarget < base + size ? nearestJccTarget - base : 0u));
        AppendCodeBytes144(L"v106_slot50_readonly.log", "[V106-CALLSITE-CODE]", callSite, 96u, 128u);
    }

    // V107: the V106 exact-slot scan proved the client does not directly RIP-reference
    // ingressSlot7 (0x147DEC68). Runtime evidence instead gives us the shared dispatcher
    // return site 0x2B592BD: the safe TABLE00 handler is repeatedly called from there while
    // the Source3 TABLE50 handler is never selected. Pivot to the dispatcher owner and the
    // ingress table BASE (0x147DEC30), both read-only.
    static std::atomic_bool g_v107DispatcherDumpDone{false};
    static std::atomic_uint g_v107TableBaseXrefs{0};
    static std::atomic_uint g_v107OwnerIndirectCalls{0};
    static std::atomic_uint g_v107OwnerSlot38Calls{0};

    static bool V107DecodeRipRelativeAny144(const unsigned char* b, std::size_t avail,
        std::uintptr_t instruction, std::uintptr_t& target, std::size_t& length) noexcept
    {
        target = 0; length = 0;
        if (!b || avail < 6u) return false;
        std::size_t i = 0;
        if ((b[i] & 0xF0u) == 0x40u) ++i; // optional REX
        if (i + 6u > avail) return false;
        // LEA/MOV r64,[rip+rel32] or MOV r/m32,[rip+rel32].
        if (b[i] != 0x8Du && b[i] != 0x8Bu && b[i] != 0x89u) return false;
        const unsigned modrm = b[i + 1u];
        if ((modrm & 0xC7u) != 0x05u) return false;
        std::int32_t rel = 0;
        memcpy(&rel, b + i + 2u, sizeof(rel));
        length = i + 6u;
        target = instruction + length + static_cast<std::intptr_t>(rel);
        return true;
    }

    // V108: V107 proved the 0x2B592BD pivot was a different object/class path:
    // the live call at 0x2B592BA is [vtable+0x08], not slot7/+0x38, and the
    // TABLE00 handler argument is not the Source3 task.  Return to the exact
    // TASK_TABLE_50 class materializer already established by earlier static
    // work (0x2B5B097 -> vtable 0x6F1A230) and search only the tight 0x2B58xxx-
    // 0x2B5Cxxx family for real virtual calls through +0x38.  Everything here
    // is read-only and runs on the background worker.
    static std::atomic_uint g_v108FocusedSlot38Candidates{0};
    static std::atomic_uint g_v108FocusedSlot38Plus50Owners{0};

    static unsigned V108CountPlus50Evidence144(const unsigned char* code, std::size_t n) noexcept
    {
        if (!code || !n) return 0;
        unsigned hits = 0;
        for (std::size_t i = 0; i < n; ++i)
        {
            // LEA/MOV r64,[base+0x50] with disp8.  SIB forms are accepted.
            if (i + 4u <= n && (code[i] & 0xF0u) == 0x40u &&
                (code[i + 1u] == 0x8Du || code[i + 1u] == 0x8Bu || code[i + 1u] == 0x89u))
            {
                const unsigned modrm = code[i + 2u];
                const unsigned mod = (modrm >> 6u) & 3u;
                const unsigned rm = modrm & 7u;
                if (mod == 1u)
                {
                    const std::size_t dispIndex = i + (rm == 4u ? 4u : 3u);
                    if (dispIndex < n && code[dispIndex] == 0x50u) ++hits;
                }
            }
            // ADD r64,0x50 (83 /0 ib) is another common this-adjust shape.
            if (i + 4u <= n && (code[i] & 0xF0u) == 0x40u && code[i + 1u] == 0x83u)
            {
                const unsigned modrm = code[i + 2u];
                if (((modrm >> 6u) & 3u) == 3u && ((modrm >> 3u) & 7u) == 0u && code[i + 3u] == 0x50u)
                    ++hits;
            }
        }
        return hits;
    }

    static unsigned V108CountExactRipRefs144(const unsigned char* code, std::size_t n,
        std::uintptr_t begin, std::uintptr_t wanted) noexcept
    {
        unsigned hits = 0;
        if (!code || !n || !begin || !wanted) return 0;
        for (std::size_t i = 0; i + 6u <= n; ++i)
        {
            std::uintptr_t target = 0; std::size_t ilen = 0;
            if (V107DecodeRipRelativeAny144(code + i, n - i, begin + i, target, ilen) && target == wanted)
                ++hits;
        }
        return hits;
    }

    static void V108ScanFocusedSlot50Dispatch144() noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size) return;

        const std::uintptr_t familyBeginRva = 0x2B58000u;
        const std::uintptr_t familyEndRva = 0x2B5C000u;
        if (familyBeginRva >= size) return;
        const std::uintptr_t begin = base + familyBeginRva;
        const std::uintptr_t end = base + (std::min<std::uintptr_t>)(familyEndRva, size);
        if (end <= begin) return;

        // Validate the known TASK_TABLE_50 materializer and its old proven parent.
        const std::uintptr_t matSiteRva = 0x2B5B097u;
        const std::uintptr_t constructorRva = 0x2B5B065u;
        const std::uintptr_t parentEdgeRva = 0x19D426Fu;
        const std::uintptr_t vtable50Rva = 0x6F1A230u;
        unsigned char matBytes[16]{};
        std::uintptr_t matTarget = 0; std::size_t matLen = 0;
        const bool matRead = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + matSiteRva), matBytes, sizeof(matBytes));
        const bool matRip = matRead && V107DecodeRipRelativeAny144(matBytes, sizeof(matBytes), base + matSiteRva, matTarget, matLen);
        unsigned char edgeBytes[5]{};
        bool edgeOk = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + parentEdgeRva), edgeBytes, sizeof(edgeBytes));
        std::uintptr_t edgeTarget = 0;
        if (edgeOk && edgeBytes[0] == 0xE9u)
        {
            std::int32_t rel = 0; memcpy(&rel, edgeBytes + 1u, sizeof(rel));
            edgeTarget = base + parentEdgeRva + 5u + static_cast<std::intptr_t>(rel);
        }
        ServerEmuTargetedAppend(L"v108_slot50_class_dispatch.log",
            "[V108-MATERIALIZER] siteRva=0x%llX constructorRva=0x%llX ripTarget=%s0x%llX expectedVtable=0x%llX match=%s parentEdgeRva=0x%llX parentTarget=%s0x%llX parentMatch=%s mode=READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(matSiteRva), static_cast<unsigned long long>(constructorRva),
            matRip && matTarget >= base && matTarget < base + size ? "" : "n/a-",
            static_cast<unsigned long long>(matRip && matTarget >= base && matTarget < base + size ? matTarget - base : 0u),
            static_cast<unsigned long long>(vtable50Rva),
            matRip && matTarget == base + vtable50Rva ? "YES" : "no",
            static_cast<unsigned long long>(parentEdgeRva),
            edgeTarget >= base && edgeTarget < base + size ? "" : "n/a-",
            static_cast<unsigned long long>(edgeTarget >= base && edgeTarget < base + size ? edgeTarget - base : 0u),
            edgeTarget == base + constructorRva ? "YES" : "no");
        AppendCodeBytes144(L"v108_slot50_class_dispatch.log", "[V108-MATERIALIZER-CODE]", base + constructorRva, 0x90u, 0x120u);
        AppendCodeBytes144(L"v108_slot50_class_dispatch.log", "[V108-PARENT-CODE]", base + parentEdgeRva, 0x80u, 0x80u);

        const std::size_t rangeBytes = static_cast<std::size_t>(end - begin);
        std::vector<unsigned char> bytes(rangeBytes);
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(begin), bytes.data(), bytes.size())) return;

        unsigned candidates = 0;
        unsigned plus50Owners = 0;
        for (std::size_t i = 0; i < bytes.size(); ++i)
        {
            std::size_t callLen = 0; std::uint32_t disp = 0; unsigned modrm = 0;
            if (!V106DecodeIndirectCallDisp144(bytes.data() + i, bytes.size() - i, callLen, disp, modrm) || disp != 0x38u)
                continue;

            const std::uintptr_t callVa = begin + i;
            std::uintptr_t ownerBegin = 0, ownerEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(callVa, ownerBegin, ownerEnd) && ownerEnd > ownerBegin;
            unsigned plus50 = 0, vtableRefs = 0;
            if (bounded && ownerEnd - ownerBegin <= 0x2000u)
            {
                const std::size_t ownerBytes = static_cast<std::size_t>(ownerEnd - ownerBegin);
                std::vector<unsigned char> owner(ownerBytes);
                if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(ownerBegin), owner.data(), owner.size()))
                {
                    plus50 = V108CountPlus50Evidence144(owner.data(), owner.size());
                    vtableRefs = V108CountExactRipRefs144(owner.data(), owner.size(), ownerBegin, base + vtable50Rva);
                }
            }
            ++candidates;
            if (plus50) ++plus50Owners;
            ServerEmuTargetedAppend(L"v108_slot50_class_dispatch.log",
                "[V108-SLOT38] candidate=%u callRva=0x%llX modrm=0x%02X owner=%s0x%llX..0x%llX plus50Evidence=%u vtable50Refs=%u classHint=%s mode=READ_ONLY stateWrites=off\r\n",
                candidates, static_cast<unsigned long long>(callVa - base), modrm,
                bounded ? "" : "UNBOUNDED/", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
                static_cast<unsigned long long>(bounded ? ownerEnd - base : 0u), plus50, vtableRefs,
                (plus50 || vtableRefs) ? "POSSIBLE_TASK50_DISPATCH" : "GENERIC_SLOT7_CALL");
            if (candidates <= 24u)
                AppendCodeBytes144(L"v108_slot50_class_dispatch.log", "[V108-SLOT38-CODE]", callVa, 0x60u, 0x80u);
        }
        g_v108FocusedSlot38Candidates.store(candidates, std::memory_order_release);
        g_v108FocusedSlot38Plus50Owners.store(plus50Owners, std::memory_order_release);

        const std::uintptr_t task = V97ReadSlot7Task144();
        std::uintptr_t live50 = 0;
        if (task) ServerEmuSafeReadPointer(reinterpret_cast<const void*>(task + 0x50u), live50);
        ServerEmuTargetedAppend(L"v108_slot50_class_dispatch.log",
            "[V108-SCAN] COMPLETE family=0x2B58000..0x2B5C000 slot38Candidates=%u plus50Owners=%u task=%p live50Rva=%s0x%llX expectedVtable=0x6F1A230 oldPivot0x2B592BD=RECLASSIFIED_NON_SLOT38 mode=READ_ONLY noHooksAdded=yes vtableWrites=OFF codeWrites=OFF stateWrites=off\r\n",
            candidates, plus50Owners, reinterpret_cast<void*>(task),
            live50 >= base && live50 < base + size ? "" : "n/a-",
            static_cast<unsigned long long>(live50 >= base && live50 < base + size ? live50 - base : 0u));
    }


