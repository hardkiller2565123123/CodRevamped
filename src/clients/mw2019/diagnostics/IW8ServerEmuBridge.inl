                    targetRefs, kind ? kind : "?", static_cast<unsigned long long>(sourceVa - base),
                    targetLabels[targetIndex], static_cast<unsigned long long>(materialized - base), BNetRegNameV58(reg),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnBegin - base : 0u),
                    bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnEnd - base : 0u),
                    postFenceRef ? "YES" : "no", getterCall ? "YES" : "no", globalRef ? "YES" : "no");
                LogBNetFenceRegistrationWindowV58("callback_materialization", sourceVa - base);

