    std::atomic<bool> g_bgsStockBundleDumped{ false };
    std::atomic<unsigned> g_bgsStockBundleDumpAttempts{ 0 };

    bool DumpEmbeddedBgsCertificateBundle(HMODULE module) noexcept
    {
        if (g_bgsStockBundleDumped.load())
            return true;
        if (!module)
            return false;

        if (kServerEmuProductionRuntimeV92)
        {
            wchar_t cached[32768]{};
            if (BuildGameRootPath(L"bgs-key-fingerprint.stock", cached, ArrayCount(cached)) &&
                GetFileAttributesW(cached) != INVALID_FILE_ATTRIBUTES)
            {
                g_bgsStockBundleDumped.store(true, std::memory_order_release);
                InternalLog("[V94-PRODUCTION] cached bgs-key-fingerprint.stock ready; embedded .rdata bundle scan=OFF\r\n");
                return true;
            }
            InternalLog("[V94-PRODUCTION] bgs-key-fingerprint.stock missing; embedded bundle extraction scan is disabled. Start with the previously generated cache file.\r\n");
            return false;
        }

        const unsigned attempt = g_bgsStockBundleDumpAttempts.fetch_add(1) + 1u;

        ImageSectionView rdata{};
        if (!GetImageSection(module, ".rdata", rdata))
        {
            if (attempt <= 3u)
                InternalLog("[BGS-BUNDLE] attempt=%u unable to locate .rdata; will retry\r\n", attempt);
            return false;
        }

        // Exact IW8 1.44 location discovered by the read-only protocol scan:
        //   http://nydus.battle.net/Bnet/zxx/client/bgs-key-fingerprint @ 0x70CF348
        //   embedded stock bundle JSON begins                          @ 0x70CF390
        //
        // The previous extractor guessed the end from a later "NGIS" marker.
        // That marker is separate data, not a reliable bundle terminator. Parse
        // the stock JSON object itself so the local server replays exactly the
        // bytes embedded in the client, without changing trust or auth state.
        const std::uintptr_t kStockBundleRva = iw8_addresses::MW2019_1_44_AuthLandmarks.BgsEmbeddedCertificateBundleJson;
        constexpr std::size_t kMaxBundleScan = 512u * 1024u;

        const auto base = reinterpret_cast<std::uintptr_t>(module);
        const auto startAddress = base + kStockBundleRva;
        const auto rdataBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const auto rdataEnd = rdataBegin + rdata.size;
        if (startAddress < rdataBegin || startAddress >= rdataEnd)
        {
            if (attempt <= 3u)
                InternalLog("[BGS-BUNDLE] attempt=%u stock bundle RVA 0x%llX is outside .rdata; will retry\r\n",
                    attempt, static_cast<unsigned long long>(kStockBundleRva));
            return false;
        }

        const auto* bytes = reinterpret_cast<const unsigned char*>(startAddress);
        const std::size_t available = static_cast<std::size_t>(rdataEnd - startAddress);
        const std::size_t scanLimit = (std::min)(available, kMaxBundleScan);
        if (scanLimit < 512u || bytes[0] != '{')
        {
            if (attempt <= 3u || (attempt % 5u) == 0u)
                InternalLog("[BGS-BUNDLE] attempt=%u stock JSON is not readable/ready at rva=0x%llX first=0x%02X; will retry\r\n",
                    attempt,
                    static_cast<unsigned long long>(kStockBundleRva),
                    scanLimit ? static_cast<unsigned>(bytes[0]) : 0u);
            return false;
        }

        std::size_t bundleSize = 0;
        unsigned depth = 0;
        bool inString = false;
        bool escaped = false;
        bool started = false;
        for (std::size_t i = 0; i < scanLimit; ++i)
        {
            const unsigned char c = bytes[i];
            if (inString)
            {
                if (escaped)
                {
                    escaped = false;
                    continue;
                }
                if (c == '\\')
                {
                    escaped = true;
                    continue;
                }
                if (c == '"')
                    inString = false;
                continue;
            }

            if (c == '"')
            {
                inString = true;
                continue;
            }
            if (c == '{')
            {
                ++depth;
                started = true;
                continue;
            }
            if (c == '}')
            {
                if (!depth)
                    break;
                --depth;
                if (started && depth == 0)
                {
                    bundleSize = i + 1u;
                    break;
                }
            }
        }

        if (bundleSize < 512u)
        {
            if (attempt <= 3u || (attempt % 5u) == 0u)
                InternalLog("[BGS-BUNDLE] attempt=%u stock JSON closing brace not available within 0x%llX bytes; will retry\r\n",
                    attempt, static_cast<unsigned long long>(scanLimit));
            return false;
        }

        // Cheap sanity checks on the exact JSON object before writing it out.
        const auto containsAscii = [bytes, bundleSize](const char* needle) noexcept -> bool
        {
            if (!needle || !*needle)
                return false;
            const std::size_t needleLen = strlen(needle);
            if (needleLen > bundleSize)
                return false;
            for (std::size_t i = 0; i + needleLen <= bundleSize; ++i)
            {
                if (memcmp(bytes + i, needle, needleLen) == 0)
                    return true;
            }
            return false;
        };

        if (!containsAscii("\"Certificates\"") ||
            !containsAscii("\"PublicKeys\"") ||
            !containsAscii("\"SigningCertificates\""))
        {
            if (attempt <= 3u || (attempt % 5u) == 0u)
                InternalLog("[BGS-BUNDLE] attempt=%u parsed JSON failed stock bundle field validation bytes=%llu; will retry\r\n",
                    attempt, static_cast<unsigned long long>(bundleSize));
            return false;
        }

        wchar_t path[32768]{};
        if (!BuildServerEmuPath(L"bgs-key-fingerprint.stock", path, ArrayCount(path)))
        {
            InternalLog("[BGS-BUNDLE] attempt=%u failed to build output path; will retry\r\n", attempt);
            return false;
        }

        HANDLE file = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE)
        {
            InternalLog("[BGS-BUNDLE] attempt=%u CreateFile failed win32=%lu; will retry\r\n", attempt, GetLastError());
            return false;
        }

        DWORD written = 0;
        const BOOL ok = WriteFile(file, bytes, static_cast<DWORD>(bundleSize), &written, nullptr);
        const DWORD writeError = ok ? ERROR_SUCCESS : GetLastError();
        FlushFileBuffers(file);
        CloseHandle(file);
        if (!ok || written != bundleSize)
        {
            InternalLog("[BGS-BUNDLE] attempt=%u dump write failed win32=%lu wrote=%lu expected=%llu; will retry\r\n",
                attempt, writeError, written, static_cast<unsigned long long>(bundleSize));
            return false;
        }

        // Also mirror the exact stock bundle beside ModernWarfare.exe. This makes
        // the hand-off robust when RevampedIW8Server.exe is launched with a different
        // working directory (for example from Visual Studio).
        wchar_t rootMirrorPath[32768]{};
        bool mirrorReady = false;
        if (BuildGameRootPath(L"bgs-key-fingerprint.stock", rootMirrorPath, ArrayCount(rootMirrorPath)))
        {
            HANDLE mirror = CreateFileW(rootMirrorPath, GENERIC_WRITE,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
            if (mirror != INVALID_HANDLE_VALUE)
            {
                DWORD mirrorWritten = 0;
                const BOOL mirrorOk = WriteFile(mirror, bytes, static_cast<DWORD>(bundleSize), &mirrorWritten, nullptr);
                FlushFileBuffers(mirror);
                CloseHandle(mirror);
                mirrorReady = mirrorOk && mirrorWritten == bundleSize;
            }
        }

        g_bgsStockBundleDumped.store(true);
        char pathUtf8[32768]{};
        char mirrorUtf8[32768]{};
        WideToUtf8(path, pathUtf8, static_cast<int>(ArrayCount(pathUtf8)));
        if (rootMirrorPath[0])
            WideToUtf8(rootMirrorPath, mirrorUtf8, static_cast<int>(ArrayCount(mirrorUtf8)));
        InternalLog("[BGS-BUNDLE] READY attempt=%u exact stock JSON rva=0x%llX bytes=%llu file=%s mirror=%s mirrorReady=%s\r\n",
            attempt,
            static_cast<unsigned long long>(kStockBundleRva),
            static_cast<unsigned long long>(bundleSize),
            pathUtf8,
            mirrorUtf8[0] ? mirrorUtf8 : "<unavailable>",
            mirrorReady ? "yes" : "no");
        ServerEmuAppend(L"network_trace.log",
            "[BGS-BUNDLE] READY attempt=%u exact stock JSON rva=0x%llX bytes=%llu file=bgs-key-fingerprint.stock\r\n",
            attempt,
            static_cast<unsigned long long>(kStockBundleRva),
            static_cast<unsigned long long>(bundleSize));
        return true;
    }


