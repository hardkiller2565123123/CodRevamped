    void V74Hex(const void* data, std::size_t size, char* out, std::size_t outCount, std::size_t maxBytes = 128u) noexcept
    {
        if (!out || !outCount) return;
        out[0] = '\0';
        if (!data || !size) return;
        unsigned char local[256]{};
        const std::size_t take = (std::min)((std::min)(size, maxBytes), sizeof(local));
        if (!ServerEmuSafeReadBytes(data, local, take))
        {
            strncpy_s(out, outCount, "<unreadable>", _TRUNCATE);
            return;
        }
        std::size_t used = 0;
        for (std::size_t i = 0; i < take && used + 4 < outCount; ++i)
        {
            const int n = _snprintf_s(out + used, outCount - used, _TRUNCATE, "%02X%s",
                static_cast<unsigned>(local[i]), (i + 1u < take) ? " " : "");
            if (n <= 0) break;
            used += static_cast<std::size_t>(n);
        }
        if (take < size && used + 8 < outCount)
            _snprintf_s(out + used, outCount - used, _TRUNCATE, " ...");
    }

    void V74DumpMemoryWindow(const char* label, std::uintptr_t address, std::size_t before, std::size_t after) noexcept
    {
        if (!label || !address) return;
        MEMORY_BASIC_INFORMATION mbi{};
        if (!VirtualQuery(reinterpret_cast<const void*>(address), &mbi, sizeof(mbi)) || !ServerEmuReadableRegion(mbi))
            return;
        const auto regionBegin = reinterpret_cast<std::uintptr_t>(mbi.BaseAddress);
        const auto regionEnd = regionBegin + static_cast<std::uintptr_t>(mbi.RegionSize);
        const auto start = address > regionBegin + before ? address - before : regionBegin;
        const auto wantedEnd = address + after;
        const auto end = wantedEnd < regionEnd ? wantedEnd : regionEnd;
        unsigned char chunk[64]{};
        for (std::uintptr_t cursor = start; cursor < end; cursor += sizeof(chunk))
        {
            const std::size_t n = static_cast<std::size_t>((std::min)(end - cursor, static_cast<std::uintptr_t>(sizeof(chunk))));
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), chunk, n))
                break;
            char hex[3 * sizeof(chunk) + 8]{};
            V74Hex(chunk, n, hex, ArrayCount(hex), n);
            const auto base = MainImageBase();
            const auto size = MainImageSize();
            const bool inImage = base && size && cursor >= base && cursor < base + size;
            ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                "[DW-LSG-V74-MEM] label=%s address=%p%s0x%llX regionType=0x%lX protect=0x%lX bytes=%s\r\n",
                label, reinterpret_cast<void*>(cursor), inImage ? " game+" : " rva=n/a+",
                static_cast<unsigned long long>(inImage ? cursor - base : 0u),
                static_cast<unsigned long>(mbi.Type), static_cast<unsigned long>(mbi.Protect), hex);
        }
    }

