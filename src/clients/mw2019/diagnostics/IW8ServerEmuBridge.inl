            return;

        const std::uintptr_t start = rva > before ? rva - before : 0u;
        const std::uintptr_t end = (std::min)(static_cast<std::uintptr_t>(size), rva + after);
        char hex[2048]{};
        std::size_t used = 0;
        bool readable = true;
        for (std::uintptr_t cur = start; cur < end && used + 5u < ArrayCount(hex); ++cur)
        {
            unsigned char b = 0;
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + cur), b))
            {
                readable = false;
                used += static_cast<std::size_t>(_snprintf_s(
                    hex + used, ArrayCount(hex) - used, _TRUNCATE, "?? "));
                continue;
