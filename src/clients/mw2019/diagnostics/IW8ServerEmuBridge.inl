    int WSAAPI ServerEmuWSASend(SOCKET socket, LPWSABUF buffers, DWORD bufferCount, LPDWORD sent, DWORD flags, LPWSAOVERLAPPED overlapped, LPWSAOVERLAPPED_COMPLETION_ROUTINE completion) noexcept
    {
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        RecordServerEmuCaller("WSASend", caller);
        ++g_serverEmuSendCalls;

        char local[128]{};
        char peer[128]{};
        SocketEndpointsToText(socket, local, ArrayCount(local), peer, ArrayCount(peer));
        const bool bgs1119 = SocketPeerUsesPort(socket, 1119);
        const bool rawTls443 = SocketPeerUsesPort(socket, 443);
        if (rawTls443 && !kServerEmuProductionRuntimeV92)
            CaptureRawTlsGameStack144("TLS443-WSASEND", caller);
        std::size_t totalBytes = 0;
        for (DWORD i = 0; buffers && i < bufferCount; ++i)
            totalBytes += buffers[i].len;
        if (buffers && bufferCount && buffers[0].buf && buffers[0].len)
        {
            TracePayload(bgs1119 ? "BGS1119-WSASEND" : "WSASEND", socket, buffers[0].buf, buffers[0].len, caller);
            LogLsgPayloadV61("WSASEND", socket, buffers[0].buf, buffers[0].len, caller);

            unsigned char v74Combined[512]{};
            std::size_t v74CombinedBytes = 0;
            bool v74Complete = true;
            for (DWORD i = 0; i < bufferCount; ++i)
            {
                if (!buffers[i].buf || !buffers[i].len) continue;
                if (v74CombinedBytes + buffers[i].len > sizeof(v74Combined))
                {
                    v74Complete = false;
                    break;
                }
                if (!ServerEmuSafeReadBytes(buffers[i].buf, v74Combined + v74CombinedBytes, buffers[i].len))
                {
                    v74Complete = false;
                    break;
                }
                v74CombinedBytes += buffers[i].len;
            }
            if (v74Complete && v74CombinedBytes)
            {
                ObserveDwPostLoginCensusV83(socket, v74Combined, v74CombinedBytes, caller);
                ObserveLsgOutboundCryptoV74(socket, v74Combined, v74CombinedBytes, caller);
            }
        }
        if (bgs1119)
            InternalLog("[BGS1119] WSASend socket=%llu totalBytes=%llu buffers=%u overlapped=%p completion=%p local=%s peer=%s\r\n",
                static_cast<unsigned long long>(socket), static_cast<unsigned long long>(totalBytes),
                static_cast<unsigned>(bufferCount), overlapped, completion, local, peer);

        const int result = g_wsaSendOriginal ? g_wsaSendOriginal(socket, buffers, bufferCount, sent, flags, overlapped, completion) : SOCKET_ERROR;
        const int error = result == SOCKET_ERROR ? WSAGetLastError() : 0;
        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        ServerEmuAppend(L"network_trace.log",
            "[WSASEND] socket=%llu local=%s peer=%s buffers=%u totalBytes=%llu result=%d wsa=%d overlapped=%s ov=%p completion=%p caller=%s%s\r\n",
            static_cast<unsigned long long>(socket), local, peer, static_cast<unsigned>(bufferCount),
            static_cast<unsigned long long>(totalBytes), result, error, overlapped ? "yes" : "no",
            overlapped, completion, where, bgs1119 ? " BGS1119" : "");
        if (bgs1119)
            InternalLog("[BGS1119] WSASend result=%d wsa=%d sentNow=%u\r\n",
                result, error, (result == 0 && sent) ? static_cast<unsigned>(*sent) : 0u);
        if (result == SOCKET_ERROR) WSASetLastError(error);
        return result;
    }

    void V101WaitLog(const char* api, const char* phase, ULONGLONG started,
        ULONGLONG requestedMs, long long result, std::uintptr_t waitCaller = 0,
        std::uintptr_t objectValue = 0) noexcept
    {
        if (g_v101WaitTraceDepth)
            return;
        const DWORD tid = GetCurrentThreadId();
        if (!V101IsTlsThread(tid))
            return;
        g_v101WaitTraceDepth = true;
        const ULONGLONG now = GetTickCount64();
        const ULONGLONG elapsed = started ? now - started : 0ull;
        // V103: V102 proved the apparent INFINITE waits are normal short worker
        // synchronization (typically 15-125 ms), not the frontend blocker. Keep
        // the hooks installed, but print only completed waits that actually take
        // >=250 ms. This preserves evidence for a real future stall without flooding
        // the CMD window with harmless BEGIN/END pairs.
        const bool begin = phase && strcmp(phase, "BEGIN") == 0;
        if (begin || elapsed < 250ull)
        {
            g_v101WaitTraceDepth = false;
            return;
        }

        char waitWhere[96]{};
        char netWhere[96]{};
        FormatCaller(waitCaller, waitWhere, ArrayCount(waitWhere));
        FormatCaller(g_v102LastTlsCaller, netWhere, ArrayCount(netWhere));
        const ULONGLONG sinceNet = g_v102LastTlsEventMs && now >= g_v102LastTlsEventMs
            ? now - g_v102LastTlsEventMs : 0ull;

        InternalLog("[V103-WAIT] t=%llu api=%s phase=%s tid=%lu requestedMs=%s%llu elapsedMs=%llu result=%lld object=0x%llX caller=%s lastTls={api:%s phase:%s socket:%llu caller:%s ageMs:%llu} stateWrites=off\r\n",
            static_cast<unsigned long long>(now), api ? api : "<api>", phase ? phase : "<phase>",
            static_cast<unsigned long>(tid), requestedMs == INFINITE ? "INFINITE/" : "",
            static_cast<unsigned long long>(requestedMs), static_cast<unsigned long long>(elapsed), result,
            static_cast<unsigned long long>(objectValue), waitWhere,
            g_v102LastTlsApi ? g_v102LastTlsApi : "-", g_v102LastTlsPhase ? g_v102LastTlsPhase : "-",
            static_cast<unsigned long long>(g_v102LastTlsSocket), netWhere,
            static_cast<unsigned long long>(sinceNet));
        g_v101WaitTraceDepth = false;
    }

    int WSAAPI V101SelectTiming(int nfds, fd_set* readfds, fd_set* writefds, fd_set* exceptfds, const timeval* timeout) noexcept
    {
        if (!g_selectOriginal)
            return SOCKET_ERROR;
        if (g_v101WaitTraceDepth)
            return g_selectOriginal(nfds, readfds, writefds, exceptfds, timeout);
        const DWORD tid = GetCurrentThreadId();
        const bool trace = V101IsTlsThread(tid);
        ULONGLONG requested = INFINITE;
        if (timeout)
            requested = static_cast<ULONGLONG>(timeout->tv_sec) * 1000ull + static_cast<ULONGLONG>(timeout->tv_usec) / 1000ull;
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        const ULONGLONG started = GetTickCount64();
        if (trace) V101WaitLog("select", "BEGIN", 0, requested, 0, caller);
        const int result = g_selectOriginal(nfds, readfds, writefds, exceptfds, timeout);
        if (trace) V101WaitLog("select", "END", started, requested, result, caller);
        return result;
    }

    int WSAAPI V101WSAPollTiming(LPWSAPOLLFD fds, ULONG count, INT timeoutMs) noexcept
    {
        if (!g_wsaPollOriginal)
