    bool BuildGameRootPath(const wchar_t* fileName, wchar_t* out, std::size_t outCount) noexcept
    {
        if (!fileName || !out || !outCount)
            return false;

        wchar_t exePath[32768]{};
        const DWORD length = GetModuleFileNameW(nullptr, exePath, static_cast<DWORD>(ArrayCount(exePath)));
        if (!length || length >= ArrayCount(exePath))
            return false;
        if (wchar_t* slash = wcsrchr(exePath, L'\\'))
            *slash = L'\0';

        _snwprintf_s(out, outCount, _TRUNCATE, L"%s\\%s", exePath, fileName);
        return true;
    }

    bool BuildServerEmuPath(const wchar_t* fileName, wchar_t* out, std::size_t outCount) noexcept
    {
        if (!fileName || !out || !outCount)
            return false;

        wchar_t exePath[32768]{};
        const DWORD length = GetModuleFileNameW(nullptr, exePath, static_cast<DWORD>(ArrayCount(exePath)));
        if (!length || length >= ArrayCount(exePath))
            return false;
        if (wchar_t* slash = wcsrchr(exePath, L'\\'))
            *slash = L'\0';

        wchar_t revamped[32768]{};
        wchar_t mw[32768]{};
        wchar_t emu[32768]{};
        _snwprintf_s(revamped, ArrayCount(revamped), _TRUNCATE, L"%s\\CodRevamped", exePath);
        _snwprintf_s(mw, ArrayCount(mw), _TRUNCATE, L"%s\\MW2019", revamped);
        _snwprintf_s(emu, ArrayCount(emu), _TRUNCATE, L"%s\\server_emu", mw);
        CreateDirectoryW(revamped, nullptr);
        CreateDirectoryW(mw, nullptr);
        CreateDirectoryW(emu, nullptr);
        _snwprintf_s(out, outCount, _TRUNCATE, L"%s\\%s", emu, fileName);
        return true;
    }

    void ServerEmuAppend(const wchar_t* fileName, const char* format, ...) noexcept
    {
        if (kServerEmuProductionRuntimeV92)
            return;
        if (!fileName || !format)
            return;

        char line[8192]{};
        va_list args;
        va_start(args, format);
        _vsnprintf_s(line, sizeof(line), _TRUNCATE, format, args);
        va_end(args);

        wchar_t path[32768]{};
        if (!BuildServerEmuPath(fileName, path, ArrayCount(path)))
            return;

        HANDLE file = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE)
            return;
        DWORD written = 0;
        WriteFile(file, line, static_cast<DWORD>(strlen(line)), &written, nullptr);
        CloseHandle(file);
    }

    // V99 targeted diagnostics must remain writable even in the V92 production
    // runtime profile. Do not use this helper for broad/legacy research logs.
    void ServerEmuTargetedAppend(const wchar_t* fileName, const char* format, ...) noexcept
    {
        // V101: targeted diagnostics are CMD-only. Keep the parameter so older
        // V98/V99 call sites compile, but never create a trace file.
        (void)fileName;
        if (!format)
            return;
        char line[8192]{};
        va_list args;
        va_start(args, format);
        _vsnprintf_s(line, sizeof(line), _TRUNCATE, format, args);
        va_end(args);
        InternalLog("%s", line);
    }

