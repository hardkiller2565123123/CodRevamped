        ServerEmuAppend(L"frontend_backtrace.log",
            "[FRONTEND-BACKTRACE144] COMPLETE next=decode_frontend_fence_dependencies_then_trace_first_missing_writer_back_to_DW_task stateWrites=off\r\n");
