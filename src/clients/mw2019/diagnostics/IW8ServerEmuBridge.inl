    struct SimpleRipRef144
    {
        std::size_t instructionLength = 0;
        std::size_t displacementOffset = 0;
        const char* op = nullptr;
        const char* access = nullptr;
    };

    bool DecodeSimpleRipRef144(const unsigned char* p, std::size_t available, SimpleRipRef144& out) noexcept
    {
        out = {};
        if (!p || available < 6)
            return false;

        std::size_t pos = 0;
        if ((p[pos] & 0xF0u) == 0x40u)
        {
            ++pos;
            if (available <= pos)
                return false;
        }

        const unsigned char opcode = p[pos];
        const auto ripModRm = [](unsigned char modrm) noexcept -> bool
        {
            return (modrm & 0xC7u) == 0x05u;
        };

        if (opcode == 0x8D || opcode == 0x8B || opcode == 0x89 || opcode == 0x8A || opcode == 0x88)
        {
            if (available < pos + 6 || !ripModRm(p[pos + 1]))
                return false;
            out.displacementOffset = pos + 2;
            out.instructionLength = pos + 6;
            if (opcode == 0x8D)
            {
                out.op = "LEA_RIP";
                out.access = "ADDRESS";
            }
            else if (opcode == 0x89 || opcode == 0x88)
            {
                out.op = opcode == 0x89 ? "MOV_RIP_WRITE" : "MOV8_RIP_WRITE";
                out.access = "WRITE";
            }
            else
            {
                out.op = opcode == 0x8B ? "MOV_RIP_READ" : "MOV8_RIP_READ";
                out.access = "READ";
            }
            return true;
        }

        if (opcode == 0x0F && available >= pos + 7 &&
            (p[pos + 1] == 0xB6 || p[pos + 1] == 0xB7 || p[pos + 1] == 0xBE || p[pos + 1] == 0xBF) &&
            ripModRm(p[pos + 2]))
        {
            out.displacementOffset = pos + 3;
            out.instructionLength = pos + 7;
            out.op = "MOVX_RIP_READ";
            out.access = "READ";
            return true;
        }

        if ((opcode == 0xC6 || opcode == 0xC7) &&
            available >= pos + (opcode == 0xC6 ? 7u : 10u) &&
            ripModRm(p[pos + 1]) && ((p[pos + 1] >> 3) & 7u) == 0)
        {
            out.displacementOffset = pos + 2;
            out.instructionLength = pos + (opcode == 0xC6 ? 7u : 10u);
            out.op = opcode == 0xC6 ? "MOV8_IMM_RIP_WRITE" : "MOV32_IMM_RIP_WRITE";
            out.access = "WRITE";
            return true;
        }

        if ((opcode == 0x80 || opcode == 0x81 || opcode == 0x83) &&
            available >= pos + (opcode == 0x81 ? 10u : 7u) && ripModRm(p[pos + 1]))
        {
            const unsigned group = (p[pos + 1] >> 3) & 7u;
            out.displacementOffset = pos + 2;
            out.instructionLength = pos + (opcode == 0x81 ? 10u : 7u);
            out.op = group == 7u ? "CMP_RIP_IMM" : "GRP1_RIP_IMM";
            out.access = group == 7u ? "READ" : "READWRITE";
            return true;
        }

        if (opcode == 0xFF && available >= pos + 6 && ripModRm(p[pos + 1]))
        {
            const unsigned group = (p[pos + 1] >> 3) & 7u;
            out.displacementOffset = pos + 2;
            out.instructionLength = pos + 6;
            out.op = "FF_RIP";
            out.access = (group == 0u || group == 1u) ? "READWRITE" : "READ";
            return true;
        }

        return false;
    }

    template <typename T>
    bool InstallBNetGameObserverHook144(std::uintptr_t targetRva, void* detour, T& original, const char* label) noexcept
    {
        if (!targetRva || !detour || !label)
            return false;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || targetRva >= size)
            return false;

        const auto target = base + targetRva;
        MEMORY_BASIC_INFORMATION mbi{};
        if (!VirtualQuery(reinterpret_cast<void*>(target), &mbi, sizeof(mbi)) ||
            mbi.State != MEM_COMMIT || (mbi.Protect & PAGE_GUARD) ||
            (mbi.Protect & 0xFFu) == PAGE_NOACCESS)
        {
            InternalLog("[AUTH-GATE-RUNTIME144] observer target unavailable label=%s rva=0x%llX\r\n",
                label, static_cast<unsigned long long>(targetRva));
            return false;
        }

        const MH_STATUS init = MH_Initialize();
        if (init != MH_OK && init != MH_ERROR_ALREADY_INITIALIZED)
        {
            InternalLog("[AUTH-GATE-RUNTIME144] MH_Initialize failed label=%s status=%d\r\n", label, static_cast<int>(init));
            return false;
        }

        void* trampoline = reinterpret_cast<void*>(original);
        const MH_STATUS create = MH_CreateHook(reinterpret_cast<void*>(target), detour, &trampoline);
        if (create == MH_OK)
        {
            original = reinterpret_cast<T>(trampoline);
        }
        else if (create != MH_ERROR_ALREADY_CREATED || !original)
        {
            InternalLog("[AUTH-GATE-RUNTIME144] MH_CreateHook failed label=%s rva=0x%llX status=%d\r\n",
                label, static_cast<unsigned long long>(targetRva), static_cast<int>(create));
            return false;
        }

        const MH_STATUS enable = MH_EnableHook(reinterpret_cast<void*>(target));
        if (enable != MH_OK && enable != MH_ERROR_ENABLED)
        {
            InternalLog("[AUTH-GATE-RUNTIME144] MH_EnableHook failed label=%s rva=0x%llX status=%d\r\n",
                label, static_cast<unsigned long long>(targetRva), static_cast<int>(enable));
            if (create == MH_OK)
            {
                MH_RemoveHook(reinterpret_cast<void*>(target));
                original = nullptr;
            }
            return false;
        }

        InternalLog("[AUTH-GATE-RUNTIME144] observer active label=%s rva=0x%llX original=%p state_unchanged=yes\r\n",
            label, static_cast<unsigned long long>(targetRva), reinterpret_cast<void*>(original));
        ServerEmuAppend(L"auth_gate_runtime.log",
            "[AUTH-GATE-RUNTIME144] observer active label=%s rva=0x%llX original=%p mode=CALL_ORIGINAL_UNCHANGED\r\n",
            label, static_cast<unsigned long long>(targetRva), reinterpret_cast<void*>(original));
        return original != nullptr;
    }


