        }

        if (prepared && !g_bnetAuthFailureTraceVeh144)
            g_bnetAuthFailureTraceVeh144 = AddVectoredExceptionHandler(1u, &BNetAuthFailureTraceVeh144);
        InternalLog("[AUTH-GATE-FAILTRACE144] PREP COMPLETE candidates=%u veh=%s window=0x%llX..0x%llX mode=EXACT_CONFIRMED_INSTRUCTIONS_ONLY\r\n",
