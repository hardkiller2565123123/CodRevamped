        unsigned targetRefs = 0;
        unsigned adapterRefs = 0;
        unsigned ownerCalls = 0;
        unsigned incomingOwnerEdges = 0;
        unsigned incomingPostFenceRefs = 0;
        unsigned unreadableChunks = 0;
