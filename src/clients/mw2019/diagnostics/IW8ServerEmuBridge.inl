    struct LocalWebTrustSpki144
    {
        char ca[65]{};
        char leaf[65]{};
        char battleNet[65]{};
        char demonware[65]{};
    };

    bool IsHex64TrustValue144(const char* text) noexcept
    {
        if (!text)
            return false;
        for (unsigned i = 0; i < 64u; ++i)
        {
            const char c = text[i];
            const bool hex = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f');
            if (!hex)
                return false;
        }
        return text[64] == '\0';
    }

    bool ReadSmallTrustManifest144(const wchar_t* path, LocalWebTrustSpki144& out) noexcept
    {
        if (!path || !*path)
            return false;
        HANDLE file = CreateFileW(path, GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE)
            return false;

        LARGE_INTEGER size{};
        if (!GetFileSizeEx(file, &size) || size.QuadPart <= 0 || size.QuadPart > 4096)
        {
            CloseHandle(file);
            return false;
        }
        char buffer[4097]{};
        DWORD read = 0;
        const BOOL ok = ReadFile(file, buffer, static_cast<DWORD>(size.QuadPart), &read, nullptr);
        CloseHandle(file);
        if (!ok || read != size.QuadPart)
            return false;
        buffer[read] = '\0';
        if (strstr(buffer, "REVAMPED_IW8_TRUST_V1") == nullptr)
            return false;

        const auto readField = [&buffer](const char* key, char (&dest)[65]) noexcept -> bool
        {
            const char* found = strstr(buffer, key);
            if (!found)
                return false;
            found += strlen(key);
            char candidate[65]{};
            for (unsigned i = 0; i < 64u; ++i)
            {
                const char c = found[i];
                const bool hex = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f');
                if (!hex)
                    return false;
                candidate[i] = static_cast<char>((c >= 'a' && c <= 'f') ? (c - ('a' - 'A')) : c);
            }
            candidate[64] = '\0';
            memcpy(dest, candidate, sizeof(candidate));
            return true;
        };

        return readField("ca=", out.ca) &&
            readField("leaf=", out.leaf) &&
            readField("battleNet=", out.battleNet) &&
            readField("demonware=", out.demonware) &&
            IsHex64TrustValue144(out.ca) && IsHex64TrustValue144(out.leaf) &&
            IsHex64TrustValue144(out.battleNet) && IsHex64TrustValue144(out.demonware);
    }

    bool LoadLocalWebTrustSpki144(LocalWebTrustSpki144& out, wchar_t* resolvedPath, std::size_t resolvedCount) noexcept
    {
        if (resolvedPath && resolvedCount)
            resolvedPath[0] = L'\0';

        wchar_t path[32768]{};
        if (BuildGameRootPath(L"revamped-iw8-trust-spki.txt", path, ArrayCount(path)) &&
            ReadSmallTrustManifest144(path, out))
        {
            if (resolvedPath && resolvedCount)
                wcsncpy_s(resolvedPath, resolvedCount, path, _TRUNCATE);
            return true;
        }

        if (BuildServerEmuPath(L"revamped-iw8-trust-spki.txt", path, ArrayCount(path)) &&
            ReadSmallTrustManifest144(path, out))
        {
            if (resolvedPath && resolvedCount)
                wcsncpy_s(resolvedPath, resolvedCount, path, _TRUNCATE);
            return true;
        }
        return false;
    }

    bool WriteTrustHashInPlace144(char* destination, const char* spki) noexcept
    {
        if (!destination || !IsHex64TrustValue144(spki))
            return false;
        DWORD oldProtect = 0;
        if (!VirtualProtect(destination, 64u, PAGE_READWRITE, &oldProtect))
            return false;
        memcpy(destination, spki, 64u);
        DWORD ignored = 0;
        VirtualProtect(destination, 64u, oldProtect, &ignored);
        FlushInstructionCache(GetCurrentProcess(), destination, 64u);
        return memcmp(destination, spki, 64u) == 0;
    }

    std::size_t PatchEmbeddedTrustUri144(char* json, std::size_t jsonSize,
        const char* uri, const char* spki, std::size_t& seen) noexcept
    {
        seen = 0;
        if (!json || !jsonSize || !uri || !*uri || !IsHex64TrustValue144(spki))
            return 0;

        const std::string uriNeedle = std::string("\"Uri\":\"") + uri + "\"";
        static const char hashKey[] = "\"ShaHashPublicKeyInfo\":\"";
        std::size_t patched = 0;
        for (std::size_t pos = 0; pos + uriNeedle.size() <= jsonSize; )
        {
            const char* hit = std::search(json + pos, json + jsonSize,
                uriNeedle.begin(), uriNeedle.end());
            if (hit == json + jsonSize)
                break;
            ++seen;
            const std::size_t hitOffset = static_cast<std::size_t>(hit - json);
            const std::size_t objectLimit = (std::min)(jsonSize, hitOffset + 768u);
            const char* objectEnd = static_cast<const char*>(memchr(hit, '}', objectLimit - hitOffset));
            const char* searchEnd = objectEnd ? objectEnd : (json + objectLimit);
            const char* hash = std::search(hit, searchEnd,
                hashKey, hashKey + sizeof(hashKey) - 1u);
            if (hash != searchEnd)
            {
                char* hashValue = const_cast<char*>(hash + sizeof(hashKey) - 1u);
                if (hashValue + 64u <= json + jsonSize && hashValue[64] == '"')
                {
                    bool currentIsHex = true;
                    for (unsigned i = 0; i < 64u; ++i)
                    {
                        const char c = hashValue[i];
                        if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f')))
                        {
                            currentIsHex = false;
                            break;
                        }
                    }
                    if (currentIsHex && WriteTrustHashInPlace144(hashValue, spki))
                        ++patched;
                }
            }
            pos = hitOffset + uriNeedle.size();
        }
        return patched;
    }

    bool AdaptEmbeddedBgsWebTrustPins(HMODULE module) noexcept
    {
        if (g_bgsEmbeddedWebTrustPatched.load())
            return true;
        if (g_bgsEmbeddedWebTrustAttempted.exchange(true) || !module)
            return false;

        LocalWebTrustSpki144 trust{};
        wchar_t manifestPath[32768]{};
        if (!LoadLocalWebTrustSpki144(trust, manifestPath, ArrayCount(manifestPath)))
        {
            g_bgsEmbeddedWebTrustAttempted.store(false);
            InternalLog("[TRUST-443] local SPKI manifest not ready; will retry at the next bootstrap preflight\r\n");
            return false;
        }

        ImageSectionView rdata{};
        if (!GetImageSection(module, ".rdata", rdata))
        {
            g_bgsEmbeddedWebTrustAttempted.store(false);
            return false;
        }

        const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(module);
        const std::uintptr_t jsonAddress = base + iw8_addresses::MW2019_1_44_AuthLandmarks.BgsEmbeddedCertificateBundleJson;
        const std::uintptr_t sectionBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const std::uintptr_t sectionEnd = sectionBegin + rdata.size;
        if (jsonAddress < sectionBegin || jsonAddress >= sectionEnd)
        {
            InternalLog("[TRUST-443] embedded bundle RVA is outside .rdata; no trust pins changed\r\n");
            return false;
        }

        char* json = reinterpret_cast<char*>(jsonAddress);
        const std::size_t available = static_cast<std::size_t>(sectionEnd - jsonAddress);
        const std::size_t scanLimit = (std::min)(available, static_cast<std::size_t>(512u * 1024u));
        if (scanLimit < 512u || json[0] != '{')
        {
            g_bgsEmbeddedWebTrustAttempted.store(false);
            InternalLog("[TRUST-443] embedded bundle not materialized yet; will retry\r\n");
            return false;
        }

        std::size_t jsonSize = 0;
        unsigned depth = 0;
        bool inString = false;
        bool escaped = false;
        for (std::size_t i = 0; i < scanLimit; ++i)
        {
            const char c = json[i];
            if (inString)
            {
                if (escaped) { escaped = false; continue; }
                if (c == '\\') { escaped = true; continue; }
                if (c == '"') inString = false;
                continue;
            }
            if (c == '"') { inString = true; continue; }
            if (c == '{') { ++depth; continue; }
            if (c == '}' && depth)
            {
                --depth;
                if (depth == 0) { jsonSize = i + 1u; break; }
            }
        }
        if (jsonSize < 512u)
        {
            g_bgsEmbeddedWebTrustAttempted.store(false);
            return false;
        }

        struct PinTarget { const char* uri; const char* spki; };
        const PinTarget targets[] = {
            {"us.battle.net", trust.battleNet},
            {"oauth-us.web.blizzard.net", trust.battleNet},
            {"us.api.blizzard.com", trust.battleNet},
            {"us-gateway.integration.blizzard.com", trust.battleNet},
            {"battle.net", trust.battleNet},
            {"*.battle.net", trust.battleNet},
            {"blizzard.net", trust.battleNet},
            {"*.blizzard.net", trust.battleNet},
            {"blizzard.com", trust.battleNet},
            {"*.blizzard.com", trust.battleNet},
            {"iw8-bnet-auth3.prod.demonware.net", trust.demonware},
            {"auth3.prod.demonware.net", trust.demonware},
            {"auth3-login.prod.demonware.net", trust.demonware},
            {"loginqueue.prod.demonware.net", trust.demonware},
            {"prod.demonware.net", trust.demonware},
            {"*.prod.demonware.net", trust.demonware},
            {"*.demonware.net", trust.demonware},
            {"demonware.net", trust.demonware},
        };

        std::size_t totalSeen = 0;
        std::size_t totalPatched = 0;
        for (const auto& target : targets)
        {
            std::size_t seen = 0;
            const std::size_t patched = PatchEmbeddedTrustUri144(json, jsonSize, target.uri, target.spki, seen);
            totalSeen += seen;
            totalPatched += patched;
            if (seen || patched)
                InternalLog("[TRUST-443] embedded pin uri='%s' seen=%llu patched=%llu\r\n",
                    target.uri,
                    static_cast<unsigned long long>(seen),
                    static_cast<unsigned long long>(patched));
        }

        char manifestUtf8[32768]{};
        if (manifestPath[0])
            WideToUtf8(manifestPath, manifestUtf8, static_cast<int>(ArrayCount(manifestUtf8)));
        InternalLog("[TRUST-443] embedded web trust pass jsonBytes=%llu manifest=%s totalUriHits=%llu totalPinsPatched=%llu scope=TRUST_ONLY no_auth_state_modified\r\n",
            static_cast<unsigned long long>(jsonSize),
            manifestUtf8[0] ? manifestUtf8 : "<loaded>",
            static_cast<unsigned long long>(totalSeen),
            static_cast<unsigned long long>(totalPatched));
        ServerEmuAppend(L"network_trace.log",
            "[TRUST-443] embedded web trust pass jsonBytes=%llu totalUriHits=%llu totalPinsPatched=%llu scope=TRUST_ONLY\r\n",
            static_cast<unsigned long long>(jsonSize),
            static_cast<unsigned long long>(totalSeen),
            static_cast<unsigned long long>(totalPatched));

        g_bgsEmbeddedWebTrustPatched.store(totalPatched != 0u);
        return totalPatched != 0u;
    }

    bool ServerEmuReadableRegion(const MEMORY_BASIC_INFORMATION& mbi) noexcept
    {
        if (mbi.State != MEM_COMMIT) return false;
        if (mbi.Protect & PAGE_GUARD) return false;
        const DWORD protect = mbi.Protect & 0xFFu;
        return protect != PAGE_NOACCESS && protect != 0;
    }

    // Keep SEH isolated from scanner functions that own C++ objects. MSVC does
    // not allow __try in a function that requires C++ object unwinding (C2712).
    bool ServerEmuSafeReadPointer(const void* source, std::uintptr_t& value) noexcept
    {
        value = 0;
        if (!source)
            return false;
        __try
        {
            memcpy(&value, source, sizeof(value));
            return true;
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            value = 0;
            return false;
        }
    }

