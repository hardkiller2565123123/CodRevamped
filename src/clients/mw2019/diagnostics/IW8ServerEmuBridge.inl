    bool DwAuthFailurePredicateObserver144(std::uintptr_t arg0Raw, std::uintptr_t arg1, std::uintptr_t arg2, std::uintptr_t arg3) noexcept
    {
        const auto arg0 = static_cast<std::uint32_t>(arg0Raw & 0xFFFFFFFFu);
        if (g_dwAuthFailurePredicateObserverDepth144)
            return g_dwAuthFailurePredicateOriginal144 ? g_dwAuthFailurePredicateOriginal144(arg0Raw, arg1, arg2, arg3) : false;

        g_dwAuthFailurePredicateObserverDepth144 = true;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());

        const bool result = g_dwAuthFailurePredicateOriginal144 ?
            g_dwAuthFailurePredicateOriginal144(arg0Raw, arg1, arg2, arg3) : false;

        const bool callerInGame = base && size && caller >= base && caller < base + size;
        const bool exactCaller = callerInGame && (caller - base) == kDwAuthFailurePredicateReturnRva144;
        const unsigned totalCall = ++g_dwAuthFailurePredicateObserverTotalCalls144;
        if (totalCall <= 16u || exactCaller)
        {
            InternalLog(
                "[DW-AUTH-FAIL-LIVE144] HIT total=%u callerRva=%s0x%llX arg0=0x%08X(%u) result=%s exactResetCaller=%s "
                "mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
                totalCall, callerInGame ? "" : "outside-game/",
                static_cast<unsigned long long>(callerInGame ? caller - base : 0),
                arg0, arg0, result ? "TRUE" : "false", exactCaller ? "YES" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-FAIL-LIVE144] HIT total=%u callerRva=%s0x%llX arg0=0x%08X(%u) result=%s exactResetCaller=%s "
                "mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
                totalCall, callerInGame ? "" : "outside-game/",
                static_cast<unsigned long long>(callerInGame ? caller - base : 0),
                arg0, arg0, result ? "TRUE" : "false", exactCaller ? "YES" : "no");
        }
        if (exactCaller)
        {
            const unsigned call = ++g_dwAuthFailurePredicateObserverCalls144;
            InternalLog(
                "[DW-AUTH-FAIL-LIVE144] call=%u callerRva=0x%llX predicateRva=0x%llX arg0=0x%08X(%u) result=%s "
                "semantics={false:skip_reset,true:enter_reset_path} originalCalled=%s stateWrites=stock_only\r\n",
                call, static_cast<unsigned long long>(caller - base),
                static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), arg0, arg0,
                result ? "TRUE" : "false", g_dwAuthFailurePredicateOriginal144 ? "yes" : "NO");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-FAIL-LIVE144] call=%u callerRva=0x%llX predicateRva=0x%llX arg0=0x%08X(%u) result=%s "
                "semantics={false:skip_reset,true:enter_reset_path} originalCalled=%s stateWrites=stock_only\r\n",
                call, static_cast<unsigned long long>(caller - base),
                static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), arg0, arg0,
                result ? "TRUE" : "false", g_dwAuthFailurePredicateOriginal144 ? "yes" : "NO");

            if (result)
                DumpDwAuthFailurePredicateData144(arg0, result);
        }

        g_dwAuthFailurePredicateObserverDepth144 = false;
        return result;
    }

    bool InstallDwAuthFailurePredicateObserver144() noexcept
    {
        if (g_dwAuthFailurePredicateObserverInstalled144.load(std::memory_order_acquire))
            return true;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || kDwAuthFailurePredicateRva144 + 0x44u >= size)
            return false;

        // Do not hook unless the V24 caller relationship is still exact for this
        // build. This prevents a stale RVA from ever becoming an active probe.
        unsigned char caller[9]{};
        bool callerVerified = false;
        if (kDwAuthFailurePredicateCallsiteRva144 + sizeof(caller) < size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + kDwAuthFailurePredicateCallsiteRva144), caller, sizeof(caller)) &&
            caller[0] == 0xE8u && caller[5] == 0x84u && caller[6] == 0xC0u && caller[7] == 0x74u)
        {
            std::int32_t rel = 0;
            memcpy(&rel, caller + 1u, sizeof(rel));
            const auto target = base + kDwAuthFailurePredicateCallsiteRva144 + 5u + static_cast<std::intptr_t>(rel);
            const auto rel8 = static_cast<std::int8_t>(caller[8]);
            const auto skip = base + kDwAuthFailurePredicateCallsiteRva144 + 9u + rel8;
            callerVerified = target == base + kDwAuthFailurePredicateRva144 &&
                skip == base + kDwAuthFailurePredicateSkipTargetRva144;
        }
        if (!callerVerified)
        {
            InternalLog(
                "[DW-AUTH-FAIL-LIVE144] ARM failed predicateRva=0x%llX reason=caller_sequence_mismatch mode=NO_HOOK stateWrites=off\r\n",
                static_cast<unsigned long long>(kDwAuthFailurePredicateRva144));
            return false;
        }

        std::uintptr_t functionBegin = 0;
        std::uintptr_t functionEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(base + kDwAuthFailurePredicateRva144, functionBegin, functionEnd);
        if (!bounded || functionBegin != base + kDwAuthFailurePredicateRva144 ||
            functionEnd <= functionBegin || functionEnd - functionBegin != 0x44u)
        {
            InternalLog(
                "[DW-AUTH-FAIL-LIVE144] ARM failed predicateRva=0x%llX reason=function_bounds_mismatch begin=%s0x%llX end=%s0x%llX mode=NO_HOOK stateWrites=off\r\n",
                static_cast<unsigned long long>(kDwAuthFailurePredicateRva144),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0));
            return false;
        }

        unsigned char code[0x44]{};
        char hex[0x44u * 3u + 1u]{};
        const bool codeReadable = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(functionBegin), code, sizeof(code));
        if (codeReadable)
        {
            std::size_t used = 0;
            for (std::size_t i = 0; i < sizeof(code) && used + 4u < ArrayCount(hex); ++i)
            {
                const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X%s",
                    code[i], (i + 1u) == sizeof(code) ? "" : " ");
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
        }
        InternalLog(
            "[DW-AUTH-FAIL-LIVE144] CODE predicateRva=0x%llX bytes=0x44 raw=%s read_only=yes\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), codeReadable ? hex : "UNREADABLE");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-FAIL-LIVE144] CODE predicateRva=0x%llX bytes=0x44 raw=%s read_only=yes\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144), codeReadable ? hex : "UNREADABLE");

        if (codeReadable)
        {
            memcpy(g_dwAuthFailurePredicateOriginalBytes144, code,
                sizeof(g_dwAuthFailurePredicateOriginalBytes144));
            g_dwAuthFailurePredicateOriginalBytesReady144.store(true, std::memory_order_release);
        }

        const MH_STATUS init = MH_Initialize();
        if (init != MH_OK && init != MH_ERROR_ALREADY_INITIALIZED)
        {
            InternalLog("[DW-AUTH-FAIL-LIVE144] ARM failed stage=MH_Initialize status=%d predicateRva=0x%llX stateWrites=off\r\n",
                static_cast<int>(init), static_cast<unsigned long long>(kDwAuthFailurePredicateRva144));
            return false;
        }

        void* trampoline = nullptr;
        const MH_STATUS create = MH_CreateHook(reinterpret_cast<void*>(functionBegin),
            reinterpret_cast<void*>(&DwAuthFailurePredicateObserver144), &trampoline);
        if (create != MH_OK)
        {
            InternalLog(
                "[DW-AUTH-FAIL-LIVE144] ARM failed stage=MH_CreateHook status=%d predicateRva=0x%llX fallback=static_predicate_only stateWrites=off\r\n",
                static_cast<int>(create), static_cast<unsigned long long>(kDwAuthFailurePredicateRva144));
            return false;
        }

        g_dwAuthFailurePredicateOriginal144 = reinterpret_cast<DwAuthFailurePredicateFn144>(trampoline);
        const MH_STATUS enable = MH_EnableHook(reinterpret_cast<void*>(functionBegin));
        if (enable != MH_OK && enable != MH_ERROR_ENABLED)
        {
            InternalLog("[DW-AUTH-FAIL-LIVE144] ARM failed stage=MH_EnableHook status=%d predicateRva=0x%llX stateWrites=off\r\n",
                static_cast<int>(enable), static_cast<unsigned long long>(kDwAuthFailurePredicateRva144));
            MH_RemoveHook(reinterpret_cast<void*>(functionBegin));
            g_dwAuthFailurePredicateOriginal144 = nullptr;
            return false;
        }

        g_dwAuthFailurePredicateObserverInstalled144.store(true, std::memory_order_release);
        InternalLog(
            "[DW-AUTH-FAIL-LIVE144] ARMED predicateRva=0x%llX callerReturnRva=0x%llX dataRva=0x%llX filter=EXACT_RESET_PATH_CALLER "
            "mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144),
            static_cast<unsigned long long>(kDwAuthFailurePredicateReturnRva144),
            static_cast<unsigned long long>(kDwAuthFailurePredicateDataRva144));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-FAIL-LIVE144] ARMED predicateRva=0x%llX callerReturnRva=0x%llX dataRva=0x%llX filter=EXACT_RESET_PATH_CALLER "
            "mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
            static_cast<unsigned long long>(kDwAuthFailurePredicateRva144),
            static_cast<unsigned long long>(kDwAuthFailurePredicateReturnRva144),
            static_cast<unsigned long long>(kDwAuthFailurePredicateDataRva144));
        return g_dwAuthFailurePredicateOriginal144 != nullptr;
    }

    void AnalyzeDwConnectionFailureWriter144(const DwAuthTrackedGlobal144& item) noexcept
    {
        bool expected = false;
        if (!g_dwConnectionFailureWriterAnalysisDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !item.instruction || item.instruction < base || item.instruction >= base + size)
        {
            InternalLog("[DW-CONNECTION-WRITER144] SKIP invalid source instruction; stateWrites=off\r\n");
            return;
        }

        std::uintptr_t functionBegin = 0;
        std::uintptr_t functionEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(item.instruction, functionBegin, functionEnd);
        if (!bounded || functionEnd <= functionBegin)
        {
            InternalLog("[DW-CONNECTION-WRITER144] SKIP source function bounds unavailable sourceInstructionRva=0x%llX stateWrites=off\r\n",
                static_cast<unsigned long long>(item.instruction - base));
            return;
        }

        const std::uintptr_t scanEnd = (std::min)(functionEnd, functionBegin + static_cast<std::uintptr_t>(0x2000));
        InternalLog(
            "[DW-CONNECTION-WRITER144] BEGIN sourceInstructionRva=0x%llX function=0x%llX..0x%llX bytes=0x%llX "
            "scope=LOCAL_FUNCTION_ONLY no_full_image_scan=yes mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(item.instruction - base),
            static_cast<unsigned long long>(functionBegin - base),
            static_cast<unsigned long long>(functionEnd - base),
            static_cast<unsigned long long>(functionEnd - functionBegin));
        ServerEmuAppend(L"dw_auth_result.log",
            "\r\n[DW-CONNECTION-WRITER144] BEGIN sourceInstructionRva=0x%llX function=0x%llX..0x%llX bytes=0x%llX "
            "scope=LOCAL_FUNCTION_ONLY no_full_image_scan=yes mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(item.instruction - base),
            static_cast<unsigned long long>(functionBegin - base),
            static_cast<unsigned long long>(functionEnd - base),
            static_cast<unsigned long long>(functionEnd - functionBegin));
        AppendCodeBytes144(L"dw_auth_result.log", "[DW-CONNECTION-WRITER-CODE144]", functionBegin, 0,
            static_cast<std::size_t>((std::min)(scanEnd - functionBegin, static_cast<std::uintptr_t>(512))));

        unsigned directCalls = 0;
        unsigned ripRefs = 0;
        unsigned printableRefs = 0;
        unsigned compares = 0;
        for (std::uintptr_t cursor = functionBegin; cursor + 7u <= scanEnd; ++cursor)
        {
            unsigned char b[11]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && directCalls < 48u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1u, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size)
                {
                    ++directCalls;
                    InternalLog("[DW-CONNECTION-WRITER144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        directCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base));
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-CONNECTION-WRITER144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        directCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base));
                }
            }

            if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Du || b[1] == 0x8Bu) && (b[2] & 0xC7u) == 0x05u && ripRefs < 48u)
            {
                std::int32_t displacement = 0;
                memcpy(&displacement, b + 3u, sizeof(displacement));
                const std::uintptr_t target = cursor + 7u + static_cast<std::intptr_t>(displacement);
                if (target >= base && target < base + size)
                {
                    ++ripRefs;
                    char text[160]{};
                    const char* encoding = "?";
                    const bool printable = TryReadDwTlsPrintable144(target, text, ArrayCount(text), encoding);
                    if (printable) ++printableRefs;
                    const bool isCandidate = target == base + kDwConnectionFailureCandidateRva144;
                    InternalLog(
                        "[DW-CONNECTION-WRITER144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX candidate=%s printable=%s%s%s%s\r\n",
                        ripRefs,
                        static_cast<unsigned long long>(cursor - base),
                        b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(target - base),
                        isCandidate ? "YES" : "no", printable ? "yes" : "no",
                        printable ? " encoding=" : "", printable ? encoding : "",
                        printable ? " text=REDACTED_IN_CONSOLE_SEE_dw_auth_result.log" : "");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-CONNECTION-WRITER144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX candidate=%s printable=%s encoding=%s text='%s'\r\n",
                        ripRefs,
                        static_cast<unsigned long long>(cursor - base),
                        b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(target - base),
                        isCandidate ? "YES" : "no", printable ? "yes" : "no",
                        printable ? encoding : "n/a", printable ? text : "");
                }
            }

            // Log only compact immediate compare forms.  We do not execute or
            // alter the branch; this is just enough to classify the writer's
            // local state machine on the next capture.
            bool isCompare = false;
            unsigned compareBytes = 0;
            unsigned long long immediate = 0;
            if (b[0] == 0x3Du)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 1u, sizeof(imm));
                immediate = imm; compareBytes = 5u; isCompare = true;
            }
            else if (b[0] == 0x83u && ((b[1] >> 3u) & 7u) == 7u)
            {
                immediate = b[2]; compareBytes = 3u; isCompare = true;
            }
            else if (b[0] == 0x81u && ((b[1] >> 3u) & 7u) == 7u)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 2u, sizeof(imm));
                immediate = imm; compareBytes = 6u; isCompare = true;
            }
            if (isCompare && compares < 32u)
            {
                ++compares;
                InternalLog("[DW-CONNECTION-WRITER144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-CONNECTION-WRITER144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
            }
        }

        // A bounded +/-128 KiB caller search is cheap enough to run after the
        // frontend has already reached state 2, unlike the old whole-image scan.
        unsigned localCallers = 0;
        const std::uintptr_t localBegin = functionBegin > base + 0x20000u ? functionBegin - 0x20000u : base;
        const std::uintptr_t localEnd = (std::min)(base + size, functionEnd + static_cast<std::uintptr_t>(0x20000));
        for (std::uintptr_t cursor = localBegin; cursor + 5u <= localEnd && localCallers < 32u; ++cursor)
        {
            unsigned char b[5]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)) || b[0] != 0xE8u)
                continue;
            std::int32_t rel = 0;
            memcpy(&rel, b + 1u, sizeof(rel));
            const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
            if (target != functionBegin)
                continue;
            ++localCallers;
            std::uintptr_t callerBegin = 0;
            std::uintptr_t callerEnd = 0;
            const bool callerBounded = RuntimeFunctionBounds144(cursor, callerBegin, callerEnd);
            InternalLog(
                "[DW-CONNECTION-WRITER144] LOCAL_CALLER index=%u callRva=0x%llX callerFunction=%s0x%llX..%s0x%llX\r\n",
                localCallers, static_cast<unsigned long long>(cursor - base),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-CONNECTION-WRITER144] LOCAL_CALLER index=%u callRva=0x%llX callerFunction=%s0x%llX..%s0x%llX\r\n",
                localCallers, static_cast<unsigned long long>(cursor - base),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0));
            if (callerBounded)
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-CONNECTION-WRITER-CALLER-CODE144]", cursor, 64, 96);
        }

        InternalLog(
            "[DW-CONNECTION-WRITER144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u localCallers=%u "
            "next=classify_0x3634390_before_any_new_protocol_guess stateWrites=off\r\n",
            directCalls, ripRefs, printableRefs, compares, localCallers);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-CONNECTION-WRITER144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u localCallers=%u "
            "next=classify_0x3634390_before_any_new_protocol_guess stateWrites=off\r\n",
            directCalls, ripRefs, printableRefs, compares, localCallers);
    }

    void AnalyzeDwAuthResetWriter144(unsigned globalChange, ULONGLONG elapsed) noexcept
    {
        bool expected = false;
        if (!g_dwAuthResetWriterAnalysisDone144.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || kDwAuthResetWriterScanEndRva144 >= size)
        {
            InternalLog("[DW-AUTH-RESET-WRITER144] SKIP image/range unavailable stateWrites=off\r\n");
            return;
        }

        const std::uintptr_t scanBegin = base + kDwAuthResetWriterScanBeginRva144;
        const std::uintptr_t scanEnd = base + kDwAuthResetWriterScanEndRva144;
        const std::uintptr_t writer = base + kDwAuthResetWriterRva144;

        unsigned char writerBytes[96]{};
        char writerHex[sizeof(writerBytes) * 3u + 1u]{};
        if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(writer >= base + 32u ? writer - 32u : writer), writerBytes, sizeof(writerBytes)))
        {
            std::size_t used = 0;
            for (std::size_t i = 0; i < sizeof(writerBytes) && used + 4u < ArrayCount(writerHex); ++i)
                used += static_cast<std::size_t>(_snprintf_s(writerHex + used, ArrayCount(writerHex) - used, _TRUNCATE, "%02X ", writerBytes[i]));
        }

        InternalLog(
            "[DW-AUTH-RESET-WRITER144] BEGIN triggerChange=%u t=%llums flagRva=0x%llX writerRva=0x%llX "
            "scan=0x%llX..0x%llX writerBytes=%s mode=STATIC_READ_ONLY stateWrites=off\r\n",
            globalChange, static_cast<unsigned long long>(elapsed),
            static_cast<unsigned long long>(kDwAuthResetFlagRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterScanBeginRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterScanEndRva144),
            writerHex[0] ? writerHex : "UNREADABLE");
        ServerEmuAppend(L"dw_auth_result.log",
            "\r\n[DW-AUTH-RESET-WRITER144] BEGIN triggerChange=%u t=%llums flagRva=0x%llX writerRva=0x%llX "
            "scan=0x%llX..0x%llX mode=STATIC_READ_ONLY stateWrites=off\r\n",
            globalChange, static_cast<unsigned long long>(elapsed),
            static_cast<unsigned long long>(kDwAuthResetFlagRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterScanBeginRva144),
            static_cast<unsigned long long>(kDwAuthResetWriterScanEndRva144));
        AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-WRITER-CODE144]", writer, 128, 256);

        unsigned directCalls = 0;
        unsigned ripRefs = 0;
        unsigned printableRefs = 0;
        unsigned compares = 0;
        unsigned branches = 0;
        unsigned writerEdges = 0;

        for (std::uintptr_t cursor = scanBegin; cursor + 11u <= scanEnd; ++cursor)
        {
            unsigned char b[16]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && directCalls < 48u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1u, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size)
                {
                    ++directCalls;
                    InternalLog("[DW-AUTH-RESET-WRITER144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        directCalls, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base));
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-WRITER144] CALL index=%u callRva=0x%llX targetRva=0x%llX\r\n",
                        directCalls, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base));
                }
            }

            if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Du || b[1] == 0x8Bu) && (b[2] & 0xC7u) == 0x05u && ripRefs < 48u)
            {
                std::int32_t displacement = 0;
                memcpy(&displacement, b + 3u, sizeof(displacement));
                const std::uintptr_t target = cursor + 7u + static_cast<std::intptr_t>(displacement);
                if (target >= base && target < base + size)
                {
                    ++ripRefs;
                    char text[160]{};
                    const char* encoding = "?";
                    const bool printable = TryReadDwTlsPrintable144(target, text, ArrayCount(text), encoding);
                    if (printable) ++printableRefs;
                    const bool resetFlag = target == base + kDwAuthResetFlagRva144;
                    InternalLog(
                        "[DW-AUTH-RESET-WRITER144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX resetFlag=%s printable=%s%s%s%s\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(target - base), resetFlag ? "YES" : "no", printable ? "yes" : "no",
                        printable ? " encoding=" : "", printable ? encoding : "",
                        printable ? " text=SEE_dw_auth_result.log" : "");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-WRITER144] RIP index=%u instructionRva=0x%llX op=%s targetRva=0x%llX resetFlag=%s printable=%s encoding=%s text='%s'\r\n",
                        ripRefs, static_cast<unsigned long long>(cursor - base), b[1] == 0x8Du ? "LEA" : "MOV",
                        static_cast<unsigned long long>(target - base), resetFlag ? "YES" : "no", printable ? "yes" : "no",
                        printable ? encoding : "n/a", printable ? text : "");
                }
            }

            bool isCompare = false;
            unsigned compareBytes = 0;
            unsigned long long immediate = 0;
            if (b[0] == 0x3Du)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 1u, sizeof(imm));
                immediate = imm; compareBytes = 5u; isCompare = true;
            }
            else if (b[0] == 0x83u && ((b[1] >> 3u) & 7u) == 7u)
            {
                immediate = b[2]; compareBytes = 3u; isCompare = true;
            }
            else if (b[0] == 0x81u && ((b[1] >> 3u) & 7u) == 7u)
            {
                std::uint32_t imm = 0; memcpy(&imm, b + 2u, sizeof(imm));
                immediate = imm; compareBytes = 6u; isCompare = true;
            }
            if (isCompare && compares < 32u)
            {
                ++compares;
                InternalLog("[DW-AUTH-RESET-WRITER144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-WRITER144] CMP index=%u instructionRva=0x%llX bytes=%u imm=0x%llX\r\n",
                    compares, static_cast<unsigned long long>(cursor - base), compareBytes, immediate);
            }

            std::uintptr_t branchTarget = 0;
            unsigned branchBytes = 0;
            unsigned branchOpcode = 0;
            if (b[0] >= 0x70u && b[0] <= 0x7Fu)
            {
                branchTarget = cursor + 2u + static_cast<std::int8_t>(b[1]);
                branchBytes = 2u;
                branchOpcode = b[0];
            }
            else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu)
            {
                std::int32_t rel = 0; memcpy(&rel, b + 2u, sizeof(rel));
                branchTarget = cursor + 6u + static_cast<std::intptr_t>(rel);
                branchBytes = 6u;
                branchOpcode = 0x0F00u | b[1];
            }
            if (branchTarget && branchTarget >= scanBegin && branchTarget < scanEnd && branches < 64u)
            {
                ++branches;
                const bool writerEdge = (branchTarget >= writer - 16u && branchTarget <= writer + 16u) ||
                    (cursor >= writer - 32u && cursor <= writer + 32u);
                if (writerEdge) ++writerEdges;
                InternalLog(
                    "[DW-AUTH-RESET-WRITER144] JCC index=%u instructionRva=0x%llX bytes=%u opcode=0x%X targetRva=0x%llX writerEdge=%s\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchBytes, branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base), writerEdge ? "YES" : "no");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-WRITER144] JCC index=%u instructionRva=0x%llX bytes=%u opcode=0x%X targetRva=0x%llX writerEdge=%s\r\n",
                    branches, static_cast<unsigned long long>(cursor - base), branchBytes, branchOpcode,
                    static_cast<unsigned long long>(branchTarget - base), writerEdge ? "YES" : "no");
            }
        }

        unsigned localCallers = 0;
        const std::uintptr_t localBegin = scanBegin > base + 0x20000u ? scanBegin - 0x20000u : base;
        const std::uintptr_t localEnd = (std::min)(base + size, scanEnd + static_cast<std::uintptr_t>(0x20000));
        for (std::uintptr_t cursor = localBegin; cursor + 5u <= localEnd && localCallers < 48u; ++cursor)
        {
            unsigned char b[5]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)) || b[0] != 0xE8u)
                continue;
            std::int32_t rel = 0;
            memcpy(&rel, b + 1u, sizeof(rel));
            const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
            if (target < scanBegin || target >= scanEnd)
                continue;

            ++localCallers;
            std::uintptr_t callerBegin = 0;
            std::uintptr_t callerEnd = 0;
            const bool callerBounded = RuntimeFunctionBounds144(cursor, callerBegin, callerEnd);
            InternalLog(
                "[DW-AUTH-RESET-WRITER144] LOCAL_CALLER index=%u callRva=0x%llX targetRva=0x%llX callerFunction=%s0x%llX..%s0x%llX\r\n",
                localCallers, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-WRITER144] LOCAL_CALLER index=%u callRva=0x%llX targetRva=0x%llX callerFunction=%s0x%llX..%s0x%llX\r\n",
                localCallers, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerBegin - base : 0),
                callerBounded ? "" : "n/a-", static_cast<unsigned long long>(callerBounded ? callerEnd - base : 0));
            if (callerBounded)
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-WRITER-CALLER-CODE144]", cursor, 80, 112);
        }

        InternalLog(
            "[DW-AUTH-RESET-WRITER144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u writerEdges=%u localCallers=%u "
            "next=identify_condition_that_sets_reset_latch stateWrites=off\r\n",
            directCalls, ripRefs, printableRefs, compares, branches, writerEdges, localCallers);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-WRITER144] SUMMARY calls=%u ripRefs=%u printableRefs=%u compares=%u jcc=%u writerEdges=%u localCallers=%u "
            "next=identify_condition_that_sets_reset_latch stateWrites=off\r\n",
            directCalls, ripRefs, printableRefs, compares, branches, writerEdges, localCallers);
    }

    void LogDwConnectionFailureCorrelation144(const DwAuthTrackedGlobal144& item,
        unsigned globalChange, unsigned targetChange, ULONGLONG elapsed,
        std::uint64_t oldValue, std::uint64_t newValue, bool observedPopupWindow) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || item.address != base + kDwConnectionFailureCandidateRva144)
            return;

        // V20 classification found two references to the static string at
        // 0x6F06100 whose bytes begin "DEV ERRO".  That makes 0x171C2200 a
        // generic developer-error formatting/scratch buffer, not the DW auth
        // state itself.  Emit this once at the old user-observed window and
        // stop treating every buffer rewrite as a connection-failure state.
        if (!observedPopupWindow || targetChange != 3u)
            return;

        char evidence[160]{};
        const char* encoding = "?";
        const bool printable = kDwDevErrorStringRva144 < size &&
            TryReadDwTlsPrintable144(base + kDwDevErrorStringRva144, evidence, ArrayCount(evidence), encoding);

        InternalLog(
            "[DW-CONNECTION-RECLASS144] targetChange=%u t=%llums dataRva=0x%llX role=GENERIC_DEV_ERROR_BUFFER "
            "writerRva=0x%llX evidenceRva=0x%llX evidence=%s%s%s not_auth_state=yes pivot=DW_RESET_LATCH_0x17BFBC22 stateWrites=off\r\n",
            targetChange, static_cast<unsigned long long>(elapsed),
            static_cast<unsigned long long>(kDwConnectionFailureCandidateRva144),
            static_cast<unsigned long long>(item.instruction ? item.instruction - base : 0),
            static_cast<unsigned long long>(kDwDevErrorStringRva144),
            printable ? "'" : "", printable ? evidence : "UNREADABLE", printable ? "'" : "");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-CONNECTION-RECLASS144] globalChange=%u targetChange=%u t=%llums dataRva=0x%llX old=0x%016llX new=0x%016llX "
            "role=GENERIC_DEV_ERROR_BUFFER writerRva=0x%llX evidenceRva=0x%llX encoding=%s evidence='%s' "
            "not_auth_state=yes pivot=DW_RESET_LATCH_0x17BFBC22 stateWrites=off\r\n",
            globalChange, targetChange, static_cast<unsigned long long>(elapsed),
            static_cast<unsigned long long>(kDwConnectionFailureCandidateRva144),
            static_cast<unsigned long long>(oldValue), static_cast<unsigned long long>(newValue),
            static_cast<unsigned long long>(item.instruction ? item.instruction - base : 0),
            static_cast<unsigned long long>(kDwDevErrorStringRva144), printable ? encoding : "n/a", printable ? evidence : "UNREADABLE");
    }

    // Auth3 helper monitoring (0x6CE0xxx-0x6CE1xxx)
    constexpr std::uintptr_t kDwAuth3HelperStartRva144 = 0x6CE0000u;
    constexpr std::uintptr_t kDwAuth3HelperEndRva144 = 0x6CE1FFFu;
    constexpr std::size_t kDwAuth3HelperSize144 = 0x2000u; // 8KB

    bool ReadDwControllerStateBlock144(std::uintptr_t address, unsigned char* out, std::size_t length) noexcept
    {
        if (!address || !out || !length)
            return false;
        __try
        {
            memcpy(out, reinterpret_cast<const void*>(address), length);
            return true;
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            memset(out, 0, length);
            return false;
        }
    }

    constexpr std::size_t kDwStatusEntryBaseOffset144 = 0x0Cu;
    constexpr std::size_t kDwStatusEntryCountOffset144 = 0x80u;
    constexpr std::size_t kDwStatusEntryMax144 = (kDwStatusEntryCountOffset144 - kDwStatusEntryBaseOffset144) / sizeof(std::uint32_t);

    struct DwStatusSetSnapshot144
    {
        bool valid = false;
        std::uint32_t count = 0;
        std::uint32_t entries[kDwStatusEntryMax144]{};
        bool hasSuccess21 = false;
        bool hasState1 = false;
        std::uint32_t derivedStatus = 1;
    };

    DwStatusSetSnapshot144 ReadDwStatusSetSnapshot144(const unsigned char* block, std::size_t length) noexcept
    {
        DwStatusSetSnapshot144 snapshot{};
        if (!block || length < kDwStatusEntryCountOffset144 + sizeof(std::uint32_t))
            return snapshot;

        std::uint32_t rawCount = 0;
        memcpy(&rawCount, block + kDwStatusEntryCountOffset144, sizeof(rawCount));
        snapshot.count = (std::min)(rawCount, static_cast<std::uint32_t>(kDwStatusEntryMax144));
        for (std::uint32_t i = 0; i < snapshot.count; ++i)
        {
            std::uint32_t value = 0;
            memcpy(&value, block + kDwStatusEntryBaseOffset144 + static_cast<std::size_t>(i) * sizeof(value), sizeof(value));
            snapshot.entries[i] = value;
            if (value == 0x21u)
                snapshot.hasSuccess21 = true;
            if (value == 1u)
                snapshot.hasState1 = true;
        }
        snapshot.derivedStatus = snapshot.hasSuccess21 ? 2u : (snapshot.hasState1 ? 0u : 1u);
        snapshot.valid = true;
        return snapshot;
    }

    bool SameDwStatusSet144(const DwStatusSetSnapshot144& a, const DwStatusSetSnapshot144& b) noexcept
    {
        if (a.valid != b.valid || a.count != b.count || a.hasSuccess21 != b.hasSuccess21 ||
            a.hasState1 != b.hasState1 || a.derivedStatus != b.derivedStatus)
            return false;
        if (!a.valid)
            return true;
        for (std::uint32_t i = 0; i < a.count; ++i)
        {
            if (a.entries[i] != b.entries[i])
                return false;
        }
        return true;
    }

    void FormatDwStatusEntries144(const DwStatusSetSnapshot144& snapshot, char* out, std::size_t outSize) noexcept
    {
        if (!out || !outSize)
            return;
        out[0] = '\0';
        if (!snapshot.valid)
        {
            strcpy_s(out, outSize, "<unreadable>");
            return;
        }

        std::size_t used = 0;
        used += static_cast<std::size_t>(_snprintf_s(out + used, outSize - used, _TRUNCATE, "["));
        for (std::uint32_t i = 0; i < snapshot.count && used + 16u < outSize; ++i)
            used += static_cast<std::size_t>(_snprintf_s(out + used, outSize - used, _TRUNCATE, "%s0x%X", i ? "," : "", snapshot.entries[i]));
        if (used + 2u < outSize)
            _snprintf_s(out + used, outSize - used, _TRUNCATE, "]");
    }

    bool DwStatusFunctionContainsImmediate144(std::uintptr_t begin, std::uintptr_t end, std::uint32_t value) noexcept
    {
        if (!begin || end <= begin)
            return false;
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x3000));
        unsigned char bytes[4]{};
        for (std::uintptr_t cursor = begin; cursor + sizeof(bytes) <= scanEnd; ++cursor)
        {
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), bytes, sizeof(bytes)))
                continue;
            std::uint32_t current = 0;
            memcpy(&current, bytes, sizeof(current));
            if (current == value)
                return true;
        }
        return false;
    }

    bool DwStatusFunctionHasCountWrite144(std::uintptr_t begin, std::uintptr_t end) noexcept
    {
        if (!begin || end <= begin)
            return false;
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x3000));
        unsigned char b[10]{};
        for (std::uintptr_t cursor = begin; cursor + sizeof(b) <= scanEnd; ++cursor)
        {
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            // Write-class instructions with a disp32 of +0x80. The exact base
            // register is intentionally not assumed here; the owning function is
            // correlated separately with the controller-state base/0x2130 stride.
            if ((b[0] == 0x89u || b[0] == 0xC7u || b[0] == 0xFFu) &&
                (b[1] & 0xC0u) == 0x80u)
            {
                std::int32_t disp = 0;
                memcpy(&disp, b + 2u, sizeof(disp));
                if (disp == static_cast<std::int32_t>(kDwStatusEntryCountOffset144))
                    return true;
            }
            if ((b[0] & 0xF0u) == 0x40u &&
                (b[1] == 0x89u || b[1] == 0xC7u || b[1] == 0xFFu) &&
                (b[2] & 0xC0u) == 0x80u)
            {
                std::int32_t disp = 0;
                memcpy(&disp, b + 3u, sizeof(disp));
                if (disp == static_cast<std::int32_t>(kDwStatusEntryCountOffset144))
                    return true;
            }
        }
        return false;
    }

    bool ReadDwStatusSetProcess144(std::uintptr_t base, unsigned controller, DwStatusSetSnapshot144& snapshot) noexcept
    {
        snapshot = {};
        if (!base || controller >= kDwControllerStateCount144)
            return false;
        unsigned char bytes[0x100]{};
        const std::uintptr_t object = base + kDwControllerStateBaseRva144 +
            static_cast<std::uintptr_t>(controller) * kDwControllerStateStride144;
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(object), bytes, sizeof(bytes)))
            return false;
        snapshot = ReadDwStatusSetSnapshot144(bytes, sizeof(bytes));
        return snapshot.valid;
    }

    void RegisterDwStatusMutatorCandidate144(std::uintptr_t base, std::uintptr_t functionBegin, std::uintptr_t functionEnd) noexcept
    {
        if (!base || !functionBegin || functionEnd <= functionBegin ||
            g_dwStatusMutatorBreakpointCount144 >= kDwStatusMutatorMaxBreakpoints144)
            return;
        const std::uintptr_t rva = functionBegin - base;
        if (rva < 0x452F000ull || rva > 0x4531000ull)
            return;
        for (unsigned i = 0; i < g_dwStatusMutatorBreakpointCount144; ++i)
            if (g_dwStatusMutatorBreakpoints144[i].functionRva == rva)
                return;

        auto& bp = g_dwStatusMutatorBreakpoints144[g_dwStatusMutatorBreakpointCount144++];
        bp.function = functionBegin;
        bp.functionRva = rva;
        bp.functionEndRva = functionEnd - base;
    }

    void DisarmDwStatusMutatorProbe144(const char* reason) noexcept
    {
        for (unsigned i = 0; i < g_dwStatusMutatorBreakpointCount144; ++i)
        {
            auto& bp = g_dwStatusMutatorBreakpoints144[i];
            if (bp.prepared && bp.armed)
            {
                ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.function), bp.originalByte, nullptr);
                bp.armed = false;
            }
        }
        const bool wasArmed = g_dwStatusMutatorProbeArmed144.exchange(false, std::memory_order_acq_rel);
        if (wasArmed)
        {
            InternalLog("[DW-AUTH-MUTATOR144] DISARM reason=%s hits=%u stateWrites=off\r\n",
                reason ? reason : "unknown", g_dwStatusMutatorHits144.load(std::memory_order_acquire));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-MUTATOR144] DISARM reason=%s hits=%u stateWrites=off\r\n",
                reason ? reason : "unknown", g_dwStatusMutatorHits144.load(std::memory_order_acquire));
        }
    }

    LONG CALLBACK DwStatusMutatorVeh144(EXCEPTION_POINTERS* info) noexcept
    {
        if (!info || !info->ExceptionRecord || !info->ContextRecord ||
            !g_dwStatusMutatorProbeArmed144.load(std::memory_order_acquire))
            return EXCEPTION_CONTINUE_SEARCH;

        CONTEXT* context = info->ContextRecord;
        const DWORD code = info->ExceptionRecord->ExceptionCode;
        if (code == EXCEPTION_BREAKPOINT)
        {
            const auto exceptionAddress = reinterpret_cast<std::uintptr_t>(info->ExceptionRecord->ExceptionAddress);
            for (unsigned i = 0; i < g_dwStatusMutatorBreakpointCount144; ++i)
            {
                auto& bp = g_dwStatusMutatorBreakpoints144[i];
                if (!bp.prepared || !bp.armed || exceptionAddress != bp.function)
                    continue;

                if (!ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.function), bp.originalByte, nullptr))
                    return EXCEPTION_CONTINUE_SEARCH;
                bp.armed = false;

                const unsigned hit = ++g_dwStatusMutatorHits144;
                const auto base = MainImageBase();
                DwStatusSetSnapshot144 s0{};
                DwStatusSetSnapshot144 s1{};
                ReadDwStatusSetProcess144(base, 0u, s0);
                ReadDwStatusSetProcess144(base, 1u, s1);
                char e0[256]{};
                char e1[256]{};
                FormatDwStatusEntries144(s0, e0, ArrayCount(e0));
                FormatDwStatusEntries144(s1, e1, ArrayCount(e1));

                const std::uintptr_t state0 = base + kDwControllerStateBaseRva144;
                const std::uintptr_t state1 = state0 + kDwControllerStateStride144;
                auto argOffset = [&](std::uintptr_t v, char* out, std::size_t n) noexcept {
                    if (!out || !n) return;
                    if (v >= state0 && v < state0 + kDwControllerStateStride144)
                        _snprintf_s(out, n, _TRUNCATE, "C0+0x%llX", static_cast<unsigned long long>(v - state0));
                    else if (v >= state1 && v < state1 + kDwControllerStateStride144)
                        _snprintf_s(out, n, _TRUNCATE, "C1+0x%llX", static_cast<unsigned long long>(v - state1));
                    else
                        strcpy_s(out, n, "-");
                };
                char rcxObj[32]{}, rdxObj[32]{}, r8Obj[32]{}, r9Obj[32]{};
                argOffset(static_cast<std::uintptr_t>(context->Rcx), rcxObj, ArrayCount(rcxObj));
                argOffset(static_cast<std::uintptr_t>(context->Rdx), rdxObj, ArrayCount(rdxObj));
                argOffset(static_cast<std::uintptr_t>(context->R8), r8Obj, ArrayCount(r8Obj));
                argOffset(static_cast<std::uintptr_t>(context->R9), r9Obj, ArrayCount(r9Obj));

                InternalLog("[DW-AUTH-MUTATOR144] HIT=%u index=%u functionRva=0x%llX elapsedMs=%llu args={rcx:%p/%s rdx:%p/%s r8:%p/%s r9:%p/%s low32={ecx:0x%X edx:0x%X r8d:0x%X r9d:0x%X}} set0={count:%u entries:%s has21:%s status:%u} set1={count:%u entries:%s has21:%s status:%u} mode=EXECUTE_ORIGINAL_UNCHANGED\r\n",
                    hit, i, static_cast<unsigned long long>(bp.functionRva),
                    static_cast<unsigned long long>(GetTickCount64() - g_dwStatusMutatorArmTick144),
                    reinterpret_cast<void*>(context->Rcx), rcxObj,
                    reinterpret_cast<void*>(context->Rdx), rdxObj,
                    reinterpret_cast<void*>(context->R8), r8Obj,
                    reinterpret_cast<void*>(context->R9), r9Obj,
                    static_cast<unsigned>(context->Rcx), static_cast<unsigned>(context->Rdx),
                    static_cast<unsigned>(context->R8), static_cast<unsigned>(context->R9),
                    s0.count, e0, s0.hasSuccess21 ? "yes" : "no", s0.derivedStatus,
                    s1.count, e1, s1.hasSuccess21 ? "yes" : "no", s1.derivedStatus);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-MUTATOR144] HIT=%u index=%u functionRva=0x%llX elapsedMs=%llu argsLow32={ecx:0x%X edx:0x%X r8d:0x%X r9d:0x%X} argObjects={rcx:%s rdx:%s r8:%s r9:%s} set0={count:%u entries:%s has21:%s status:%u} mode=EXECUTE_ORIGINAL_UNCHANGED stateWrites=off\r\n",
                    hit, i, static_cast<unsigned long long>(bp.functionRva),
                    static_cast<unsigned long long>(GetTickCount64() - g_dwStatusMutatorArmTick144),
                    static_cast<unsigned>(context->Rcx), static_cast<unsigned>(context->Rdx),
                    static_cast<unsigned>(context->R8), static_cast<unsigned>(context->R9),
                    rcxObj, rdxObj, r8Obj, r9Obj,
                    s0.count, e0, s0.hasSuccess21 ? "yes" : "no", s0.derivedStatus);

                g_dwStatusMutatorPendingStep144 = static_cast<int>(i);
                context->Rip = bp.function;
                context->EFlags |= 0x100u;
                return EXCEPTION_CONTINUE_EXECUTION;
            }
        }
        else if (code == EXCEPTION_SINGLE_STEP && g_dwStatusMutatorPendingStep144 >= 0)
        {
            const int index = g_dwStatusMutatorPendingStep144;
            g_dwStatusMutatorPendingStep144 = -1;
            context->EFlags &= ~0x100u;
            if (index >= 0 && static_cast<unsigned>(index) < g_dwStatusMutatorBreakpointCount144)
            {
                auto& bp = g_dwStatusMutatorBreakpoints144[index];
                const unsigned hits = g_dwStatusMutatorHits144.load(std::memory_order_acquire);
                const ULONGLONG elapsed = GetTickCount64() - g_dwStatusMutatorArmTick144;
                DwStatusSetSnapshot144 s0{};
                const bool statusOk = ReadDwStatusSetProcess144(MainImageBase(), 0u, s0);
                if (statusOk && s0.hasSuccess21)
                {
                    DisarmDwStatusMutatorProbe144("status_0x21_observed");
                }
                else if (hits >= 128u || elapsed >= 25000ull)
                {
                    DisarmDwStatusMutatorProbe144(hits >= 128u ? "hit_cap_128" : "timeout_25s");
                }
                else if (g_dwStatusMutatorProbeArmed144.load(std::memory_order_acquire))
                {
                    if (ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.function), 0xCC, nullptr))
                        bp.armed = true;
                }
            }
            return EXCEPTION_CONTINUE_EXECUTION;
        }
        return EXCEPTION_CONTINUE_SEARCH;
    }

    void ArmDwStatusMutatorProbe144() noexcept
    {
        // Disabled intentionally. V6's INT3/single-step entry observer could
        // collide with protected/rewritten IW8 code and produce 0xC000001D.
        // The replacement path below is static/read-only and never changes
        // executable bytes.
        g_dwStatusMutatorProbeArmed144.store(false, std::memory_order_release);
        InternalLog("[DW-AUTH-MUTATOR144] RUNTIME_OBSERVER_DISABLED reason=passive_scanner_only_no_code_patching stateWrites=off\r\n");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-MUTATOR144] RUNTIME_OBSERVER_DISABLED reason=passive_scanner_only_no_code_patching stateWrites=off\r\n");
    }

    struct DwStatusCallerArgHint144
    {
        bool found21 = false;
        bool found1 = false;
        const char* reg21 = "-";
        const char* reg1 = "-";
        std::uintptr_t instruction21 = 0;
        std::uintptr_t instruction1 = 0;
    };

    DwStatusCallerArgHint144 ScanDwStatusCallerArgHints144(std::uintptr_t callAddress) noexcept
    {
        DwStatusCallerArgHint144 out{};
        if (!callAddress)
            return out;

        constexpr std::size_t kLookback = 64u;
        unsigned char bytes[kLookback]{};
        const std::uintptr_t begin = callAddress > kLookback ? callAddress - kLookback : 0;
        if (!begin || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(begin), bytes, sizeof(bytes)))
            return out;

        auto record = [&](std::uint32_t imm, const char* reg, std::uintptr_t at) noexcept
        {
            if (imm == 0x21u)
            {
                out.found21 = true;
                out.reg21 = reg;
                out.instruction21 = at;
            }
            else if (imm == 1u)
            {
                out.found1 = true;
                out.reg1 = reg;
                out.instruction1 = at;
            }
        };

        for (std::size_t i = 0; i + 6u <= sizeof(bytes); ++i)
        {
            std::uint32_t imm = 0;
            if (bytes[i] == 0xB9u && i + 5u <= sizeof(bytes))
            {
                memcpy(&imm, bytes + i + 1u, sizeof(imm));
                record(imm, "ECX", begin + i);
            }
            else if (bytes[i] == 0xBAu && i + 5u <= sizeof(bytes))
            {
                memcpy(&imm, bytes + i + 1u, sizeof(imm));
                record(imm, "EDX", begin + i);
            }
            else if (bytes[i] == 0x41u && bytes[i + 1u] == 0xB8u)
            {
                memcpy(&imm, bytes + i + 2u, sizeof(imm));
                record(imm, "R8D", begin + i);
            }
            else if (bytes[i] == 0x41u && bytes[i + 1u] == 0xB9u)
            {
                memcpy(&imm, bytes + i + 2u, sizeof(imm));
                record(imm, "R9D", begin + i);
            }
        }
        return out;
    }

    void ScanDwStatusMutatorCallers144(std::uintptr_t base, std::uintptr_t textBegin, std::uintptr_t textEnd) noexcept
    {
        if (!base || !textBegin || textEnd <= textBegin || !g_dwStatusMutatorBreakpointCount144)
            return;

        struct ScanRange144 { std::uintptr_t firstRva; std::uintptr_t lastRva; const char* label; };
        const ScanRange144 ranges[] = {
            { 0x00400000u, 0x00800000u, "auth3_loginqueue" },
            { 0x02C00000u, 0x02D00000u, "dw_auth_bridge" },
            { 0x03B00000u, 0x03D80000u, "dw_auth_pump" },
            { 0x04500000u, 0x04560000u, "status_helpers" },
            { 0x05D00000u, 0x05E00000u, "dw_api" }
        };

        unsigned directCalls = 0;
        unsigned callsWith21 = 0;
        unsigned callsWith1 = 0;

        InternalLog("[DW-AUTH-MUTATOR-CALLER144] BEGIN targets=%u mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            g_dwStatusMutatorBreakpointCount144);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-MUTATOR-CALLER144] BEGIN targets=%u mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            g_dwStatusMutatorBreakpointCount144);

        for (const auto& range : ranges)
        {
            const std::uintptr_t rangeBegin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t rangeEnd = (std::min)(textEnd, base + range.lastRva);
            if (rangeEnd <= rangeBegin)
                continue;

            for (std::uintptr_t cursor = rangeBegin; cursor + 5u <= rangeEnd && directCalls < 192u; ++cursor)
            {
                // rangeBegin/rangeEnd are already clipped to the committed
                // executable .text section, so avoid millions of VirtualQuery-
                // style safe-read probes in this background static scan.
                const auto* op = reinterpret_cast<const unsigned char*>(cursor);
                if (op[0] != 0xE8u)
                    continue;

                std::int32_t rel = 0;
                memcpy(&rel, op + 1u, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);

                int targetIndex = -1;
                for (unsigned i = 0; i < g_dwStatusMutatorBreakpointCount144; ++i)
                {
                    if (g_dwStatusMutatorBreakpoints144[i].function == target)
                    {
                        targetIndex = static_cast<int>(i);
                        break;
                    }
                }
                if (targetIndex < 0)
                    continue;

                ++directCalls;
                const auto hints = ScanDwStatusCallerArgHints144(cursor);
                if (hints.found21) ++callsWith21;
                if (hints.found1) ++callsWith1;

                std::uintptr_t callerBegin = 0;
                std::uintptr_t callerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(cursor, callerBegin, callerEnd);
                const auto& targetInfo = g_dwStatusMutatorBreakpoints144[static_cast<unsigned>(targetIndex)];

                InternalLog("[DW-AUTH-MUTATOR-CALLER144] hit=%u range=%s callRva=0x%llX caller=0x%llX..0x%llX unwind=%s targetIndex=%d targetRva=0x%llX arg21=%s/%s arg1=%s/%s mode=STATIC_READ_ONLY\r\n",
                    directCalls, range.label,
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                    static_cast<unsigned long long>(bounded ? callerEnd - base : 0),
                    bounded ? "yes" : "no",
                    targetIndex,
                    static_cast<unsigned long long>(targetInfo.functionRva),
                    hints.found21 ? "YES" : "no", hints.reg21,
                    hints.found1 ? "yes" : "no", hints.reg1);

                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-MUTATOR-CALLER144] hit=%u range=%s callRva=0x%llX caller=0x%llX..0x%llX unwind=%s targetIndex=%d targetRva=0x%llX arg21=%s reg21=%s set21Rva=0x%llX arg1=%s reg1=%s set1Rva=0x%llX mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                    directCalls, range.label,
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                    static_cast<unsigned long long>(bounded ? callerEnd - base : 0),
                    bounded ? "yes" : "no",
                    targetIndex,
                    static_cast<unsigned long long>(targetInfo.functionRva),
                    hints.found21 ? "YES" : "no", hints.reg21,
                    static_cast<unsigned long long>(hints.instruction21 ? hints.instruction21 - base : 0),
                    hints.found1 ? "yes" : "no", hints.reg1,
                    static_cast<unsigned long long>(hints.instruction1 ? hints.instruction1 - base : 0));
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-MUTATOR-CALLER-CODE144]", cursor, 80, 112);
            }
        }

        InternalLog("[DW-AUTH-MUTATOR-CALLER144] COMPLETE directCalls=%u callsWith21=%u callsWith1=%u next=trace_static_success_caller_chain stateWrites=off no_code_patching=yes\r\n",
            directCalls, callsWith21, callsWith1);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-MUTATOR-CALLER144] COMPLETE directCalls=%u callsWith21=%u callsWith1=%u next=trace_static_success_caller_chain stateWrites=off no_code_patching=yes\r\n",
            directCalls, callsWith21, callsWith1);
    }

    void LogDwAuthResetCodeWindow144(std::uintptr_t base, const char* label, std::uintptr_t rva) noexcept
    {
        if (!base || !label || !rva)
            return;

        unsigned char bytes[64]{};
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + rva), bytes, sizeof(bytes)))
        {
            InternalLog("[DW-AUTH-RESET-CODE144] label=%s rva=0x%llX readable=no mode=STATIC_READ_ONLY\r\n",
                label, static_cast<unsigned long long>(rva));
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-CODE144] label=%s rva=0x%llX readable=no mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                label, static_cast<unsigned long long>(rva));
            return;
        }

        char hex[64u * 3u + 1u]{};
        std::size_t used = 0;
        for (unsigned i = 0; i < ArrayCount(bytes) && used + 4u < ArrayCount(hex); ++i)
            used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", bytes[i]));

        InternalLog("[DW-AUTH-RESET-CODE144] label=%s rva=0x%llX bytes={%s} mode=STATIC_READ_ONLY\r\n",
            label, static_cast<unsigned long long>(rva), hex);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-CODE144] label=%s rva=0x%llX bytes={%s} mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            label, static_cast<unsigned long long>(rva), hex);
    }

    bool ReadStaticAsciiPreview144(std::uintptr_t address, char* out, std::size_t capacity) noexcept
    {
        if (!address || !out || capacity < 2u)
            return false;
        out[0] = '\0';

        unsigned char bytes[96]{};
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(address), bytes, sizeof(bytes)))
            return false;

        std::size_t length = 0;
        for (; length + 1u < capacity && length < ArrayCount(bytes); ++length)
        {
            const unsigned char c = bytes[length];
            if (c == 0u)
                break;
            if (c < 0x20u || c > 0x7Eu)
                return false;
            out[length] = static_cast<char>(c);
        }
        out[length] = '\0';
        return length >= 5u;
    }

    void ScanDwAuthResetControlFlow144(std::uintptr_t base, std::uintptr_t textBegin, std::uintptr_t textEnd) noexcept
    {
        if (!base || !textBegin || textEnd <= textBegin)
            return;

        constexpr std::uintptr_t kRegionFirstRva = 0x3C1DE80u;
        constexpr std::uintptr_t kRegionLastRva = 0x3C1E100u;
        constexpr std::uintptr_t kSetOneRva = 0x3C1DF30u;
        constexpr std::uintptr_t kClearOneRva = 0x3C1DF44u;
        constexpr std::uintptr_t kClearTwoRva = 0x3C1DF68u;
        constexpr std::uintptr_t kPumpRva = 0x3C1DFB3u;
        constexpr std::uintptr_t kResetReadRva = 0x3C1E069u;

        InternalLog("[DW-AUTH-RESET-CFG144] BEGIN region=0x%llX..0x%llX set1=0x%llX pump=0x%llX targetFlag=0x%llX mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            static_cast<unsigned long long>(kRegionFirstRva),
            static_cast<unsigned long long>(kRegionLastRva),
            static_cast<unsigned long long>(kSetOneRva),
            static_cast<unsigned long long>(kPumpRva),
            static_cast<unsigned long long>(kDwAuthResetFlagRva144));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-CFG144] BEGIN region=0x%llX..0x%llX set1=0x%llX pump=0x%llX targetFlag=0x%llX mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            static_cast<unsigned long long>(kRegionFirstRva),
            static_cast<unsigned long long>(kRegionLastRva),
            static_cast<unsigned long long>(kSetOneRva),
            static_cast<unsigned long long>(kPumpRva),
            static_cast<unsigned long long>(kDwAuthResetFlagRva144));

        LogDwAuthResetCodeWindow144(base, "pre_set1", 0x3C1DEF0u);
        LogDwAuthResetCodeWindow144(base, "set1", kSetOneRva);
        LogDwAuthResetCodeWindow144(base, "clear1", kClearOneRva);
        LogDwAuthResetCodeWindow144(base, "clear2", kClearTwoRva);
        LogDwAuthResetCodeWindow144(base, "pump_entry", kPumpRva);
        LogDwAuthResetCodeWindow144(base, "flag_read", kResetReadRva);

        const std::uintptr_t regionBegin = (std::max)(textBegin, base + kRegionFirstRva);
        const std::uintptr_t regionEnd = (std::min)(textEnd, base + kRegionLastRva);
        if (regionEnd <= regionBegin)
            return;

        unsigned localBranches = 0;
        unsigned incomingSetBlock = 0;
        unsigned localCalls = 0;
        unsigned stringRefs = 0;

        // First map direct CALL/JMP/Jcc edges in the small reset/auth-pump neighborhood.
        // This is intentionally byte-scanned like the other research decoders: candidates
        // are evidence for topology, never execution targets and never patched.
        for (std::uintptr_t cursor = regionBegin; cursor + 6u <= regionEnd && localBranches < 128u; ++cursor)
        {
            const auto* p = reinterpret_cast<const unsigned char*>(cursor);
            const char* kind = nullptr;
            std::size_t length = 0;
            std::intptr_t rel = 0;

            if (p[0] == 0xE8u || p[0] == 0xE9u)
            {
                std::int32_t rel32 = 0;
                memcpy(&rel32, p + 1u, sizeof(rel32));
                rel = rel32;
                length = 5u;
                kind = p[0] == 0xE8u ? "CALL_REL32" : "JMP_REL32";
            }
            else if (p[0] == 0xEBu || (p[0] >= 0x70u && p[0] <= 0x7Fu))
            {
                rel = static_cast<std::int8_t>(p[1]);
                length = 2u;
                kind = p[0] == 0xEBu ? "JMP_REL8" : "JCC_REL8";
            }
            else if (p[0] == 0x0Fu && p[1] >= 0x80u && p[1] <= 0x8Fu)
            {
                std::int32_t rel32 = 0;
                memcpy(&rel32, p + 2u, sizeof(rel32));
                rel = rel32;
                length = 6u;
                kind = "JCC_REL32";
            }
            else
            {
                continue;
            }

            const std::uintptr_t target = cursor + length + rel;
            if (p[0] == 0xE8u)
            {
                if (target >= base && target < base + MainImageSize() && localCalls < 48u)
                {
                    ++localCalls;
                    std::uintptr_t calleeBegin = 0;
                    std::uintptr_t calleeEnd = 0;
                    const bool calleeBounded = RuntimeFunctionBounds144(target, calleeBegin, calleeEnd);
                    InternalLog("[DW-AUTH-RESET-CALL144] hit=%u callRva=0x%llX targetRva=0x%llX callee=0x%llX..0x%llX unwind=%s mode=STATIC_READ_ONLY\r\n",
                        localCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base),
                        static_cast<unsigned long long>(calleeBounded ? calleeBegin - base : 0),
                        static_cast<unsigned long long>(calleeBounded ? calleeEnd - base : 0),
                        calleeBounded ? "yes" : "no");
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-CALL144] hit=%u callRva=0x%llX targetRva=0x%llX callee=0x%llX..0x%llX unwind=%s mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                        localCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base),
                        static_cast<unsigned long long>(calleeBounded ? calleeBegin - base : 0),
                        static_cast<unsigned long long>(calleeBounded ? calleeEnd - base : 0),
                        calleeBounded ? "yes" : "no");
                }
                continue;
            }

            if (target < regionBegin || target >= regionEnd)
                continue;

            ++localBranches;
            const bool entersSetBlock = target >= base + 0x3C1DF10u && target <= base + 0x3C1DF38u;
            if (entersSetBlock)
                ++incomingSetBlock;
            InternalLog("[DW-AUTH-RESET-BRANCH144] hit=%u kind=%s sourceRva=0x%llX targetRva=0x%llX entersSet1Block=%s mode=STATIC_READ_ONLY\r\n",
                localBranches, kind,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(target - base),
                entersSetBlock ? "YES" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-BRANCH144] hit=%u kind=%s sourceRva=0x%llX targetRva=0x%llX entersSet1Block=%s mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                localBranches, kind,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(target - base),
                entersSetBlock ? "YES" : "no");
        }

        // Search the broader known auth neighborhoods only for branches entering the
        // set-to-1 block. This catches jump-driven dispatch without rescanning all .text.
        struct ScanRange144 { std::uintptr_t firstRva; std::uintptr_t lastRva; const char* label; };
        const ScanRange144 ranges[] = {
            { 0x00400000u, 0x00800000u, "auth3_loginqueue" },
            { 0x02C00000u, 0x02D00000u, "dw_auth_bridge" },
            { 0x03B00000u, 0x03D80000u, "dw_auth_pump" },
            { 0x04500000u, 0x04560000u, "dw_status" },
            { 0x05D00000u, 0x05E00000u, "dw_api" }
        };
        unsigned externalIncoming = 0;
        for (const auto& range : ranges)
        {
            const std::uintptr_t first = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t last = (std::min)(textEnd, base + range.lastRva);
            if (last <= first)
                continue;

            for (std::uintptr_t cursor = first; cursor + 6u <= last && externalIncoming < 64u; ++cursor)
            {
                if (cursor >= regionBegin && cursor < regionEnd)
                    continue;
                const auto* p = reinterpret_cast<const unsigned char*>(cursor);
                const char* kind = nullptr;
                std::size_t length = 0;
                std::intptr_t rel = 0;
                if (p[0] == 0xE9u)
                {
                    std::int32_t rel32 = 0;
                    memcpy(&rel32, p + 1u, sizeof(rel32));
                    rel = rel32; length = 5u; kind = "JMP_REL32";
                }
                else if (p[0] == 0xEBu || (p[0] >= 0x70u && p[0] <= 0x7Fu))
                {
                    rel = static_cast<std::int8_t>(p[1]);
                    length = 2u; kind = p[0] == 0xEBu ? "JMP_REL8" : "JCC_REL8";
                }
                else if (p[0] == 0x0Fu && p[1] >= 0x80u && p[1] <= 0x8Fu)
                {
                    std::int32_t rel32 = 0;
                    memcpy(&rel32, p + 2u, sizeof(rel32));
                    rel = rel32; length = 6u; kind = "JCC_REL32";
                }
                else
                {
                    continue;
                }

                const std::uintptr_t target = cursor + length + rel;
                if (target < base + 0x3C1DF10u || target > base + 0x3C1DF38u)
                    continue;

                ++externalIncoming;
                std::uintptr_t sourceBegin = 0;
                std::uintptr_t sourceEnd = 0;
                const bool sourceBounded = RuntimeFunctionBounds144(cursor, sourceBegin, sourceEnd);
                InternalLog("[DW-AUTH-RESET-INCOMING144] hit=%u range=%s kind=%s sourceRva=0x%llX targetRva=0x%llX sourceFunction=0x%llX..0x%llX unwind=%s mode=STATIC_READ_ONLY\r\n",
                    externalIncoming, range.label, kind,
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(target - base),
                    static_cast<unsigned long long>(sourceBounded ? sourceBegin - base : 0),
                    static_cast<unsigned long long>(sourceBounded ? sourceEnd - base : 0),
                    sourceBounded ? "yes" : "no");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-INCOMING144] hit=%u range=%s kind=%s sourceRva=0x%llX targetRva=0x%llX sourceFunction=0x%llX..0x%llX unwind=%s mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                    externalIncoming, range.label, kind,
                    static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(target - base),
                    static_cast<unsigned long long>(sourceBounded ? sourceBegin - base : 0),
                    static_cast<unsigned long long>(sourceBounded ? sourceEnd - base : 0),
                    sourceBounded ? "yes" : "no");
            }
        }

        // Resolve printable static strings referenced by RIP-relative LEA instructions in
        // the local block. Error/log strings often classify the branch without invoking it.
        for (std::uintptr_t cursor = regionBegin; cursor + 7u <= regionEnd && stringRefs < 24u; ++cursor)
        {
            const auto* p = reinterpret_cast<const unsigned char*>(cursor);
            std::size_t pos = ((p[0] & 0xF0u) == 0x40u) ? 1u : 0u;
            if (p[pos] != 0x8Du || (p[pos + 1u] & 0xC7u) != 0x05u)
                continue;
            std::int32_t rel = 0;
            memcpy(&rel, p + pos + 2u, sizeof(rel));
            const std::uintptr_t target = cursor + pos + 6u + static_cast<std::intptr_t>(rel);
            if (target < base || target >= base + MainImageSize())
                continue;
            char preview[81]{};
            if (!ReadStaticAsciiPreview144(target, preview, ArrayCount(preview)))
                continue;
            ++stringRefs;
            InternalLog("[DW-AUTH-RESET-STRING144] hit=%u instructionRva=0x%llX stringRva=0x%llX value='%s' mode=STATIC_READ_ONLY\r\n",
                stringRefs,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(target - base), preview);
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-STRING144] hit=%u instructionRva=0x%llX stringRva=0x%llX value='%s' mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                stringRefs,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(target - base), preview);
        }

        InternalLog("[DW-AUTH-RESET-CFG144] COMPLETE localBranches=%u enteringSet1Block=%u externalIncoming=%u localCalls=%u staticStrings=%u next=decode_branch_predecessor_of_set1 stateWrites=off no_code_patching=yes\r\n",
            localBranches, incomingSetBlock, externalIncoming, localCalls, stringRefs);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-CFG144] COMPLETE localBranches=%u enteringSet1Block=%u externalIncoming=%u localCalls=%u staticStrings=%u next=decode_branch_predecessor_of_set1 stateWrites=off no_code_patching=yes\r\n",
            localBranches, incomingSetBlock, externalIncoming, localCalls, stringRefs);
    }

    void ScanDwAuthResetIncomingBranchesSafe144(std::uintptr_t base, std::uintptr_t textBegin, std::uintptr_t textEnd) noexcept
    {
        if (!base || !textBegin || textEnd <= textBegin)
            return;

        constexpr std::uintptr_t kSetOneRva = 0x3C1DF30u;
        constexpr std::uintptr_t kScanFirstRva = 0x3C1C000u;
        constexpr std::uintptr_t kScanLastRva = 0x3C1F000u;
        constexpr std::size_t kChunkSize = 0x1000u;

        const std::uintptr_t targetVa = base + kSetOneRva;
        const std::uintptr_t scanBegin = (std::max)(textBegin, base + kScanFirstRva);
        const std::uintptr_t scanEnd = (std::min)(textEnd, base + kScanLastRva);
        if (scanEnd <= scanBegin || targetVa < textBegin || targetVa >= textEnd)
            return;

        InternalLog("[DW-AUTH-RESET-EDGE144] BEGIN targetRva=0x%llX scan=0x%llX..0x%llX mode=SAFE_COPIED_BYTES_ONLY no_code_patching=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kSetOneRva),
            static_cast<unsigned long long>(scanBegin - base),
            static_cast<unsigned long long>(scanEnd - base));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-EDGE144] BEGIN targetRva=0x%llX scan=0x%llX..0x%llX mode=SAFE_COPIED_BYTES_ONLY no_code_patching=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kSetOneRva),
            static_cast<unsigned long long>(scanBegin - base),
            static_cast<unsigned long long>(scanEnd - base));

        unsigned hits = 0;
        unsigned unreadableChunks = 0;
        for (std::uintptr_t chunkVa = scanBegin; chunkVa < scanEnd; chunkVa += kChunkSize)
        {
            const std::size_t remaining = static_cast<std::size_t>(scanEnd - chunkVa);
            const std::size_t chunkBytes = (std::min)(kChunkSize, remaining);
            unsigned char bytes[kChunkSize]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, chunkBytes))
            {
                ++unreadableChunks;
                continue;
            }

            for (std::size_t i = 0; i < chunkBytes; ++i)
            {
                const unsigned char opcode = bytes[i];
                std::size_t length = 0;
                std::intptr_t relative = 0;
                const char* kind = nullptr;
                const char* condition = "n/a";

                if ((opcode == 0xE9u || opcode == 0xE8u) && i + 5u <= chunkBytes)
                {
                    std::int32_t rel32 = 0;
                    memcpy(&rel32, bytes + i + 1u, sizeof(rel32));
                    relative = rel32;
                    length = 5u;
                    kind = opcode == 0xE9u ? "JMP_REL32" : "CALL_REL32";
                }
                else if ((opcode == 0xEBu || (opcode >= 0x70u && opcode <= 0x7Fu) || (opcode >= 0xE0u && opcode <= 0xE3u)) && i + 2u <= chunkBytes)
                {
                    relative = static_cast<std::int8_t>(bytes[i + 1u]);
                    length = 2u;
                    if (opcode == 0xEBu)
                        kind = "JMP_REL8";
                    else if (opcode >= 0x70u && opcode <= 0x7Fu)
                    {
                        kind = "JCC_REL8";
                        static const char* kJcc8[16] = {
                            "JO","JNO","JB","JAE","JE","JNE","JBE","JA",
                            "JS","JNS","JP","JNP","JL","JGE","JLE","JG"
                        };
                        condition = kJcc8[opcode - 0x70u];
                    }
                    else
                    {
                        static const char* kLoopKinds[4] = { "LOOPNE", "LOOPE", "LOOP", "JRCXZ" };
                        kind = "LOOP_REL8";
                        condition = kLoopKinds[opcode - 0xE0u];
                    }
                }
                else if (opcode == 0x0Fu && i + 6u <= chunkBytes && bytes[i + 1u] >= 0x80u && bytes[i + 1u] <= 0x8Fu)
                {
                    std::int32_t rel32 = 0;
                    memcpy(&rel32, bytes + i + 2u, sizeof(rel32));
                    relative = rel32;
                    length = 6u;
                    kind = "JCC_REL32";
                    static const char* kJcc32[16] = {
                        "JO","JNO","JB","JAE","JE","JNE","JBE","JA",
                        "JS","JNS","JP","JNP","JL","JGE","JLE","JG"
                    };
                    condition = kJcc32[bytes[i + 1u] - 0x80u];
                }
                else
                {
                    continue;
                }

                const std::uintptr_t sourceVa = chunkVa + i;
                const std::uintptr_t branchTarget = sourceVa + length + relative;
                if (branchTarget != targetVa)
                    continue;

                ++hits;
                InternalLog("[DW-AUTH-RESET-EDGE144] hit=%u kind=%s condition=%s sourceRva=0x%llX targetRva=0x%llX distance=%lld copiedBytes=yes candidateOnly=yes\r\n",
                    hits, kind, condition,
                    static_cast<unsigned long long>(sourceVa - base),
                    static_cast<unsigned long long>(branchTarget - base),
                    static_cast<long long>(static_cast<std::intptr_t>(branchTarget) - static_cast<std::intptr_t>(sourceVa)));
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-EDGE144] hit=%u kind=%s condition=%s sourceRva=0x%llX targetRva=0x%llX distance=%lld copiedBytes=yes candidateOnly=yes no_code_patching=yes\r\n",
                    hits, kind, condition,
                    static_cast<unsigned long long>(sourceVa - base),
                    static_cast<unsigned long long>(branchTarget - base),
                    static_cast<long long>(static_cast<std::intptr_t>(branchTarget) - static_cast<std::intptr_t>(sourceVa)));

                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-EDGE-CODE144]", sourceVa, 64, 96);
            }
        }

        // No direct branch to the writer means the set-to-1 instruction is most likely
        // reached by fall-through.  Copy a small local window and look for conditional
        // branches immediately before it whose TAKEN path skips over the writer.  The
        // writer then belongs to the opposite/fall-through condition.  This is still a
        // candidate-only byte scan; it never decodes or executes from live game memory.
        constexpr std::size_t kLocalBefore = 0x80u;
        constexpr std::size_t kLocalAfter = 0x80u;
        constexpr std::size_t kLocalBytes = kLocalBefore + kLocalAfter;
        unsigned skipHits = 0;
        const std::uintptr_t localBegin = targetVa >= textBegin + kLocalBefore ? targetVa - kLocalBefore : textBegin;
        const std::uintptr_t localEndWanted = targetVa + kLocalAfter;
        const std::uintptr_t localEnd = (std::min)(textEnd, localEndWanted);
        const std::size_t localSize = localEnd > localBegin ? static_cast<std::size_t>(localEnd - localBegin) : 0u;
        unsigned char local[kLocalBytes]{};
        if (localSize && localSize <= kLocalBytes && ServerEmuSafeReadBytes(reinterpret_cast<const void*>(localBegin), local, localSize))
        {
            char localHex[kLocalBytes * 3u + 1u]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < localSize && used + 4u < ArrayCount(localHex); ++i)
                used += static_cast<std::size_t>(_snprintf_s(localHex + used, ArrayCount(localHex) - used, _TRUNCATE, "%02X ", local[i]));

            InternalLog("[DW-AUTH-RESET-LOCAL144] targetRva=0x%llX startRva=0x%llX bytes=%s copiedBytes=yes\r\n",
                static_cast<unsigned long long>(kSetOneRva),
                static_cast<unsigned long long>(localBegin - base), localHex);
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-RESET-LOCAL144] targetRva=0x%llX startRva=0x%llX bytes=%s copiedBytes=yes no_code_patching=yes\r\n",
                static_cast<unsigned long long>(kSetOneRva),
                static_cast<unsigned long long>(localBegin - base), localHex);

            const std::size_t targetOffset = static_cast<std::size_t>(targetVa - localBegin);
            const std::size_t searchFirst = targetOffset > 0x60u ? targetOffset - 0x60u : 0u;
            for (std::size_t i = searchFirst; i < targetOffset && skipHits < 16u; ++i)
            {
                const unsigned char opcode = local[i];
                std::size_t length = 0;
                std::intptr_t relative = 0;
                const char* kind = nullptr;
                const char* condition = nullptr;

                if (opcode >= 0x70u && opcode <= 0x7Fu && i + 2u <= localSize)
                {
                    static const char* kJcc8[16] = {
                        "JO","JNO","JB","JAE","JE","JNE","JBE","JA",
                        "JS","JNS","JP","JNP","JL","JGE","JLE","JG"
                    };
                    length = 2u;
                    relative = static_cast<std::int8_t>(local[i + 1u]);
                    kind = "JCC_REL8";
                    condition = kJcc8[opcode - 0x70u];
                }
                else if (opcode == 0x0Fu && i + 6u <= localSize && local[i + 1u] >= 0x80u && local[i + 1u] <= 0x8Fu)
                {
                    static const char* kJcc32[16] = {
                        "JO","JNO","JB","JAE","JE","JNE","JBE","JA",
                        "JS","JNS","JP","JNP","JL","JGE","JLE","JG"
                    };
                    std::int32_t rel32 = 0;
                    memcpy(&rel32, local + i + 2u, sizeof(rel32));
                    length = 6u;
                    relative = rel32;
                    kind = "JCC_REL32";
                    condition = kJcc32[local[i + 1u] - 0x80u];
                }
                else if (opcode >= 0xE0u && opcode <= 0xE3u && i + 2u <= localSize)
                {
                    static const char* kLoopKinds[4] = { "LOOPNE", "LOOPE", "LOOP", "JRCXZ" };
                    length = 2u;
                    relative = static_cast<std::int8_t>(local[i + 1u]);
                    kind = "LOOP_REL8";
                    condition = kLoopKinds[opcode - 0xE0u];
                }
                else
                {
                    continue;
                }

                const std::uintptr_t sourceVa = localBegin + i;
                const std::uintptr_t fallthroughVa = sourceVa + length;
                const std::uintptr_t branchTarget = fallthroughVa + relative;
                if (fallthroughVa > targetVa || targetVa - fallthroughVa > 0x30u)
                    continue;
                if (branchTarget <= targetVa || branchTarget > targetVa + 0x100u)
                    continue;

                ++skipHits;
                InternalLog("[DW-AUTH-RESET-SKIP144] hit=%u kind=%s condition=%s sourceRva=0x%llX fallthroughRva=0x%llX set1Rva=0x%llX takenTargetRva=0x%llX set1Path=FALLTHROUGH candidateOnly=yes copiedBytes=yes\r\n",
                    skipHits, kind, condition,
                    static_cast<unsigned long long>(sourceVa - base),
                    static_cast<unsigned long long>(fallthroughVa - base),
                    static_cast<unsigned long long>(kSetOneRva),
                    static_cast<unsigned long long>(branchTarget - base));
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-SKIP144] hit=%u kind=%s condition=%s sourceRva=0x%llX fallthroughRva=0x%llX set1Rva=0x%llX takenTargetRva=0x%llX set1Path=FALLTHROUGH candidateOnly=yes copiedBytes=yes no_code_patching=yes\r\n",
                    skipHits, kind, condition,
                    static_cast<unsigned long long>(sourceVa - base),
                    static_cast<unsigned long long>(fallthroughVa - base),
                    static_cast<unsigned long long>(kSetOneRva),
                    static_cast<unsigned long long>(branchTarget - base));
            }
        }
        else
        {
            InternalLog("[DW-AUTH-RESET-LOCAL144] unreadable local window targetRva=0x%llX copiedBytes=no\r\n",
                static_cast<unsigned long long>(kSetOneRva));
        }

        InternalLog("[DW-AUTH-RESET-EDGE144] COMPLETE hits=%u skipOverHits=%u unreadableChunks=%u next=decode_fallthrough_condition_feeding_set1 mode=SAFE_COPIED_BYTES_ONLY no_code_patching=yes stateWrites=off\r\n",
            hits, skipHits, unreadableChunks);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-EDGE144] COMPLETE hits=%u skipOverHits=%u unreadableChunks=%u next=decode_fallthrough_condition_feeding_set1 mode=SAFE_COPIED_BYTES_ONLY no_code_patching=yes stateWrites=off\r\n",
            hits, skipHits, unreadableChunks);
    }

    void ScanDwAuthResetSetterAddressRefsSafe144(std::uintptr_t base, std::uintptr_t textBegin, std::uintptr_t textEnd) noexcept
    {
        if (!base || !textBegin || textEnd <= textBegin)
            return;

        constexpr std::uintptr_t kSetterRva = 0x3C1DF30u;
        constexpr std::size_t kChunkSize = 0x1000u;
        constexpr unsigned kMaxPointerCells = 32u;
        const std::uintptr_t setterVa = base + kSetterRva;

        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView rdata{};
        ImageSectionView data{};
        if (module)
        {
            GetImageSection(module, ".rdata", rdata);
            GetImageSection(module, ".data", data);
        }
        const ImageSectionView pointerSections[2] = { rdata, data };
        const char* pointerSectionNames[2] = { ".rdata", ".data" };

        InternalLog("[DW-AUTH-RESET-PTR144] BEGIN setterRva=0x%llX mode=SAFE_COPIED_POINTER_XREF_SCAN no_code_patching=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kSetterRva));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-PTR144] BEGIN setterRva=0x%llX mode=SAFE_COPIED_POINTER_XREF_SCAN no_code_patching=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kSetterRva));

        // The setter is a tiny leaf function (MOV flag,1; RET) with no unwind metadata and
        // no direct CALL xrefs.  Find relocated function-pointer cells first; indirect
        // callback registration commonly stores the leaf address in .rdata/.data.
        std::uintptr_t pointerCells[kMaxPointerCells]{};
        unsigned pointerCellCount = 0;
        unsigned unreadableDataChunks = 0;
        for (unsigned sectionIndex = 0; sectionIndex < 2u; ++sectionIndex)
        {
            const ImageSectionView& section = pointerSections[sectionIndex];
            if (!section.begin || !section.size)
                continue;

            const std::uintptr_t sectionBegin = reinterpret_cast<std::uintptr_t>(section.begin);
            const std::uintptr_t sectionEnd = sectionBegin + section.size;
            for (std::uintptr_t chunkVa = sectionBegin; chunkVa < sectionEnd; chunkVa += kChunkSize)
            {
                const std::size_t remaining = static_cast<std::size_t>(sectionEnd - chunkVa);
                const std::size_t chunkBytes = (std::min)(kChunkSize, remaining);
                unsigned char bytes[kChunkSize]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, chunkBytes))
                {
                    ++unreadableDataChunks;
                    continue;
                }

                for (std::size_t i = 0; i + sizeof(std::uintptr_t) <= chunkBytes; i += sizeof(std::uintptr_t))
                {
                    std::uintptr_t value = 0;
                    memcpy(&value, bytes + i, sizeof(value));
                    if (value != setterVa)
                        continue;

                    const std::uintptr_t cellVa = chunkVa + i;
                    bool duplicate = false;
                    for (unsigned n = 0; n < pointerCellCount; ++n)
                    {
                        if (pointerCells[n] == cellVa)
                        {
                            duplicate = true;
                            break;
                        }
                    }
                    if (duplicate || pointerCellCount >= kMaxPointerCells)
                        continue;

                    pointerCells[pointerCellCount++] = cellVa;
                    InternalLog("[DW-AUTH-RESET-PTR144] pointerCell=%u cellRva=0x%llX valueRva=0x%llX section=%s relocatedVa=yes copiedBytes=yes\r\n",
                        pointerCellCount,
                        static_cast<unsigned long long>(cellVa - base),
                        static_cast<unsigned long long>(kSetterRva),
                        pointerSectionNames[sectionIndex]);
                    ServerEmuAppend(L"dw_auth_result.log",
                        "[DW-AUTH-RESET-PTR144] pointerCell=%u cellRva=0x%llX valueRva=0x%llX section=%s relocatedVa=yes copiedBytes=yes no_code_patching=yes\r\n",
                        pointerCellCount,
                        static_cast<unsigned long long>(cellVa - base),
                        static_cast<unsigned long long>(kSetterRva),
                        pointerSectionNames[sectionIndex]);
                }
            }
        }

        unsigned directAddressRefs = 0;
        unsigned pointerCellRefs = 0;
        unsigned movImm64Refs = 0;
        unsigned unreadableTextChunks = 0;

        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += kChunkSize)
        {
            const std::size_t remaining = static_cast<std::size_t>(textEnd - chunkVa);
            const std::size_t chunkBytes = (std::min)(kChunkSize, remaining);
            unsigned char bytes[kChunkSize]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, chunkBytes))
            {
                ++unreadableTextChunks;
                continue;
            }

            for (std::size_t i = 0; i < chunkBytes; ++i)
            {
                const std::uintptr_t sourceVa = chunkVa + i;
                std::uintptr_t referencedVa = 0;
                std::size_t length = 0;
                const char* kind = nullptr;

                // REX + LEA/MOV r64,[RIP+disp32].  LEA can take the setter address
                // directly; MOV can load a callback pointer from a table cell.
                if (i + 7u <= chunkBytes && bytes[i] >= 0x40u && bytes[i] <= 0x4Fu &&
                    (bytes[i + 1u] == 0x8Du || bytes[i + 1u] == 0x8Bu) &&
                    (bytes[i + 2u] & 0xC7u) == 0x05u)
                {
                    std::int32_t disp = 0;
                    memcpy(&disp, bytes + i + 3u, sizeof(disp));
                    length = 7u;
                    referencedVa = sourceVa + length + disp;
                    kind = bytes[i + 1u] == 0x8Du ? "REX_LEA_RIP" : "REX_MOV_RIP_LOAD";
                }
                // Non-REX LEA/MOV r32,[RIP+disp32].  Keep as candidate-only because
                // 32-bit destination semantics may not represent a callable pointer.
                else if (i + 6u <= chunkBytes && (bytes[i] == 0x8Du || bytes[i] == 0x8Bu) &&
                    (bytes[i + 1u] & 0xC7u) == 0x05u)
                {
                    std::int32_t disp = 0;
                    memcpy(&disp, bytes + i + 2u, sizeof(disp));
                    length = 6u;
                    referencedVa = sourceVa + length + disp;
                    kind = bytes[i] == 0x8Du ? "LEA_RIP" : "MOV_RIP_LOAD";
                }
                // MOV r64, imm64 may materialize a callback address directly.
                else if (i + 10u <= chunkBytes && bytes[i] >= 0x48u && bytes[i] <= 0x4Fu &&
                    bytes[i + 1u] >= 0xB8u && bytes[i + 1u] <= 0xBFu)
                {
                    std::uintptr_t imm = 0;
                    memcpy(&imm, bytes + i + 2u, sizeof(imm));
                    if (imm != setterVa)
                        continue;
                    length = 10u;
                    referencedVa = imm;
                    kind = "MOV_R64_IMM64";
                    ++movImm64Refs;
                }
                else
                {
                    continue;
                }

                bool directSetter = referencedVa == setterVa;
                unsigned cellIndex = 0;
                if (!directSetter)
                {
                    for (unsigned n = 0; n < pointerCellCount; ++n)
                    {
                        if (referencedVa == pointerCells[n])
                        {
                            cellIndex = n + 1u;
                            break;
                        }
                    }
                    if (!cellIndex)
                        continue;
                }

                std::uintptr_t functionBegin = 0;
                std::uintptr_t functionEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(sourceVa, functionBegin, functionEnd);
                if (directSetter)
                    ++directAddressRefs;
                else
                    ++pointerCellRefs;

                InternalLog("[DW-AUTH-RESET-PTR-XREF144] kind=%s sourceRva=0x%llX target=%s targetRva=0x%llX cellIndex=%u function=0x%llX..0x%llX unwind=%s candidateOnly=yes copiedBytes=yes\r\n",
                    kind ? kind : "?",
                    static_cast<unsigned long long>(sourceVa - base),
                    directSetter ? "SETTER" : "POINTER_CELL",
                    static_cast<unsigned long long>(referencedVa - base),
                    cellIndex,
                    static_cast<unsigned long long>(functionBegin ? functionBegin - base : 0u),
                    static_cast<unsigned long long>(functionEnd ? functionEnd - base : 0u),
                    bounded ? "yes" : "no");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-PTR-XREF144] kind=%s sourceRva=0x%llX target=%s targetRva=0x%llX cellIndex=%u function=0x%llX..0x%llX unwind=%s candidateOnly=yes copiedBytes=yes no_code_patching=yes\r\n",
                    kind ? kind : "?",
                    static_cast<unsigned long long>(sourceVa - base),
                    directSetter ? "SETTER" : "POINTER_CELL",
                    static_cast<unsigned long long>(referencedVa - base),
                    cellIndex,
                    static_cast<unsigned long long>(functionBegin ? functionBegin - base : 0u),
                    static_cast<unsigned long long>(functionEnd ? functionEnd - base : 0u),
                    bounded ? "yes" : "no");

                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-PTR-CODE144]", sourceVa, 64, 96);
            }
        }

        InternalLog("[DW-AUTH-RESET-PTR144] COMPLETE pointerCells=%u directAddressRefs=%u pointerCellRefs=%u movImm64Refs=%u unreadable={text:%u dataSections:%u} next=classify_indirect_reset_callback_registration no_code_patching=yes stateWrites=off\r\n",
            pointerCellCount, directAddressRefs, pointerCellRefs, movImm64Refs,
            unreadableTextChunks, unreadableDataChunks);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-PTR144] COMPLETE pointerCells=%u directAddressRefs=%u pointerCellRefs=%u movImm64Refs=%u unreadable={text:%u dataSections:%u} next=classify_indirect_reset_callback_registration no_code_patching=yes stateWrites=off\r\n",
            pointerCellCount, directAddressRefs, pointerCellRefs, movImm64Refs,
            unreadableTextChunks, unreadableDataChunks);
    }

    void ScanDwAuthResetFlagXrefs144(std::uintptr_t base, std::uintptr_t textBegin, std::uintptr_t textEnd) noexcept
    {
        if (!base || !textBegin || textEnd <= textBegin)
            return;

        const std::uintptr_t targetVa = base + kDwAuthResetFlagRva144;
        struct ScanRange144 { std::uintptr_t firstRva; std::uintptr_t lastRva; const char* label; };
        const ScanRange144 ranges[] = {
            { 0x00400000u, 0x00800000u, "auth3_loginqueue" },
            { 0x02C00000u, 0x02D00000u, "dw_auth_bridge" },
            { 0x03B00000u, 0x03D80000u, "dw_auth_pump" },
            { 0x04500000u, 0x04560000u, "dw_status" },
            { 0x05D00000u, 0x05E00000u, "dw_api" }
        };

        struct WriterFunction144
        {
            std::uintptr_t begin = 0;
            std::uintptr_t end = 0;
        };
        WriterFunction144 writers[16]{};
        unsigned writerCount = 0;
        unsigned refs = 0;
        unsigned writeRefs = 0;

        InternalLog("[DW-AUTH-RESET-XREF144] BEGIN targetRva=0x%llX source=observed_0_to_1_before_status_reset mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            static_cast<unsigned long long>(kDwAuthResetFlagRva144));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-XREF144] BEGIN targetRva=0x%llX source=observed_0_to_1_before_status_reset mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
            static_cast<unsigned long long>(kDwAuthResetFlagRva144));

        for (const auto& range : ranges)
        {
            const std::uintptr_t rangeBegin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t rangeEnd = (std::min)(textEnd, base + range.lastRva);
            if (rangeEnd <= rangeBegin)
                continue;

            for (std::uintptr_t cursor = rangeBegin; cursor + 12u <= rangeEnd && refs < 64u; ++cursor)
            {
                const auto* p = reinterpret_cast<const unsigned char*>(cursor);
                std::size_t pos = 0;
                if ((p[0] & 0xF0u) == 0x40u)
                    pos = 1u;

                const unsigned char opcode = p[pos];
                std::size_t dispOffset = 0;
                std::size_t instructionLength = 0;
                const char* op = nullptr;
                const char* access = nullptr;
                bool hasImmediate = false;
                std::uint32_t immediate = 0;

                const auto ripModRm = [](unsigned char modrm) noexcept -> bool
                {
                    return (modrm & 0xC7u) == 0x05u;
                };

                if ((opcode == 0x8Du || opcode == 0x8Bu || opcode == 0x89u || opcode == 0x8Au || opcode == 0x88u ||
                     opcode == 0x86u || opcode == 0x87u) && ripModRm(p[pos + 1u]))
                {
                    dispOffset = pos + 2u;
                    instructionLength = pos + 6u;
                    if (opcode == 0x8Du) { op = "LEA_RIP"; access = "ADDRESS"; }
                    else if (opcode == 0x89u) { op = "MOV_RIP_WRITE"; access = "WRITE"; }
                    else if (opcode == 0x88u) { op = "MOV8_RIP_WRITE"; access = "WRITE"; }
                    else if (opcode == 0x86u) { op = "XCHG8_RIP"; access = "READWRITE"; }
                    else if (opcode == 0x87u) { op = "XCHG_RIP"; access = "READWRITE"; }
                    else if (opcode == 0x8Au) { op = "MOV8_RIP_READ"; access = "READ"; }
                    else { op = "MOV_RIP_READ"; access = "READ"; }
                }
                else if (opcode == 0x0Fu &&
                    (p[pos + 1u] == 0xB6u || p[pos + 1u] == 0xB7u || p[pos + 1u] == 0xBEu || p[pos + 1u] == 0xBFu) &&
                    ripModRm(p[pos + 2u]))
                {
                    dispOffset = pos + 3u;
                    instructionLength = pos + 7u;
                    op = "MOVX_RIP_READ";
                    access = "READ";
                }
                else if ((opcode == 0xC6u || opcode == 0xC7u) && ripModRm(p[pos + 1u]) && ((p[pos + 1u] >> 3) & 7u) == 0u)
                {
                    dispOffset = pos + 2u;
                    instructionLength = pos + (opcode == 0xC6u ? 7u : 10u);
                    op = opcode == 0xC6u ? "MOV8_IMM_RIP_WRITE" : "MOV32_IMM_RIP_WRITE";
                    access = "WRITE";
                    hasImmediate = true;
                    if (opcode == 0xC6u)
                        immediate = p[pos + 6u];
                    else
                        memcpy(&immediate, p + pos + 6u, sizeof(immediate));
                }
                else if ((opcode == 0x80u || opcode == 0x81u || opcode == 0x83u) && ripModRm(p[pos + 1u]))
                {
                    const unsigned group = (p[pos + 1u] >> 3) & 7u;
                    dispOffset = pos + 2u;
                    instructionLength = pos + (opcode == 0x81u ? 10u : 7u);
                    op = group == 7u ? "CMP_RIP_IMM" : "GRP1_RIP_IMM";
                    access = group == 7u ? "READ" : "READWRITE";
                    hasImmediate = true;
                    if (opcode == 0x81u)
                        memcpy(&immediate, p + pos + 6u, sizeof(immediate));
                    else
                        immediate = p[pos + 6u];
                }
                else if ((opcode == 0xFEu || opcode == 0xFFu) && ripModRm(p[pos + 1u]))
                {
                    const unsigned group = (p[pos + 1u] >> 3) & 7u;
                    dispOffset = pos + 2u;
                    instructionLength = pos + 6u;
                    op = opcode == 0xFEu ? "FE_RIP" : "FF_RIP";
                    access = (group == 0u || group == 1u) ? "READWRITE" : "READ";
                }
                else
                {
                    continue;
                }

                std::int32_t rel = 0;
                memcpy(&rel, p + dispOffset, sizeof(rel));
                const std::uintptr_t resolved = cursor + instructionLength + static_cast<std::intptr_t>(rel);
                if (resolved != targetVa)
                    continue;

                ++refs;
                const bool isWrite = strcmp(access, "WRITE") == 0 || strcmp(access, "READWRITE") == 0;
                if (isWrite)
                    ++writeRefs;

                std::uintptr_t functionBegin = 0;
                std::uintptr_t functionEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(cursor, functionBegin, functionEnd);
                if (!bounded)
                {
                    functionBegin = cursor > textBegin + 0x80u ? cursor - 0x80u : textBegin;
                    functionEnd = (std::min)(textEnd, cursor + static_cast<std::uintptr_t>(0x300));
                }

                if (isWrite && bounded && writerCount < ArrayCount(writers))
                {
                    bool duplicate = false;
                    for (unsigned i = 0; i < writerCount; ++i)
                        duplicate = duplicate || writers[i].begin == functionBegin;
                    if (!duplicate)
                    {
                        writers[writerCount].begin = functionBegin;
                        writers[writerCount].end = functionEnd;
                        ++writerCount;
                    }
                }

                InternalLog("[DW-AUTH-RESET-XREF144] hit=%u range=%s instructionRva=0x%llX op=%s access=%s immediate=%s0x%X function=0x%llX..0x%llX unwind=%s\r\n",
                    refs, range.label, static_cast<unsigned long long>(cursor - base), op, access,
                    hasImmediate ? "" : "n/a/", hasImmediate ? immediate : 0u,
                    static_cast<unsigned long long>(functionBegin - base),
                    static_cast<unsigned long long>(functionEnd - base), bounded ? "yes" : "no");
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-XREF144] hit=%u range=%s instructionRva=0x%llX op=%s access=%s immediate=%s0x%X function=0x%llX..0x%llX unwind=%s mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                    refs, range.label, static_cast<unsigned long long>(cursor - base), op, access,
                    hasImmediate ? "" : "n/a/", hasImmediate ? immediate : 0u,
                    static_cast<unsigned long long>(functionBegin - base),
                    static_cast<unsigned long long>(functionEnd - base), bounded ? "yes" : "no");
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-XREF-CODE144]", cursor, 96, 144);
            }
        }

        unsigned directCallers = 0;
        for (const auto& range : ranges)
        {
            const std::uintptr_t rangeBegin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t rangeEnd = (std::min)(textEnd, base + range.lastRva);
            if (rangeEnd <= rangeBegin)
                continue;
            for (std::uintptr_t cursor = rangeBegin; cursor + 5u <= rangeEnd && directCallers < 64u; ++cursor)
            {
                const auto* p = reinterpret_cast<const unsigned char*>(cursor);
                if (p[0] != 0xE8u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, p + 1u, sizeof(rel));
                const std::uintptr_t callTarget = cursor + 5u + static_cast<std::intptr_t>(rel);
                int writerIndex = -1;
                for (unsigned i = 0; i < writerCount; ++i)
                {
                    if (writers[i].begin == callTarget)
                    {
                        writerIndex = static_cast<int>(i);
                        break;
                    }
                }
                if (writerIndex < 0)
                    continue;

                ++directCallers;
                std::uintptr_t callerBegin = 0;
                std::uintptr_t callerEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(cursor, callerBegin, callerEnd);
                const auto hints = ScanDwStatusCallerArgHints144(cursor);
                InternalLog("[DW-AUTH-RESET-CALLER144] hit=%u range=%s callRva=0x%llX writerRva=0x%llX caller=0x%llX..0x%llX arg21=%s/%s arg1=%s/%s mode=STATIC_READ_ONLY\r\n",
                    directCallers, range.label, static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(writers[static_cast<unsigned>(writerIndex)].begin - base),
                    static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                    static_cast<unsigned long long>(bounded ? callerEnd - base : 0),
                    hints.found21 ? "YES" : "no", hints.reg21,
                    hints.found1 ? "yes" : "no", hints.reg1);
                ServerEmuAppend(L"dw_auth_result.log",
                    "[DW-AUTH-RESET-CALLER144] hit=%u range=%s callRva=0x%llX writerRva=0x%llX caller=0x%llX..0x%llX unwind=%s arg21=%s/%s arg1=%s/%s mode=STATIC_READ_ONLY no_code_patching=yes\r\n",
                    directCallers, range.label, static_cast<unsigned long long>(cursor - base),
                    static_cast<unsigned long long>(writers[static_cast<unsigned>(writerIndex)].begin - base),
                    static_cast<unsigned long long>(bounded ? callerBegin - base : 0),
                    static_cast<unsigned long long>(bounded ? callerEnd - base : 0), bounded ? "yes" : "no",
                    hints.found21 ? "YES" : "no", hints.reg21,
                    hints.found1 ? "yes" : "no", hints.reg1);
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-RESET-CALLER-CODE144]", cursor, 96, 144);
            }
        }

        // Keep the old CFG/fall-through scanners disabled. v11 proved the set-to-1
        // RVA is a tiny standalone leaf setter, so trace address-taken/pointer-table
        // references to that function instead of interpreting bytes before it as code.
        InternalLog("[DW-AUTH-RESET-CFG144] DISABLED reason=startup_crash_safety replacement=SAFE_POINTER_XREF_SCAN no_code_patching=yes stateWrites=off\r\n");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-CFG144] DISABLED reason=startup_crash_safety replacement=SAFE_POINTER_XREF_SCAN no_code_patching=yes stateWrites=off\r\n");
        InternalLog("[DW-AUTH-RESET-EDGE144] DISABLED reason=v11_false_positive_pre_function_bytes replacement=SAFE_POINTER_XREF_SCAN no_code_patching=yes stateWrites=off\r\n");
        ScanDwAuthResetSetterAddressRefsSafe144(base, textBegin, textEnd);

        InternalLog("[DW-AUTH-RESET-XREF144] COMPLETE refs=%u writeRefs=%u uniqueWriterFunctions=%u directCallers=%u next=classify_reset_writer_and_auth3_failure_path stateWrites=off no_code_patching=yes\r\n",
            refs, writeRefs, writerCount, directCallers);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-RESET-XREF144] COMPLETE refs=%u writeRefs=%u uniqueWriterFunctions=%u directCallers=%u next=classify_reset_writer_and_auth3_failure_path stateWrites=off no_code_patching=yes\r\n",
            refs, writeRefs, writerCount, directCallers);
    }

    void ScanDwStatusSetWriters144(std::uintptr_t base) noexcept
    {
        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView text{};
        if (!base || !module || !GetImageSection(module, ".text", text) || !text.begin || !text.size)
            return;

        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        const std::uintptr_t stateBaseVa = base + kDwControllerStateBaseRva144;
        unsigned baseXrefs = 0;
        unsigned countWriterHits = 0;

        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SET-XREF144] BEGIN stateBaseRva=0x%llX stride=0x%llX countOffset=+0x%llX entryBase=+0x%llX mode=STATIC_READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwControllerStateBaseRva144),
            static_cast<unsigned long long>(kDwControllerStateStride144),
            static_cast<unsigned long long>(kDwStatusEntryCountOffset144),
            static_cast<unsigned long long>(kDwStatusEntryBaseOffset144));
        InternalLog("[DW-AUTH-SET-XREF144] BEGIN stateBaseRva=0x%llX stride=0x%llX target=status_set_mutator_discovery read_only=yes\r\n",
            static_cast<unsigned long long>(kDwControllerStateBaseRva144),
            static_cast<unsigned long long>(kDwControllerStateStride144));

        // Find exact RIP-relative references to the controller-state array base.
        // Keep this focused to the known IW8 DW/auth neighborhoods so this
        // research pass cannot recreate the old full-.text startup stalls.
        struct ScanRange144 { std::uintptr_t firstRva; std::uintptr_t lastRva; };
        const ScanRange144 ranges[] = {
            { 0x3C00000u, 0x3D80000u },
            { 0x4500000u, 0x4560000u },
            { 0x5D00000u, 0x5E00000u }
        };
        for (const auto& range : ranges)
        {
            const std::uintptr_t rangeBegin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t rangeEnd = (std::min)(textEnd, base + range.lastRva);
            for (std::uintptr_t cursor = rangeBegin; cursor + 8u <= rangeEnd && baseXrefs < 64u; ++cursor)
            {
                unsigned char b[8]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                    continue;

            std::size_t dispOffset = 0;
            std::size_t instructionLength = 0;
            const char* op = nullptr;
            if ((b[0] & 0xF0u) == 0x40u && b[1] == 0x8Du && (b[2] & 0xC7u) == 0x05u)
            {
                dispOffset = 3u;
                instructionLength = 7u;
                op = "LEA_RIP";
            }
            else if (b[0] == 0x8Du && (b[1] & 0xC7u) == 0x05u)
            {
                dispOffset = 2u;
                instructionLength = 6u;
                op = "LEA32_RIP";
            }
            else
            {
                continue;
            }

            std::int32_t rel = 0;
            memcpy(&rel, b + dispOffset, sizeof(rel));
            const std::uintptr_t target = cursor + instructionLength + static_cast<std::intptr_t>(rel);
            if (target != stateBaseVa)
                continue;

            ++baseXrefs;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(cursor, functionBegin, functionEnd);
            if (!bounded)
            {
                functionBegin = cursor > textBegin + 0x80u ? cursor - 0x80u : textBegin;
                functionEnd = (std::min)(textEnd, cursor + static_cast<std::uintptr_t>(0x300));
            }
            const bool hasStride = DwStatusFunctionContainsImmediate144(functionBegin, functionEnd,
                static_cast<std::uint32_t>(kDwControllerStateStride144));
            const bool has21 = DwStatusFunctionContainsImmediate144(functionBegin, functionEnd, 0x21u);
            const bool hasCountWrite = DwStatusFunctionHasCountWrite144(functionBegin, functionEnd);

            InternalLog("[DW-AUTH-SET-XREF144] baseHit=%u op=%s instructionRva=0x%llX function=0x%llX..0x%llX unwind=%s stride2130=%s imm21=%s count80Write=%s\r\n",
                baseXrefs, op,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(functionBegin - base),
                static_cast<unsigned long long>(functionEnd - base),
                bounded ? "yes" : "no", hasStride ? "yes" : "no",
                has21 ? "yes" : "no", hasCountWrite ? "YES" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-SET-XREF144] baseHit=%u op=%s instructionRva=0x%llX function=0x%llX..0x%llX unwind=%s stride2130=%s imm21=%s count80Write=%s\r\n",
                baseXrefs, op,
                static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(functionBegin - base),
                static_cast<unsigned long long>(functionEnd - base),
                bounded ? "yes" : "no", hasStride ? "yes" : "no",
                has21 ? "yes" : "no", hasCountWrite ? "YES" : "no");
                AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-SET-XREF-CODE144]", cursor, 80, 112);
            }
        }

        // The collection helpers themselves receive the object pointer, so they
        // may not contain an RIP-relative reference to the global array. Search a
        // tight neighborhood around the confirmed predicate for writes to +0x80.
        const std::uintptr_t nearBegin = base + (kDwStatusPredicateRva144 > 0x8000u ? kDwStatusPredicateRva144 - 0x8000u : 0u);
        const std::uintptr_t nearEnd = (std::min)(textEnd, base + kDwStatusPredicateRva144 + static_cast<std::uintptr_t>(0x8000));
        for (std::uintptr_t cursor = (std::max)(textBegin, nearBegin); cursor + 10u <= nearEnd && countWriterHits < 48u; ++cursor)
        {
            unsigned char b[10]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            bool isWrite = false;
            std::size_t dispOffset = 0;
            if ((b[0] == 0x89u || b[0] == 0xC7u || b[0] == 0xFFu) && (b[1] & 0xC0u) == 0x80u)
            {
                isWrite = true;
                dispOffset = 2u;
            }
            else if ((b[0] & 0xF0u) == 0x40u &&
                (b[1] == 0x89u || b[1] == 0xC7u || b[1] == 0xFFu) &&
                (b[2] & 0xC0u) == 0x80u)
            {
                isWrite = true;
                dispOffset = 3u;
            }
            if (!isWrite)
                continue;

            std::int32_t disp = 0;
            memcpy(&disp, b + dispOffset, sizeof(disp));
            if (disp != static_cast<std::int32_t>(kDwStatusEntryCountOffset144))
                continue;

            ++countWriterHits;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(cursor, functionBegin, functionEnd);
            if (!bounded)
            {
                functionBegin = cursor > textBegin + 0x80u ? cursor - 0x80u : textBegin;
                functionEnd = (std::min)(textEnd, cursor + static_cast<std::uintptr_t>(0x300));
            }
            if (bounded)
                RegisterDwStatusMutatorCandidate144(base, functionBegin, functionEnd);
            const bool has21 = DwStatusFunctionContainsImmediate144(functionBegin, functionEnd, 0x21u);
            InternalLog("[DW-AUTH-SET-WRITER144] hit=%u instructionRva=0x%llX function=0x%llX..0x%llX unwind=%s imm21=%s displacement=+0x80 mode=STATIC_READ_ONLY\r\n",
                countWriterHits, static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(functionBegin - base),
                static_cast<unsigned long long>(functionEnd - base),
                bounded ? "yes" : "no", has21 ? "yes" : "no");
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-SET-WRITER144] hit=%u instructionRva=0x%llX function=0x%llX..0x%llX unwind=%s imm21=%s displacement=+0x80 mode=STATIC_READ_ONLY\r\n",
                countWriterHits, static_cast<unsigned long long>(cursor - base),
                static_cast<unsigned long long>(functionBegin - base),
                static_cast<unsigned long long>(functionEnd - base),
                bounded ? "yes" : "no", has21 ? "yes" : "no");
            AppendCodeBytes144(L"dw_auth_result.log", "[DW-AUTH-SET-WRITER-CODE144]", cursor, 96, 128);
        }

        InternalLog("[DW-AUTH-MUTATOR144] PREP uniqueBoundedFunctions=%u source=confirmed_+0x80_writer_functions next=static_caller_argument_scan stateWrites=off no_code_patching=yes\r\n",
            g_dwStatusMutatorBreakpointCount144);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-MUTATOR144] PREP uniqueBoundedFunctions=%u source=confirmed_+0x80_writer_functions next=static_caller_argument_scan stateWrites=off no_code_patching=yes\r\n",
            g_dwStatusMutatorBreakpointCount144);
        ArmDwStatusMutatorProbe144();
        ScanDwStatusMutatorCallers144(base, textBegin, textEnd);
        ScanDwAuthResetFlagXrefs144(base, textBegin, textEnd);

        InternalLog("[DW-AUTH-SET-XREF144] COMPLETE baseXrefs=%u nearbyCountWriters=%u output=dw_auth_result.log next=correlate_auth3_with_static_status_mutator_callers stateWrites=off no_code_patching=yes\r\n",
            baseXrefs, countWriterHits);
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SET-XREF144] COMPLETE baseXrefs=%u nearbyCountWriters=%u next=correlate_auth3_with_static_status_mutator_callers stateWrites=off no_code_patching=yes\r\n",
            baseXrefs, countWriterHits);
    }

    void LogDwStatusTopology144(std::uintptr_t base) noexcept
    {
        // Exact 1.44 disassembly, read-only semantics:
        //   dwGetLogOnStatus(controller)
        //     if predicate(controllerState, 0x21) -> 2
        //     else if predicate(controllerState, 1) -> 0
        //     else -> 1
        InternalLog("[DW-AUTH-STATUS144] topology getter=0x%llX predicate=0x%llX stateBase=0x%llX stride=0x%llX semantics={pred_0x21:true=>2,pred_1:true=>0,neither=>1} observed_target=2 mode=READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwGetLogOnStatusRva144),
            static_cast<unsigned long long>(kDwStatusPredicateRva144),
            static_cast<unsigned long long>(kDwControllerStateBaseRva144),
            static_cast<unsigned long long>(kDwControllerStateStride144));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-STATUS144] topology getter=0x%llX predicate=0x%llX stateBase=0x%llX stride=0x%llX semantics={pred_0x21:true=>2,pred_1:true=>0,neither=>1} observed_target=2 mode=READ_ONLY\r\n",
            static_cast<unsigned long long>(kDwGetLogOnStatusRva144),
            static_cast<unsigned long long>(kDwStatusPredicateRva144),
            static_cast<unsigned long long>(kDwControllerStateBaseRva144),
            static_cast<unsigned long long>(kDwControllerStateStride144));

        // Dump the predicate helper's opening bytes so the next run can identify
        // which controller-object offsets implement states 0x21 and 1 without
        // executing the helper or changing its result.
        if (kDwStatusPredicateRva144 < MainImageSize())
        {
            char hex[192 * 3 + 1]{};
            std::size_t used = 0;
            __try
            {
                const auto* bytes = reinterpret_cast<const unsigned char*>(base + kDwStatusPredicateRva144);
                for (std::size_t i = 0; i < 192u && used + 4u < ArrayCount(hex); ++i)
                    used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", bytes[i]));
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                strcpy_s(hex, "<unreadable>");
            }
            InternalLog("[DW-AUTH-STATUS144] predicateCode rva=0x%llX bytes=%s\r\n",
                static_cast<unsigned long long>(kDwStatusPredicateRva144), hex);
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-AUTH-STATUS144] predicateCode rva=0x%llX bytes=%s\r\n",
                static_cast<unsigned long long>(kDwStatusPredicateRva144), hex);
        }
    }

    DWORD WINAPI DwAuthResultSamplerThread144(LPVOID) noexcept
    {
