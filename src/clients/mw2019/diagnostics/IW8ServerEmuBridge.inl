    int WSAAPI ServerEmuWSARecv(SOCKET socket, LPWSABUF buffers, DWORD bufferCount, LPDWORD received, LPDWORD flags, LPWSAOVERLAPPED overlapped, LPWSAOVERLAPPED_COMPLETION_ROUTINE completion) noexcept
    {
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        RecordServerEmuCaller("WSARecv", caller);

        char local[128]{};
        char peer[128]{};
        SocketEndpointsToText(socket, local, ArrayCount(local), peer, ArrayCount(peer));
        const bool bgs1119 = SocketPeerUsesPort(socket, 1119);
        const bool rawTls443 = SocketPeerUsesPort(socket, 443);
        if (rawTls443 && !kServerEmuProductionRuntimeV92)
            CaptureRawTlsGameStack144("TLS443-WSARECV", caller);
        std::size_t requestedBytes = 0;
        for (DWORD i = 0; buffers && i < bufferCount; ++i)
            requestedBytes += buffers[i].len;
        if (overlapped)
            RememberPendingRecv(socket, buffers, bufferCount, overlapped, caller);
        if (bgs1119)
            InternalLog("[BGS1119] WSARecv QUEUE socket=%llu requested=%llu buffers=%u overlapped=%p completion=%p local=%s peer=%s\r\n",
                static_cast<unsigned long long>(socket), static_cast<unsigned long long>(requestedBytes),
                static_cast<unsigned>(bufferCount), overlapped, completion, local, peer);

        const int result = g_wsaRecvOriginal ? g_wsaRecvOriginal(socket, buffers, bufferCount, received, flags, overlapped, completion) : SOCKET_ERROR;
        const int error = result == SOCKET_ERROR ? WSAGetLastError() : 0;
        ++g_serverEmuRecvCalls;
        if (result == 0 && received && *received && buffers && bufferCount && buffers[0].buf)
        {
            const std::size_t immediateBytes = (std::min)(static_cast<std::size_t>(*received), static_cast<std::size_t>(buffers[0].len));
            TracePayload(bgs1119 ? "BGS1119-WSARECV-IMMEDIATE" : "WSARECV", socket, buffers[0].buf, immediateBytes, caller);
            LogLsgPayloadV61("WSARECV", socket, buffers[0].buf, immediateBytes, caller);
            ForgetPendingSocketIo(overlapped);
        }
        else if (result == SOCKET_ERROR && error != WSA_IO_PENDING)
        {
            ForgetPendingSocketIo(overlapped);
        }

        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        const unsigned completedBytes = (result == 0 && received) ? static_cast<unsigned>(*received) : 0u;
        ServerEmuAppend(L"network_trace.log",
            "[WSARECV] socket=%llu local=%s peer=%s buffers=%u requested=%llu result=%d wsa=%d completedBytes=%u overlapped=%s ov=%p completion=%p caller=%s%s\r\n",
            static_cast<unsigned long long>(socket), local, peer, static_cast<unsigned>(bufferCount),
            static_cast<unsigned long long>(requestedBytes), result, error, completedBytes,
            overlapped ? "yes" : "no", overlapped, completion, where, bgs1119 ? " BGS1119" : "");
        if (bgs1119)
            InternalLog("[BGS1119] WSARecv result=%d wsa=%d completedNow=%u%s\r\n",
                result, error, completedBytes, error == WSA_IO_PENDING ? " PENDING" : "");
        if (result == SOCKET_ERROR) WSASetLastError(error);
        return result;
    }

    BOOL WSAAPI ServerEmuWSAGetOverlappedResult(SOCKET socket, LPWSAOVERLAPPED overlapped,
        LPDWORD transferred, BOOL wait, LPDWORD flags) noexcept
    {
        const BOOL result = g_wsaGetOverlappedResultOriginal
            ? g_wsaGetOverlappedResultOriginal(socket, overlapped, transferred, wait, flags)
            : FALSE;
        const int error = result ? 0 : WSAGetLastError();
        PendingSocketIo pending{};
        if (result && TakePendingSocketIo(overlapped, pending))
        {
            const DWORD bytes = transferred ? *transferred : 0;
            if (pending.recv && bytes && pending.buffer)
            {
                const std::size_t doneBytes = (std::min)(static_cast<std::size_t>(bytes), static_cast<std::size_t>(pending.bufferLength));
                TracePayload(SocketPeerUsesPort(pending.socket, 1119) ? "BGS1119-WSARECV-COMPLETE" : "WSARECV-COMPLETE",
                    pending.socket, pending.buffer, doneBytes, pending.caller);
                LogLsgPayloadV61("WSARECV_COMPLETE", pending.socket, pending.buffer, doneBytes, pending.caller);
            }
            if (SocketPeerUsesPort(pending.socket, 1119))
                InternalLog("[BGS1119] WSAGetOverlappedResult ov=%p bytes=%u wait=%s result=1\r\n",
                    overlapped, static_cast<unsigned>(bytes), wait ? "yes" : "no");
        }
        else if (SocketPeerUsesPort(socket, 1119))
        {
            InternalLog("[BGS1119] WSAGetOverlappedResult ov=%p result=%d wsa=%d wait=%s\r\n",
                overlapped, result ? 1 : 0, error, wait ? "yes" : "no");
        }
        if (!result) WSASetLastError(error);
        return result;
    }

    BOOL WINAPI ServerEmuGetQueuedCompletionStatus(HANDLE completionPort, LPDWORD transferred,
        PULONG_PTR completionKey, LPOVERLAPPED* overlapped, DWORD milliseconds) noexcept
    {
        const BOOL result = g_getQueuedCompletionStatusOriginal
            ? g_getQueuedCompletionStatusOriginal(completionPort, transferred, completionKey, overlapped, milliseconds)
            : FALSE;
        const DWORD error = result ? ERROR_SUCCESS : GetLastError();
        if (overlapped && *overlapped)
        {
            PendingSocketIo pending{};
            if (TakePendingSocketIo(reinterpret_cast<LPWSAOVERLAPPED>(*overlapped), pending))
            {
                const DWORD bytes = transferred ? *transferred : 0;
                const bool bgs1119 = SocketPeerUsesPort(pending.socket, 1119);
                if (pending.recv && bytes && pending.buffer)
                {
                    const std::size_t doneBytes = (std::min)(static_cast<std::size_t>(bytes), static_cast<std::size_t>(pending.bufferLength));
                    TracePayload(bgs1119 ? "BGS1119-IOCP-RECV" : "IOCP-RECV", pending.socket, pending.buffer, doneBytes, pending.caller);
                    LogLsgPayloadV61("IOCP_RECV", pending.socket, pending.buffer, doneBytes, pending.caller);
                }
                if (bgs1119)
                    InternalLog("[BGS1119] IOCP completion socket=%llu ov=%p bytes=%u ok=%s error=%lu key=0x%llX\r\n",
                        static_cast<unsigned long long>(pending.socket), *overlapped, static_cast<unsigned>(bytes),
                        result ? "yes" : "no", static_cast<unsigned long>(error),
                        completionKey ? static_cast<unsigned long long>(*completionKey) : 0ull);
            }
        }
        if (!result) SetLastError(error);
        return result;
    }

    bool WideContainsNoCase(const wchar_t* text, const wchar_t* needle) noexcept
    {
        if (!text || !needle || !*needle) return false;
        const std::size_t needleLen = wcslen(needle);
        for (const wchar_t* p = text; *p; ++p)
        {
            if (_wcsnicmp(p, needle, needleLen) == 0)
                return true;
        }
        return false;
    }

    bool IsBattleNetRegistryPath(const wchar_t* path) noexcept
    {
        return path && WideContainsNoCase(path, L"Blizzard Entertainment\\Battle.net");
    }

    bool LookupBNetRegistryPath(HKEY key, wchar_t* out, std::size_t outCount) noexcept
    {
        if (!key || !out || !outCount) return false;
        out[0] = L'\0';
        AcquireSRWLockShared(&g_bnetRegistryLock);
        bool found = false;
        for (const auto& entry : g_bnetRegistryHandles)
        {
            if (entry.key == key)
            {
                wcsncpy_s(out, outCount, entry.path, _TRUNCATE);
                found = true;
                break;
            }
        }
        ReleaseSRWLockShared(&g_bnetRegistryLock);
        return found;
    }

    void TrackBNetRegistryHandle(HKEY key, const wchar_t* path) noexcept
    {
        if (!key || !path || !IsBattleNetRegistryPath(path)) return;
        AcquireSRWLockExclusive(&g_bnetRegistryLock);
        BNetRegistryHandle* freeEntry = nullptr;
        for (auto& entry : g_bnetRegistryHandles)
        {
            if (entry.key == key)
            {
                wcsncpy_s(entry.path, ArrayCount(entry.path), path, _TRUNCATE);
                ReleaseSRWLockExclusive(&g_bnetRegistryLock);
                return;
            }
            if (!entry.key && !freeEntry)
                freeEntry = &entry;
        }
        if (freeEntry)
        {
            freeEntry->key = key;
            wcsncpy_s(freeEntry->path, ArrayCount(freeEntry->path), path, _TRUNCATE);
        }
        ReleaseSRWLockExclusive(&g_bnetRegistryLock);
    }

    void UntrackBNetRegistryHandle(HKEY key) noexcept
    {
        if (!key) return;
        AcquireSRWLockExclusive(&g_bnetRegistryLock);
        for (auto& entry : g_bnetRegistryHandles)
        {
            if (entry.key == key)
            {
                entry.key = nullptr;
                entry.path[0] = L'\0';
                break;
            }
        }
        ReleaseSRWLockExclusive(&g_bnetRegistryLock);
    }

    bool BuildBNetRegistryPath(HKEY parent, const wchar_t* subKey, wchar_t* out, std::size_t outCount) noexcept
    {
        if (!out || !outCount) return false;
        out[0] = L'\0';

        wchar_t parentPath[512]{};
        if (LookupBNetRegistryPath(parent, parentPath, ArrayCount(parentPath)))
        {
            if (subKey && *subKey)
                _snwprintf_s(out, outCount, _TRUNCATE, L"%s\\%s", parentPath, subKey);
            else
                wcsncpy_s(out, outCount, parentPath, _TRUNCATE);
            return IsBattleNetRegistryPath(out);
        }

        if (parent == HKEY_CURRENT_USER && subKey && IsBattleNetRegistryPath(subKey))
        {
            _snwprintf_s(out, outCount, _TRUNCATE, L"HKCU\\%s", subKey);
            return true;
        }
        if (parent == HKEY_LOCAL_MACHINE && subKey && IsBattleNetRegistryPath(subKey))
        {
            _snwprintf_s(out, outCount, _TRUNCATE, L"HKLM\\%s", subKey);
            return true;
        }
        return false;
    }

    void AnsiToWideSafe(const char* text, wchar_t* out, std::size_t outCount) noexcept
    {
        if (!out || !outCount) return;
        out[0] = L'\0';
        if (!text) return;
        const int converted = MultiByteToWideChar(CP_ACP, 0, text, -1, out, static_cast<int>(outCount));
        if (!converted)
            out[0] = L'\0';
        out[outCount - 1] = L'\0';
    }

    bool IsSensitiveBNetLaunchValue(const wchar_t* valueName) noexcept
    {
        if (!valueName || !*valueName) return false;
        return _wcsicmp(valueName, L"WEB_TOKEN") == 0 ||
            _wcsicmp(valueName, L"ACCOUNT_STATE") == 0 ||
            WideContainsNoCase(valueName, L"TOKEN") ||
            WideContainsNoCase(valueName, L"SESSION");
    }

    void DumpBNetLauncherGameStack(const wchar_t* api, const wchar_t* path, const wchar_t* valueName) noexcept
    {
        // The direct return address of RegQueryValueExW is a shared Battle.net registry helper
        // (0x6968FD on this 1.44 build), so it is identical for LOCALE/ACCOUNT_STATE/WEB_TOKEN.
        // Capture the native x64 call stack and keep only frames inside ModernWarfare.exe.
        // This reveals the *consumer above the shared helper* while registry value contents stay redacted.
        void* frames[32]{};
        USHORT captured = 0;
        __try
        {
            captured = CaptureStackBackTrace(0, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            captured = 0;
        }

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        char summary[1024]{};
        std::size_t summaryUsed = 0;
        unsigned gameFrames = 0;
        std::uintptr_t previous = 0;

        for (USHORT i = 0; i < captured && gameFrames < 10; ++i)
        {
            const auto address = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (!base || !size || address < base || address >= base + size || address == previous)
                continue;
            previous = address;

            char where[96]{};
            FormatCaller(address, where, ArrayCount(where));
            if (summaryUsed + 110 < ArrayCount(summary))
            {
                summaryUsed += static_cast<std::size_t>(_snprintf_s(summary + summaryUsed, ArrayCount(summary) - summaryUsed, _TRUNCATE,
                    "%s#%u=%s", gameFrames ? " -> " : "", gameFrames, where));
            }

            char code[768]{};
            std::size_t codeUsed = 0;
            __try
            {
                const auto* start = reinterpret_cast<const unsigned char*>(address >= 24 ? address - 24 : address);
                for (unsigned b = 0; b < 80 && codeUsed + 4 < ArrayCount(code); ++b)
                    codeUsed += static_cast<std::size_t>(_snprintf_s(code + codeUsed, ArrayCount(code) - codeUsed, _TRUNCATE, "%02X ", start[b]));
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                strncpy_s(code, "<unreadable>", _TRUNCATE);
            }

            ServerEmuAppend(L"bnet_launcher_trace.log",
                "[BNET-LAUNCH-STACK-FRAME] api=%ls path='%ls' value='%ls' frame=%u address=%s contents=REDACTED code[-24..+55]=%s\r\n",
                api ? api : L"registry", path ? path : L"<unknown>",
                (valueName && *valueName) ? valueName : L"(Default)", gameFrames, where, code);
            RecordServerEmuCaller("BNetRegistryStack", address);
            ++gameFrames;
        }

        if (!gameFrames)
            strncpy_s(summary, "<no-game-frames-captured>", _TRUNCATE);

        InternalLog("[BNET-LAUNCH-STACK] value='%ls' gameFrames=%u chain=%s\r\n",
            (valueName && *valueName) ? valueName : L"(Default)", gameFrames, summary);
        ServerEmuAppend(L"bnet_launcher_trace.log",
            "[BNET-LAUNCH-STACK] api=%ls path='%ls' value='%ls' gameFrames=%u contents=REDACTED chain=%s\r\n",
            api ? api : L"registry", path ? path : L"<unknown>",
            (valueName && *valueName) ? valueName : L"(Default)", gameFrames, summary);
    }

    void LogBNetLauncherCallerContext(const wchar_t* api, const wchar_t* path, const wchar_t* valueName,
        DWORD type, DWORD bytes, std::uintptr_t caller) noexcept
    {
        if (kServerEmuProductionRuntimeV92)
        {
            InternalLog("[V94-PRODUCTION] BNet launcher value consumed value='%ls' type=%lu bytes=%lu; caller dump/stack walk=OFF\r\n",
                (valueName && *valueName) ? valueName : L"(Default)",
                static_cast<unsigned long>(type), static_cast<unsigned long>(bytes));
            return;
        }
        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));

        char code[768]{};
        std::size_t used = 0;
        __try
        {
            const auto* start = reinterpret_cast<const unsigned char*>(caller >= 24 ? caller - 24 : caller);
            for (unsigned i = 0; i < 80 && used + 4 < ArrayCount(code); ++i)
                used += static_cast<std::size_t>(_snprintf_s(code + used, ArrayCount(code) - used, _TRUNCATE, "%02X ", start[i]));
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            strncpy_s(code, "<unreadable>", _TRUNCATE);
        }

        const bool sensitive = IsSensitiveBNetLaunchValue(valueName);
        ++g_bnetLauncherContextDumps;
        InternalLog("[BNET-LAUNCH-CALLER] api=%ls value='%ls' caller=%s type=%lu bytes=%lu sensitive=%s code dumped to bnet_launcher_trace.log\r\n",
            api ? api : L"registry", (valueName && *valueName) ? valueName : L"(Default)", where,
            static_cast<unsigned long>(type), static_cast<unsigned long>(bytes), sensitive ? "yes" : "no");
        ServerEmuAppend(L"bnet_launcher_trace.log",
            "[BNET-LAUNCH-CALLER] api=%ls path='%ls' value='%ls' caller=%s type=%lu bytes=%lu sensitive=%s contents=REDACTED code[-24..+55]=%s\r\n",
            api ? api : L"registry", path ? path : L"<unknown>",
            (valueName && *valueName) ? valueName : L"(Default)", where,
            static_cast<unsigned long>(type), static_cast<unsigned long>(bytes), sensitive ? "yes" : "no", code);

        // ACCOUNT_STATE and WEB_TOKEN both return through the same generic registry helper.
        // For sensitive launcher values, record the game-only stack above that helper so the
        // next run identifies the actual stock token/account-state consumer without dumping secrets.
        if (sensitive)
            DumpBNetLauncherGameStack(api, path, valueName);

        RecordServerEmuCaller("BNetRegistryRead", caller);
    }

    void LogBNetRegistryRead(const wchar_t* api, HKEY key, const wchar_t* subKey, const wchar_t* valueName,
        LSTATUS status, DWORD type, DWORD bytes, bool dataRequested, std::uintptr_t caller) noexcept
    {
        wchar_t path[512]{};
        bool tracked = false;
        if (subKey && *subKey)
            tracked = BuildBNetRegistryPath(key, subKey, path, ArrayCount(path));
        else
            tracked = LookupBNetRegistryPath(key, path, ArrayCount(path));
        if (!tracked) return;

        ++g_bnetRegistryReads;
        const wchar_t* value = (valueName && *valueName) ? valueName : L"(Default)";
        if (kServerEmuProductionRuntimeV92 && !IsSensitiveBNetLaunchValue(valueName))
            return;
        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        InternalLog("[BNET-LAUNCH] %ls path='%ls' value='%ls' status=%ld type=%lu bytes=%lu data=%s caller=%s (contents redacted)\r\n",
            api ? api : L"registry", path, value, static_cast<long>(status),
            static_cast<unsigned long>(type), static_cast<unsigned long>(bytes), dataRequested ? "requested" : "size-only", where);
        ServerEmuAppend(L"auth_surface.log",
            "[BNET-LAUNCH] registry api=%ls path='%ls' value='%ls' status=%ld type=%lu bytes=%lu data=%s caller=%s contents=REDACTED\r\n",
            api ? api : L"registry", path, value, static_cast<long>(status),
            static_cast<unsigned long>(type), static_cast<unsigned long>(bytes), dataRequested ? "requested" : "size-only", where);

        // Only dump code around the successful data-returning call. The bytes are game code,
        // never the registry value. This lets us identify the stock parser/consumer for
        // WEB_TOKEN and ACCOUNT_STATE without leaking launcher credentials.
        if (status == ERROR_SUCCESS && dataRequested)
            LogBNetLauncherCallerContext(api, path, valueName, type, bytes, caller);
    }

    LSTATUS WINAPI ServerEmuRegOpenKeyExW(HKEY key, LPCWSTR subKey, DWORD options, REGSAM sam, PHKEY result) noexcept
    {
        const LSTATUS status = g_regOpenKeyExWOriginal ? g_regOpenKeyExWOriginal(key, subKey, options, sam, result) : ERROR_PROC_NOT_FOUND;
        if (status == ERROR_SUCCESS && result && *result)
        {
            wchar_t path[512]{};
            if (BuildBNetRegistryPath(key, subKey, path, ArrayCount(path)))
            {
                TrackBNetRegistryHandle(*result, path);
                ++g_bnetRegistryOpens;
                InternalLog("[BNET-LAUNCH] RegOpenKeyExW path='%ls' sam=0x%08lX -> tracked\r\n", path, static_cast<unsigned long>(sam));
                ServerEmuAppend(L"auth_surface.log", "[BNET-LAUNCH] registry-open path='%ls' sam=0x%08lX\r\n",
                    path, static_cast<unsigned long>(sam));
            }
        }
        return status;
    }

    LSTATUS WINAPI ServerEmuRegOpenKeyExA(HKEY key, LPCSTR subKey, DWORD options, REGSAM sam, PHKEY result) noexcept
    {
        const LSTATUS status = g_regOpenKeyExAOriginal ? g_regOpenKeyExAOriginal(key, subKey, options, sam, result) : ERROR_PROC_NOT_FOUND;
        if (status == ERROR_SUCCESS && result && *result)
        {
            wchar_t wideSub[512]{};
            AnsiToWideSafe(subKey, wideSub, ArrayCount(wideSub));
            wchar_t path[512]{};
            if (BuildBNetRegistryPath(key, wideSub, path, ArrayCount(path)))
            {
                TrackBNetRegistryHandle(*result, path);
                ++g_bnetRegistryOpens;
                InternalLog("[BNET-LAUNCH] RegOpenKeyExA path='%ls' sam=0x%08lX -> tracked\r\n", path, static_cast<unsigned long>(sam));
                ServerEmuAppend(L"auth_surface.log", "[BNET-LAUNCH] registry-open path='%ls' sam=0x%08lX\r\n",
                    path, static_cast<unsigned long>(sam));
            }
        }
        return status;
    }

    void ProbeKnownBNetLauncherDummyBlob(HKEY key, const wchar_t* valueName, LSTATUS status,
        DWORD type, const BYTE* data, DWORD bytes) noexcept
    {
        // A comparison client supplied by the user seeds ODIN with fixed-size REG_BINARY
        // launcher records whose first byte is 0x01 and whose remaining bytes are zero.
        // Do NOT dump or replace the user's launcher data.  Only report whether the stock
        // value already has that exact non-secret structural template.
        if (status != ERROR_SUCCESS || type != REG_BINARY || !data || !valueName || !*valueName)
            return;

        DWORD expected = 0;
        if (_wcsicmp(valueName, L"ACCOUNT") == 0)
            expected = 246;
        else if (_wcsicmp(valueName, L"ACCOUNT_STATE") == 0)
            expected = 230;
        else if (_wcsicmp(valueName, L"WEB_TOKEN") == 0)
            expected = 262;
        else
            return;

        wchar_t path[512]{};
        if (!LookupBNetRegistryPath(key, path, ArrayCount(path)) ||
            !WideContainsNoCase(path, L"Battle.net\\Launch Options\\ODIN"))
            return;

        bool readable = true;
        bool firstByteOne = false;
        bool restZero = false;
        __try
        {
            firstByteOne = bytes >= 1 && data[0] == 0x01;
            restZero = bytes == expected;
            if (restZero)
            {
                for (DWORD i = 1; i < bytes; ++i)
                {
                    if (data[i] != 0)
                    {
                        restZero = false;
                        break;
                    }
                }
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            readable = false;
            firstByteOne = false;
            restZero = false;
        }

        const bool exactTemplate = readable && bytes == expected && firstByteOne && restZero;
        if (_wcsicmp(valueName, L"ACCOUNT_STATE") == 0)
        {
            g_bnetAccountStateTemplateSeen.store(true, std::memory_order_release);
            g_bnetAccountStateTemplateMatch.store(exactTemplate, std::memory_order_release);

            // This successful ACCOUNT_STATE read happens before the stock WEB_TOKEN
            // guard on the captured 1.44 flow. Arm observer-only hooks here so the
            // very first guard invocation and state transition are not missed.
            InstallBNetFirstStateRuntimeObservers144();
        }
        else if (_wcsicmp(valueName, L"WEB_TOKEN") == 0)
        {
            g_bnetWebTokenTemplateSeen.store(true, std::memory_order_release);
            g_bnetWebTokenTemplateMatch.store(exactTemplate, std::memory_order_release);
        }

        InternalLog("[BNET-LAUNCH-TEMPLATE] value='%ls' bytes=%lu expected=%lu readable=%s firstByte01=%s remainingZero=%s otherClientDummyTemplate=%s contents=REDACTED\r\n",
            valueName, static_cast<unsigned long>(bytes), static_cast<unsigned long>(expected),
            readable ? "yes" : "no", firstByteOne ? "yes" : "no", restZero ? "yes" : "no",
            exactTemplate ? "MATCH" : "DIFFERENT");
        ServerEmuAppend(L"bnet_launcher_trace.log",
            "[BNET-LAUNCH-TEMPLATE] path='%ls' value='%ls' type=REG_BINARY bytes=%lu expected=%lu firstByte01=%s remainingZero=%s otherClientDummyTemplate=%s contents=REDACTED\r\n",
            path, valueName, static_cast<unsigned long>(bytes), static_cast<unsigned long>(expected),
            firstByteOne ? "yes" : "no", restZero ? "yes" : "no", exactTemplate ? "MATCH" : "DIFFERENT");
    }

