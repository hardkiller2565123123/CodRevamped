            InternalLog("[DW-SOURCE3-V55] ERROR invalid_context task=%p stateWrites=off\r\n",
                reinterpret_cast<void*>(taskObject));
            return 0;
        }

        static constexpr DwSource3WriterCellTraceV55 writers[] = {
            {0x6F1A130u, 0x2B59C40u, "COMPLETION_WRITER_A"},
            {0x6F1A148u, 0x2B59CB0u, "COMPLETION_WRITER_B"},
        };
        static constexpr std::size_t tableOffsets[] = {0x00u, 0x50u, 0xA0u, 0xF0u};

        InternalLog(
            "[DW-SOURCE3-V55] BEGIN task=%p purpose=resolve_live_writer_A_vs_B_from_exact_pointer_cells "
            "cells={A:0x6F1A130,B:0x6F1A148} mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(taskObject));
        ServerEmuAppend(L"dw_source3_v55_writer_cell_ownership.log",
            "\r\n[DW-SOURCE3-V55] BEGIN task=%p purpose=resolve_live_writer_A_vs_B_from_exact_pointer_cells "
            "cells={A:0x6F1A130,B:0x6F1A148} mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(taskObject));

        unsigned relativeHitsA = 0;
        unsigned relativeHitsB = 0;
        for (const auto off : tableOffsets)
        {
            std::uintptr_t table = 0;
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(taskObject + off), &table, sizeof(table)) ||
                table < base || table >= base + size)
                continue;

            const std::uintptr_t tableRva = table - base;
            for (int rel = -12; rel <= 12; ++rel)
            {
                const std::intptr_t byteDelta = static_cast<std::intptr_t>(rel) * static_cast<std::intptr_t>(sizeof(std::uintptr_t));
                const std::uintptr_t cell = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(table) + byteDelta);
                std::uintptr_t value = 0;
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cell), &value, sizeof(value)))
                    continue;
                if (value < base || value >= base + size)
                    continue;
                const std::uintptr_t valueRva = value - base;
                const char* label = nullptr;
                if (valueRva == writers[0].writerRva) { label = writers[0].label; ++relativeHitsA; }
                if (valueRva == writers[1].writerRva) { label = writers[1].label; ++relativeHitsB; }
                if (!label)
