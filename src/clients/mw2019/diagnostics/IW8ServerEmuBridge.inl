        }

        // A_RESULT_GATE return: JZ 0x2B59C7F, otherwise fall through to E=1 at C6E.
        bool gateJzExact = false;
        std::uintptr_t gateJzTarget = 0;
        for (unsigned i = 0; gatePathReadable && i + 2u <= sizeof(gatePath); ++i)
        {
            if (gatePath[i] == 0x74u)
            {
                gateJzTarget = static_cast<std::uintptr_t>(
                    static_cast<std::intptr_t>(0x2B59C68u + i + 2u) +
                    static_cast<std::int8_t>(gatePath[i + 1u]));
                if (gateJzTarget == 0x2B59C7Fu)
                {
                    gateJzExact = true;
                    break;
