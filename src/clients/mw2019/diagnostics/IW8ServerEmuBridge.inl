    const char* DwSecurityStatusName144(SECURITY_STATUS status) noexcept
    {
        switch (static_cast<unsigned long>(status))
        {
        case 0x00000000ul: return "SEC_E_OK";
        case 0x00090312ul: return "SEC_I_CONTINUE_NEEDED";
        case 0x00090317ul: return "SEC_I_CONTEXT_EXPIRED";
        case 0x00090320ul: return "SEC_I_INCOMPLETE_CREDENTIALS";
        case 0x80090308ul: return "SEC_E_INVALID_TOKEN";
        case 0x8009030Eul: return "SEC_E_NO_CREDENTIALS";
        case 0x80090317ul: return "SEC_E_CONTEXT_EXPIRED";
        case 0x80090318ul: return "SEC_E_INCOMPLETE_MESSAGE";
        case 0x80090322ul: return "SEC_E_WRONG_PRINCIPAL";
        case 0x80090325ul: return "SEC_E_UNTRUSTED_ROOT";
        case 0x80090326ul: return "SEC_E_ILLEGAL_MESSAGE";
        case 0x80090327ul: return "SEC_E_CERT_UNKNOWN";
        case 0x80090331ul: return "SEC_E_ALGORITHM_MISMATCH";
        default: return "OTHER";
        }
    }

    bool IsDwCurlSchannelCaller144(std::uintptr_t caller, std::uintptr_t& rva, const char*& landmark) noexcept
    {
        rva = 0;
        landmark = "outside";
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || caller < base || caller >= base + size)
            return false;

        rva = caller - base;
        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        if (rva == d.DwTlsAcquireCredentialsHandleReturn)
            landmark = "AcquireCredentialsHandle-return";
        else if (rva == d.DwTlsInitialInitializeSecurityContextReturn)
            landmark = "InitializeSecurityContext-initial-return";
        else if (rva == d.DwTlsNextInitializeSecurityContextReturn)
            landmark = "InitializeSecurityContext-next-return";
        else if (rva >= d.DwTlsRetrySendFunction - 0x2000u && rva <= d.DwTlsRecvDriverFunction + 0x2000u)
            landmark = "curl-schannel-range";
        else
            return false;
        return true;
    }

    void FormatDwSspiTarget144(const wchar_t* target, char* out, std::size_t outCount) noexcept
    {
        if (!out || !outCount)
            return;
        out[0] = '\0';
        if (!target)
        {
            strcpy_s(out, outCount, "<null>");
            return;
        }
        const int converted = WideCharToMultiByte(CP_UTF8, 0, target, -1, out, static_cast<int>(outCount), nullptr, nullptr);
        if (converted <= 0)
            strcpy_s(out, outCount, "<wide-target>");
    }

