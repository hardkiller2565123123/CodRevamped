        0x5D6ACA0u, 0x3D5E090u, 0x3D1E300u, 0x3D05920u, 0x3C1DF30u,
        0x2D1F9EFu, 0x2B598B0u, 0x2B59910u, 0x2B593F0u,
        0x2B59C40u, 0x2B59CB0u, 0x2B59D10u, 0x2B5A470u, 0x2B5AB10u,
        0x3D61170u, 0x3D5E1D0u, 0x34845D0u, 0x3484550u, 0x34845C0u,
        0x3C1E820u, 0x3D057B0u,
        0x4531BB0u, 0x3D05840u, 0x3D5B570u, 0x3D1EE20u, 0x3D61700u,
