    bool V97InstallSource3CompletionTrace144() noexcept
    {
        if (g_v97Source3HooksReady.load(std::memory_order_acquire))
            return true;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return false;

        const unsigned attempt = g_v97Source3HookAttempts.fetch_add(1, std::memory_order_acq_rel) + 1u;
        const MH_STATUS init = MH_Initialize();
        if (init != MH_OK && init != MH_ERROR_ALREADY_INITIALIZED)
            return false;

        struct Spec { std::uintptr_t rva; void* detour; void** original; const char* label; };
        Spec specs[] = {
            {kDwGetLogOnStatusRva144, reinterpret_cast<void*>(&V97DwGetLogOnStatusObserver144), reinterpret_cast<void**>(&g_v97DwStatusOriginal), "dwGetLogOnStatus"},
            {kDwIngressMaskTestRva144, reinterpret_cast<void*>(&V97MaskTestObserver144), reinterpret_cast<void**>(&g_v97MaskTestOriginal), "maskTest"},
            {kDwIngressMask80Rva144, reinterpret_cast<void*>(&V97Mask80Observer144), reinterpret_cast<void**>(&g_v97Mask80Original), "mask80Pre"},
            {kDwIngressStateMapRva144, reinterpret_cast<void*>(&V97StateMapObserver144), reinterpret_cast<void**>(&g_v97StateMapOriginal), "stateMap"},
            {kDwSource3PrimaryRouteRvaV22, reinterpret_cast<void*>(&V97PrimaryRouteObserver144), reinterpret_cast<void**>(&g_v97PrimaryRouteOriginal), "primaryCallback"},
            {kDwSource3StateSetterRva144, reinterpret_cast<void*>(&V97Source3SetterObserver144), reinterpret_cast<void**>(&g_v97Source3SetterOriginal), "source3Setter"},
        };
        unsigned ready = 0;
        for (auto& spec : specs)
        {
            if (spec.rva >= size) continue;
            const auto target = reinterpret_cast<void*>(base + spec.rva);
            const MH_STATUS create = MH_CreateHook(target, spec.detour, spec.original);
            if (create != MH_OK && create != MH_ERROR_ALREADY_CREATED)
                continue;
            const MH_STATUS enable = MH_EnableHook(target);
            if (enable == MH_OK || enable == MH_ERROR_ENABLED)
                ++ready;
        }
        const bool allReady = ready == ArrayCount(specs);
        g_v97Source3HooksReady.store(allReady, std::memory_order_release);
        InternalLog("[V97-SOURCE3] HOOKS attempt=%u ready=%u/%zu allReady=%s exactTargetsOnly=yes stackWalks=off broadScans=off normalStateWrites=off\r\n",
            attempt, ready, ArrayCount(specs), allReady ? "YES" : "no");
        ServerEmuAppend(L"v97_source3_completion.log",
            "[V97-SOURCE3] HOOKS attempt=%u ready=%u/%zu allReady=%s exactTargetsOnly=yes stackWalks=off broadScans=off normalStateWrites=off\r\n",
            attempt, ready, ArrayCount(specs), allReady ? "YES" : "no");
        return allReady;
    }


