        // V96.1: observe abrupt exits/crashes, but never block or alter them.
        InstallExitCrashTraceV961();

        const unsigned total = iatInstalled + globalInstalled;
        InternalLog("[SERVER-EMU144] minimal transport hooks active=%u (process-wide=%u iat=%u) server=%s\r\n",
            total, globalInstalled, iatInstalled, cfg.host);
        InternalLog("[SERVER-EMU144] bootstrap redirect is ON: named BNet/Demonware DNS + direct :80/:1119 -> %s; V95 targeted gate trace=ON and no auth state is patched\r\n",
            ServerEmuSettings().host);
