        order.reserve(nodes.size());
        for (std::size_t i = 0; i < nodes.size(); ++i) order.push_back(static_cast<int>(i));
        std::sort(order.begin(), order.end(), [&nodes](int a, int b) {
            if (nodes[static_cast<std::size_t>(a)].score != nodes[static_cast<std::size_t>(b)].score)
                return nodes[static_cast<std::size_t>(a)].score > nodes[static_cast<std::size_t>(b)].score;
            return nodes[static_cast<std::size_t>(a)].depth < nodes[static_cast<std::size_t>(b)].depth;
