    // V58: V57's exact call-original observer armed successfully but the adapter
    // never executed during the failed login window.  That means the missing
    // information is one level earlier: where the game registers/materializes
    // the callback address and what registration/dispatcher owns that callback.
    // This worker is entirely static/read-only.  It searches for code that
    // materializes the exact adapter address (LEA RIP-relative or MOV imm64),
    // dumps the bounded owner and nearby calls, then finds direct callers of the
    // registration owner.  No game function is called and no state is written.
    struct BNetFenceRegOwnerV58
    {
        std::uintptr_t begin{};
        std::uintptr_t end{};
        std::uintptr_t firstRef{};
    };

    const char* BNetRegNameV58(unsigned reg) noexcept
    {
        static const char* names[] = {
            "RAX","RCX","RDX","RBX","RSP","RBP","RSI","RDI",
            "R8","R9","R10","R11","R12","R13","R14","R15"
        };
        return reg < ArrayCount(names) ? names[reg] : "R?";
    }

    void LogBNetFenceRegistrationWindowV58(const char* label, std::uintptr_t centerRva,
        std::size_t before = 0x60u, std::size_t after = 0xA0u) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || centerRva >= size)
            return;
        const std::uintptr_t startRva = centerRva > before ? centerRva - before : 0u;
        const std::size_t wanted = static_cast<std::size_t>((std::min)(
            static_cast<std::uintptr_t>(before + after), size - startRva));
        constexpr std::size_t kMax = 0x180u;
        const std::size_t count = (std::min)(wanted, kMax);
        unsigned char bytes[kMax]{};
        const bool readable = count && ServerEmuSafeReadBytes(
            reinterpret_cast<const void*>(base + startRva), bytes, count);
        char hex[kMax * 3u + 1u]{};
        if (readable)
        {
            std::size_t pos = 0;
            for (std::size_t i = 0; i < count && pos + 4u < sizeof(hex); ++i)
            {
                const int wrote = snprintf(hex + pos, sizeof(hex) - pos, "%02X%s",
                    bytes[i], (i + 1u == count) ? "" : " ");
                if (wrote <= 0)
                    break;
                pos += static_cast<std::size_t>(wrote);
            }
        }
        InternalLog("[BNET-FENCE-REG-V58] CODE label=%s centerRva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label ? label : "?", static_cast<unsigned long long>(centerRva),
            static_cast<unsigned long long>(startRva), readable ? "yes" : "no", readable ? hex : "");
        ServerEmuAppend(L"bnet_fence_registration_v58.log",
            "[BNET-FENCE-REG-V58] CODE label=%s centerRva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label ? label : "?", static_cast<unsigned long long>(centerRva),
            static_cast<unsigned long long>(startRva), readable ? "yes" : "no", readable ? hex : "");
    }

    DWORD WINAPI BNetFenceRegistrationWorkerV58(LPVOID) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return 0;
        HMODULE module = reinterpret_cast<HMODULE>(base);
        ImageSectionView text{};
        if (!GetImageSection(module, ".text", text) || !text.begin || !text.size)
