    void EnsureBgsTrustBeforeBootstrapNetwork(unsigned short port) noexcept
    {
        if (port != 80u && port != 1119u)
            return;

        HMODULE game = GetModuleHandleW(nullptr);
        if (!game)
            return;

        // The earliest install attempt can run while the image is still being
        // committed and VirtualProtect can transiently return ERROR_INVALID_ADDRESS.
        // Do a bounded synchronous retry at the first real bootstrap socket so
        // the verifier key is installed before BGS can cache/use the stock key.
        const ULONGLONG started = GetTickCount64();
        bool ready = false;
        unsigned localAttempts = 0;
        for (; localAttempts < 16u; ++localAttempts)
        {
            const bool bgsReady = InstallBgsLocalTrustBootstrap(game);
            const bool auth3Ready = InstallAuth3LocalSigningTrust(game);
            if (bgsReady && auth3Ready)
            {
                ready = true;
                break;
            }
            Sleep(25);
        }

        // Dumping the stock JSON gives the local server its source bundle. Once
        // the exact JSON is readable, adapt only existing web/Demonware pin hashes
        // in-place. This is trust bootstrap only: no auth/fence/LUI state is changed.
        DumpEmbeddedBgsCertificateBundle(game);
        AdaptEmbeddedBgsWebTrustPins(game);

        InternalLog("[TRUST-BOOT] network preflight port=%u ready=%s localAttempts=%u elapsedMs=%llu; socket connect continues only after bounded trust retry\r\n",
            static_cast<unsigned>(port), ready ? "yes" : "no", localAttempts + (ready ? 1u : 0u),
            static_cast<unsigned long long>(GetTickCount64() - started));
        ServerEmuAppend(L"network_trace.log",
            "[TRUST-BOOT] network preflight port=%u ready=%s localAttempts=%u elapsedMs=%llu\r\n",
            static_cast<unsigned>(port), ready ? "yes" : "no", localAttempts + (ready ? 1u : 0u),
            static_cast<unsigned long long>(GetTickCount64() - started));
    }

