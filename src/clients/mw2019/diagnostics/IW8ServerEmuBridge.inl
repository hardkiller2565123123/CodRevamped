                    if (!lastPostFenceSnapshotValid || postFencePointerChanged || postFenceDwords[i] != lastPostFenceDwords[i])
                    {
                        postFenceObjectChanged = true;
                        break;
                    }
                }
            }

            const bool changed = firstSample || firstValue != lastFirst || snapshotValue != lastSnapshot ||
                snapshotInitValue != lastSnapshotInit || prereqValue != lastPrereq || prereqInitValue != lastPrereqInit ||
                fenceFound != lastFenceFound || fenceState != lastFenceState || postFenceObjectChanged;
