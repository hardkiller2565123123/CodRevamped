        // marker to this exact 1.44 code location.  V44 inspects only a tiny local
        // window around that transition so we can classify the guard/call that must
        // pass before the stock client opens the LSG socket.  Read-only only: no
        // detours, stack capture, or state modification.
        constexpr std::uintptr_t kConnectingLsgXrefRva = 0x619EE0Aull;
        if (kConnectingLsgXrefRva >= size)
            return;

        const std::uintptr_t xref = base + kConnectingLsgXrefRva;
        const std::uintptr_t begin = xref > base + 0x180u ? xref - 0x180u : base;
        const std::uintptr_t end = (std::min)(base + size, xref + static_cast<std::uintptr_t>(0x280u));
        InternalLog("[DW-LSG-TRANSITION-V44] BEGIN connectingLsgXrefRva=0x%llX window=0x%llX..0x%llX mode=STATIC_READ_ONLY no_hooks=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kConnectingLsgXrefRva),
            static_cast<unsigned long long>(begin - base),
            static_cast<unsigned long long>(end - base));
        ServerEmuAppend(L"dw_lsg_transition.log",
            "\r\n[DW-LSG-TRANSITION-V44] BEGIN connectingLsgXrefRva=0x%llX window=0x%llX..0x%llX mode=STATIC_READ_ONLY no_hooks=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(kConnectingLsgXrefRva),
            static_cast<unsigned long long>(begin - base),
            static_cast<unsigned long long>(end - base));
        AppendCodeBytes144(L"dw_lsg_transition.log", "[DW-LSG-TRANSITION-V44-CODE]", begin,
            static_cast<std::size_t>(end - begin), static_cast<std::size_t>(end - begin));

        unsigned directCalls = 0;
        unsigned branches = 0;
        unsigned ripRefs = 0;
        unsigned portRefs = 0;
        for (std::uintptr_t cursor = begin; cursor + 7u <= end; ++cursor)
        {
            unsigned char b[10]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size && directCalls < 32u)
                {
                    ++directCalls;
                    InternalLog("[DW-LSG-TRANSITION-V44] CALL index=%u callRva=0x%llX targetRva=0x%llX deltaFromConnecting=%+lld read_only=yes\r\n",
                        directCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base),
                        static_cast<long long>(cursor) - static_cast<long long>(xref));
                    ServerEmuAppend(L"dw_lsg_transition.log",
                        "[DW-LSG-TRANSITION-V44] CALL index=%u callRva=0x%llX targetRva=0x%llX deltaFromConnecting=%+lld read_only=yes\r\n",
                        directCalls,
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base),
                        static_cast<long long>(cursor) - static_cast<long long>(xref));
                }
            }

            std::size_t branchLen = 0;
            std::uintptr_t branchTarget = 0;
            const char* branchKind = nullptr;
            if (b[0] == 0x74 || b[0] == 0x75 || (b[0] >= 0x70 && b[0] <= 0x7F))
            {
                branchLen = 2u;
                branchTarget = cursor + 2u + static_cast<std::int8_t>(b[1]);
                branchKind = "JCC8";
            }
            else if (b[0] == 0x0F && b[1] >= 0x80 && b[1] <= 0x8F)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 2, sizeof(rel));
                branchLen = 6u;
                branchTarget = cursor + 6u + static_cast<std::intptr_t>(rel);
                branchKind = "JCC32";
            }
            if (branchLen && branches < 48u)
            {
                ++branches;
                InternalLog("[DW-LSG-TRANSITION-V44] BRANCH index=%u kind=%s rva=0x%llX targetRva=%s0x%llX deltaFromConnecting=%+lld opcode=%02X%02X read_only=yes\r\n",
                    branches, branchKind,
                    static_cast<unsigned long long>(cursor - base),
                    (branchTarget >= base && branchTarget < base + size) ? "" : "n/a-",
                    static_cast<unsigned long long>((branchTarget >= base && branchTarget < base + size) ? branchTarget - base : 0),
                    static_cast<long long>(cursor) - static_cast<long long>(xref),
                    static_cast<unsigned>(b[0]), static_cast<unsigned>(b[1]));
                ServerEmuAppend(L"dw_lsg_transition.log",
                    "[DW-LSG-TRANSITION-V44] BRANCH index=%u kind=%s rva=0x%llX targetRva=%s0x%llX deltaFromConnecting=%+lld opcode=%02X%02X read_only=yes\r\n",
                    branches, branchKind,
                    static_cast<unsigned long long>(cursor - base),
                    (branchTarget >= base && branchTarget < base + size) ? "" : "n/a-",
                    static_cast<unsigned long long>((branchTarget >= base && branchTarget < base + size) ? branchTarget - base : 0),
                    static_cast<long long>(cursor) - static_cast<long long>(xref),
                    static_cast<unsigned>(b[0]), static_cast<unsigned>(b[1]));
            }

            if ((b[0] & 0xF0u) == 0x40u && (b[1] == 0x8Du || b[1] == 0x8Bu) && (b[2] & 0xC7u) == 0x05u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 3, sizeof(rel));
