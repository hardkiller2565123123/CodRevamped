        g_dwSource3RouteObserversInstalledV22.store(routePrimaryReady || routeAltReady, std::memory_order_release);
        InternalLog(
            "[DW-SOURCE3-V22] ROUTE_OBSERVERS primary={rva:0x%llX ready:%s} alt={rva:0x%llX ready:%s} "
            "primaryMapping={controller1:2,result1000:2,result_lt100:1,else:3} mode=CALL_ORIGINAL_UNCHANGED stateWrites=off\r\n",
            static_cast<unsigned long long>(kDwSource3PrimaryRouteRvaV22), routePrimaryReady ? "YES" : "NO",
            static_cast<unsigned long long>(kDwSource3AltRouteRvaV22), routeAltReady ? "YES" : "NO");

        const bool ready = installed == ArrayCount(hooks);
