    void V95TargetedGateTick144(ULONGLONG uptimeMs) noexcept
    {
        // V95 intentionally does not inspect packet payloads, walk stacks, patch
        // state, or invoke any menu/LUI path.  It samples only the four exact
        // stock auth getters already used by the old five-second status probe and
        // three proven raw gate fields.  Output is change-only plus one bounded
        // stall line every five seconds after the LSG stream has appeared.
        const auto trackedSocket = g_dwLsgCandidateSocketV61.load(std::memory_order_acquire);
        if (!trackedSocket)
            return;

        static std::uintptr_t lastSocket = 0;
        static ULONGLONG armUptimeMs = 0;
        static ULONGLONG lastChangeUptimeMs = 0;
        static ULONGLONG lastStallLogUptimeMs = 0;
        static unsigned sequence = 0;
        static bool haveLast = false;
        static V95GateSnapshot144 last{};

        if (lastSocket != trackedSocket)
        {
            lastSocket = trackedSocket;
            armUptimeMs = uptimeMs;
            lastChangeUptimeMs = uptimeMs;
            lastStallLogUptimeMs = 0;
            haveLast = false;
            ++sequence;
            InternalLog("[V95-GATE] ARM seq=%u socket=%llu trigger=LSG_STREAM_OBSERVED intervalMs=250 mode=READ_ONLY changeOnly=yes stateWrites=off\r\n",
                sequence, static_cast<unsigned long long>(trackedSocket));
            ServerEmuAppend(L"v95_gate_trace.log",
                "[V95-GATE] ARM seq=%u socket=%llu trigger=LSG_STREAM_OBSERVED intervalMs=250 mode=READ_ONLY changeOnly=yes stateWrites=off\r\n",
                sequence, static_cast<unsigned long long>(trackedSocket));
        }

        V95GateSnapshot144 current{};
        if (!V95ReadGateSnapshot144(current))
            return;

        const bool changed = !haveLast || !V95GateSnapshotsEqual144(last, current);
        if (changed)
        {
            last = current;
            haveLast = true;
            lastChangeUptimeMs = uptimeMs;
            const ULONGLONG age = uptimeMs >= armUptimeMs ? uptimeMs - armUptimeMs : 0;
            const char* wait = V95GateWaitReason144(current);
            InternalLog(
                "[V95-GATE] CHANGE seq=%u ageMs=%llu signIn=%d bnet=%d bnetFail=%d dwSigned=%d dwStatus=%d firstState=%s%u postFence10=%s%u source3=%s0x%08X wait=%s stateWrites=off\r\n",
                sequence, static_cast<unsigned long long>(age), current.signInState, current.bnetSignedIn,
                current.bnetFailReason, current.demonwareSignedIn, current.dwLogOnStatus,
                current.firstStateReadable ? "" : "UNREADABLE/", current.firstStateReadable ? current.firstState : 0u,
                current.postFenceReadable ? "" : "UNREADABLE/", current.postFenceReadable ? current.postFenceState10 : 0u,
                current.source3Readable ? "" : "UNREADABLE/", current.source3Readable ? current.source3State : 0u,
