            total, globalInstalled, iatInstalled);
    }

    void DumpAuthGateCodeWindow144(const char* label, std::uintptr_t rva) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || rva >= size)
            return;

        const std::uintptr_t before = rva >= 24 ? 24 : rva;
        const std::uintptr_t startRva = rva - before;
        const std::size_t requested = 192;
        const std::size_t available = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(requested), static_cast<std::uintptr_t>(size - startRva)));
        char code[1024]{};
        std::size_t used = 0;
        __try
        {
            const auto* bytes = reinterpret_cast<const unsigned char*>(base + startRva);
            for (std::size_t i = 0; i < available && used + 4 < ArrayCount(code); ++i)
                used += static_cast<std::size_t>(_snprintf_s(code + used, ArrayCount(code) - used, _TRUNCATE, "%02X ", bytes[i]));
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            strncpy_s(code, "<unreadable>", _TRUNCATE);
        }

        InternalLog("[AUTH-GATE-CODE144] label=%s rva=0x%llX startRva=0x%llX bytes=%s\r\n",
            label,
            static_cast<unsigned long long>(rva),
            static_cast<unsigned long long>(startRva), code);
        ServerEmuAppend(L"auth_gate_topology.log",
            "[AUTH-GATE-CODE144] label=%s rva=0x%llX startRva=0x%llX bytes=%s\r\n",
            label,
            static_cast<unsigned long long>(rva),
            static_cast<unsigned long long>(startRva), code);
        ServerEmuAppend(L"auth_gate_dependencies.log",
            "[AUTH-GATE-CODE144] label=%s rva=0x%llX startRva=0x%llX bytes=%s\r\n",
            label,
            static_cast<unsigned long long>(rva),
            static_cast<unsigned long long>(startRva), code);
    }

    void DumpBNetSignInDependencies144() noexcept
    {
        // The previous topology capture recovered the one direct caller of
        // unk_IsUserSignedInToBNet and enough bytes from the getter itself to
        // resolve its immediate dependency chain. Keep this pass code-only:
        // it never invokes an unknown helper and never changes auth state.
        static std::atomic_bool dumped{ false };
        bool expected = false;
        if (!dumped.compare_exchange_strong(expected, true))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        const auto& r = iw8_addresses::MW2019_1_44_Rvas;
        const auto& d = iw8_addresses::MW2019_1_44_Discovery;

        struct Dependency
        {
            const char* label;
            std::uintptr_t rva;
        };

        const Dependency deps[] =
        {
            { "BNet first state getter (return pointer; stock code compares dword [rax] with 2)", d.BNetSignInFirstStateGetter },
            { "BNet first state snapshot helper", d.BNetSignInFirstStateSnapshotHelper },
            { "BNet prerequisite bool", d.BNetSignInPrereqBool },
            { "BNet prerequisite init", d.BNetSignInPrereqInit },
            { "BNet fence object getter", d.BNetSignInFenceObjectGetter },
            { "GetBattleNetFenceState", r.GetBattleNetFenceState },
            { "BNet post-fence object getter", d.BNetSignInPostFenceObjectGetter },
            { "BNet post-fence bool", d.BNetSignInPostFenceBool },
            { "BNet post-fence bool inner", d.BNetSignInPostFenceBoolInner },
            { "BNet failure-path helper #1", d.BNetFailurePathHelper1 },
            { "BNet failure-path state getter", d.BNetFailurePathStateGetter },
        };

        InternalLog("[AUTH-GATE-DEPS144] BEGIN read-only dependency decode for unk_IsUserSignedInToBNet=0x%llX\r\n",
            static_cast<unsigned long long>(r.unk_IsUserSignedInToBNet));
        InternalLog("[AUTH-GATE-DEPS144] confirmed first stock prerequisite: CALL game+0x%llX -> CMP DWORD PTR [RAX],2 -> JNE failure path; no helper is invoked by this probe\r\n",
            static_cast<unsigned long long>(d.BNetSignInFirstStateGetter));
        ServerEmuAppend(L"auth_gate_dependencies.log",
            "[AUTH-GATE-DEPS144] BEGIN mode=READ_ONLY bnetGetterRva=0x%llX firstPrereqRva=0x%llX firstCompare=DWORD_PTR_RETURN_EQ_2\r\n",
            static_cast<unsigned long long>(r.unk_IsUserSignedInToBNet),
            static_cast<unsigned long long>(d.BNetSignInFirstStateGetter));

        for (const auto& dep : deps)
        {
            if (!dep.rva || dep.rva >= size)
                continue;
            InternalLog("[AUTH-GATE-DEPS144] dependency label=%s rva=0x%llX\r\n",
                dep.label, static_cast<unsigned long long>(dep.rva));
            ServerEmuAppend(L"auth_gate_dependencies.log",
                "[AUTH-GATE-DEPS144] dependency label=%s rva=0x%llX\r\n",
                dep.label, static_cast<unsigned long long>(dep.rva));
            DumpAuthGateCodeWindow144(dep.label, dep.rva);

            // Heuristically surface common x64 RIP-relative data references from
            // the first 160 bytes. This is discovery only; a hit is labeled as a
            // candidate until its surrounding function is understood.
            const auto* bytes = reinterpret_cast<const unsigned char*>(base + dep.rva);
            const std::size_t scan = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(160), size - dep.rva));
            __try
            {
                unsigned ripHits = 0;
                for (std::size_t i = 0; i + 7 <= scan && ripHits < 24; ++i)
                {
                    std::size_t dispOffset = 0;
                    std::size_t instrLen = 0;
                    const char* op = nullptr;
                    if (bytes[i] == 0x48 && (bytes[i + 1] == 0x8D || bytes[i + 1] == 0x8B) &&
                        (bytes[i + 2] & 0xC7) == 0x05)
                    {
                        dispOffset = i + 3;
                        instrLen = 7;
                        op = bytes[i + 1] == 0x8D ? "LEA_RIP" : "MOV64_RIP";
                    }
                    else if (bytes[i] == 0x8B && i + 6 <= scan &&
                        (bytes[i + 1] & 0xC7) == 0x05)
                    {
                        dispOffset = i + 2;
                        instrLen = 6;
                        op = "MOV32_RIP";
                    }
                    else if (bytes[i] == 0x83 && i + 7 <= scan &&
                        (bytes[i + 1] & 0xC7) == 0x05)
                    {
                        dispOffset = i + 2;
                        instrLen = 7;
                        op = "CMP32_RIP";
                    }
                    if (!op)
                        continue;

                    std::int32_t displacement = 0;
                    memcpy(&displacement, bytes + dispOffset, sizeof(displacement));
                    const auto instructionRva = dep.rva + i;
                    const auto target = base + instructionRva + instrLen + static_cast<std::intptr_t>(displacement);
                    if (target < base || target >= base + size)
                        continue;
                    ++ripHits;
                    const auto targetRva = target - base;
                    InternalLog("[AUTH-GATE-RIP144] owner=%s op=%s instructionRva=0x%llX candidateDataRva=0x%llX hit=%u\r\n",
                        dep.label, op,
                        static_cast<unsigned long long>(instructionRva),
                        static_cast<unsigned long long>(targetRva), ripHits);
                    ServerEmuAppend(L"auth_gate_dependencies.log",
                        "[AUTH-GATE-RIP144] owner=%s op=%s instructionRva=0x%llX candidateDataRva=0x%llX hit=%u\r\n",
                        dep.label, op,
                        static_cast<unsigned long long>(instructionRva),
                        static_cast<unsigned long long>(targetRva), ripHits);
                }
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                ServerEmuAppend(L"auth_gate_dependencies.log",
                    "[AUTH-GATE-DEPS144] dependency rva=0x%llX code unreadable while scanning RIP references\r\n",
                    static_cast<unsigned long long>(dep.rva));
            }
        }

        InternalLog("[AUTH-GATE-DEPS144] COMPLETE output=CodRevamped\\MW2019\\server_emu\\auth_gate_dependencies.log; no state modified\r\n");
        ServerEmuAppend(L"auth_gate_dependencies.log",
            "[AUTH-GATE-DEPS144] COMPLETE mode=READ_ONLY no_state_modified\r\n");
    }

    // V16: work backwards from the stock frontend instead of guessing another
    // Umbrella response.  This is a deliberately small, one-shot read-only map
    // of the exact 1.44 frontend/fence/auth landmarks we already trust.  It does
    // not scan for raw E8 bytes, patch return values, call LUI functions, or write
    // any auth/fence state.  The output is intended to answer one question per
    // hop: which stock frontend gate depends on which Demonware state next?
    void DumpFrontendBacktrace144() noexcept
    {
        if (kServerEmuProductionRuntimeV92) return;

        static std::atomic_bool dumped{ false };
        bool expected = false;
        if (!dumped.compare_exchange_strong(expected, true))
