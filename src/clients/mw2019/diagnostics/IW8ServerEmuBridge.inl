                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(p), b, sizeof(b)))
                    continue;
                if (b[0] == 0x83u && b[1] == 0xF8u)
                {
                    compareImm = b[2];
                    if (compareImm == 1u || compareImm == 2u) score += 16u;
                    else if (compareImm == 27u) score += 8u;
                    else if (compareImm <= 0x20u) score += 2u;
                    break;
                }
                if (b[0] == 0x3Du)
                {
                    std::uint32_t imm = 0;
                    memcpy(&imm, b + 1, sizeof(imm));
                    compareImm = imm;
                    if (imm == 1u || imm == 2u) score += 16u;
                    else if (imm == 27u) score += 8u;
                    else if (imm <= 0x20u) score += 2u;
                    break;
                }
                if (b[0] == 0x48u && b[1] == 0x83u && b[2] == 0xF8u)
                {
                    compareImm = b[3];
                    if (compareImm == 1u || compareImm == 2u) score += 16u;
                    else if (compareImm == 27u) score += 8u;
                    else if (compareImm <= 0x20u) score += 2u;
                    break;
                }
