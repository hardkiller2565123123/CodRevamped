    void V74DumpKnownIw8HashOwner() noexcept
    {
        if (g_dwLsgKnownHashDumpedV74.exchange(true)) return;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        constexpr std::uintptr_t kTranscriptHashRva = 0x232D1B0u;
        if (!base || kTranscriptHashRva >= size)
            return;
        const auto target = base + kTranscriptHashRva;
        std::uintptr_t fnBegin = 0, fnEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(target, fnBegin, fnEnd);
        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
            "[DW-LSG-V74] KNOWN_TRANSCRIPT_OWNER rva=0x%llX bounded=%s function=%s0x%llX..%s0x%llX source=stock_sub_14232D1B0 staticReadOnly=yes\r\n",
            static_cast<unsigned long long>(kTranscriptHashRva), bounded ? "yes" : "no",
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnBegin - base : 0u),
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnEnd - base : 0u));
        AppendCodeBytes144(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74-TRANSCRIPT-CODE]", target, 128u, 256u);
        if (bounded)
        {
            const std::uintptr_t scanEnd = (std::min)(fnEnd, fnBegin + 0x1800u);
            unsigned calls = 0;
            for (std::uintptr_t cursor = fnBegin; cursor + 5u <= scanEnd; ++cursor)
            {
                unsigned char b[5]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)) || b[0] != 0xE8u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, b + 1, sizeof(rel));
                const auto callee = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (callee < base || callee >= base + size) continue;
                std::uintptr_t cb = 0, ce = 0;
                const bool cbounded = RuntimeFunctionBounds144(callee, cb, ce);
                ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                    "[DW-LSG-V74-TRANSCRIPT-CALL] index=%u callRva=0x%llX calleeRva=0x%llX bounded=%s function=%s0x%llX..%s0x%llX\r\n",
                    calls++, static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(callee - base),
                    cbounded ? "yes" : "no", cbounded ? "" : "n/a-",
                    static_cast<unsigned long long>(cbounded ? cb - base : 0u), cbounded ? "" : "n/a-",
                    static_cast<unsigned long long>(cbounded ? ce - base : 0u));
                if (calls <= 24u)
                    AppendCodeBytes144(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74-TRANSCRIPT-CALLEE-CODE]", callee, 32u, 128u);
            }
            ServerEmuAppend(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74] KNOWN_TRANSCRIPT_OWNER directCalls=%u\r\n", calls);
        }

        // Find every direct IW8 caller of the known transcript-hash owner.  The
        // handshake parent is especially valuable because its calls immediately
        // after sub_14232D1B0 are prime derive-keys / CLIENTCHAL candidates.
        unsigned callers = 0;
        std::uintptr_t scan = base;
        const std::uintptr_t imageEnd = base + size;
        while (scan < imageEnd && callers < 32u)
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<const void*>(scan), &mbi, sizeof(mbi))) break;
            const auto regionBegin = (std::max)(scan, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(imageEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + static_cast<std::uintptr_t>(mbi.RegionSize));
            const DWORD prot = mbi.Protect & 0xFFu;
            const bool executable = prot == PAGE_EXECUTE || prot == PAGE_EXECUTE_READ || prot == PAGE_EXECUTE_READWRITE || prot == PAGE_EXECUTE_WRITECOPY;
            if (ServerEmuReadableRegion(mbi) && executable && regionEnd > regionBegin + 5u)
            {
                __try
                {
                    const auto* p = reinterpret_cast<const unsigned char*>(regionBegin);
                    const std::size_t n = static_cast<std::size_t>(regionEnd - regionBegin);
                    for (std::size_t off = 0; off + 5u <= n && callers < 32u; ++off)
                    {
                        if (p[off] != 0xE8u) continue;
                        std::int32_t rel = 0; memcpy(&rel, p + off + 1u, sizeof(rel));
                        const auto callsite = regionBegin + off;
                        const auto callee = callsite + 5u + static_cast<std::intptr_t>(rel);
                        if (callee != target) continue;
                        std::uintptr_t parentBegin = 0, parentEnd = 0;
                        const bool parentBounded = RuntimeFunctionBounds144(callsite, parentBegin, parentEnd);
                        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                            "[DW-LSG-V74-TRANSCRIPT-CALLER] index=%u callRva=0x%llX parent=%s0x%llX..%s0x%llX\r\n",
                            callers, static_cast<unsigned long long>(callsite - base),
                            parentBounded ? "" : "n/a-", static_cast<unsigned long long>(parentBounded ? parentBegin - base : 0u),
                            parentBounded ? "" : "n/a-", static_cast<unsigned long long>(parentBounded ? parentEnd - base : 0u));
                        AppendCodeBytes144(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74-TRANSCRIPT-CALLER-CODE]", callsite, 256u, 512u);

                        if (parentBounded)
                        {
                            const auto afterEnd = (std::min)(parentEnd, callsite + 0x500u);
                            unsigned downstream = 0;
                            for (std::uintptr_t ip = callsite + 5u; ip + 5u <= afterEnd && downstream < 24u; ++ip)
                            {
                                unsigned char cb[5]{};
                                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(ip), cb, sizeof(cb)) || cb[0] != 0xE8u) continue;
                                std::int32_t cr = 0; memcpy(&cr, cb + 1u, sizeof(cr));
                                const auto child = ip + 5u + static_cast<std::intptr_t>(cr);
                                if (child < base || child >= imageEnd) continue;
                                std::uintptr_t childBegin = 0, childEnd = 0;
                                const bool childBounded = RuntimeFunctionBounds144(child, childBegin, childEnd);
                                ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                                    "[DW-LSG-V74-DOWNSTREAM-CALL] callerIndex=%u seq=%u callRva=0x%llX childRva=0x%llX function=%s0x%llX..%s0x%llX\r\n",
                                    callers, downstream++, static_cast<unsigned long long>(ip - base), static_cast<unsigned long long>(child - base),
                                    childBounded ? "" : "n/a-", static_cast<unsigned long long>(childBounded ? childBegin - base : 0u),
                                    childBounded ? "" : "n/a-", static_cast<unsigned long long>(childBounded ? childEnd - base : 0u));
                                if (downstream <= 12u)
                                    AppendCodeBytes144(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74-DOWNSTREAM-CODE]", child, 32u, 160u);
                            }
                        }
                        ++callers;
                    }
                }
                __except (EXCEPTION_EXECUTE_HANDLER) {}
            }
            if (regionEnd <= scan) break;
            scan = regionEnd;
        }
        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
            "[DW-LSG-V74] KNOWN_TRANSCRIPT_CALLERS total=%u interpretation=parent_and_post_hash_calls_dumped_for_exact_derive_keys_recovery\r\n", callers);
    }

