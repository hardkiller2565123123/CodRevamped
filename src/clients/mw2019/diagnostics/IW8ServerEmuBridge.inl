                    ++argSources;
                    InternalLog(
                        "[DW-SOURCE3-V33] ARG_SOURCE index=%u label=%s arg=%s kind=MOV_IMM32 siteRva=0x%llX value=0x%08X\r\n",
                        argSources, p.label, code[i] == 0xB9u ? "RCX" : "RDX",
                        static_cast<unsigned long long>(va - base), imm);
                    continue;
                }
                if (i + 6u <= spanBytes && code[i] == 0x41u && (code[i + 1u] == 0xB8u || code[i + 1u] == 0xB9u))
                {
                    std::uint32_t imm = 0;
                    memcpy(&imm, code + i + 2u, sizeof(imm));
                    ++argSources;
                    InternalLog(
                        "[DW-SOURCE3-V33] ARG_SOURCE index=%u label=%s arg=%s kind=MOV_IMM32 siteRva=0x%llX value=0x%08X\r\n",
                        argSources, p.label, code[i + 1u] == 0xB8u ? "R8" : "R9",
                        static_cast<unsigned long long>(va - base), imm);
                    continue;
                }

                // RIP-relative LEA/MOV into the four Windows x64 argument registers.
                if (i + 7u <= spanBytes && code[i] >= 0x48u && code[i] <= 0x4Fu &&
                    (code[i + 1u] == 0x8Du || code[i + 1u] == 0x8Bu))
                {
                    const unsigned rex = code[i];
                    const unsigned modrm = code[i + 2u];
                    const unsigned mod = (modrm >> 6u) & 3u;
                    const unsigned rm = modrm & 7u;
                    const unsigned reg = ((modrm >> 3u) & 7u) + ((rex & 0x04u) ? 8u : 0u);
                    if (mod == 0u && rm == 5u)
                    {
                        std::int32_t disp = 0;
                        memcpy(&disp, code + i + 3u, sizeof(disp));
                        const std::uintptr_t target = va + 7u + static_cast<std::intptr_t>(disp);
                        ++parentRipRefs;
                        if (reg == 1u || reg == 2u || reg == 8u || reg == 9u)
                        {
                            ++argSources;
                            InternalLog(
                                "[DW-SOURCE3-V33] ARG_SOURCE index=%u label=%s arg=%s kind=%s_RIP siteRva=0x%llX "
                                "targetRva=%s0x%llX\r\n",
                                argSources, p.label, argName(reg), code[i + 1u] == 0x8Du ? "LEA" : "MOV",
                                static_cast<unsigned long long>(va - base),
                                target >= base && target < base + size ? "" : "n/a-",
                                static_cast<unsigned long long>(target >= base && target < base + size ? target - base : 0u));
                        }
                        else
                        {
                            InternalLog(
                                "[DW-SOURCE3-V33] RIP_REF label=%s siteRva=0x%llX dst=%s kind=%s targetRva=%s0x%llX\r\n",
                                p.label, static_cast<unsigned long long>(va - base), argName(reg),
                                code[i + 1u] == 0x8Du ? "LEA" : "MOV",
                                target >= base && target < base + size ? "" : "n/a-",
                                static_cast<unsigned long long>(target >= base && target < base + size ? target - base : 0u));
                        }
                        continue;
                    }

                    // Register-to-register MOV is important at a tail-call boundary.
                    if (code[i + 1u] == 0x8Bu && mod == 3u)
                    {
                        const unsigned src = rm + ((rex & 0x01u) ? 8u : 0u);
                        if (reg == 1u || reg == 2u || reg == 8u || reg == 9u)
                        {
                            ++argSources;
                            InternalLog(
                                "[DW-SOURCE3-V33] ARG_SOURCE index=%u label=%s arg=%s kind=MOV_REG siteRva=0x%llX srcReg=%u\r\n",
                                argSources, p.label, argName(reg),
                                static_cast<unsigned long long>(va - base), src);
                        }
                    }
                }

                if (i + 5u <= spanBytes && code[i] == 0xE8u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, code + i + 1u, sizeof(rel));
                    const std::uintptr_t dest = va + 5u + static_cast<std::intptr_t>(rel);
                    ++parentCalls;
                    InternalLog(
                        "[DW-SOURCE3-V33] PARENT_CALL index=%u label=%s callRva=0x%llX targetRva=%s0x%llX\r\n",
                        parentCalls, p.label, static_cast<unsigned long long>(va - base),
                        dest >= base && dest < base + size ? "" : "n/a-",
                        static_cast<unsigned long long>(dest >= base && dest < base + size ? dest - base : 0u));
                }
            }
        }

        // One level upstream: find direct calls/tail-jumps to the two bounded/heuristic
        // parent starts. This turns the V32 tail-call discovery into a concrete caller chain.
        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(textSection.begin);
        const std::uintptr_t textEnd = textBegin + textSection.size;
        unsigned char chunk[0x8000]{};
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += sizeof(chunk))
        {
            const std::size_t bytesToRead = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(sizeof(chunk)), textEnd - chunkVa));
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), chunk, bytesToRead))
                continue;
            for (std::size_t i = 0; i + 5u <= bytesToRead; ++i)
            {
                if (chunk[i] != 0xE8u && chunk[i] != 0xE9u)
                    continue;
                std::int32_t rel = 0;
                memcpy(&rel, chunk + i + 1u, sizeof(rel));
                const std::uintptr_t sourceVa = chunkVa + i;
                const std::uintptr_t dest = sourceVa + 5u + static_cast<std::intptr_t>(rel);
                for (unsigned pi = 0; pi < ArrayCount(pivots); ++pi)
                {
                    if (!spans[pi].begin || dest != spans[pi].begin || sourceVa == base + pivots[pi].edgeRva)
                        continue;
                    ++upstreamEdges;
                    std::uintptr_t ownerBegin = 0;
                    std::uintptr_t ownerEnd = 0;
                    const bool bounded = RuntimeFunctionBounds144(sourceVa, ownerBegin, ownerEnd) &&
                        ownerEnd > ownerBegin && (ownerEnd - ownerBegin) <= 0x4000u;
                    InternalLog(
                        "[DW-SOURCE3-V33] UPSTREAM index=%u label=%s kind=%s edgeRva=0x%llX parentStartRva=0x%llX "
                        "caller=%s0x%llX..%s0x%llX\r\n",
                        upstreamEdges, pivots[pi].label, chunk[i] == 0xE8u ? "CALL_REL32" : "JMP_REL32",
                        static_cast<unsigned long long>(sourceVa - base),
                        static_cast<unsigned long long>(dest - base),
                        bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerBegin - base : 0u),
                        bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? ownerEnd - base : 0u));
                    AppendCodeBytes144(L"dw_source3_v33.log", "[DW-SOURCE3-V33-UPSTREAM-CODE]", sourceVa, 64u, 96u);
                }
            }
        }

        // Address-taken parent functions can be registered through a table instead of
        // direct calls. Capture those exact .rdata cells if they exist.
        const std::uintptr_t rdataBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const std::uintptr_t rdataEnd = rdataBegin + rdata.size;
        for (std::uintptr_t cell = rdataBegin; cell + sizeof(std::uintptr_t) <= rdataEnd; cell += sizeof(std::uintptr_t))
        {
            std::uintptr_t value = 0;
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cell), &value, sizeof(value)))
                continue;
            for (unsigned pi = 0; pi < ArrayCount(pivots); ++pi)
            {
                if (!spans[pi].begin || value != spans[pi].begin)
                    continue;
                ++parentPtrCells;
                InternalLog(
                    "[DW-SOURCE3-V33] PARENT_PTR index=%u label=%s cellRva=0x%llX parentStartRva=0x%llX\r\n",
                    parentPtrCells, pivots[pi].label,
                    static_cast<unsigned long long>(cell - base),
                    static_cast<unsigned long long>(value - base));
            }
        }

        const char* interpretation =
            upstreamEdges && argSources ? "CONSTRUCTOR_PARENT_ARGUMENT_PATH_FOUND" :
            argSources ? "CONSTRUCTOR_ARGUMENT_SETUP_FOUND" :
            upstreamEdges ? "CONSTRUCTOR_PARENT_CHAIN_FOUND_NO_SIMPLE_ARG_SETUP" :
            parentPtrCells ? "CONSTRUCTOR_PARENT_REGISTERED_INDIRECTLY" :
            "CONSTRUCTOR_PARENT_DECODED_NO_UPSTREAM_OWNER";

        InternalLog(
            "[DW-SOURCE3-V33] SUMMARY liveTies=%u parentSpans=%u verifiedTailEdges=%u argSources=%u parentCalls=%u "
            "parentRipRefs=%u upstreamEdges=%u parentPtrCells=%u interpretation=%s "
            "next=trace_result_argument_to_backend_response stateWrites=off\r\n",
            liveTies, parentSpans, verifiedTailEdges, argSources, parentCalls,
            parentRipRefs, upstreamEdges, parentPtrCells, interpretation);
        ServerEmuAppend(L"dw_source3_v33.log",
            "[DW-SOURCE3-V33] SUMMARY liveTies=%u parentSpans=%u verifiedTailEdges=%u argSources=%u parentCalls=%u "
            "parentRipRefs=%u upstreamEdges=%u parentPtrCells=%u interpretation=%s "
            "next=trace_result_argument_to_backend_response stateWrites=off\r\n",
            liveTies, parentSpans, verifiedTailEdges, argSources, parentCalls,
            parentRipRefs, upstreamEdges, parentPtrCells, interpretation);

        // V34 follows the exact completion-writer helper results that V30 already
        // proved, avoiding V33's low-confidence byte-alignment argument candidate.
        QueueDwSource3ResultBackendTraceV34(object);
        return 0;
    }

    void QueueDwSource3ConstructorParentTraceV33(std::uintptr_t object) noexcept
    {
        if (!object)
            return;
        static std::atomic_bool queued{false};
        if (queued.exchange(true, std::memory_order_acq_rel))
            return;
        HANDLE thread = CreateThread(nullptr, 0, &DwSource3ConstructorParentWorkerV33,
            reinterpret_cast<LPVOID>(object), 0, nullptr);
        if (!thread)
        {
            InternalLog("[DW-SOURCE3-V33] QUEUE_FAILED error=%lu object=%p stateWrites=off\r\n",
                static_cast<unsigned long>(GetLastError()), reinterpret_cast<void*>(object));
            return;
        }
        CloseHandle(thread);
        InternalLog(
            "[DW-SOURCE3-V33] QUEUED object=%p scan=constructor_parent_arguments mode=BACKGROUND_READ_ONLY stateWrites=off\r\n",
            reinterpret_cast<void*>(object));
    }

    void DumpDwSource3TaskCompletionV28(
        std::uintptr_t object,
        unsigned char flagD,
        unsigned char flagE) noexcept
    {
        if (!object || flagE == 0u)
            return;

        bool expected = false;
        if (!g_dwSource3TaskCompletionDumpedV28.compare_exchange_strong(
                expected, true, std::memory_order_acq_rel))
            return;

        unsigned char pre[kDwSource3TaskTraceBytesV28]{};
        unsigned char current[kDwSource3TaskTraceBytesV28]{};
        std::uintptr_t trackedObject = 0;
        unsigned preUpdates = 0;

        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(object), current, sizeof(current)))
        {
            InternalLog("[DW-SOURCE3-V28] E1_TASK abort=object_unreadable object=%p stateWrites=off\r\n",
                reinterpret_cast<void*>(object));
            return;
        }

        AcquireSRWLockShared(&g_dwSource3TaskTraceLockV28);
        trackedObject = g_dwSource3TaskObjectV28;
        memcpy(pre, g_dwSource3TaskPreE1V28, sizeof(pre));
        preUpdates = g_dwSource3TaskPreE1UpdatesV28.load(std::memory_order_acquire);
        ReleaseSRWLockShared(&g_dwSource3TaskTraceLockV28);

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const bool sameObject = trackedObject == object;

        InternalLog(
            "[DW-SOURCE3-V28] E1_TASK object=%p trackedObject=%p sameObject=%s flags={D:0x%02X E:0x%02X} "
            "bytes=0x%llX preE1Updates=%u goal=locate_callback_context_result_transition read_only=yes stateWrites=off\r\n",
            reinterpret_cast<void*>(object), reinterpret_cast<void*>(trackedObject),
            sameObject ? "YES" : "no", static_cast<unsigned>(flagD), static_cast<unsigned>(flagE),
            static_cast<unsigned long long>(sizeof(current)), preUpdates);
        ServerEmuAppend(L"dw_source3_v28.log",
            "\r\n[DW-SOURCE3-V28] E1_TASK object=%p trackedObject=%p sameObject=%s flags={D:0x%02X E:0x%02X} "
            "bytes=0x%llX preE1Updates=%u read_only=yes stateWrites=off\r\n",
            reinterpret_cast<void*>(object), reinterpret_cast<void*>(trackedObject),
            sameObject ? "YES" : "no", static_cast<unsigned>(flagD), static_cast<unsigned>(flagE),
            static_cast<unsigned long long>(sizeof(current)), preUpdates);

        unsigned changedBytes = 0;
        unsigned changedQwords = 0;
        unsigned gamePointers = 0;
        unsigned interestingPointers = 0;
        unsigned nestedObjects = 0;
        unsigned nestedGamePointers = 0;
        unsigned nestedCallbackHits = 0;

        for (std::size_t i = 0; i < sizeof(current); ++i)
            if (pre[i] != current[i])
                ++changedBytes;

        for (std::size_t off = 0; off + sizeof(std::uintptr_t) <= sizeof(current); off += sizeof(std::uintptr_t))
        {
            std::uintptr_t before = 0;
            std::uintptr_t now = 0;
            memcpy(&before, pre + off, sizeof(before));
            memcpy(&now, current + off, sizeof(now));
            const bool changed = before != now;
            if (changed)
                ++changedQwords;

            const bool inGame = base && size && now >= base && now < base + size;
            const auto rva = inGame ? now - base : 0u;
            const char* label = inGame ? DwSource3TaskInterestingPointerLabelV28(rva) : nullptr;
            if (inGame)
                ++gamePointers;
            if (label)
                ++interestingPointers;

            if (changed || inGame || off == 0u || off == 8u || off == 0x10u)
            {
                InternalLog(
                    "[DW-SOURCE3-V28] FIELD off=+0x%02llX pre=0x%llX now=0x%llX changed=%s "
                    "gameRva=%s0x%llX label=%s\r\n",
                    static_cast<unsigned long long>(off),
                    static_cast<unsigned long long>(before),
                    static_cast<unsigned long long>(now),
                    changed ? "YES" : "no",
                    inGame ? "" : "n/a-",
                    static_cast<unsigned long long>(rva),
                    label ? label : "-");
                ServerEmuAppend(L"dw_source3_v28.log",
                    "[DW-SOURCE3-V28] FIELD off=+0x%02llX pre=0x%llX now=0x%llX changed=%s "
                    "gameRva=%s0x%llX label=%s\r\n",
                    static_cast<unsigned long long>(off),
                    static_cast<unsigned long long>(before),
                    static_cast<unsigned long long>(now),
                    changed ? "YES" : "no",
                    inGame ? "" : "n/a-",
                    static_cast<unsigned long long>(rva),
                    label ? label : "-");
            }

            if (!now || inGame || nestedObjects >= 16u)
                continue;

            unsigned char nested[kDwSource3NestedTraceBytesV28]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(now), nested, sizeof(nested)))
                continue;
            ++nestedObjects;

            unsigned localGamePointers = 0;
            unsigned localCallbackHits = 0;
            for (std::size_t noff = 0; noff + sizeof(std::uintptr_t) <= sizeof(nested); noff += sizeof(std::uintptr_t))
            {
                std::uintptr_t nestedValue = 0;
                memcpy(&nestedValue, nested + noff, sizeof(nestedValue));
                if (!base || !size || nestedValue < base || nestedValue >= base + size)
                    continue;
                ++localGamePointers;
                ++nestedGamePointers;
                const auto nestedRva = nestedValue - base;
                const char* nestedLabel = DwSource3TaskInterestingPointerLabelV28(nestedRva);
                if (IsDwSource3KnownCallbackRvaV28(nestedRva))
                {
                    ++localCallbackHits;
                    ++nestedCallbackHits;
                }
                if (nestedLabel || localGamePointers <= 4u)
                {
                    InternalLog(
                        "[DW-SOURCE3-V28] NESTED parentOff=+0x%02llX ptr=%p childOff=+0x%02llX "
                        "gameRva=0x%llX label=%s callbackExact=%s\r\n",
                        static_cast<unsigned long long>(off), reinterpret_cast<void*>(now),
                        static_cast<unsigned long long>(noff), static_cast<unsigned long long>(nestedRva),
                        nestedLabel ? nestedLabel : "-", IsDwSource3KnownCallbackRvaV28(nestedRva) ? "YES" : "no");
                    ServerEmuAppend(L"dw_source3_v28.log",
                        "[DW-SOURCE3-V28] NESTED parentOff=+0x%02llX ptr=%p childOff=+0x%02llX "
                        "gameRva=0x%llX label=%s callbackExact=%s\r\n",
                        static_cast<unsigned long long>(off), reinterpret_cast<void*>(now),
                        static_cast<unsigned long long>(noff), static_cast<unsigned long long>(nestedRva),
                        nestedLabel ? nestedLabel : "-", IsDwSource3KnownCallbackRvaV28(nestedRva) ? "YES" : "no");
                }
            }
            if (localCallbackHits)
            {
                InternalLog(
                    "[DW-SOURCE3-V28] NESTED_CALLBACK_OWNER parentOff=+0x%02llX ptr=%p callbackHits=%u "
                    "interpretation=TASK_OBJECT_REACHES_STOCK_RESULT_CALLBACK read_only=yes\r\n",
                    static_cast<unsigned long long>(off), reinterpret_cast<void*>(now), localCallbackHits);
            }
        }

        unsigned ranges = 0;
        for (std::size_t i = 0; i < sizeof(current) && ranges < 24u;)
        {
            if (pre[i] == current[i])
            {
                ++i;
                continue;
            }
            const std::size_t start = i;
            while (i < sizeof(current) && pre[i] != current[i] && i - start < 32u)
                ++i;
            InternalLog(
                "[DW-SOURCE3-V28] BYTE_DIFF range=%u off=+0x%02llX len=%llu preFirst=0x%02X nowFirst=0x%02X\r\n",
                ++ranges, static_cast<unsigned long long>(start),
                static_cast<unsigned long long>(i - start),
                static_cast<unsigned>(pre[start]), static_cast<unsigned>(current[start]));
        }

        const char* interpretation =
            nestedCallbackHits ? "CALLBACK_POINTER_REACHABLE_BUT_NOT_DISPATCHED" :
            interestingPointers ? "KNOWN_LOGIN_POINTERS_PRESENT_IN_TASK_OBJECT" :
            gamePointers ? "TASK_OBJECT_HAS_GAME_POINTERS_BUT_NO_KNOWN_RESULT_CALLBACK" :
            "TASK_OBJECT_COMPLETES_WITHOUT_VISIBLE_CALLBACK_POINTER";

        InternalLog(
            "[DW-SOURCE3-V28] SUMMARY changedBytes=%u changedQwords=%u gamePointers=%u interestingPointers=%u "
            "nestedObjects=%u nestedGamePointers=%u nestedCallbackHits=%u interpretation=%s "
            "next=trace_exact_task_callback_or_result_field_from_this_object stateWrites=off\r\n",
            changedBytes, changedQwords, gamePointers, interestingPointers,
            nestedObjects, nestedGamePointers, nestedCallbackHits, interpretation);
        ServerEmuAppend(L"dw_source3_v28.log",
            "[DW-SOURCE3-V28] SUMMARY changedBytes=%u changedQwords=%u gamePointers=%u interestingPointers=%u "
            "nestedObjects=%u nestedGamePointers=%u nestedCallbackHits=%u interpretation=%s "
            "next=trace_exact_task_callback_or_result_field_from_this_object stateWrites=off\r\n",
            changedBytes, changedQwords, gamePointers, interestingPointers,
            nestedObjects, nestedGamePointers, nestedCallbackHits, interpretation);

        // V33: V32 identified two real incoming tail-call parents into the live
        // task-table materializers. Trace only those parent argument setups and
        // one upstream ownership level; older V29-V32 scans stay disabled here.
        QueueDwSource3ConstructorParentTraceV33(object);
    }

    void LogDwSource3MaskFlagsV38(
        const char* phase,
        std::uint32_t controller,
        std::uint32_t mask,
        bool helperResult) noexcept
    {
        if (mask != 0x80u)
            return;

        unsigned bitIndex = 0;
        std::uintptr_t object = 0;
        unsigned char flagD = 0xFFu;
        unsigned char flagE = 0xFFu;
        const bool readable =
            ReadDwIngressMaskFlagsV38(controller, mask, bitIndex, object, flagD, flagE);

        if (!readable)
        {
            if (helperResult)
            {
                InternalLog(
                    "[DW-AUTH-SOURCE3-FLAG-V38] phase=%s controller=%u mask=0x%X object=unreadable "
                    "helperResult=%u tableRva=0x%llX stateWrites=off\r\n",
                    phase ? phase : "?", controller, mask, helperResult ? 1u : 0u,
                    static_cast<unsigned long long>(kDwIngressObjectTableRva144));
            }
            return;
        }

        // V28 follows the actual source3/slot7 task object instead of widening
        // static topology scans. Refresh the latest pre-E1 snapshot while the
        // task is live; completion is dumped once when +0x0E becomes 1.
        UpdateDwSource3TaskSnapshotV28(object, flagD, flagE, phase);
        if (flagE != 0u)
            DumpDwSource3TaskCompletionV28(object, flagD, flagE);

        const unsigned packed =
            (static_cast<unsigned>(flagD)) |
            (static_cast<unsigned>(flagE) << 8u) |
            ((bitIndex & 0xFFu) << 16u);
        const unsigned previous =
            g_dwSource3MaskFlagSnapshot144.exchange(packed, std::memory_order_acq_rel);
        const std::uintptr_t previousObject =
            g_dwSource3MaskObject144.exchange(object, std::memory_order_acq_rel);

        const bool changed = previous == 0xFFFFFFFFu || previous != packed || previousObject != object;
        if (!changed && !helperResult)
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const bool objectInGame = base && size && object >= base && object < base + size;
        const std::uintptr_t objectRva = objectInGame ? object - base : 0;

        InternalLog(
            "[DW-AUTH-SOURCE3-FLAG-V38] phase=%s controller=%u mask=0x%X bitIndex=%u tableIndex=%u "
            "tableRva=0x%llX object=%p objectRva=%s0x%llX flagD=0x%02X flagE=0x%02X helperResult=%u "
            "changed=%s semantics={pre:D_or_E,second:E_only} read_only=yes stateWrites=off\r\n",
            phase ? phase : "?", controller, mask, bitIndex,
            controller * 31u + bitIndex,
            static_cast<unsigned long long>(kDwIngressObjectTableRva144),
            reinterpret_cast<void*>(object),
            objectInGame ? "" : "n/a-",
            static_cast<unsigned long long>(objectRva),
            static_cast<unsigned>(flagD), static_cast<unsigned>(flagE),
            helperResult ? 1u : 0u, changed ? "yes" : "no");
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-AUTH-SOURCE3-FLAG-V38] phase=%s controller=%u mask=0x%X bitIndex=%u tableIndex=%u "
            "tableRva=0x%llX object=%p flagD=0x%02X flagE=0x%02X helperResult=%u changed=%s "
            "semantics={pre:D_or_E,second:E_only} read_only=yes stateWrites=off\r\n",
            phase ? phase : "?", controller, mask, bitIndex,
            controller * 31u + bitIndex,
            static_cast<unsigned long long>(kDwIngressObjectTableRva144),
            reinterpret_cast<void*>(object),
            static_cast<unsigned>(flagD), static_cast<unsigned>(flagE),
            helperResult ? 1u : 0u, changed ? "yes" : "no");
    }

    void ScanDwSource3MaskFlagWritersV38() noexcept
    {
        if (g_dwSource3MaskFlagWriterScanDone144.exchange(true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView text{};
        if (!base || !module || !GetImageSection(module, ".text", text) || !text.begin || !text.size)
        {
            InternalLog("[DW-AUTH-SOURCE3-WRITER-V38] unavailable reason=no_text_section stateWrites=off\r\n");
            return;
        }

        struct Range144
        {
            std::uintptr_t firstRva;
            std::uintptr_t lastRva;
            const char* label;
        };
        static constexpr Range144 ranges[] = {
            { 0x02B00000u, 0x02C00000u, "dw_mask_task_helpers" },
            { 0x03C00000u, 0x03E00000u, "dw_auth_pump" },
            { 0x06B00000u, 0x06D80000u, "dw_transport_auth" },
        };

        const std::uintptr_t textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const std::uintptr_t textEnd = textBegin + text.size;
        unsigned candidates = 0;

        InternalLog(
            "[DW-AUTH-SOURCE3-WRITER-V38] BEGIN targetOffsets={+0x0D,+0x0E} ranges=%llu "
            "mode=FOCUSED_STATIC_BYTE_WRITE_SCAN read_only=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(ArrayCount(ranges)));

        for (const auto& range : ranges)
        {
            const std::uintptr_t begin = (std::max)(textBegin, base + range.firstRva);
            const std::uintptr_t end = (std::min)(textEnd, base + range.lastRva);
            if (end <= begin)
                continue;

            for (std::uintptr_t cursor = begin; cursor + 8u <= end && candidates < 80u; ++cursor)
            {
                unsigned char op[8]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), op, sizeof(op)))
                    continue;

                const unsigned char opcode = op[0];
                const unsigned char modrm = op[1];
