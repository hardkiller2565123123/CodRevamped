        // legacy shortest-path searches so a disconnected/large graph cannot starve the
        // useful cross-component join analysis.
        InternalLog("[DW-GRAPH-V50] BRIDGE_PHASE_ENTER reason=run_before_legacy_paths nodes=%zu edges=%zu stateWrites=off\r\n",
            nodes.size(), edges.size());
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] BRIDGE_PHASE_ENTER reason=run_before_legacy_paths nodes=%zu edges=%zu stateWrites=off\r\n",
            nodes.size(), edges.size());

        DwV49RunFocusedGateProof(nodes, edges);
        DwRankLogBridgeAnalysisV45(nodes, edges);

        const unsigned long long v46Elapsed = static_cast<unsigned long long>(GetTickCount64() - startMs);
        InternalLog("[DW-GRAPH-V50] SUMMARY nodes=%zu edges=%zu reverseIndex=%zu expanded=%u hotNodes=%u protocolNodes=%u reverseAdds=%u elapsedMs=%llu interpretation=GLOBAL_GATE_RULED_OUT_TERMINAL_STATE_WRITER_IS_ACTIVE_PIVOT next=trace_missing_primary_callback_dispatch stateWrites=off\r\n",
            nodes.size(), edges.size(), reverse.size(), expanded, hotNodes, protocolNodes, reverseAdds, v46Elapsed);
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] SUMMARY nodes=%zu edges=%zu reverseIndex=%zu expanded=%u hotNodes=%u protocolNodes=%u reverseAdds=%u elapsedMs=%llu interpretation=GLOBAL_GATE_RULED_OUT_TERMINAL_STATE_WRITER_IS_ACTIVE_PIVOT next=trace_missing_primary_callback_dispatch stateWrites=off\r\n",
            nodes.size(), edges.size(), reverse.size(), expanded, hotNodes, protocolNodes, reverseAdds, v46Elapsed);

        InternalLog("[DW-GRAPH-V50] LEGACY_PATHS_SKIPPED reason=global_gate_table_proof_keeps_legacy_paths_disabled stateWrites=off\r\n");
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] LEGACY_PATHS_SKIPPED reason=global_gate_table_proof_keeps_legacy_paths_disabled stateWrites=off\r\n");
