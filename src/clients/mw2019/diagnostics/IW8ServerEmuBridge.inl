        InternalLog("[BNET-FENCE-STATE1-V54] VTABLE_FIELD80 deferred=V55_BOUNDED_PROVENANCE reason=avoid_cross_function_spillover no_state_writes=yes\r\n");
        ServerEmuAppend(L"bnet_fence_state1_v54.log",
            "[BNET-FENCE-STATE1-V54] VTABLE_FIELD80 deferred=V55_BOUNDED_PROVENANCE reason=avoid_cross_function_spillover no_state_writes=yes\r\n");

        InternalLog("[BNET-FENCE-STATE1-V54] SUMMARY exactWriter=%s exactGuard=%s currentField80=%s%u familyField80Mutations=%u nonZeroImmediate=%u vtableField80Mutations=%u next=%s output=bnet_fence_state1_v54.log no_hooks=yes no_state_writes=yes\r\n",
            writer ? "YES" : "NO", exactGuard ? "YES" : "NO",
            field80Ok ? "" : "UNREADABLE/", field80Ok ? field80 : 0u,
            familyMutations, nonZeroImmediate, vtableField80Mutations,
            field80Ok && field80 == 0u ?
                "identify_native_nonzero_writer_for_fence_plus_0x80_then_trace_its_input_callback" :
