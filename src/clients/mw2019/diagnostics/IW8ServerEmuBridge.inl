        unsigned writerAHits = 0, writerBHits = 0, writerCHits = 0;
        unsigned knownHits = 0;
        static constexpr std::size_t tableOffsets[] = {0x00u, 0x50u, 0xA0u, 0xF0u};
        for (const auto off : tableOffsets)
        {
            std::uintptr_t table = 0;
            const bool tablePtrOk = taskObject &&
                ServerEmuSafeReadBytes(reinterpret_cast<const void*>(taskObject + off), &table, sizeof(table));
            const bool tableInGame = tablePtrOk && table >= base && table < base + size;
            InternalLog(
                "[DW-SOURCE3-V54] TASK_TABLE off=+0x%02llX ptr=%p rva=%s0x%llX readable=%s scanEntries=%u stateWrites=off\r\n",
                static_cast<unsigned long long>(off), reinterpret_cast<void*>(table), tableInGame ? "" : "n/a-",
                static_cast<unsigned long long>(tableInGame ? table - base : 0u), tableInGame ? "YES" : "no", 24u);
            ServerEmuAppend(L"dw_source3_v54_writer_branch_proof.log",
                "[DW-SOURCE3-V54] TASK_TABLE off=+0x%02llX ptr=%p rva=%s0x%llX readable=%s scanEntries=%u stateWrites=off\r\n",
                static_cast<unsigned long long>(off), reinterpret_cast<void*>(table), tableInGame ? "" : "n/a-",
                static_cast<unsigned long long>(tableInGame ? table - base : 0u), tableInGame ? "YES" : "no", 24u);
            if (!tableInGame)
