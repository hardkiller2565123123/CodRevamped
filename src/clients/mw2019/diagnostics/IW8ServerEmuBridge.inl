            ? g_wsaIoctlOriginal(socket, controlCode, inBuffer, inBufferSize, outBuffer, outBufferSize,
                bytesReturned, overlapped, completion)
            : SOCKET_ERROR;
        const int error = result == SOCKET_ERROR ? WSAGetLastError() : 0;

        if (result == 0 && controlCode == SIO_GET_EXTENSION_FUNCTION_POINTER &&
            inBuffer && inBufferSize >= sizeof(GUID) && outBuffer && outBufferSize >= sizeof(void*))
        {
            const GUID* requested = reinterpret_cast<const GUID*>(inBuffer);
            const GUID connectExGuid = WSAID_CONNECTEX;
            if (memcmp(requested, &connectExGuid, sizeof(GUID)) == 0)
            {
                void** functionSlot = reinterpret_cast<void**>(outBuffer);
                void* discovered = *functionSlot;
                if (discovered && discovered != reinterpret_cast<void*>(&ServerEmuConnectEx))
                {
                    g_connectExOriginal = reinterpret_cast<ConnectExFn>(discovered);
                    *functionSlot = reinterpret_cast<void*>(&ServerEmuConnectEx);
                    char where[96]{};
                    FormatCaller(caller, where, ArrayCount(where));
                    InternalLog("[NET-HOOK] ConnectEx extension captured original=%p wrapper=%p caller=%s\r\n",
                        discovered, reinterpret_cast<void*>(&ServerEmuConnectEx), where);
                    ServerEmuAppend(L"network_trace.log",
                        "[WSAIOCTL] ConnectEx extension captured original=%p wrapper=%p caller=%s\r\n",
                        discovered, reinterpret_cast<void*>(&ServerEmuConnectEx), where);
                }
            }
        }

        if (result == SOCKET_ERROR) WSASetLastError(error);
        return result;
    }

