                        static_cast<unsigned long long>(target - base),
                        b[1] == 0x8D ? "LEA" : "MOV",
                        printableLen >= 3u ? "yes" : "no",
                        printableLen >= 3u ? printable : "",
                        static_cast<long long>(cursor) - static_cast<long long>(xref));
                    ServerEmuAppend(L"dw_lsg_transition.log",
                        "[DW-LSG-TRANSITION-V44] RIP index=%u instructionRva=0x%llX targetRva=0x%llX op=%s printable=%s value='%s' deltaFromConnecting=%+lld read_only=yes\r\n",
                        ripRefs,
