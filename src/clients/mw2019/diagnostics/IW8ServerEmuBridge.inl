        }

        static constexpr unsigned char stockSha256[32] = {
            0x35,0x6C,0x4B,0xC3,0x9A,0x66,0x4D,0xD9,
            0xA1,0x49,0x64,0xA3,0xA4,0x42,0x58,0xD8,
