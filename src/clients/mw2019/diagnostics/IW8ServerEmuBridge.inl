            printableRefs || calleePrintableRefs ? "RESULT_HELPER_RESPONSE_FIELD_EVIDENCE_FOUND" :
            knownEdges ? "RESULT_HELPER_REACHES_KNOWN_DW_STATE_PATH" :
            boundedHelpers ? "RESULT_HELPER_CHAIN_DECODED_NO_PRINTABLE_RESPONSE_FIELD" :
