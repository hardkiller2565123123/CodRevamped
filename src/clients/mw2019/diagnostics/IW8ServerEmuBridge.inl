            unreadableChunks, g_bnetFenceAdapterCallsV57.load(std::memory_order_acquire), next);
        ServerEmuAppend(L"bnet_fence_registration_v58.log",
            "[BNET-FENCE-REG-V58] SUMMARY targetRefs=%u adapterRefs=%u registrationOwners=%u ownerCalls=%u incomingOwnerEdges=%u incomingPostFenceRefs=%u unreadableTextChunks=%u v57AdapterCalls=%u next=%s no_state_writes=yes\r\n",
