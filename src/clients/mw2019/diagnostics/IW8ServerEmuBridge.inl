        // post-call back-edge explicitly so owner0 semantics are not ambiguous.
        unsigned char loopBytes[2]{};
        bool owner0Loop = false;
        std::uintptr_t owner0LoopTarget = 0;
        if (kOwner0BackEdgeRva + sizeof(loopBytes) <= size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + kOwner0BackEdgeRva), loopBytes, sizeof(loopBytes)) &&
            loopBytes[0] >= 0x70u && loopBytes[0] <= 0x7Fu)
        {
            const std::int8_t rel = static_cast<std::int8_t>(loopBytes[1]);
            owner0LoopTarget = kOwner0BackEdgeRva + 2u + static_cast<std::intptr_t>(rel);
            owner0Loop = owner0LoopTarget < kOwner0BackEdgeRva;
            InternalLog("[DW-SOURCE3-V39] OWNER0_BACKEDGE siteRva=0x%llX opcode=0x%02X targetRva=0x%llX backward=%s\r\n",
                static_cast<unsigned long long>(kOwner0BackEdgeRva), loopBytes[0],
                static_cast<unsigned long long>(owner0LoopTarget), owner0Loop ? "YES" : "no");
        }

        unsigned edxSources = 0, hardcodedEvent1 = 0, inheritedOrDynamic = 0;
        for (const auto& call : kDwStatusIndirectCallsV39)
        {
            LogDwSource3V39Hex(call.label, call.ownerBeginRva,
                static_cast<std::size_t>(call.ownerEndRva - call.ownerBeginRva));
            if (call.siteRva <= call.ownerBeginRva || call.siteRva >= call.ownerEndRva) continue;
            const std::uintptr_t scanBeginRva = call.siteRva > 0x40u ?
                (std::max)(call.ownerBeginRva, call.siteRva - 0x40u) : call.ownerBeginRva;
            const std::size_t n = static_cast<std::size_t>(call.siteRva - scanBeginRva);
            unsigned char code[0x80]{};
            if (!n || n > sizeof(code) ||
                !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + scanBeginRva), code, n))
                continue;

            std::uintptr_t bestSite = 0;
            const char* bestKind = "INHERITED_OR_DYNAMIC";
            std::uint32_t bestImm = 0;
            unsigned bestSrcReg = 0xFFu;
            std::int32_t bestDisp = 0;

            for (std::size_t i = 0; i < n; ++i)
            {
                const std::uintptr_t siteRva = scanBeginRva + i;
                if (i + 5u <= n && code[i] == 0xBAu)
                {
                    std::uint32_t imm = 0; memcpy(&imm, code + i + 1u, sizeof(imm));
                    bestSite = siteRva; bestKind = "MOV_EDX_IMM32"; bestImm = imm; bestSrcReg = 0xFFu; bestDisp = 0;
                }
                if (i + 2u <= n && code[i] == 0x8Bu)
                {
                    const unsigned m = code[i + 1u];
                    const unsigned dst = (m >> 3) & 7u;
                    const unsigned mod = m >> 6;
                    const unsigned rm = m & 7u;
                    if (dst == 2u)
                    {
                        std::int32_t disp = 0;
                        if (mod == 1u && i + 3u <= n) disp = static_cast<std::int8_t>(code[i + 2u]);
                        else if (mod == 2u && i + 6u <= n) memcpy(&disp, code + i + 2u, sizeof(disp));
                        bestSite = siteRva; bestKind = mod == 3u ? "MOV_EDX_REG" : "MOV_EDX_MEM";
                        bestSrcReg = rm; bestDisp = disp; bestImm = 0;
                    }
                }
