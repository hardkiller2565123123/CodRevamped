        }

        InternalLog("[DW-LSG-TRANSITION-V44] SUMMARY calls=%u branches=%u ripRefs=%u portCandidates=%u output=dw_lsg_transition.log next=classify_guard_before_connecting_lsg stateWrites=off no_hooks=yes\r\n",
