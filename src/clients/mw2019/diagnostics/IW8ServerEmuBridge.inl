                {
                    const unsigned m = code[i + 1u];
                    const unsigned mod = m >> 6;
                    const unsigned src = (m >> 3) & 7u;
                    const unsigned rm = m & 7u;
                    if (mod == 3u && rm == 2u)
                    {
                        bestSite = siteRva; bestKind = "MOV_EDX_REG"; bestSrcReg = src; bestDisp = 0; bestImm = 0;
                    }
                }
            }

            ++edxSources;
            if (!bestSite) ++inheritedOrDynamic;
            if (bestSite && strcmp(bestKind, "MOV_EDX_IMM32") == 0 && bestImm == 1u) ++hardcodedEvent1;
            InternalLog("[DW-SOURCE3-V39] EDX_SOURCE index=%u label=%s callRva=0x%llX sourceRva=%s0x%llX kind=%s imm=0x%X srcReg=%u disp=%d status1Immediate=%s\r\n",
                edxSources, call.label, static_cast<unsigned long long>(call.siteRva),
                bestSite ? "" : "n/a-", static_cast<unsigned long long>(bestSite),
                bestKind, bestImm, bestSrcReg, bestDisp,
                (bestSite && strcmp(bestKind, "MOV_EDX_IMM32") == 0 && bestImm == 1u) ? "YES" : "no");
        }

        unsigned incomingEvent1 = 0, incomingEdges = 0;
        const std::uintptr_t localBeginRva = 0x452E000u;
        const std::uintptr_t localEndRva = (std::min)(size, static_cast<std::uintptr_t>(0x4540000u));
        for (std::uintptr_t pRva = localBeginRva; pRva + 5u <= localEndRva; ++pRva)
        {
            unsigned char b[5]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + pRva), b, sizeof(b))) continue;
            if (b[0] != 0xE8u && b[0] != 0xE9u) continue;
            std::int32_t rel = 0; memcpy(&rel, b + 1u, sizeof(rel));
            const std::uintptr_t targetRva = pRva + 5u + static_cast<std::intptr_t>(rel);
            bool ownerTarget = false;
            for (const auto& call : kDwStatusIndirectCallsV39)
                if (targetRva == call.ownerBeginRva) { ownerTarget = true; break; }
            if (!ownerTarget) continue;
