        const auto size = MainImageSize();
        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        if (!base || !size || d.BNetFirstStatePumpGuardDescriptorTable >= size)
            return -2;

        int match = -1;
        for (unsigned i = 0; i < 6u; ++i)
        {
            keys[i] = 0xFFFFFFFFu;
            const auto address = base + d.BNetFirstStatePumpGuardDescriptorTable +
                i * d.BNetFirstStatePumpGuardDescriptorStride;
            std::uint32_t key = 0;
            if (ServerEmuSafeReadU32(reinterpret_cast<const void*>(address), key))
            {
                keys[i] = key;
                if (key == static_cast<std::uint32_t>(selector) && match < 0)
                    match = static_cast<int>(i);
            }
        }
        return match;
    }

    bool __fastcall BNetFirstStatePumpGuardObserver144(std::uintptr_t arg0, void* tokenOut) noexcept
    {
        const unsigned call = ++g_bnetFirstStateGuardCalls;
        std::uint32_t descriptorKeys[6]{};
        const int descriptorIndex = BNetFirstStateGuardDescriptorIndex144(arg0, descriptorKeys);

        std::uintptr_t beforeBuffer = 0;
        std::uintptr_t beforeLength = 0;
        std::uintptr_t beforeMeta = 0;
        if (tokenOut)
        {
            ServerEmuSafeReadPointer(tokenOut, beforeBuffer);
            ServerEmuSafeReadPointer(reinterpret_cast<const unsigned char*>(tokenOut) + sizeof(std::uintptr_t), beforeLength);
            ServerEmuSafeReadPointer(reinterpret_cast<const unsigned char*>(tokenOut) + sizeof(std::uintptr_t) * 2u, beforeMeta);
        }

        // Call the stock guard first so its normal token/decryption work still runs.
        // V47 leaves this returned readiness result stock. Mark this thread while
        // the original guard executes so the DPAPI observer can
        // report only decrypt attempts that belong to this exact stock decision.
        const bool previousActive = g_bnetFirstStateGuardActive;
        const unsigned previousCall = g_bnetFirstStateGuardActiveCall;
        const std::uintptr_t previousArg0 = g_bnetFirstStateGuardActiveArg0;
        g_bnetFirstStateGuardActive = true;
        g_bnetFirstStateGuardActiveCall = call;
        g_bnetFirstStateGuardActiveArg0 = arg0;
        const bool stockResult = g_bnetFirstStatePumpGuardOriginal ?
            g_bnetFirstStatePumpGuardOriginal(arg0, tokenOut) : false;
        g_bnetFirstStateGuardActive = previousActive;
        g_bnetFirstStateGuardActiveCall = previousCall;
        g_bnetFirstStateGuardActiveArg0 = previousArg0;

        // V47 correction: V46 targeted the wrong layer. The BNet WEB_TOKEN guard
        // now always returns its stock result. The 1->2 experiment is performed
        // only at the dynamically identified Demonware bdLogin status getter.
        const bool forced = false;
        const bool effectiveResult = stockResult;

        std::uintptr_t afterBuffer = 0;
        std::uintptr_t afterLength = 0;
        std::uintptr_t afterMeta = 0;
        if (tokenOut)
        {
            ServerEmuSafeReadPointer(tokenOut, afterBuffer);
            ServerEmuSafeReadPointer(reinterpret_cast<const unsigned char*>(tokenOut) + sizeof(std::uintptr_t), afterLength);
            ServerEmuSafeReadPointer(reinterpret_cast<const unsigned char*>(tokenOut) + sizeof(std::uintptr_t) * 2u, afterMeta);
        }

        if (g_bnetFirstStatePumpDepth != 0)
        {
            g_bnetFirstStateGuardSeenInPump = true;
            g_bnetFirstStateGuardResultInPump = effectiveResult;
            g_bnetFirstStateGuardArg0InPump = arg0;
            g_bnetFirstStateGuardOutInPump = reinterpret_cast<std::uintptr_t>(tokenOut);
            g_bnetFirstStateGuardBufferInPump = afterBuffer;
            g_bnetFirstStateGuardLengthInPump = afterLength;
            g_bnetFirstStateGuardMetaInPump = afterMeta;
        }

        const bool webSeen = g_bnetWebTokenTemplateSeen.load(std::memory_order_acquire);
        const bool webMatch = g_bnetWebTokenTemplateMatch.load(std::memory_order_acquire);
        const char* descriptorClass = descriptorIndex >= 0 ? "MATCH" : (descriptorIndex == -1 ? "NO_MATCH" : "UNREADABLE");
        InternalLog("[AUTH-GATE-FORCE144] guard call=%u stock=%s effective=%s forced=%s mode=%s arg0=0x%llX descriptor=%s/%d WEB_TOKEN={seen=%s template=%s} firstPartyOnly=yes dwStateUntouched=yes\r\n",
            call, stockResult ? "TRUE" : "FALSE", effectiveResult ? "TRUE" : "FALSE", forced ? "YES" : "no",
            "STOCK_V47_BNET_GUARD", static_cast<unsigned long long>(arg0), descriptorClass, descriptorIndex,
            webSeen ? "yes" : "no", webMatch ? "MATCH" : "DIFFERENT");
        ServerEmuAppend(L"auth_gate_runtime.log",
            "[AUTH-GATE-FORCE144] guard call=%u stock=%s effective=%s forced=%s mode=%s arg0=0x%llX descriptor=%s/%d keys=[%u,%u,%u,%u,%u,%u] tokenOut=%p beforeBuffer=%p beforeLengthLike=%llu beforeMeta=0x%llX afterBuffer=%p afterLengthLike=%llu afterMeta=0x%llX WEB_TOKEN_seen=%s WEB_TOKEN_template=%s contents=REDACTED firstPartyOnly=yes dwStateUntouched=yes\r\n",
            call, stockResult ? "TRUE" : "FALSE", effectiveResult ? "TRUE" : "FALSE", forced ? "YES" : "no",
            "STOCK_V47_BNET_GUARD", static_cast<unsigned long long>(arg0), descriptorClass, descriptorIndex,
            descriptorKeys[0], descriptorKeys[1], descriptorKeys[2], descriptorKeys[3], descriptorKeys[4], descriptorKeys[5], tokenOut,
            reinterpret_cast<void*>(beforeBuffer), static_cast<unsigned long long>(beforeLength), static_cast<unsigned long long>(beforeMeta),
            reinterpret_cast<void*>(afterBuffer), static_cast<unsigned long long>(afterLength), static_cast<unsigned long long>(afterMeta),
            webSeen ? "yes" : "no", webMatch ? "MATCH" : "DIFFERENT");
        return effectiveResult;
    }

    bool ServerEmuPatchCodeByte144(void* address, BYTE value, BYTE* previous = nullptr) noexcept
    {
        if (!address)
            return false;
        DWORD oldProtect = 0;
        if (!VirtualProtect(address, 1u, PAGE_EXECUTE_READWRITE, &oldProtect))
            return false;
        if (previous)
            *previous = *reinterpret_cast<volatile BYTE*>(address);
        *reinterpret_cast<volatile BYTE*>(address) = value;
        DWORD ignored = 0;
        VirtualProtect(address, 1u, oldProtect, &ignored);
        FlushInstructionCache(GetCurrentProcess(), address, 1u);
        return true;
    }

