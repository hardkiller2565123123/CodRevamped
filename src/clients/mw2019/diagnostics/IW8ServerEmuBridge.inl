    static bool DwGraphInKnownRangeV40(std::uintptr_t rva, const char** label = nullptr) noexcept
    {
        for (const auto& range : kDwGraphRangesV40)
        {
            if (rva >= range.beginRva && rva < range.endRva)
            {
                if (label) *label = range.label;
                return true;
            }
        }
        return false;
    }

    static bool DwGraphLooksLikeImageCodeV40(std::uintptr_t rva, const ImageSectionView& text) noexcept
    {
        return rva >= text.rva && rva < text.rva + text.size;
    }

    static int DwGraphFindNodeV40(const std::vector<DwGraphNodeV40>& nodes, std::uintptr_t rva) noexcept
    {
        for (std::size_t i = 0; i < nodes.size(); ++i)
        {
            const auto& n = nodes[i];
            if (rva == n.rva || (n.beginRva && rva >= n.beginRva && rva < n.endRva))
                return static_cast<int>(i);
        }
        return -1;
    }

    static int DwGraphAddNodeV40(std::vector<DwGraphNodeV40>& nodes, std::uintptr_t rva,
        unsigned depth, unsigned origin, const ImageSectionView& text) noexcept
    {
        if (!DwGraphLooksLikeImageCodeV40(rva, text)) return -1;
        const int existing = DwGraphFindNodeV40(nodes, rva);
        if (existing >= 0)
        {
            if (depth < nodes[static_cast<std::size_t>(existing)].depth)
                nodes[static_cast<std::size_t>(existing)].depth = depth;
            return existing;
        }
        if (nodes.size() >= 1200u) return -1;

        DwGraphNodeV40 node{};
        node.rva = rva;
        node.depth = depth;
        node.origin = origin;
        std::uintptr_t beginAbs = 0, endAbs = 0;
        const auto base = MainImageBase();
        if (base && RuntimeFunctionBounds144(base + rva, beginAbs, endAbs) &&
            beginAbs >= base && endAbs > beginAbs && endAbs - beginAbs <= 0x2000u)
        {
            node.beginRva = beginAbs - base;
            node.endRva = endAbs - base;
            node.rva = node.beginRva;
        }
        else
        {
            node.beginRva = rva;
            node.endRva = (std::min)(rva + static_cast<std::uintptr_t>(0x180u),
                text.rva + static_cast<std::uintptr_t>(text.size));
        }
        nodes.push_back(node);
        return static_cast<int>(nodes.size() - 1u);
    }

    static void DwGraphLogArgWindowV40(std::uintptr_t callRva, std::uintptr_t fnBeginRva,
        const unsigned char* code, std::size_t codeSize) noexcept
    {
        if (!code || !codeSize || callRva < fnBeginRva) return;
        const std::size_t callOff = static_cast<std::size_t>(callRva - fnBeginRva);
        if (callOff > codeSize) return;
        const std::size_t start = callOff > 0x50u ? callOff - 0x50u : 0u;
        for (std::size_t i = start; i < callOff; ++i)
        {
            const std::uintptr_t site = fnBeginRva + i;
            if (i + 5u <= codeSize && (code[i] == 0xB9u || code[i] == 0xBAu))
            {
                std::uint32_t imm = 0; memcpy(&imm, code + i + 1u, sizeof(imm));
                const char* reg = code[i] == 0xB9u ? "ECX" : "EDX";
                InternalLog("[DW-GRAPH-V40] ARG callRva=0x%llX siteRva=0x%llX reg=%s kind=IMM32 value=0x%X\r\n",
                    static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), reg, imm);
                ServerEmuAppend(L"dw_source3_v40_graph.log",
                    "[DW-GRAPH-V40] ARG callRva=0x%llX siteRva=0x%llX reg=%s kind=IMM32 value=0x%X\r\n",
                    static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), reg, imm);
                if (code[i] == 0xBAu && (imm == 1u || imm == 2u || imm == 3u || imm == 0x21u || imm == 1000u))
                {
                    InternalLog("[DW-GRAPH-V40] HOT_EDX callRva=0x%llX siteRva=0x%llX value=0x%X significance=%s\r\n",
                        static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), imm,
                        imm == 1u ? "STATUS1_EVENT_OR_FAILURE" : imm == 0x21u ? "CONNECTED_STATUS" : imm == 1000u ? "RESULT1000" : "STATUS_OR_COMMAND");
                    ServerEmuAppend(L"dw_source3_v40_graph.log",
                        "[DW-GRAPH-V40] HOT_EDX callRva=0x%llX siteRva=0x%llX value=0x%X\r\n",
                        static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), imm);
                }
            }
            if (i + 6u <= codeSize && code[i] == 0x41u && (code[i + 1u] == 0xB8u || code[i + 1u] == 0xB9u))
            {
                std::uint32_t imm = 0; memcpy(&imm, code + i + 2u, sizeof(imm));
                const char* reg = code[i + 1u] == 0xB8u ? "R8D" : "R9D";
                InternalLog("[DW-GRAPH-V40] ARG callRva=0x%llX siteRva=0x%llX reg=%s kind=IMM32 value=0x%X\r\n",
                    static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), reg, imm);
                ServerEmuAppend(L"dw_source3_v40_graph.log",
                    "[DW-GRAPH-V40] ARG callRva=0x%llX siteRva=0x%llX reg=%s kind=IMM32 value=0x%X\r\n",
                    static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site), reg, imm);
            }
            if (i + 2u <= codeSize && (code[i] == 0x8Bu || code[i] == 0x89u))
            {
                const unsigned m = code[i + 1u];
                if ((m >> 6) == 3u)
                {
                    const unsigned reg = (m >> 3) & 7u;
                    const unsigned rm = m & 7u;
                    const unsigned dst = code[i] == 0x8Bu ? reg : rm;
                    const unsigned src = code[i] == 0x8Bu ? rm : reg;
                    if (dst == 1u || dst == 2u)
                    {
                        InternalLog("[DW-GRAPH-V40] ARG callRva=0x%llX siteRva=0x%llX reg=%s kind=MOV_REG srcReg=%u\r\n",
                            static_cast<unsigned long long>(callRva), static_cast<unsigned long long>(site),
                            dst == 1u ? "ECX" : "EDX", src);
                    }
                }
            }
        }
    }

    static void DwGraphScanPointerTableV40(std::uintptr_t targetRva, unsigned depth, unsigned origin,
        std::vector<DwGraphNodeV40>& nodes, std::vector<DwGraphEdgeV40>& edges,
        const ImageSectionView& text) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || targetRva >= size) return;
        const std::size_t span = (std::min)(static_cast<std::size_t>(0x80u), size - static_cast<std::size_t>(targetRva));
        unsigned char raw[0x80]{};
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + targetRva), raw, span)) return;

        for (std::size_t off = 0; off + 8u <= span; off += 8u)
        {
            std::uintptr_t ptr = 0; memcpy(&ptr, raw + off, sizeof(ptr));
            if (ptr >= base && ptr < base + size)
            {
                const std::uintptr_t rva = ptr - base;
                if (DwGraphLooksLikeImageCodeV40(rva, text))
                {
                    DwGraphAddNodeV40(nodes, rva, depth + 1u, origin, text);
                    edges.push_back({targetRva, targetRva + off, rva, "TABLE_PTR64", depth});
                    InternalLog("[DW-GRAPH-V40] TABLE_PTR cellRva=0x%llX targetRva=0x%llX\r\n",
                        static_cast<unsigned long long>(targetRva + off), static_cast<unsigned long long>(rva));
                }
            }
        }
        for (std::size_t off = 0; off + 4u <= span; off += 4u)
        {
            std::uint32_t candidate = 0; memcpy(&candidate, raw + off, sizeof(candidate));
            const std::uintptr_t absoluteRva = static_cast<std::uintptr_t>(candidate);
            if (DwGraphLooksLikeImageCodeV40(absoluteRva, text))
            {
                DwGraphAddNodeV40(nodes, absoluteRva, depth + 1u, origin, text);
                edges.push_back({targetRva, targetRva + off, absoluteRva, "TABLE_RVA32", depth});
            }

            std::int32_t relative = 0; memcpy(&relative, raw + off, sizeof(relative));
            const std::intptr_t signedTarget = static_cast<std::intptr_t>(targetRva) + static_cast<std::intptr_t>(off) + static_cast<std::intptr_t>(relative);
            if (signedTarget >= 0)
            {
                const std::uintptr_t relativeRva = static_cast<std::uintptr_t>(signedTarget);
                if (relativeRva != absoluteRva && DwGraphLooksLikeImageCodeV40(relativeRva, text))
                {
                    DwGraphAddNodeV40(nodes, relativeRva, depth + 1u, origin, text);
                    edges.push_back({targetRva, targetRva + off, relativeRva, "TABLE_REL32", depth});
                    InternalLog("[DW-GRAPH-V40] SWITCH_TARGET cellRva=0x%llX targetRva=0x%llX kind=REL32\r\n",
                        static_cast<unsigned long long>(targetRva + off), static_cast<unsigned long long>(relativeRva));
                }
            }
        }
    }

    DWORD WINAPI DwSource3OneShotGraphExplorerWorkerV40(LPVOID) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView text{}, rdata{}, data{};
        if (!base || !size || !module || !GetImageSection(module, ".text", text))
        {
            InternalLog("[DW-GRAPH-V40] ERROR invalid_context stateWrites=off\r\n");
            return 0;
        }
        GetImageSection(module, ".rdata", rdata);
        GetImageSection(module, ".data", data);

        std::vector<DwGraphNodeV40> nodes;
        std::vector<DwGraphEdgeV40> edges;
        static constexpr std::size_t kMaxNodes = 1200u;
        static constexpr unsigned kMaxDepth = 9u;
        static constexpr unsigned kMaxRounds = 6u;
        nodes.reserve(kMaxNodes);
        edges.reserve(8000u);
        for (unsigned i = 0; i < ArrayCount(kDwGraphSeedsV40); ++i)
            DwGraphAddNodeV40(nodes, kDwGraphSeedsV40[i], 0u, i + 1u, text);

        InternalLog("[DW-GRAPH-V40] BEGIN seeds=%zu maxNodes=%zu maxDepth=%u rounds=%u methods={direct_calls,jumps,jcc,rip_refs,pointer_tables,rva_tables,rel32_switch_tables,indirect_sites,arg_flow,reverse_direct_callers} mode=ONE_SHOT_RABBIT_HOLE_GRAPH stateWrites=off\r\n",
            ArrayCount(kDwGraphSeedsV40), kMaxNodes, kMaxDepth, kMaxRounds);
        ServerEmuAppend(L"dw_source3_v40_graph.log",
            "[DW-GRAPH-V40] BEGIN seeds=%zu maxNodes=%zu maxDepth=%u rounds=%u mode=ONE_SHOT_RABBIT_HOLE_GRAPH stateWrites=off\r\n",
            ArrayCount(kDwGraphSeedsV40), kMaxNodes, kMaxDepth, kMaxRounds);

        unsigned expanded = 0, directEdges = 0, branchEdges = 0, indirectSites = 0;
        unsigned ripRefs = 0, tableTargets = 0, incomingEdges = 0, roundsDone = 0;

        for (unsigned round = 0; round < kMaxRounds && nodes.size() < kMaxNodes; ++round)
        {
            bool changed = false;
            ++roundsDone;
            for (std::size_t ni = 0; ni < nodes.size() && nodes.size() < kMaxNodes; ++ni)
            {
                auto& node = nodes[ni];
                if (node.expanded || node.depth > kMaxDepth) continue;
                node.expanded = true;
                ++expanded;
                const std::uintptr_t beginRva = node.beginRva;
                const std::uintptr_t endRva = node.endRva;
                if (endRva <= beginRva || endRva > size) continue;
                const std::size_t fnSize = static_cast<std::size_t>((std::min)(endRva - beginRva,
                    static_cast<std::uintptr_t>(0x1000u)));
                std::vector<unsigned char> code(fnSize);
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + beginRva), code.data(), fnSize))
                    continue;
                const char* rangeLabel = nullptr;
                DwGraphInKnownRangeV40(beginRva, &rangeLabel);
                InternalLog("[DW-GRAPH-V40] NODE index=%zu rva=0x%llX end=0x%llX depth=%u origin=%u range=%s\r\n",
                    ni, static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(endRva),
                    node.depth, node.origin, rangeLabel ? rangeLabel : "other");
                ServerEmuAppend(L"dw_source3_v40_graph.log",
                    "[DW-GRAPH-V40] NODE index=%zu rva=0x%llX end=0x%llX depth=%u origin=%u range=%s\r\n",
                    ni, static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(endRva),
                    node.depth, node.origin, rangeLabel ? rangeLabel : "other");

                for (std::size_t i = 0; i < fnSize; ++i)
                {
                    const std::uintptr_t siteRva = beginRva + i;
                    if (i + 5u <= fnSize && (code[i] == 0xE8u || code[i] == 0xE9u))
                    {
                        std::int32_t rel = 0; memcpy(&rel, code.data() + i + 1u, sizeof(rel));
                        const std::uintptr_t targetRva = siteRva + 5u + static_cast<std::intptr_t>(rel);
                        if (DwGraphLooksLikeImageCodeV40(targetRva, text))
                        {
                            const int before = DwGraphFindNodeV40(nodes, targetRva);
                            DwGraphAddNodeV40(nodes, targetRva, node.depth + 1u, node.origin, text);
                            if (before < 0) changed = true;
                            edges.push_back({beginRva, siteRva, targetRva, code[i] == 0xE8u ? "CALL" : "JMP", node.depth});
                            ++directEdges;
                            DwGraphLogArgWindowV40(siteRva, beginRva, code.data(), fnSize);
                        }
                    }
                    if (i + 2u <= fnSize && code[i] >= 0x70u && code[i] <= 0x7Fu)
                    {
                        const std::int8_t rel = static_cast<std::int8_t>(code[i + 1u]);
                        const std::uintptr_t targetRva = siteRva + 2u + static_cast<std::intptr_t>(rel);
                        if (DwGraphLooksLikeImageCodeV40(targetRva, text) &&
                            (targetRva < beginRva || targetRva >= endRva))
                        {
                            const int before = DwGraphFindNodeV40(nodes, targetRva);
                            DwGraphAddNodeV40(nodes, targetRva, node.depth + 1u, node.origin, text);
                            if (before < 0) changed = true;
                            edges.push_back({beginRva, siteRva, targetRva, "JCC8", node.depth});
                            ++branchEdges;
                        }
                    }
                    if (i + 6u <= fnSize && code[i] == 0x0Fu && code[i + 1u] >= 0x80u && code[i + 1u] <= 0x8Fu)
                    {
                        std::int32_t rel = 0; memcpy(&rel, code.data() + i + 2u, sizeof(rel));
                        const std::uintptr_t targetRva = siteRva + 6u + static_cast<std::intptr_t>(rel);
                        if (DwGraphLooksLikeImageCodeV40(targetRva, text) &&
                            (targetRva < beginRva || targetRva >= endRva))
                        {
                            const int before = DwGraphFindNodeV40(nodes, targetRva);
                            DwGraphAddNodeV40(nodes, targetRva, node.depth + 1u, node.origin, text);
                            if (before < 0) changed = true;
                            edges.push_back({beginRva, siteRva, targetRva, "JCC32", node.depth});
                            ++branchEdges;
                        }
                    }
                    if (i + 7u <= fnSize && (code[i] == 0x48u || code[i] == 0x4Cu) &&
                        (code[i + 1u] == 0x8Du || code[i + 1u] == 0x8Bu) && (code[i + 2u] & 0xC7u) == 0x05u)
                    {
                        std::int32_t disp = 0; memcpy(&disp, code.data() + i + 3u, sizeof(disp));
                        const std::uintptr_t targetRva = siteRva + 7u + static_cast<std::intptr_t>(disp);
                        if (targetRva < size)
                        {
                            ++ripRefs;
                            InternalLog("[DW-GRAPH-V40] RIP_REF fromRva=0x%llX siteRva=0x%llX targetRva=0x%llX op=%s\r\n",
                                static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(siteRva),
                                static_cast<unsigned long long>(targetRva), code[i + 1u] == 0x8Du ? "LEA" : "MOV");
                            char textProbe[96]{};
                            if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + targetRva), textProbe, sizeof(textProbe) - 1u))
                            {
                                std::size_t printable = 0;
                                while (printable < sizeof(textProbe) - 1u && textProbe[printable] >= 0x20 && textProbe[printable] <= 0x7Eu) ++printable;
                                if (printable >= 5u)
                                {
                                    textProbe[printable] = '\0';
                                    std::string lower(textProbe, printable);
                                    std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return static_cast<char>((c >= 'A' && c <= 'Z') ? (c - 'A' + 'a') : c); });
                                    if (AuthInteresting(lower) || ProtocolInteresting(lower))
                                    {
                                        InternalLog("[DW-GRAPH-V40] STRING ownerRva=0x%llX siteRva=0x%llX targetRva=0x%llX value='%s'\r\n",
                                            static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(siteRva),
                                            static_cast<unsigned long long>(targetRva), textProbe);
                                        ServerEmuAppend(L"dw_source3_v40_graph.log",
                                            "[DW-GRAPH-V40] STRING ownerRva=0x%llX siteRva=0x%llX targetRva=0x%llX value='%s'\r\n",
                                            static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(siteRva),
                                            static_cast<unsigned long long>(targetRva), textProbe);
                                    }
                                }
                            }
                            if ((rdata.size && targetRva >= rdata.rva && targetRva < rdata.rva + rdata.size) ||
                                (data.size && targetRva >= data.rva && targetRva < data.rva + data.size))
                            {
                                const std::size_t beforeNodes = nodes.size();
                                DwGraphScanPointerTableV40(targetRva, node.depth, node.origin, nodes, edges, text);
                                if (nodes.size() > beforeNodes) { changed = true; tableTargets += static_cast<unsigned>(nodes.size() - beforeNodes); }
                            }
                        }
                    }
                    if (i + 2u <= fnSize && code[i] == 0xFFu)
                    {
                        const unsigned modrm = code[i + 1u];
                        const unsigned ext = (modrm >> 3) & 7u;
                        if (ext == 2u || ext == 4u)
                        {
                            ++indirectSites;
                            InternalLog("[DW-GRAPH-V40] INDIRECT ownerRva=0x%llX siteRva=0x%llX kind=%s modrm=0x%02X\r\n",
                                static_cast<unsigned long long>(beginRva), static_cast<unsigned long long>(siteRva),
                                ext == 2u ? "CALL" : "JMP", modrm);
                            DwGraphLogArgWindowV40(siteRva, beginRva, code.data(), fnSize);
                        }
                    }
                }
            }

            // Bounce backward: scan only the known DW ranges for direct CALL/JMP
            // edges into any node discovered so far, then add the owning function.
            for (const auto& range : kDwGraphRangesV40)
            {
                const std::uintptr_t scanEnd = (std::min)(range.endRva, static_cast<std::uintptr_t>(size));
                if (scanEnd <= range.beginRva + 5u) continue;
                const std::size_t span = static_cast<std::size_t>(scanEnd - range.beginRva);
                std::vector<unsigned char> region(span);
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + range.beginRva), region.data(), span))
                    continue;
                for (std::size_t off = 0; off + 5u <= span; ++off)
                {
                    const unsigned char op = region[off];
                    if (op != 0xE8u && op != 0xE9u) continue;
                    std::int32_t rel = 0; memcpy(&rel, region.data() + off + 1u, sizeof(rel));
                    const std::uintptr_t pRva = range.beginRva + off;
                    const std::uintptr_t targetRva = pRva + 5u + static_cast<std::intptr_t>(rel);
                    const int targetIndex = DwGraphFindNodeV40(nodes, targetRva);
                    if (targetIndex < 0) continue;
                    std::uintptr_t ownerBeginAbs = 0, ownerEndAbs = 0;
                    if (!RuntimeFunctionBounds144(base + pRva, ownerBeginAbs, ownerEndAbs) ||
                        ownerBeginAbs < base || ownerEndAbs <= ownerBeginAbs || ownerEndAbs - ownerBeginAbs > 0x2000u)
                        continue;
                    const std::uintptr_t ownerRva = ownerBeginAbs - base;
                    if (!DwGraphInKnownRangeV40(ownerRva)) continue;
                    const unsigned depth = nodes[static_cast<std::size_t>(targetIndex)].depth + 1u;
                    const int before = DwGraphFindNodeV40(nodes, ownerRva);
                    DwGraphAddNodeV40(nodes, ownerRva, depth,
                        nodes[static_cast<std::size_t>(targetIndex)].origin, text);
                    if (before < 0) changed = true;
                    edges.push_back({ownerRva, pRva, targetRva, op == 0xE8u ? "IN_CALL" : "IN_JMP", depth});
                    ++incomingEdges;
                }
            }

            InternalLog("[DW-GRAPH-V40] ROUND round=%u nodes=%zu edges=%zu expanded=%u changed=%s\r\n",
                round + 1u, nodes.size(), edges.size(), expanded, changed ? "YES" : "no");
            if (!changed) break;
        }

        // Emit a compact edge list at the end so a single log can be graphed later.
        for (std::size_t i = 0; i < edges.size() && i < 6000u; ++i)
        {
            const auto& e = edges[i];
            ServerEmuAppend(L"dw_source3_v40_graph.log",
                "[DW-GRAPH-V40] EDGE index=%zu fromRva=0x%llX siteRva=0x%llX toRva=0x%llX kind=%s depth=%u\r\n",
                i, static_cast<unsigned long long>(e.fromRva), static_cast<unsigned long long>(e.siteRva),
                static_cast<unsigned long long>(e.toRva), e.kind ? e.kind : "?", e.depth);
        }

        const int status1Node = DwGraphFindNodeV40(nodes, 0x452F810u);
        const int umbrellaHelper = DwGraphFindNodeV40(nodes, 0x3D61170u);
        const int resultFetch = DwGraphFindNodeV40(nodes, 0x3D5E090u);
        const int source3Mapper = DwGraphFindNodeV40(nodes, 0x3D1E300u);
        InternalLog("[DW-GRAPH-V40] SUMMARY rounds=%u seeds=%zu nodes=%zu edges=%zu expanded=%u directEdges=%u branchEdges=%u indirectSites=%u ripRefs=%u tableTargets=%u incomingEdges=%u anchors={status1:%s,umbrellaHelper:%s,resultFetch:%s,source3Mapper:%s} interpretation=ONE_SHOT_RABBIT_HOLE_GRAPH_BUILT next=analyze_hot_edx1_and_shortest_failure_to_backend_paths stateWrites=off\r\n",
            roundsDone, ArrayCount(kDwGraphSeedsV40), nodes.size(), edges.size(), expanded,
            directEdges, branchEdges, indirectSites, ripRefs, tableTargets, incomingEdges,
            status1Node >= 0 ? "YES" : "no", umbrellaHelper >= 0 ? "YES" : "no",
            resultFetch >= 0 ? "YES" : "no", source3Mapper >= 0 ? "YES" : "no");
        ServerEmuAppend(L"dw_source3_v40_graph.log",
            "[DW-GRAPH-V40] SUMMARY rounds=%u seeds=%zu nodes=%zu edges=%zu expanded=%u directEdges=%u branchEdges=%u indirectSites=%u ripRefs=%u tableTargets=%u incomingEdges=%u interpretation=ONE_SHOT_RABBIT_HOLE_GRAPH_BUILT stateWrites=off\r\n",
            roundsDone, ArrayCount(kDwGraphSeedsV40), nodes.size(), edges.size(), expanded,
            directEdges, branchEdges, indirectSites, ripRefs, tableTargets, incomingEdges);
        return 0;
    }

    void QueueDwSource3OneShotGraphExplorerV40() noexcept
    {
        static std::atomic_bool queued{false};
        if (queued.exchange(true, std::memory_order_acq_rel)) return;
        HANDLE thread = CreateThread(nullptr, 0, &DwSource3OneShotGraphExplorerWorkerV40, nullptr, 0, nullptr);
        if (!thread)
        {
            InternalLog("[DW-GRAPH-V40] QUEUE_FAILED error=%lu stateWrites=off\r\n",
                static_cast<unsigned long>(GetLastError()));
            return;
        }
        CloseHandle(thread);
        InternalLog("[DW-GRAPH-V40] QUEUED mode=ONE_SHOT_RABBIT_HOLE_GRAPH output=dw_source3_v40_graph.log stateWrites=off\r\n");
    }



    // V42 runtime: streaming ranked one-shot rabbit-hole explorer (internals retain V41 type names). V40 proved the graph approach
    // works, but a bytewise reverse-caller fanout filled the 1200-node budget in
    // round one (23k+ incoming edges). V41 indexes reverse direct edges once,
    // then expands the highest-value nodes first. Hot EDX=1 sites, DW status,
    // source3, Auth3/Umbrella/LSG strings, and transport anchors receive priority;
    // generic owners are only pulled in when a hot node asks for its callers.
    // Diagnostic only: no discovered code is invoked/detoured and no state is written.
    struct DwRankNodeV41
    {
        std::uintptr_t rva = 0;
        std::uintptr_t beginRva = 0;
        std::uintptr_t endRva = 0;
        unsigned depth = 0;
        int score = 0;
        unsigned flags = 0;
        unsigned origin = 0;
        bool expanded = false;
    };

    struct DwRankEdgeV41
    {
        std::uintptr_t fromRva = 0;
        std::uintptr_t siteRva = 0;
        std::uintptr_t toRva = 0;
        const char* kind = nullptr;
    };

    struct DwReverseEdgeV41
    {
        std::uintptr_t ownerRva = 0;
        std::uintptr_t siteRva = 0;
        std::uintptr_t targetRva = 0;
        const char* kind = nullptr;
    };

    enum : unsigned
    {
        kV41Anchor = 1u << 0,
        kV41HotEdx1 = 1u << 1,
        kV41Protocol = 1u << 2,
        kV41StatusOp = 1u << 3,
        kV41Transport = 1u << 4
    };

