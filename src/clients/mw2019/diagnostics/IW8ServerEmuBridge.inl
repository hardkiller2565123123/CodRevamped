    bool InstallLsgCryptoApiObserversV74() noexcept
    {
        if (kServerEmuProductionRuntimeV92) return false;

        HMODULE bcrypt = GetModuleHandleW(L"bcrypt.dll");
        if (!bcrypt) bcrypt = LoadLibraryW(L"bcrypt.dll");
        HMODULE advapi = GetModuleHandleW(L"advapi32.dll");
        if (!advapi) advapi = LoadLibraryW(L"advapi32.dll");
        unsigned installed = 0;
        if (InstallProcessWideHook(bcrypt, "BCryptOpenAlgorithmProvider", reinterpret_cast<void*>(&V74BCryptOpenAlgorithmProvider), g_bcryptOpenAlgorithmProviderOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptCreateHash", reinterpret_cast<void*>(&V74BCryptCreateHash), g_bcryptCreateHashOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptHashData", reinterpret_cast<void*>(&V74BCryptHashData), g_bcryptHashDataOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptFinishHash", reinterpret_cast<void*>(&V74BCryptFinishHash), g_bcryptFinishHashOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptGenerateSymmetricKey", reinterpret_cast<void*>(&V74BCryptGenerateSymmetricKey), g_bcryptGenerateSymmetricKeyOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptImportKey", reinterpret_cast<void*>(&V74BCryptImportKey), g_bcryptImportKeyOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptDeriveKey", reinterpret_cast<void*>(&V74BCryptDeriveKey), g_bcryptDeriveKeyOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptKeyDerivation", reinterpret_cast<void*>(&V74BCryptKeyDerivation), g_bcryptKeyDerivationOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptSetProperty", reinterpret_cast<void*>(&V74BCryptSetProperty), g_bcryptSetPropertyOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptDeriveKeyPBKDF2", reinterpret_cast<void*>(&V74BCryptDeriveKeyPBKDF2), g_bcryptDeriveKeyPBKDF2OriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptEncrypt", reinterpret_cast<void*>(&V74BCryptEncrypt), g_bcryptEncryptOriginalV74)) ++installed;
        if (InstallProcessWideHook(bcrypt, "BCryptDecrypt", reinterpret_cast<void*>(&V74BCryptDecrypt), g_bcryptDecryptOriginalV74)) ++installed;
        if (InstallProcessWideHook(advapi, "CryptCreateHash", reinterpret_cast<void*>(&V74CryptCreateHash), g_cryptCreateHashOriginalV74)) ++installed;
        if (InstallProcessWideHook(advapi, "CryptHashData", reinterpret_cast<void*>(&V74CryptHashData), g_cryptHashDataOriginalV74)) ++installed;
        if (InstallProcessWideHook(advapi, "CryptGetHashParam", reinterpret_cast<void*>(&V74CryptGetHashParam), g_cryptGetHashParamOriginalV74)) ++installed;
        if (InstallProcessWideHook(advapi, "CryptImportKey", reinterpret_cast<void*>(&V74CryptImportKey), g_cryptImportKeyOriginalV74)) ++installed;
