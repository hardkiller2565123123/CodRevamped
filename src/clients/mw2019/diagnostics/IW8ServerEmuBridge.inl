    bool MarkDwPostLoginOriginSignatureV85(std::uint64_t signature) noexcept
    {
        bool isNew = false;
        AcquireSRWLockExclusive(&g_dwPostLoginOriginLockV85);
        bool found = false;
        for (unsigned i = 0; i < g_dwPostLoginOriginSignatureCountV85; ++i)
        {
            if (g_dwPostLoginOriginSignaturesV85[i] == signature)
            {
                found = true;
                break;
            }
        }
        if (!found && g_dwPostLoginOriginSignatureCountV85 < ArrayCount(g_dwPostLoginOriginSignaturesV85))
        {
            g_dwPostLoginOriginSignaturesV85[g_dwPostLoginOriginSignatureCountV85++] = signature;
            isNew = true;
        }
        ReleaseSRWLockExclusive(&g_dwPostLoginOriginLockV85);
        return isNew;
    }

    bool RuntimeFunctionBounds144(std::uintptr_t address, std::uintptr_t& begin, std::uintptr_t& end) noexcept
    {
        begin = 0;
        end = 0;
#if defined(_M_X64) || defined(__x86_64__)
        DWORD64 imageBase = 0;
        PRUNTIME_FUNCTION runtime = RtlLookupFunctionEntry(static_cast<DWORD64>(address), &imageBase, nullptr);
        if (!runtime || !imageBase)
            return false;
        begin = static_cast<std::uintptr_t>(imageBase + runtime->BeginAddress);
        end = static_cast<std::uintptr_t>(imageBase + runtime->EndAddress);
        return end > begin && address >= begin && address < end;
#else
        (void)address;
        return false;
#endif
    }

    void ObserveDwPostLoginCensusV83(SOCKET socket, const void* data, std::size_t size, std::uintptr_t caller) noexcept
    {
        if (kServerEmuProductionRuntimeV92)
            return;
        if (!data || size < 10u || !IsTrackedLsgSocketV61(socket))
            return;

        unsigned char header[10]{};
        if (!ServerEmuSafeReadBytes(data, header, sizeof(header)))
            return;
        if (header[4] != 0xABu || header[5] != 0x85u)
            return;

        const auto readLe32 = [](const unsigned char* p) -> unsigned
        {
            return static_cast<unsigned>(p[0]) |
                (static_cast<unsigned>(p[1]) << 8) |
                (static_cast<unsigned>(p[2]) << 16) |
                (static_cast<unsigned>(p[3]) << 24);
        };
        const unsigned declaredBody = readLe32(header);
        const unsigned counter = readLe32(header + 6);
        const unsigned event = g_dwPostLoginCensusEventsV83.fetch_add(1, std::memory_order_relaxed) + 1u;
        if (event > 192u)
            return;

        if (!g_dwPostLoginCensusClientLogInitializedV83.exchange(true, std::memory_order_acq_rel))
        {
            wchar_t censusPath[32768]{};
            if (BuildServerEmuPath(L"dw_postlogin_census_client.log", censusPath, ArrayCount(censusPath)))
            {
                HANDLE file = CreateFileW(censusPath, GENERIC_WRITE,
                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, CREATE_ALWAYS,
                    FILE_ATTRIBUTE_NORMAL, nullptr);
                if (file != INVALID_HANDLE_VALUE)
                {
                    const char* headerText =
                        "[DW-CENSUS-V85] CLIENT census started mode=NATIVE_READ_ONLY origin_code_dump=yes no_state_writes=yes no_result_forcing=yes\r\n"
                        "[DW-CENSUS-V85] Match counter=N here with counter=N in dw_postlogin_census_server.log. Unique stack paths also emit ORIGIN/CODE records.\r\n";
                    DWORD written = 0;
                    WriteFile(file, headerText, static_cast<DWORD>(strlen(headerText)), &written, nullptr);
                    CloseHandle(file);
                }
            }
        }

        const auto base = MainImageBase();
        const auto imageSize = MainImageSize();
        char directCaller[96]{};
        FormatCaller(caller, directCaller, ArrayCount(directCaller));

        void* frames[56]{};
        const USHORT captured = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        std::uintptr_t gameRvas[24]{};
        unsigned gameFrames = 0;
        for (USHORT i = 0; i < captured && gameFrames < ArrayCount(gameRvas); ++i)
        {
            const auto frame = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (!base || !imageSize || frame < base || frame >= base + imageSize)
                continue;
            gameRvas[gameFrames++] = frame - base;
        }

        std::uint64_t stackSignature = 1469598103934665603ull;
        const unsigned signatureFrames = (std::min)(gameFrames, 12u);
        for (unsigned i = 0; i < signatureFrames; ++i)
        {
            const std::uintptr_t value = gameRvas[i];
            for (unsigned b = 0; b < sizeof(value); ++b)
            {
                stackSignature ^= static_cast<unsigned char>(value >> (b * 8u));
                stackSignature *= 1099511628211ull;
            }
        }

        ServerEmuAppend(L"dw_postlogin_census_client.log",
            "\r\n[DW-CENSUS-V85-SEND] event=%u tick=%llu thread=%lu socket=%llu counter=%u declaredBody=%u bytes=%llu "
            "directCaller=%s captured=%u gameFrames=%u stackSig=0x%016llX stateWrites=off\r\n",
            event, static_cast<unsigned long long>(GetTickCount64()), static_cast<unsigned long>(GetCurrentThreadId()),
            static_cast<unsigned long long>(socket), counter, declaredBody, static_cast<unsigned long long>(size),
            directCaller, static_cast<unsigned>(captured), gameFrames,
            static_cast<unsigned long long>(stackSignature));

        // V85: transport/lobby frames dominate the top of every secure send.
        // Pick the first lower-RVA IW8 frame after the common transport prefix
        // as the likely service/task wrapper, then dump a few adjacent stack
        // functions exactly once for each unique stack signature.
        if (MarkDwPostLoginOriginSignatureV85(stackSignature))
        {
            unsigned originIndex = gameFrames;
            for (unsigned i = 5; i < gameFrames; ++i)
            {
                if (gameRvas[i] < 0x60000000ull)
                {
                    originIndex = i;
                    break;
                }
            }
            if (originIndex == gameFrames && gameFrames > 5u)
                originIndex = 5u;

            const std::uintptr_t originRva = originIndex < gameFrames ? gameRvas[originIndex] : 0u;
            ServerEmuAppend(L"dw_postlogin_census_client.log",
                "[DW-CENSUS-V85-ORIGIN] event=%u counter=%u stackSig=0x%016llX originIndex=%u originRva=0x%llX uniquePath=yes\r\n",
                event, counter, static_cast<unsigned long long>(stackSignature), originIndex,
                static_cast<unsigned long long>(originRva));

            const unsigned dumpEnd = (std::min)(gameFrames, originIndex + 5u);
            for (unsigned i = originIndex; i < dumpEnd; ++i)
            {
                const std::uintptr_t frame = base + gameRvas[i];
                std::uintptr_t functionBegin = 0;
                std::uintptr_t functionEnd = 0;
                const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
                if (!bounded)
                    continue;

                const std::size_t functionBytes = static_cast<std::size_t>(functionEnd - functionBegin);
                const std::size_t dumpBytes = (std::min)(functionBytes, static_cast<std::size_t>(256u));
                unsigned char code[256]{};
                if (!dumpBytes || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(functionBegin), code, dumpBytes))
                    continue;

                char hex[769]{};
                std::size_t used = 0;
                for (std::size_t b = 0; b < dumpBytes && used + 3u < ArrayCount(hex); ++b)
                {
                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X", code[b]);
                    if (wrote <= 0)
                        break;
                    used += static_cast<std::size_t>(wrote);
                    if (b + 1u < dumpBytes && used + 2u < ArrayCount(hex))
                        hex[used++] = ' ';
                }
                hex[(std::min)(used, ArrayCount(hex) - 1u)] = '\0';

                ServerEmuAppend(L"dw_postlogin_census_client.log",
                    "[DW-CENSUS-V85-CODE] event=%u counter=%u stackIndex=%u frameRva=0x%llX functionRva=0x%llX..0x%llX functionBytes=%llu dumped=%llu code={%s}\r\n",
                    event, counter, i, static_cast<unsigned long long>(gameRvas[i]),
                    static_cast<unsigned long long>(functionBegin - base),
                    static_cast<unsigned long long>(functionEnd - base),
                    static_cast<unsigned long long>(functionBytes),
                    static_cast<unsigned long long>(dumpBytes), hex);
            }
        }

        for (unsigned i = 0; i < gameFrames; ++i)
        {
            const auto frame = base + gameRvas[i];
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
            ServerEmuAppend(L"dw_postlogin_census_client.log",
                "[DW-CENSUS-V85-FRAME] event=%u counter=%u index=%u frameRva=0x%llX function=%s0x%llX..%s0x%llX unwind=%s\r\n",
                event, counter, i,
                static_cast<unsigned long long>(gameRvas[i]),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0u),
                bounded ? "yes" : "no");
        }

        InternalLog("[DW-CENSUS-V85] event=%u counter=%u bytes=%llu gameFrames=%u stackSig=0x%016llX output=dw_postlogin_census_client.log stateWrites=off\r\n",
            event, counter, static_cast<unsigned long long>(size), gameFrames,
            static_cast<unsigned long long>(stackSignature));
    }

    void AppendCodeBytes144(const wchar_t* fileName, const char* prefix, std::uintptr_t address,
        std::size_t before, std::size_t after) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!fileName || !prefix || !base || !size || address < base || address >= base + size)
            return;

        const std::uintptr_t start = address > base + before ? address - before : base;
        const std::uintptr_t imageEnd = base + size;
        const std::uintptr_t wantedEnd = address + after;
        const std::uintptr_t end = wantedEnd < imageEnd ? wantedEnd : imageEnd;
        char hex[1024]{};
        std::size_t used = 0;
        __try
        {
            for (std::uintptr_t cursor = start; cursor < end && used + 4 < ArrayCount(hex); ++cursor)
            {
                const unsigned byte = *reinterpret_cast<const unsigned char*>(cursor);
                used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", byte));
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            strncpy_s(hex, "<unreadable>", _TRUNCATE);
        }

        ServerEmuAppend(fileName, "%s addressRva=0x%llX startRva=0x%llX bytes=%s\r\n",
            prefix,
            static_cast<unsigned long long>(address - base),
            static_cast<unsigned long long>(start - base), hex);
    }

    void CaptureRawTlsGameStack144(const char* label, std::uintptr_t caller) noexcept
    {
        // V93 production runtime: this helper used to remain reachable from the
        // DNS wrappers even though the background TLS scanner itself was disabled.
        // Hard-stop before CaptureStackBackTrace so endpoint redirection stays cheap.
        if (kServerEmuProductionRuntimeV92)
            return;

        const unsigned event = g_dwTlsLiveStackEvents.fetch_add(1, std::memory_order_relaxed) + 1u;
        // We want several independently useful call stacks (DNS/connect/send/recv),
        // but never enough logging to recreate the old startup hitch.
        if (event > 12u)
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        void* frames[32]{};
        const USHORT frameCount = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        char callerText[96]{};
        FormatCaller(caller, callerText, ArrayCount(callerText));
        InternalLog("[DW-TLS-SCAN] LIVE_STACK event=%u label=%s caller=%s frames=%u read_only=yes\r\n",
            event, label ? label : "?", callerText, static_cast<unsigned>(frameCount));
        ServerEmuAppend(L"dw_tls_scan.log",
            "\r\n[DW-TLS-LIVE] event=%u label=%s caller=%s frames=%u read_only=yes\r\n",
            event, label ? label : "?", callerText, static_cast<unsigned>(frameCount));

        unsigned gameFrames = 0;
        for (USHORT i = 0; i < frameCount && gameFrames < 16u; ++i)
        {
            const auto frame = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (frame < base || frame >= base + size)
                continue;
            ++gameFrames;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
            ServerEmuAppend(L"dw_tls_scan.log",
                "[DW-TLS-LIVE-FRAME] event=%u index=%u frameRva=0x%llX functionBeginRva=%s0x%llX functionEndRva=%s0x%llX unwind=%s\r\n",
                event, gameFrames,
                static_cast<unsigned long long>(frame - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");
            AppendCodeBytes144(L"dw_tls_scan.log", "[DW-TLS-LIVE-CODE]", frame, 24, 48);
        }

        InternalLog("[DW-TLS-SCAN] LIVE_STACK event=%u label=%s gameFrames=%u output=dw_tls_scan.log\r\n",
            event, label ? label : "?", gameFrames);
    }

    void CaptureLsgParserStackV63(const char* label, std::uintptr_t caller, const void* data, std::size_t size) noexcept
    {
        const unsigned event = g_dwLsgParserTraceEventsV63.fetch_add(1, std::memory_order_relaxed) + 1u;
        if (event > 6u)
            return;

        const auto base = MainImageBase();
        const auto imageSize = MainImageSize();
        if (!base || !imageSize)
            return;

        const auto* bytes = static_cast<const unsigned char*>(data);
        char hex[3 * 32 + 1]{};
        std::size_t used = 0;
        const std::size_t count = (std::min)(size, static_cast<std::size_t>(32));
        for (std::size_t i = 0; bytes && i < count && used + 4 < ArrayCount(hex); ++i)
        {
            const int n = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X%s",
                static_cast<unsigned>(bytes[i]), (i + 1u < count) ? " " : "");
            if (n <= 0) break;
            used += static_cast<std::size_t>(n);
        }

        char callerText[96]{};
        FormatCaller(caller, callerText, ArrayCount(callerText));
        InternalLog("[DW-LSG-V63] PARSER_STACK event=%u label=%s caller=%s bytes=%llu first32={%s} mode=NATIVE_READ_ONLY stateWrites=off\r\n",
            event, label ? label : "?", callerText, static_cast<unsigned long long>(size), hex);
        ServerEmuAppend(L"dw_lsg_parser_v63.log",
            "\r\n[DW-LSG-V63] PARSER_STACK event=%u label=%s caller=%s bytes=%llu first32={%s} mode=NATIVE_READ_ONLY stateWrites=off\r\n",
            event, label ? label : "?", callerText, static_cast<unsigned long long>(size), hex);

        std::uintptr_t recvOwnerBegin = 0;
        std::uintptr_t recvOwnerEnd = 0;
        const bool recvOwnerBounded = RuntimeFunctionBounds144(caller, recvOwnerBegin, recvOwnerEnd);
        ServerEmuAppend(L"dw_lsg_parser_v63.log",
            "[DW-LSG-V63] RECV_OWNER event=%u returnRva=0x%llX bounded=%s function=0x%llX..0x%llX next=trace_native_post_recv_branch\r\n",
            event,
            static_cast<unsigned long long>(caller >= base ? caller - base : 0),
            recvOwnerBounded ? "yes" : "no",
            static_cast<unsigned long long>(recvOwnerBounded ? recvOwnerBegin - base : 0),
            static_cast<unsigned long long>(recvOwnerBounded ? recvOwnerEnd - base : 0));
        AppendCodeBytes144(L"dw_lsg_parser_v63.log", "[DW-LSG-V63-RECV-CODE]", caller, 64, 160);

        void* frames[40]{};
        const USHORT frameCount = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        unsigned gameFrames = 0;
        for (USHORT i = 0; i < frameCount && gameFrames < 20u; ++i)
        {
            const auto frame = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (frame < base || frame >= base + imageSize)
                continue;
            ++gameFrames;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
            ServerEmuAppend(L"dw_lsg_parser_v63.log",
                "[DW-LSG-V63-FRAME] event=%u index=%u frameRva=0x%llX function=0x%llX..0x%llX unwind=%s\r\n",
                event, gameFrames,
                static_cast<unsigned long long>(frame - base),
                static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");
            AppendCodeBytes144(L"dw_lsg_parser_v63.log", "[DW-LSG-V63-FRAME-CODE]", frame, 40, 96);
        }

        InternalLog("[DW-LSG-V63] PARSER_STACK event=%u gameFrames=%u output=dw_lsg_parser_v63.log no_hooks_to_game_logic=yes stateWrites=off\r\n",
            event, gameFrames);
    }

    void CaptureLsgCloseStackV64(SOCKET socket, std::uintptr_t caller) noexcept
    {
        const unsigned event = g_dwLsgCloseTraceEventsV64.fetch_add(1, std::memory_order_relaxed) + 1u;
        if (event > 6u)
            return;

        const auto base = MainImageBase();
        const auto imageSize = MainImageSize();
        if (!base || !imageSize)
            return;

        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        InternalLog("[DW-LSG-V64] CLOSE_STACK event=%u socket=%llu caller=%s mode=NATIVE_READ_ONLY stateWrites=off\r\n",
            event, static_cast<unsigned long long>(socket), where);
        ServerEmuAppend(L"dw_lsg_close_v64.log",
            "\r\n[DW-LSG-V64] CLOSE_STACK event=%u socket=%llu caller=%s mode=NATIVE_READ_ONLY stateWrites=off\r\n",
            event, static_cast<unsigned long long>(socket), where);

        std::uintptr_t closeOwnerBegin = 0;
        std::uintptr_t closeOwnerEnd = 0;
        const bool closeOwnerBounded = RuntimeFunctionBounds144(caller, closeOwnerBegin, closeOwnerEnd);
        ServerEmuAppend(L"dw_lsg_close_v64.log",
            "[DW-LSG-V64] CLOSE_OWNER event=%u returnRva=0x%llX bounded=%s function=0x%llX..0x%llX next=identify_native_rejection_owner\r\n",
            event,
            static_cast<unsigned long long>(caller >= base ? caller - base : 0),
            closeOwnerBounded ? "yes" : "no",
            static_cast<unsigned long long>(closeOwnerBounded ? closeOwnerBegin - base : 0),
            static_cast<unsigned long long>(closeOwnerBounded ? closeOwnerEnd - base : 0));
        AppendCodeBytes144(L"dw_lsg_close_v64.log", "[DW-LSG-V64-CLOSE-CODE]", caller, 64, 160);

        void* frames[48]{};
        const USHORT frameCount = CaptureStackBackTrace(1, static_cast<DWORD>(ArrayCount(frames)), frames, nullptr);
        unsigned gameFrames = 0;
        for (USHORT i = 0; i < frameCount && gameFrames < 24u; ++i)
        {
            const auto frame = reinterpret_cast<std::uintptr_t>(frames[i]);
            if (frame < base || frame >= base + imageSize)
                continue;
            ++gameFrames;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(frame, functionBegin, functionEnd);
            InternalLog("[DW-LSG-V64] CLOSE_FRAME event=%u index=%u rva=0x%llX function=0x%llX..0x%llX\r\n",
                event, gameFrames,
                static_cast<unsigned long long>(frame - base),
                static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                static_cast<unsigned long long>(bounded ? functionEnd - base : 0));
            ServerEmuAppend(L"dw_lsg_close_v64.log",
                "[DW-LSG-V64-FRAME] event=%u index=%u frameRva=0x%llX function=0x%llX..0x%llX unwind=%s\r\n",
                event, gameFrames,
                static_cast<unsigned long long>(frame - base),
                static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
                static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
                bounded ? "yes" : "no");
            AppendCodeBytes144(L"dw_lsg_close_v64.log", "[DW-LSG-V64-FRAME-CODE]", frame, 40, 96);
        }

        // V63's three independent receives all converged through this first
        // stable high-level handoff above the networking wrappers. Dump it once
        // in full so the close stack can be correlated against its branches and
        // direct callees without broad scanning or any game-state modification.
        if (!g_dwLsgHandoffDumpedV64.exchange(true))
        {
            constexpr std::uintptr_t kHandoffBeginRva = 0x2C28150u;
            constexpr std::uintptr_t kHandoffEndRva = 0x2C2853Cu;
            if (kHandoffEndRva <= imageSize)
