                "mode=CALL_ORIGINAL_UNCHANGED stateWrites=stock_only\r\n",
                static_cast<unsigned long long>(kDwSource3StateSetterRva144),
                static_cast<unsigned long long>(kDwSource3StateArrayRva144),
