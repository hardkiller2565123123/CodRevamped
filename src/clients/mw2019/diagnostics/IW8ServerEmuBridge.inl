    }

    void PrintServerEmuStatus() noexcept
    {
        if (kServerEmuProductionRuntimeV92)
        {
            // The timer survives because other client code already calls this entry
            // point, but V92 must not use it as a research sampler. Keep only the
            // cheap bootstrap readiness report and never resolve/scan auth objects.
            HMODULE game = GetModuleHandleW(nullptr);
            if (!g_bgsStockBundleDumped.load())
                DumpEmbeddedBgsCertificateBundle(game);
            if (g_bnetAccountStateTemplateSeen.load(std::memory_order_acquire) &&
                !g_bnetRuntimeObserversInstalled.load(std::memory_order_acquire))
                InstallBNetFirstStateRuntimeObservers144(); // V92 branch = DPAPI only.

            static bool statusLogged = false;
            if (!statusLogged)
            {
                statusLogged = true;
                InternalLog("[V96.1-TARGETED] runtime healthy dns=%u connect=%u winhttp=%u trust=%s bundle=%s deepObservers=OFF targetedGateTrace=ON stateForcing=OFF\r\n",
                    g_serverEmuDnsCalls.load(), g_serverEmuConnectCalls.load(), g_serverEmuWinHttpCalls.load(),
                    g_bgsTrustBootstrapPatched.load() ? "ready" : "waiting",
                    g_bgsStockBundleDumped.load() ? "ready" : "waiting");
            }
            return;
        }

        // The BGS fingerprint JSON may not be readable at the earliest network
        // hook install point. Retry from the existing 5-second status heartbeat
        // until it is written, well before the stock client normally requests it.
        HMODULE game = GetModuleHandleW(nullptr);
        // Keep status polling read-only. The verifier modulus is intentionally written
        // only by EnsureBgsTrustBeforeBootstrapNetwork() at the first :80/:1119
        // connection, so a timer/status heartbeat can never race early image setup.
        if (!g_bgsStockBundleDumped.load())
            DumpEmbeddedBgsCertificateBundle(game);

        // Once ACCOUNT_STATE and WEB_TOKEN have both been consumed, map direct
        // stock auth-gate call sites once, then sample the getters on this existing
        // heartbeat and log only state changes. Both operations are read-only.
        if (g_bnetAccountStateTemplateSeen.load(std::memory_order_acquire) &&
            !g_bnetRuntimeObserversInstalled.load(std::memory_order_acquire))
            InstallBNetFirstStateRuntimeObservers144();
        ProbeBNetEarlyGateState144();

        // Do not run the full-image auth-gate topology scan from the 5-second
        // heartbeat.  On 1.44 this pass can take tens of seconds while the
        // frontend is still starting, which can leave the game on a black
        // screen before BGS/Demonware traffic ever begins.  The v19 failure
        // correlation itself is driven by the DW auth-result monitor and does
        // not require this topology sweep.  Keep the scanner code available
        // for explicit research only; normal pure-emulation startup stays light.
        static std::atomic<bool> authGateTopologyDeferredLogged{false};
        if (g_bnetAccountStateTemplateSeen.load(std::memory_order_acquire))
        {
            bool expected = false;
            if (authGateTopologyDeferredLogged.compare_exchange_strong(expected, true))
                InternalLog("[AUTH-GATE-XREF144] automatic full-image topology scan deferred to avoid startup/frontend stalls; failure correlation remains active and stateWrites=off\r\n");
        }

        ProbeStockAuthGates144();

        InternalLog("[SERVER-EMU144] dns=%u connect=%u send=%u recv=%u winhttp=%u uniqueCallers=%u trustBootstrap=%s trustAttempts=%u bgsBundle=%s attempts=%u bnetRegOpen=%u bnetRegRead=%u authObservers=%s pumpCalls=%u guardCalls=%u bnetGuardForced=%u nativeLoginTrace=ON nativeStatusObject=%s nativeFieldOffset=%d stateForcing=OFF\r\n",
            g_serverEmuDnsCalls.load(), g_serverEmuConnectCalls.load(), g_serverEmuSendCalls.load(),
            g_serverEmuRecvCalls.load(), g_serverEmuWinHttpCalls.load(), g_serverEmuCallerCount,
            g_bgsTrustBootstrapPatched.load() ? "ready" : "waiting",
            g_bgsTrustBootstrapAttempts.load(),
            g_bgsStockBundleDumped.load() ? "ready" : "waiting",
            g_bgsStockBundleDumpAttempts.load(),
            g_bnetRegistryOpens.load(), g_bnetRegistryReads.load(),
            g_bnetRuntimeObserversInstalled.load(std::memory_order_acquire) ? "ready" : "waiting",
            g_bnetFirstStatePumpCalls.load(), g_bnetFirstStateGuardCalls.load(), g_bnetFirstPartyForcedCalls144.load(),
            ResolveDwFirstPartyStatusObjectV47() ? "found" : "waiting",
            g_dwFirstPartyStatusFieldOffsetV47.load());
    }
