        const bool writerAStaticExact = dStoreExact && dJnzExact && gateJzExact && a1StoreExact &&
            fetchJzExact && a2StoreExact && fetchToStatus && statusJnzExact && falseReturnExact;
        const bool lastFetchKnownFalse = fetchStatusAtE1 == 1 && fetchToStatus && statusJnzExact && falseReturnExact;
        const bool a2Eliminated = lastFetchKnownFalse && fetchJzExact && a2StoreExact;

        InternalLog(
            "[DW-SOURCE3-V54] WRITER_A_BRANCH_PROOF flags={D:0x%02X,E:0x%02X} fetchAtE1=%u lastFetchStatus=%d "
            "dPath={store:%s,jnzTarget:0x%llX,exact:%s} gatePath={jzTarget:0x%llX,a1EStore:%s,exact:%s} "
            "fetchPath={jzTarget:0x%llX,a2EStore:%s,exact:%s} stateWrites=off\r\n",
            static_cast<unsigned>(flagD), static_cast<unsigned>(flagE), fetchCallsAtE1, fetchStatusAtE1,
            dStoreExact ? "YES" : "no", static_cast<unsigned long long>(dJnzTarget), dJnzExact ? "YES" : "no",
            static_cast<unsigned long long>(gateJzTarget), a1StoreExact ? "YES" : "no", gateJzExact ? "YES" : "no",
            static_cast<unsigned long long>(fetchJzTarget), a2StoreExact ? "YES" : "no", fetchJzExact ? "YES" : "no");
        ServerEmuAppend(L"dw_source3_v54_writer_branch_proof.log",
            "[DW-SOURCE3-V54] WRITER_A_BRANCH_PROOF flags={D:0x%02X,E:0x%02X} fetchAtE1=%u lastFetchStatus=%d "
            "dPath={store:%s,jnzTarget:0x%llX,exact:%s} gatePath={jzTarget:0x%llX,a1EStore:%s,exact:%s} "
            "fetchPath={jzTarget:0x%llX,a2EStore:%s,exact:%s} stateWrites=off\r\n",
            static_cast<unsigned>(flagD), static_cast<unsigned>(flagE), fetchCallsAtE1, fetchStatusAtE1,
            dStoreExact ? "YES" : "no", static_cast<unsigned long long>(dJnzTarget), dJnzExact ? "YES" : "no",
            static_cast<unsigned long long>(gateJzTarget), a1StoreExact ? "YES" : "no", gateJzExact ? "YES" : "no",
            static_cast<unsigned long long>(fetchJzTarget), a2StoreExact ? "YES" : "no", fetchJzExact ? "YES" : "no");

        InternalLog(
            "[DW-SOURCE3-V54] RESULT_FETCH_FALSE_PROOF statusCall=%s statusJnz={exact:%s,target:0x%llX} "
            "falseEpilogueEax0=%s lastStatusIsConnecting=%s expectedFetchReturn=%s "
            "a2PostFetchE1Eliminated=%s stateWrites=off\r\n",
            fetchToStatus ? "YES" : "no", statusJnzExact ? "YES" : "no",
            static_cast<unsigned long long>(statusJnzTarget), falseReturnExact ? "YES" : "no",
            fetchStatusAtE1 == 1 ? "YES" : "no", lastFetchKnownFalse ? "FALSE" : "unknown",
            a2Eliminated ? "YES" : "no");
        ServerEmuAppend(L"dw_source3_v54_writer_branch_proof.log",
            "[DW-SOURCE3-V54] RESULT_FETCH_FALSE_PROOF statusCall=%s statusJnz={exact:%s,target:0x%llX} "
            "falseEpilogueEax0=%s lastStatusIsConnecting=%s expectedFetchReturn=%s "
            "a2PostFetchE1Eliminated=%s stateWrites=off\r\n",
            fetchToStatus ? "YES" : "no", statusJnzExact ? "YES" : "no",
