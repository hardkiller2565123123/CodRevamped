            writerToFetch ? "YES" : "no", fetchToStatus ? "YES" : "no", branchExact ? "YES" : "no",
            static_cast<unsigned long long>(branchTargetRva), falseReturnExact ? "YES" : "no");
        ServerEmuAppend(L"dw_source3_v52_connecting_blocks_dispatch.log",
            "[DW-SOURCE3-V52] FETCH_BRANCH writerCall=0x2B59C87->0x3D5E090:%s statusCall=0x3D5E151->0x5D6ACA0:%s "
            "testJnz={rva:0x3D5E156 exact:%s target:0x%llX} falseEpilogue={rva:0x3D5E1B0 eaxZero:%s} "
            "semantics=NONZERO_DW_STATUS_BRANCHES_TO_RESULT_FETCH_FALSE stateWrites=off\r\n",
            writerToFetch ? "YES" : "no", fetchToStatus ? "YES" : "no", branchExact ? "YES" : "no",
