            return;
        }

        g_dwFirstPartyStatusFieldOffsetV47.store(best.fieldOffset, std::memory_order_release);
        if (best.directObject)
            g_dwFirstPartyStatusObjectV47.store(best.directObject, std::memory_order_release);
        if (best.pointerSlot)
            g_dwFirstPartyStatusPointerSlotV47.store(best.pointerSlot, std::memory_order_release);

        const std::uintptr_t resolvedObject = ResolveDwFirstPartyStatusObjectV47();
        std::uint32_t currentStatus = 0xFFFFFFFFu;
