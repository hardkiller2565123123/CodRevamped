        // satisfy.  We intentionally do not execute anything.
        unsigned boundedCallees = 0;
        unsigned calleeRipRefs = 0;
        unsigned calleePrintableRefs = 0;
        for (unsigned ci = 0; ci < calleeCount; ++ci)
