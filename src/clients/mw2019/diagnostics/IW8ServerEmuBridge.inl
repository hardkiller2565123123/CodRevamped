    int WSAAPI ServerEmuWSAIoctl(SOCKET socket, DWORD controlCode, LPVOID inBuffer, DWORD inBufferSize,
        LPVOID outBuffer, DWORD outBufferSize, LPDWORD bytesReturned, LPWSAOVERLAPPED overlapped,
        LPWSAOVERLAPPED_COMPLETION_ROUTINE completion) noexcept
    {
        const auto caller = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
        RecordServerEmuCaller("WSAIoctl", caller);
