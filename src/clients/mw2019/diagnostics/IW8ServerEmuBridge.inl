    struct BNetFenceWriterCandidateV53
    {
        std::uintptr_t instructionRva = 0;
        std::uintptr_t functionRva = 0;
        unsigned baseRm = 0;
        unsigned sourceReg = 0;
        unsigned char opcode = 0;
        bool hasImmediate = false;
        std::uint32_t immediate = 0;
    };

    bool DecodeFenceState10WriteV53(const unsigned char* q, std::size_t bytes,
        BNetFenceWriterCandidateV53& out) noexcept
    {
        out = {};
        if (!q || bytes < 4u)
            return false;

        std::size_t pos = 0;
        if ((q[pos] & 0xF0u) == 0x40u)
            ++pos; // optional REX
        if (pos + 3u >= bytes)
            return false;

        const unsigned char op = q[pos];
        if (!(op == 0x89u || op == 0x88u || op == 0xC7u || op == 0xC6u))
            return false;

        const unsigned char modrm = q[pos + 1u];
        const unsigned mod = (modrm >> 6u) & 3u;
        const unsigned reg = (modrm >> 3u) & 7u;
        const unsigned rm = modrm & 7u;
        if (mod != 1u || rm == 4u || static_cast<signed char>(q[pos + 2u]) != 0x10)
            return false; // simple [reg+0x10], no SIB

        if ((op == 0xC7u || op == 0xC6u) && reg != 0u)
            return false;

        out.opcode = op;
        out.baseRm = rm;
        out.sourceReg = reg;
        if (op == 0xC7u)
        {
            if (pos + 7u > bytes)
                return false;
            out.hasImmediate = true;
            memcpy(&out.immediate, q + pos + 3u, sizeof(out.immediate));
        }
        else if (op == 0xC6u)
        {
            if (pos + 4u > bytes)
                return false;
            out.hasImmediate = true;
            out.immediate = q[pos + 3u];
        }
        return true;
    }

