            const bool firstOk = ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetFirstStateValue), firstState);
            const bool snapshotOk = ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetFirstStateSnapshotValue), snapshotState);
            const bool snapshotInitOk = ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetFirstStateSnapshotInit), snapshotInit);
            const bool prereqOk = ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqBoolValue), prereq);
            const bool prereqInitOk = ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqInitFlag), prereqInit);
            const bool postFenceOk = ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetPostFenceObjectPtr), postFencePtr);
            const bool fenceCountOk = ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetFenceObject + 0xB8), fenceCount);

            if (postFenceOk && postFencePtr)
            {
                for (unsigned i = 0; i < ArrayCount(postFenceDwords); ++i)
                {
                    postFenceDwordReadable[i] = ServerEmuSafeReadU32(
                        reinterpret_cast<const void*>(postFencePtr + static_cast<std::uintptr_t>(i) * sizeof(std::uint32_t)),
                        postFenceDwords[i]);
                }
            }

            if (fenceCountOk)
            {
                const std::uintptr_t boundedCount = (std::min)(fenceCount, static_cast<std::uintptr_t>(64));
                for (std::uintptr_t i = 0; i < boundedCount; ++i)
                {
                    std::uintptr_t entry = 0;
                    if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetFenceObject + 0x40 + i * sizeof(std::uintptr_t)), entry) || !entry)
                        continue;
                    std::uint32_t id = 0;
                    std::uint32_t state = 0;
                    if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(entry + 0x14), id) ||
                        !ServerEmuSafeReadU32(reinterpret_cast<const void*>(entry + 0x10), state))
                        continue;
                    if (id == 1u)
                    {
                        fenceFound = 1;
                        fenceState = static_cast<int>(state);
                        break;
                    }
                }
            }

            const std::uint32_t firstValue = firstOk ? firstState : 0xFFFFFFFEu;
            const std::uint32_t snapshotValue = snapshotOk ? snapshotState : 0xFFFFFFFEu;
            const unsigned char snapshotInitValue = snapshotInitOk ? snapshotInit : 0xFEu;
            const unsigned char prereqValue = prereqOk ? prereq : 0xFEu;
            const unsigned char prereqInitValue = prereqInitOk ? prereqInit : 0xFEu;
            const std::uintptr_t postFenceValue = postFenceOk ? postFencePtr : 0;
            const bool postFencePointerChanged = postFenceValue != lastPostFencePtr;
            const bool postFenceState10Ok = postFenceDwordReadable[0x10u / 4u];
            const std::uint32_t postFenceState10 = postFenceState10Ok ? postFenceDwords[0x10u / 4u] : 0xFFFFFFFEu;
            bool postFenceObjectChanged = postFencePointerChanged;
            if (postFenceOk && postFencePtr)
            {
                for (unsigned i = 0; i < ArrayCount(postFenceDwords); ++i)
