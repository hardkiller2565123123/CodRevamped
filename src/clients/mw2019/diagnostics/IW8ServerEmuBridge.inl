    // V17: the V16 backwards map proved the first concrete missing frontend
    // dependency is the post-fence object's +0x10 state.  Do not guess a
    // server response from that observation.  Instead, capture the exact,
    // bounded stock code for the post-fence wrapper/inner function, its two
    // already-catalogued callsites, the Demonware signed-in predicate, and the
    // dwGetLogOnStatus HSM anchors.  Every edge below is decoded only at a
    // known exact callsite; there is no raw E8 sweep and nothing is patched.
    void LogFrontendWriterFunctionBytesV17(const char* label, std::uintptr_t rva,
        std::size_t maxBytes = 1024u) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || !rva || rva >= size)
            return;

        const auto address = base + rva;
        std::uintptr_t functionBegin = 0;
        std::uintptr_t functionEnd = 0;
        const bool bounded = RuntimeFunctionBounds144(address, functionBegin, functionEnd);
        std::uintptr_t start = bounded ? functionBegin : address;
        std::uintptr_t end = bounded ? functionEnd : address + 64u;
        if (end > base + size)
            end = base + size;
        if (end <= start)
            return;

        std::size_t total = static_cast<std::size_t>(end - start);
        if (total > maxBytes)
            total = maxBytes;

        InternalLog("[FRONTEND-WRITER144] FUNCTION label=%s anchorRva=0x%llX beginRva=%s0x%llX endRva=%s0x%llX unwind=%s dumpBytes=%llu read_only=yes\r\n",
            label,
            static_cast<unsigned long long>(rva),
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
            bounded ? "yes" : "no",
            static_cast<unsigned long long>(total));
        ServerEmuAppend(L"frontend_writer_trace.log",
            "[FRONTEND-WRITER144] FUNCTION label=%s anchorRva=0x%llX beginRva=%s0x%llX endRva=%s0x%llX unwind=%s dumpBytes=%llu read_only=yes\r\n",
            label,
            static_cast<unsigned long long>(rva),
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0),
            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0),
            bounded ? "yes" : "no",
            static_cast<unsigned long long>(total));

        for (std::size_t offset = 0; offset < total; offset += 32u)
        {
            const std::size_t take = (total - offset) < 32u ? (total - offset) : 32u;
            unsigned char bytes[32]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(start + offset), bytes, take))
            {
                InternalLog("[FRONTEND-WRITER-CODE144] label=%s rva=0x%llX bytes=<unreadable>\r\n",
                    label, static_cast<unsigned long long>(start + offset - base));
                ServerEmuAppend(L"frontend_writer_trace.log",
                    "[FRONTEND-WRITER-CODE144] label=%s rva=0x%llX bytes=<unreadable>\r\n",
                    label, static_cast<unsigned long long>(start + offset - base));
                continue;
            }

            char hex[32u * 3u + 2u]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < take && used + 3u < ArrayCount(hex); ++i)
            {
                used += static_cast<std::size_t>(_snprintf_s(
                    hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", static_cast<unsigned>(bytes[i])));
            }

            InternalLog("[FRONTEND-WRITER-CODE144] label=%s rva=0x%llX bytes=%s\r\n",
                label, static_cast<unsigned long long>(start + offset - base), hex);
            ServerEmuAppend(L"frontend_writer_trace.log",
                "[FRONTEND-WRITER-CODE144] label=%s rva=0x%llX bytes=%s\r\n",
                label, static_cast<unsigned long long>(start + offset - base), hex);
        }
    }

    void LogFrontendExactEdgeV17(const char* label, std::uintptr_t callRva,
        std::uintptr_t expectedTargetRva) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
