                    }
                    printable[printableLen] = '\0';
                    InternalLog("[DW-LSG-TRANSITION-V44] RIP index=%u instructionRva=0x%llX targetRva=0x%llX op=%s printable=%s value='%s' deltaFromConnecting=%+lld read_only=yes\r\n",
