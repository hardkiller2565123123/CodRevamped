            { "FENCE", "GetBattleNetFenceState", r.GetBattleNetFenceState },
            { "AUTH", "unk_IsUserSignedInToBNet", r.unk_IsUserSignedInToBNet },
            { "AUTH", "Live_IsUserSignedInToDemonware", r.Live_IsUserSignedInToDemonware },
            { "AUTH", "dwGetLogOnStatus", r.dwGetLogOnStatus },
            { "POSTFENCE", "BNetSignInPostFenceObjectGetter", d.BNetSignInPostFenceObjectGetter },
            { "POSTFENCE", "BNetSignInPostFenceBool", d.BNetSignInPostFenceBool },
            { "POSTFENCE", "BNetSignInPostFenceBoolInner", d.BNetSignInPostFenceBoolInner },
            // These three exact 1.44 dwGetLogOnStatus callsites sit in the same
            // region as the live reset stack and are useful HSM/backtrace anchors.
            { "DW_HSM", "DwLogOnStatusCaller31", d.DwLogOnStatusCaller31 },
            { "DW_HSM", "DwLogOnStatusCaller32", d.DwLogOnStatusCaller32 },
            { "DW_HSM", "DwLogOnStatusCaller33", d.DwLogOnStatusCaller33 },
        };

        std::uint32_t firstState = 0;
        unsigned char prereq = 0;
        std::uintptr_t postFencePtr = 0;
        std::uint32_t postFence10 = 0;
        const bool firstOk = d.BNetFirstStateValue < size &&
            ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetFirstStateValue), firstState);
        const bool prereqOk = d.BNetPrereqBoolValue < size &&
