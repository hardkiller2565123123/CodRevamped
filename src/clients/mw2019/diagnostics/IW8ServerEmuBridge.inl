            static_cast<unsigned long long>(kAdapterRva));

        // Pass 1: find code that materializes the callback/function address.
        for (std::uintptr_t chunkVa = textBegin; chunkVa < textEnd; chunkVa += kChunk)
        {
            const std::size_t bytesToRead = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(kChunk), textEnd - chunkVa));
            unsigned char bytes[kChunk]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, bytesToRead))
            {
