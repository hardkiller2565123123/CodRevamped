    static void V106QueueReadOnlyScan144() noexcept
    {
        if (g_v106ReadOnlyScanQueued.exchange(true, std::memory_order_acq_rel))
            return;
        HANDLE thread = CreateThread(nullptr, 0, &V106ReadOnlyScanWorker144, nullptr, 0, nullptr);
