        const bool statusChanged = preStatus != postStatus || pre21 != post21 || pre1 != post1;
        const bool carries21 = static_cast<std::uint32_t>(a0) == 0x21u || static_cast<std::uint32_t>(a1) == 0x21u ||
            static_cast<std::uint32_t>(a2) == 0x21u || static_cast<std::uint32_t>(a3) == 0x21u;

