            primaryCalls == 0u && altCalls == 0u && setterCalls == 0u;

        InternalLog(
            "[DW-SOURCE3-V52] STATUS_AT_E1 controller=%d flags={D:0x%02X,E:0x%02X} dwLogOnStatus=%d classification=CONNECTING "
            "source3State=0x%08X statusSet={readable:%s,count:%u,entries:{%s},has21:%s,has1:%s} stateWrites=off\r\n",
            controller, static_cast<unsigned>(flagD), static_cast<unsigned>(flagE), logonStatus, source3State,
            statusReadable ? "YES" : "no", statusCount, statusReadable ? entryText : "unreadable",
            has21 ? "YES" : "no", has1 ? "YES" : "no");
        ServerEmuAppend(L"dw_source3_v52_connecting_blocks_dispatch.log",
            "[DW-SOURCE3-V52] STATUS_AT_E1 controller=%d flags={D:0x%02X,E:0x%02X} dwLogOnStatus=%d classification=CONNECTING "
            "source3State=0x%08X statusSet={readable:%s,count:%u,entries:{%s},has21:%s,has1:%s} stateWrites=off\r\n",
            controller, static_cast<unsigned>(flagD), static_cast<unsigned>(flagE), logonStatus, source3State,
            statusReadable ? "YES" : "no", statusCount, statusReadable ? entryText : "unreadable",
            has21 ? "YES" : "no", has1 ? "YES" : "no");

        InternalLog(
            "[DW-SOURCE3-V52] FETCH_BRANCH writerCall=0x2B59C87->0x3D5E090:%s statusCall=0x3D5E151->0x5D6ACA0:%s "
