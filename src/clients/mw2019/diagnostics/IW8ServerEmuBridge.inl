    enum class BNetFenceField80MutationKindV54 : unsigned
    {
        Unknown = 0,
        SetImmediate,
        SetRegister,
        Inc,
        Dec,
        AddImmediate,
        SubImmediate
    };

    struct BNetFenceField80MutationV54
    {
        BNetFenceField80MutationKindV54 kind = BNetFenceField80MutationKindV54::Unknown;
        unsigned baseRm = 0;
        unsigned sourceReg = 0;
        bool hasImmediate = false;
        std::int32_t immediate = 0;
        std::size_t bytes = 0;
    };

    const char* BNetFenceField80MutationNameV54(BNetFenceField80MutationKindV54 kind) noexcept
    {
        switch (kind)
        {
        case BNetFenceField80MutationKindV54::SetImmediate: return "SET_IMM";
        case BNetFenceField80MutationKindV54::SetRegister: return "SET_REG";
        case BNetFenceField80MutationKindV54::Inc: return "INC";
        case BNetFenceField80MutationKindV54::Dec: return "DEC";
        case BNetFenceField80MutationKindV54::AddImmediate: return "ADD_IMM";
        case BNetFenceField80MutationKindV54::SubImmediate: return "SUB_IMM";
        default: return "UNKNOWN";
        }
    }

    bool DecodeFenceField80MutationV54(const unsigned char* q, std::size_t bytes,
        BNetFenceField80MutationV54& out) noexcept
    {
        out = {};
        if (!q || bytes < 7u)
            return false;

        std::size_t pos = 0;
        unsigned rex = 0;
        if ((q[pos] & 0xF0u) == 0x40u)
        {
            rex = q[pos];
            ++pos;
        }
        if (pos + 6u >= bytes)
            return false;

        const unsigned char op = q[pos];
        const unsigned char modrm = q[pos + 1u];
        const unsigned mod = (modrm >> 6u) & 3u;
        const unsigned reg = (modrm >> 3u) & 7u;
        const unsigned rm = modrm & 7u;
        if (mod != 2u || rm == 4u)
            return false; // simple [reg+disp32], no SIB

        std::uint32_t disp = 0;
        memcpy(&disp, q + pos + 2u, sizeof(disp));
        if (disp != 0x80u)
            return false;

        out.baseRm = rm | ((rex & 0x01u) ? 8u : 0u);
        out.sourceReg = reg | ((rex & 0x04u) ? 8u : 0u);

        if (op == 0xC7u && reg == 0u)
        {
            if (pos + 10u > bytes)
                return false;
            std::uint32_t imm = 0;
            memcpy(&imm, q + pos + 6u, sizeof(imm));
            out.kind = BNetFenceField80MutationKindV54::SetImmediate;
            out.hasImmediate = true;
            out.immediate = static_cast<std::int32_t>(imm);
            out.bytes = pos + 10u;
            return true;
        }
        if (op == 0x89u)
        {
            out.kind = BNetFenceField80MutationKindV54::SetRegister;
            out.bytes = pos + 6u;
            return true;
        }
        if (op == 0xFFu && (reg == 0u || reg == 1u))
        {
            out.kind = reg == 0u ? BNetFenceField80MutationKindV54::Inc :
                                  BNetFenceField80MutationKindV54::Dec;
            out.bytes = pos + 6u;
            return true;
        }
        if (op == 0x83u && (reg == 0u || reg == 5u))
        {
            if (pos + 7u > bytes)
                return false;
            out.kind = reg == 0u ? BNetFenceField80MutationKindV54::AddImmediate :
                                  BNetFenceField80MutationKindV54::SubImmediate;
            out.hasImmediate = true;
            out.immediate = static_cast<signed char>(q[pos + 6u]);
            out.bytes = pos + 7u;
            return true;
        }
        return false;
    }

    void LogBNetFenceState1WindowV54(const char* label, std::uintptr_t rva,
        std::size_t before, std::size_t after) noexcept
    {
