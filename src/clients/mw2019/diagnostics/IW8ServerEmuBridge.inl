    struct ImageSectionView
    {
        const unsigned char* begin = nullptr;
        std::size_t size = 0;
        std::uintptr_t rva = 0;
    };

    bool GetImageSection(HMODULE module, const char* sectionName, ImageSectionView& out) noexcept
    {
        out = {};
        if (!module || !sectionName)
            return false;
        const auto base = reinterpret_cast<std::uintptr_t>(module);
        __try
        {
            const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + static_cast<std::uintptr_t>(dos->e_lfanew));
            const auto* sections = IMAGE_FIRST_SECTION(nt);
            for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i)
            {
                char name[9]{};
                memcpy(name, sections[i].Name, 8);
                if (strcmp(name, sectionName) != 0)
                    continue;
                out.begin = reinterpret_cast<const unsigned char*>(base + sections[i].VirtualAddress);
                out.size = sections[i].Misc.VirtualSize
                    ? static_cast<std::size_t>(sections[i].Misc.VirtualSize)
                    : static_cast<std::size_t>(sections[i].SizeOfRawData);
                out.rva = sections[i].VirtualAddress;
                return out.begin && out.size;
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER) {}
        return false;
    }

    std::size_t GetImageSections(HMODULE module, const char* sectionName,
        ImageSectionView* out, std::size_t capacity) noexcept
    {
        if (!module || !sectionName || !out || !capacity)
            return 0;
        for (std::size_t i = 0; i < capacity; ++i)
            out[i] = {};

        const auto base = reinterpret_cast<std::uintptr_t>(module);
        std::size_t count = 0;
        __try
        {
            const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + static_cast<std::uintptr_t>(dos->e_lfanew));
            const auto* sections = IMAGE_FIRST_SECTION(nt);
            for (unsigned i = 0; i < nt->FileHeader.NumberOfSections && count < capacity; ++i)
            {
                char name[9]{};
                memcpy(name, sections[i].Name, 8);
                if (strcmp(name, sectionName) != 0)
                    continue;
                out[count].begin = reinterpret_cast<const unsigned char*>(base + sections[i].VirtualAddress);
                out[count].size = sections[i].Misc.VirtualSize
                    ? static_cast<std::size_t>(sections[i].Misc.VirtualSize)
                    : static_cast<std::size_t>(sections[i].SizeOfRawData);
                out[count].rva = sections[i].VirtualAddress;
                if (out[count].begin && out[count].size)
                    ++count;
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            return count;
        }
        return count;
    }


    std::atomic<bool> g_bgsTrustBootstrapPatched{ false };
    std::atomic<unsigned> g_bgsTrustBootstrapAttempts{ 0 };

    bool ReadExactFile256(const wchar_t* path, unsigned char (&out)[256]) noexcept
    {
        if (!path || !*path)
            return false;
        HANDLE file = CreateFileW(path, GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE)
            return false;
        LARGE_INTEGER size{};
        if (!GetFileSizeEx(file, &size) || size.QuadPart != 256)
        {
            CloseHandle(file);
            return false;
        }
        DWORD read = 0;
        const BOOL ok = ReadFile(file, out, 256, &read, nullptr);
        CloseHandle(file);
        return ok && read == 256;
    }

    bool LoadRevampedBundleSignerModulus(unsigned char (&modulus)[256], wchar_t* resolvedPath, std::size_t resolvedCount) noexcept
    {
        if (resolvedPath && resolvedCount) resolvedPath[0] = L'\0';
        wchar_t rootPath[32768]{};
        if (BuildGameRootPath(L"bgs-bundle-signing-modulus.bin", rootPath, ArrayCount(rootPath)) &&
            ReadExactFile256(rootPath, modulus))
        {
            if (resolvedPath && resolvedCount) wcsncpy_s(resolvedPath, resolvedCount, rootPath, _TRUNCATE);
            return true;
        }

        wchar_t emuPath[32768]{};
        if (BuildServerEmuPath(L"bgs-bundle-signing-modulus.bin", emuPath, ArrayCount(emuPath)) &&
            ReadExactFile256(emuPath, modulus))
        {
            if (resolvedPath && resolvedCount) wcsncpy_s(resolvedPath, resolvedCount, emuPath, _TRUNCATE);
            return true;
        }
        return false;
    }

    bool InstallBgsLocalTrustBootstrap(HMODULE module) noexcept
    {
        if (g_bgsTrustBootstrapPatched.load())
            return true;
        if (!module)
            return false;

        const unsigned attempt = g_bgsTrustBootstrapAttempts.fetch_add(1) + 1u;
        unsigned char localModulus[256]{};
        wchar_t modulusPath[32768]{};
        if (!LoadRevampedBundleSignerModulus(localModulus, modulusPath, ArrayCount(modulusPath)))
        {
            if (attempt <= 3u || (attempt % 5u) == 0u)
                InternalLog("[TRUST-BOOT] attempt=%u waiting for bgs-bundle-signing-modulus.bin (start RevampedIW8Server.exe first)\r\n", attempt);
            return false;
        }

        ImageSectionView rdata{};
        if (!GetImageSection(module, ".rdata", rdata))
        {
            InternalLog("[TRUST-BOOT] attempt=%u unable to locate .rdata\r\n", attempt);
            return false;
        }

        // V92 production: the verifier location is already proven for IW8 1.44.
        // Do not rescan the entire .rdata section every launch. Validate the exact
        // known RVA against the stock prefix (or our already-written modulus) and
        // patch only those 256 bytes. This removes the largest remaining startup
        // memory sweep from the DLL.
        static const unsigned char stockPrefix[8]{0x35,0xFF,0x17,0xE7,0x33,0xC4,0xD3,0xD4};
        constexpr std::uintptr_t kBgsVerifierModulusRvaV91 = 0x70D7540u;
        const unsigned char* hit = nullptr;
        unsigned hits = 0;
        if (kServerEmuProductionRuntimeV92)
        {
            const std::uintptr_t rdataStart = rdata.rva;
            const std::uintptr_t rdataEnd = rdataStart + rdata.size;
            if (kBgsVerifierModulusRvaV91 < rdataStart ||
                kBgsVerifierModulusRvaV91 + 256u > rdataEnd)
            {
                InternalLog("[V94-PRODUCTION] verifier exact RVA 0x%llX outside .rdata; refusing trust write\r\n",
                    static_cast<unsigned long long>(kBgsVerifierModulusRvaV91));
                return false;
            }
            const auto* exact = reinterpret_cast<const unsigned char*>(module) + kBgsVerifierModulusRvaV91;
            if (memcmp(exact, localModulus, 256u) == 0 ||
                memcmp(exact, stockPrefix, sizeof(stockPrefix)) == 0)
            {
                hit = exact;
                hits = 1u;
            }
            else
            {
                InternalLog("[V94-PRODUCTION] verifier exact RVA signature mismatch; full .rdata scan is disabled\r\n");
                return false;
            }
        }
        else
        {
            for (std::size_t i = 0; i + 256u <= rdata.size; ++i)
            {
                if (memcmp(rdata.begin + i, stockPrefix, sizeof(stockPrefix)) != 0)
                    continue;
                hit = rdata.begin + i;
                ++hits;
            }
        }

        char pathUtf8[32768]{};
        if (modulusPath[0]) WideToUtf8(modulusPath, pathUtf8, static_cast<int>(ArrayCount(pathUtf8)));
        InternalLog("[TRUST-BOOT] attempt=%u signerModulus=%s stockVerifierPatternHits=%u\r\n",
            attempt, pathUtf8[0] ? pathUtf8 : "<loaded>", hits);

        if (hits != 1u || !hit)
        {
            InternalLog("[TRUST-BOOT] NOT PATCHED: expected exactly one stock verifier modulus prefix hit, got %u; login/auth state remains untouched\r\n", hits);
            return false;
        }

        auto* writable = const_cast<unsigned char*>(hit);
        if (memcmp(writable, localModulus, 256u) == 0)
        {
            g_bgsTrustBootstrapPatched.store(true);
            return true;
        }

        DWORD oldProtect = 0;
        if (!VirtualProtect(writable, 256u, PAGE_READWRITE, &oldProtect))
        {
            const DWORD error = GetLastError();
            MEMORY_BASIC_INFORMATION mbi{};
            const SIZE_T queried = VirtualQuery(writable, &mbi, sizeof(mbi));
            InternalLog("[TRUST-BOOT] VirtualProtect failed win32=%lu target=%p vq=%llu state=0x%lX protect=0x%lX type=0x%lX regionBase=%p regionSize=0x%llX; will retry\r\n",
                error, writable, static_cast<unsigned long long>(queried),
                queried ? mbi.State : 0ul, queried ? mbi.Protect : 0ul, queried ? mbi.Type : 0ul,
                queried ? mbi.BaseAddress : nullptr,
                static_cast<unsigned long long>(queried ? mbi.RegionSize : 0u));
            return false;
        }
        memcpy(writable, localModulus, 256u);
        DWORD ignored = 0;
        VirtualProtect(writable, 256u, oldProtect, &ignored);
        FlushInstructionCache(GetCurrentProcess(), writable, 256u);

        if (memcmp(writable, localModulus, 256u) != 0)
        {
            InternalLog("[TRUST-BOOT] verifier modulus write did not persist; refusing to mark ready\r\n");
            return false;
        }

        const std::uintptr_t rva = reinterpret_cast<std::uintptr_t>(hit) - reinterpret_cast<std::uintptr_t>(module);
        g_bgsTrustBootstrapPatched.store(true);
        InternalLog("[TRUST-BOOT] OPTION2 PATCHED verifier public modulus rva=0x%llX bytes=256 endian=LE\r\n",
            static_cast<unsigned long long>(rva));
        InternalLog("[TRUST-BOOT] scope=certificate-bundle-signature-trust ONLY; clientStateHooks=0 and login/fence/LUI success remain server-driven\r\n");
        ServerEmuAppend(L"network_trace.log",
            "[TRUST-BOOT] OPTION2 verifier modulus patched rva=0x%llX bytes=256; no auth state changed\r\n",
            static_cast<unsigned long long>(rva));
        return true;
    }

