    DWORD WINAPI LsgCryptoStaticScanWorkerV74(LPVOID) noexcept
    {
        if (kServerEmuProductionRuntimeV92) return 0;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size) return 0;
        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
            "\r\n[DW-LSG-V74] STATIC_SCAN_BEGIN imageBase=%p imageBytes=%llu targets={CLIENTCHAL,BDDATA,SHA1,HMAC,SHA-1,bdHashSHA1} readOnly=yes\r\n",
            reinterpret_cast<void*>(base), static_cast<unsigned long long>(size));
        V74DumpKnownIw8HashOwner();

        static const char* const texts[] = {"CLIENTCHAL", "BDDATA", "SHA1", "HMAC", "SHA-1", "bdHashSHA1"};
        V74LiteralHit hits[64]{};
        unsigned hitCount = 0;
        std::uintptr_t cursor = base;
        const std::uintptr_t imageEnd = base + size;
        while (cursor < imageEnd)
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<const void*>(cursor), &mbi, sizeof(mbi))) break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(imageEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + static_cast<std::uintptr_t>(mbi.RegionSize));
            if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
            {
                __try
                {
                    const auto* p = reinterpret_cast<const unsigned char*>(regionBegin);
                    const std::size_t n = static_cast<std::size_t>(regionEnd - regionBegin);
                    for (unsigned ti = 0; ti < ArrayCount(texts) && hitCount < ArrayCount(hits); ++ti)
                    {
                        const std::size_t len = strlen(texts[ti]);
                        if (!len || len > n) continue;
                        for (std::size_t off = 0; off + len <= n && hitCount < ArrayCount(hits); ++off)
                        {
                            if (p[off] == static_cast<unsigned char>(texts[ti][0]) && memcmp(p + off, texts[ti], len) == 0)
                            {
                                hits[hitCount++] = {regionBegin + off, texts[ti]};
                                ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                                    "[DW-LSG-V74-LITERAL] label=%s rva=0x%llX address=%p\r\n",
                                    texts[ti], static_cast<unsigned long long>(regionBegin + off - base), reinterpret_cast<void*>(regionBegin + off));
                                off += len - 1u;
                            }
                        }
                    }
                }
                __except (EXCEPTION_EXECUTE_HANDLER) {}
            }
            if (regionEnd <= cursor) break;
            cursor = regionEnd;
        }

        // One executable-image pass for common x64 RIP-relative LEA/MOV references
        // to every literal found above.  This avoids N full-image scans.
        unsigned xrefs = 0;
        cursor = base;
        while (cursor < imageEnd && hitCount)
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<const void*>(cursor), &mbi, sizeof(mbi))) break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(imageEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + static_cast<std::uintptr_t>(mbi.RegionSize));
            const DWORD prot = mbi.Protect & 0xFFu;
            const bool executable = prot == PAGE_EXECUTE || prot == PAGE_EXECUTE_READ || prot == PAGE_EXECUTE_READWRITE || prot == PAGE_EXECUTE_WRITECOPY;
            if (ServerEmuReadableRegion(mbi) && executable && regionEnd > regionBegin + 7u)
            {
                for (std::uintptr_t ip = regionBegin; ip + 7u <= regionEnd; ++ip)
                {
                    unsigned char b[7]{};
                    if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(ip), b, sizeof(b))) continue;
                    if (!((b[0] == 0x48u || b[0] == 0x4Cu) && (b[1] == 0x8Du || b[1] == 0x8Bu) && ((b[2] & 0xC7u) == 0x05u)))
                        continue;
                    std::int32_t disp = 0;
                    memcpy(&disp, b + 3, sizeof(disp));
                    const auto target = ip + 7u + static_cast<std::intptr_t>(disp);
                    for (unsigned hi = 0; hi < hitCount; ++hi)
                    {
                        if (target != hits[hi].address) continue;
                        std::uintptr_t fnBegin = 0, fnEnd = 0;
                        const bool bounded = RuntimeFunctionBounds144(ip, fnBegin, fnEnd);
                        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
                            "[DW-LSG-V74-XREF] label=%s instructionRva=0x%llX targetRva=0x%llX bounded=%s function=%s0x%llX..%s0x%llX\r\n",
                            hits[hi].label, static_cast<unsigned long long>(ip - base), static_cast<unsigned long long>(target - base),
                            bounded ? "yes" : "no", bounded ? "" : "n/a-",
                            static_cast<unsigned long long>(bounded ? fnBegin - base : 0u), bounded ? "" : "n/a-",
                            static_cast<unsigned long long>(bounded ? fnEnd - base : 0u));
                        if (xrefs < 64u)
                            AppendCodeBytes144(L"dw_lsg_crypto_v74.log", "[DW-LSG-V74-XREF-CODE]", ip, 96u, 192u);
                        ++xrefs;
                    }
                }
            }
            if (regionEnd <= cursor) break;
            cursor = regionEnd;
        }
        ServerEmuAppend(L"dw_lsg_crypto_v74.log",
            "[DW-LSG-V74] STATIC_SCAN_END literals=%u xrefs=%u next=wait_native_0x82_and_memory_correlation\r\n", hitCount, xrefs);
        InternalLog("[DW-LSG-V74] static crypto scan complete literals=%u xrefs=%u output=dw_lsg_crypto_v74.log\r\n", hitCount, xrefs);
        return 0;
    }

