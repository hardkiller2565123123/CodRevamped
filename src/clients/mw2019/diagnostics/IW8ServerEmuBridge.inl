    // V19: V18 proved the BGS AccountListener subscription-completion path is
    // correct: stock itself moved firstState/prereq/Fence ID 1/postFence+0x10 to
    // their ready values.  Do not perturb that success.  The remaining failure is
    // later in the native Demonware login task.  This diagnostic records the exact
    // DW status set and the source3/mask-0x80 completion state without calling or
    // modifying any game setter.  It also emits small code windows around the two
    // 1.44 anchors needed for the next server-side fix.
    bool ReadDwLogOnStatusSetV19(
        unsigned controller,
        std::uint32_t& count,
        std::uint32_t* entries,
        std::size_t entryCapacity,
        bool& containsConnected21,
        bool& containsFailure1) noexcept
    {
        count = 0;
        containsConnected21 = false;
        containsFailure1 = false;
        if (entries && entryCapacity)
            memset(entries, 0, entryCapacity * sizeof(entries[0]));

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        constexpr std::uintptr_t kDwStatusBaseRva = 0x18208360ull;
        constexpr std::uintptr_t kDwStatusStride = 0x2130ull;
        if (!base || !size || controller >= 8u)
            return false;

        const auto objectRva = kDwStatusBaseRva + static_cast<std::uintptr_t>(controller) * kDwStatusStride;
        if (objectRva + 0x84u > size)
            return false;

        const auto object = base + objectRva;
        if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(object + 0x80u), count))
            return false;

        // Exact 1.44 dwGetLogOnStatus predicate 0x4531BB0 walks a uint32 array
        // beginning at +0x0C for count(+0x80) entries.  Cap diagnostics to avoid
        // following corrupt/transient counts; the stock object has a tiny set.
        const std::uint32_t safeCount = (std::min)(count, 32u);
        for (std::uint32_t i = 0; i < safeCount; ++i)
        {
            std::uint32_t value = 0;
            if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(object + 0x0Cu + static_cast<std::uintptr_t>(i) * 4u), value))
                return false;
            if (entries && i < entryCapacity)
                entries[i] = value;
            if (value == 0x21u)
                containsConnected21 = true;
            if (value == 1u)
                containsFailure1 = true;
        }
        return true;
    }

    void LogV19CodeWindow144(const char* label, std::uintptr_t centerRva,
        std::size_t before, std::size_t after) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || centerRva >= size)
            return;

        const std::uintptr_t startRva = centerRva > before ? centerRva - before : 0u;
        std::uintptr_t endRva = centerRva + after;
        if (endRva > size)
            endRva = size;
        if (endRva <= startRva)
            return;

        InternalLog("[DW-GATE-V19-CODE] BEGIN label=%s centerRva=0x%llX range=0x%llX..0x%llX read_only=yes stateWrites=off\r\n",
            label,
            static_cast<unsigned long long>(centerRva),
            static_cast<unsigned long long>(startRva),
            static_cast<unsigned long long>(endRva));
        ServerEmuAppend(L"dw_auth_result.log",
            "[DW-GATE-V19-CODE] BEGIN label=%s centerRva=0x%llX range=0x%llX..0x%llX read_only=yes stateWrites=off\r\n",
            label,
            static_cast<unsigned long long>(centerRva),
            static_cast<unsigned long long>(startRva),
            static_cast<unsigned long long>(endRva));

        constexpr std::size_t kChunk = 32u;
        for (std::uintptr_t rva = startRva; rva < endRva; rva += kChunk)
        {
            const std::size_t take = static_cast<std::size_t>((std::min)(
                static_cast<std::uintptr_t>(kChunk), endRva - rva));
            unsigned char bytes[kChunk]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + rva), bytes, take))
            {
                InternalLog("[DW-GATE-V19-CODE] label=%s rva=0x%llX bytes=<unreadable>\r\n",
                    label, static_cast<unsigned long long>(rva));
                continue;
            }

            char hex[kChunk * 3u + 4u]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < take && used + 4u < ArrayCount(hex); ++i)
            {
                const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                    "%02X%s", static_cast<unsigned>(bytes[i]), (i + 1u) == take ? "" : " ");
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
            InternalLog("[DW-GATE-V19-CODE] label=%s rva=0x%llX bytes={%s}\r\n",
                label, static_cast<unsigned long long>(rva), hex);
            ServerEmuAppend(L"dw_auth_result.log",
                "[DW-GATE-V19-CODE] label=%s rva=0x%llX bytes={%s}\r\n",
                label, static_cast<unsigned long long>(rva), hex);
        }
    }

