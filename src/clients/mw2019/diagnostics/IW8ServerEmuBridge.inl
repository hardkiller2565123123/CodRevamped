        InternalLog("[DW-NATIVE-LOGIN-V50] SELECTED getterRva=0x%llX fieldOffset=+0x%X score=%u compareImm=%s%u object=%p currentStatus=%s%u objectSane=%s nativeOnly=%s\r\n",
            static_cast<unsigned long long>(best.target - base), static_cast<unsigned>(best.fieldOffset), best.score,
