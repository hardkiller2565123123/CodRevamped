            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + kCommandMapRva), commandMap, sizeof(commandMap));
        const bool targetsOk = kCaseTargetTableRva + sizeof(caseTargets) <= size &&
            ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + kCaseTargetTableRva), caseTargets, sizeof(caseTargets));

        unsigned status1Commands = 0, status3Commands = 0;
        if (targetsOk)
        {
            for (unsigned i = 0; i < ArrayCount(caseTargets); ++i)
            {
                const std::uintptr_t targetRva = static_cast<std::uintptr_t>(caseTargets[i]);
                InternalLog("[DW-SOURCE3-V39] CASE_TARGET case=%u targetRva=0x%llX class=%s\r\n",
                    i, static_cast<unsigned long long>(targetRva),
                    targetRva == kStatus1CaseRva ? "STATUS1_FATAL" :
                    targetRva == kStatus3CaseRva ? "STATUS3" : "OTHER");
            }
        }
        if (mapOk && targetsOk)
        {
            for (unsigned command = 0; command < ArrayCount(commandMap); ++command)
            {
                const unsigned caseIndex = commandMap[command];
                const std::uintptr_t targetRva = caseIndex < ArrayCount(caseTargets) ?
                    static_cast<std::uintptr_t>(caseTargets[caseIndex]) : 0u;
                const bool isStatus1 = targetRva == kStatus1CaseRva;
                const bool isStatus3 = targetRva == kStatus3CaseRva;
                if (isStatus1) ++status1Commands;
                if (isStatus3) ++status3Commands;
                InternalLog("[DW-SOURCE3-V39] COMMAND_MAP command=0x%X case=%u targetRva=%s0x%llX class=%s\r\n",
                    command, caseIndex, targetRva ? "" : "n/a-",
                    static_cast<unsigned long long>(targetRva),
                    isStatus1 ? "STATUS1_FATAL" : isStatus3 ? "STATUS3" : "OTHER");
            }
