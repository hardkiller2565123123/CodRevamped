        // The early-state watcher proved the first Battle.net state naturally moves
        // 0 -> 3 while the stock signed-in gate requires 2. This pass stays purely
        // code/read-only and follows callers of the pointer getter to find the stock
        // updater that receives that pointer. It never hooks the updater and never
        // writes the state itself.
        static std::atomic_bool dumped{ false };
        bool expected = false;
        if (!dumped.compare_exchange_strong(expected, true))
            return;

        HMODULE game = GetModuleHandleW(nullptr);
        const auto base = reinterpret_cast<std::uintptr_t>(game);
        const auto size = MainImageSize();
        ImageSectionView text{};
        if (!game || !base || !size || !GetImageSection(game, ".text", text))
            return;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;

        struct Focus
        {
            const char* label;
            std::uintptr_t rva;
        };

        const Focus focus[] =
        {
            { "BNet auth-cluster pre-pump helper", d.BNetAuthClusterPrePumpHelper },
            { "BNet first-state pump candidate", d.BNetFirstStatePumpCandidate },
            { "BNet first-state pump guard", d.BNetFirstStatePumpGuard },
            { "BNet first-state write-3 candidate", d.BNetFirstStateWrite3Candidate },
            { "BNet auth-cluster helper #1", d.BNetAuthClusterHelper01 },
            { "BNet auth-cluster helper #2", d.BNetAuthClusterHelper02 },
            { "BNet prerequisite pump candidate", d.BNetPrereqPumpCandidate },
            { "BNet prerequisite pump candidate #2", d.BNetPrereqPumpCandidate2 },
            { "BNet auth-cluster helper #3", d.BNetAuthClusterHelper03 },
            { "BNet auth-cluster helper #4", d.BNetAuthClusterHelper04 },
            { "BNet auth-cluster helper #5", d.BNetAuthClusterHelper05 },
            { "BNet auth-cluster helper #6", d.BNetAuthClusterHelper06 },
            { "BNet auth-cluster helper #7", d.BNetAuthClusterHelper07 },
            { "BNet launcher/auth helper", d.BNetAuthClusterLauncherHelper },
        };

        InternalLog("[AUTH-GATE-STATE-PUMP144] BEGIN mode=READ_ONLY getter=0x%llX observedTransition=0_to_3 requiredReadyState=2\r\n",
            static_cast<unsigned long long>(d.BNetSignInFirstStateGetter));
        ServerEmuAppend(L"auth_gate_state_pump.log",
            "[AUTH-GATE-STATE-PUMP144] BEGIN mode=READ_ONLY getterRva=0x%llX stateRva=0x%llX observedTransition=0_to_3 requiredReadyState=2 no_state_modified\r\n",
            static_cast<unsigned long long>(d.BNetSignInFirstStateGetter),
            static_cast<unsigned long long>(d.BNetFirstStateValue));

        for (const auto& item : focus)
        {
            if (!item.rva || item.rva >= size)
                continue;
            DumpAuthGateCodeWindow144(item.label, item.rva);
            ServerEmuAppend(L"auth_gate_state_pump.log",
                "[AUTH-GATE-STATE-PUMP144] focus label=%s rva=0x%llX\r\n",
                item.label, static_cast<unsigned long long>(item.rva));
        }

        // Decode the first-state pump candidate more deeply. The known call site is:
        // CALL getter -> MOV RCX,RAX -> CALL game+0x4641D40. Because RCX carries the
        // returned state pointer, writes through [RCX] in this function are especially
        // interesting. They are only reported, never changed.
        if (d.BNetFirstStatePumpCandidate && d.BNetFirstStatePumpCandidate < size)
        {
            const auto* pump = reinterpret_cast<const unsigned char*>(base + d.BNetFirstStatePumpCandidate);
            const std::size_t pumpScan = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(768), size - d.BNetFirstStatePumpCandidate));
            __try
            {
                unsigned callHits = 0;
                unsigned writeHits = 0;
                bool rcxAliasedToRbx = false;
                // Track the common x64 parameter-preservation pattern used by this
                // function. If the incoming RCX state pointer is copied to RBX, then
                // later [RBX] stores are relevant to the exact state object we care about.
                const std::size_t aliasScan = (std::min)(static_cast<std::size_t>(96), pumpScan);
                for (std::size_t a = 0; a + 3 <= aliasScan; ++a)
                {
                    if ((pump[a] == 0x48 && pump[a + 1] == 0x8B && pump[a + 2] == 0xD9) ||
                        (pump[a] == 0x48 && pump[a + 1] == 0x89 && pump[a + 2] == 0xCB))
                    {
                        rcxAliasedToRbx = true;
                        const auto aliasRva = d.BNetFirstStatePumpCandidate + a;
                        InternalLog("[AUTH-GATE-STATE-PUMP144] pointerAlias RCX_to_RBX=yes instructionRva=0x%llX\r\n",
                            static_cast<unsigned long long>(aliasRva));
                        ServerEmuAppend(L"auth_gate_state_pump.log",
                            "[AUTH-GATE-STATE-PUMP144] pointerAlias RCX_to_RBX=yes instructionRva=0x%llX\r\n",
                            static_cast<unsigned long long>(aliasRva));
                        break;
                    }
                }
                if (!rcxAliasedToRbx)
                {
                    ServerEmuAppend(L"auth_gate_state_pump.log",
                        "[AUTH-GATE-STATE-PUMP144] pointerAlias RCX_to_RBX=no within_first_%u_bytes; RBX stores remain unconfirmed aliases\r\n",
                        static_cast<unsigned>(aliasScan));
                }

                for (std::size_t i = 0; i + 5 <= pumpScan; ++i)
                {
                    const auto instructionRva = d.BNetFirstStatePumpCandidate + i;
                    if (pump[i] == 0xE8 && i + 5 <= pumpScan)
                    {
                        std::int32_t rel = 0;
                        memcpy(&rel, pump + i + 1, sizeof(rel));
                        const auto callee = base + instructionRva + 5 + static_cast<std::intptr_t>(rel);
                        if (callee >= base && callee < base + size && callHits < 64)
                        {
                            ++callHits;
                            InternalLog("[AUTH-GATE-STATE-PUMP144] pumpCall instructionRva=0x%llX calleeRva=0x%llX hit=%u\r\n",
                                static_cast<unsigned long long>(instructionRva),
                                static_cast<unsigned long long>(callee - base), callHits);
                            ServerEmuAppend(L"auth_gate_state_pump.log",
                                "[AUTH-GATE-STATE-PUMP144] pumpCall instructionRva=0x%llX calleeRva=0x%llX hit=%u\r\n",
                                static_cast<unsigned long long>(instructionRva),
                                static_cast<unsigned long long>(callee - base), callHits);
                        }
                    }

                    // Common direct stores to the state object when RCX is the state pointer.
                    // If the prologue preserves RCX in RBX, also report [RBX] stores.
                    // The current log already exposed C7 03 03 00 00 00 at 0x4641DB1;
                    // this pass verifies whether that is truly state=3 on the same pointer.
                    // C7 01 imm32          mov dword ptr [rcx], imm32
                    // C7 41 xx imm32       mov dword ptr [rcx+disp8], imm32
                    // C7 03 imm32          mov dword ptr [rbx], imm32
                    // C7 43 xx imm32       mov dword ptr [rbx+disp8], imm32
                    // 89 /r forms report register stores to [rcx]/[rbx].
                    bool isWrite = false;
                    bool hasImmediate = false;
                    std::int32_t immediate = 0;
                    std::size_t instructionLength = 0;
                    const char* kind = nullptr;

                    if (i + 6 <= pumpScan && pump[i] == 0xC7 && pump[i + 1] == 0x01)
                    {
                        memcpy(&immediate, pump + i + 2, sizeof(immediate));
                        isWrite = true;
                        hasImmediate = true;
                        instructionLength = 6;
                        kind = "MOV_DWORD_[RCX]_IMM";
                    }
                    else if (i + 7 <= pumpScan && pump[i] == 0xC7 && (pump[i + 1] & 0xC7u) == 0x41u)
                    {
                        memcpy(&immediate, pump + i + 3, sizeof(immediate));
                        isWrite = true;
                        hasImmediate = true;
                        instructionLength = 7;
                        kind = "MOV_DWORD_[RCX+DISP8]_IMM";
                    }
                    else if (i + 2 <= pumpScan && pump[i] == 0x89 && (pump[i + 1] & 0xC7u) == 0x01u)
                    {
                        isWrite = true;
                        instructionLength = 2;
                        kind = "MOV_DWORD_[RCX]_REG";
                    }
                    else if (i + 3 <= pumpScan && (pump[i] & 0xF0u) == 0x40u && pump[i + 1] == 0x89 && (pump[i + 2] & 0xC7u) == 0x01u)
                    {
                        isWrite = true;
                        instructionLength = 3;
                        kind = "MOV_DWORD_[RCX]_REG_REX";
                    }
                    else if (rcxAliasedToRbx && i + 6 <= pumpScan && pump[i] == 0xC7 && pump[i + 1] == 0x03)
                    {
                        memcpy(&immediate, pump + i + 2, sizeof(immediate));
                        isWrite = true;
                        hasImmediate = true;
                        instructionLength = 6;
                        kind = "MOV_DWORD_[RBX_ALIAS]_IMM";
                    }
                    else if (rcxAliasedToRbx && i + 7 <= pumpScan && pump[i] == 0xC7 && (pump[i + 1] & 0xC7u) == 0x43u)
                    {
                        memcpy(&immediate, pump + i + 3, sizeof(immediate));
                        isWrite = true;
                        hasImmediate = true;
                        instructionLength = 7;
                        kind = "MOV_DWORD_[RBX_ALIAS+DISP8]_IMM";
                    }
                    else if (rcxAliasedToRbx && i + 2 <= pumpScan && pump[i] == 0x89 && (pump[i + 1] & 0xC7u) == 0x03u)
                    {
                        isWrite = true;
                        instructionLength = 2;
                        kind = "MOV_DWORD_[RBX_ALIAS]_REG";
                    }
                    else if (rcxAliasedToRbx && i + 3 <= pumpScan && (pump[i] & 0xF0u) == 0x40u && pump[i + 1] == 0x89 && (pump[i + 2] & 0xC7u) == 0x03u)
                    {
                        isWrite = true;
                        instructionLength = 3;
                        kind = "MOV_DWORD_[RBX_ALIAS]_REG_REX";
                    }

                    if (isWrite && writeHits < 64)
                    {
                        ++writeHits;
                        char context[512]{};
                        std::size_t used = 0;
                        const std::size_t begin = i >= 16 ? i - 16 : 0;
                        const std::size_t count = (std::min)(static_cast<std::size_t>(80), pumpScan - begin);
                        for (std::size_t b = 0; b < count && used + 4 < ArrayCount(context); ++b)
                            used += static_cast<std::size_t>(_snprintf_s(context + used, ArrayCount(context) - used, _TRUNCATE, "%02X ", pump[begin + b]));

                        InternalLog("[AUTH-GATE-STATE-PUMP144] stateWriteCandidate kind=%s instructionRva=0x%llX immediate=%s%d hit=%u\r\n",
                            kind ? kind : "<unknown>",
                            static_cast<unsigned long long>(instructionRva),
                            hasImmediate ? "" : "n/a/", hasImmediate ? immediate : 0, writeHits);
                        ServerEmuAppend(L"auth_gate_state_pump.log",
                            "[AUTH-GATE-STATE-PUMP144] stateWriteCandidate kind=%s instructionRva=0x%llX instructionLength=%u immediate=%s%d hit=%u code[-16..]=%s\r\n",
                            kind ? kind : "<unknown>",
                            static_cast<unsigned long long>(instructionRva),
                            static_cast<unsigned>(instructionLength),
                            hasImmediate ? "" : "n/a/", hasImmediate ? immediate : 0, writeHits, context);
                    }
                }
                InternalLog("[AUTH-GATE-STATE-PUMP144] pump candidate summary rva=0x%llX calls=%u stateWriteCandidates=%u\r\n",
                    static_cast<unsigned long long>(d.BNetFirstStatePumpCandidate), callHits, writeHits);
                ServerEmuAppend(L"auth_gate_state_pump.log",
                    "[AUTH-GATE-STATE-PUMP144] pump candidate summary rva=0x%llX calls=%u stateWriteCandidates=%u\r\n",
                    static_cast<unsigned long long>(d.BNetFirstStatePumpCandidate), callHits, writeHits);
                ServerEmuAppend(L"auth_gate_state_pump.log",
                    "[AUTH-GATE-STATE-PUMP144] knownBranch guardCallRva=0x%llX guardRva=0x%llX resultTestRva=0x%llX successJnzRva=0x%llX write3CandidateRva=0x%llX guardTrueTargetRva=0x%llX aliasConfirmed=%s interpretation=guard_FALSE_falls_through_to_state_3_guard_TRUE_jumps_over_failure_write\r\n",
                    static_cast<unsigned long long>(d.BNetFirstStatePumpGuardCall),
                    static_cast<unsigned long long>(d.BNetFirstStatePumpGuard),
                    static_cast<unsigned long long>(d.BNetFirstStatePumpGuardResultTest),
                    static_cast<unsigned long long>(d.BNetFirstStatePumpGuardSuccessJnz),
                    static_cast<unsigned long long>(d.BNetFirstStateWrite3Candidate),
                    static_cast<unsigned long long>(d.BNetFirstStatePumpGuardTrueTarget),
                    rcxAliasedToRbx ? "yes" : "no");
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                ServerEmuAppend(L"auth_gate_state_pump.log",
                    "[AUTH-GATE-STATE-PUMP144] pump candidate unreadable rva=0x%llX\r\n",
                    static_cast<unsigned long long>(d.BNetFirstStatePumpCandidate));
            }
        }

        // Find stock callers of the state getter and identify the strongest pointer-flow
        // pattern: CALL getter -> MOV RCX,RAX -> CALL helper. This statically identifies
        // candidate writers/updaters without detouring any game function.
        const auto textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const auto textEnd = textBegin + text.size;
        unsigned getterCalls = 0;
        unsigned forwardedCalls = 0;
        unsigned directWriteCandidates = 0;
        for (std::uintptr_t cursor = textBegin; cursor < textEnd; )
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<void*>(cursor), &mbi, sizeof(mbi)))
                break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(textEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
            if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
            {
                const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                for (std::size_t local = 0; local + 5 <= regionSize; ++local)
                {
                    if (bytes[local] != 0xE8)
                        continue;
                    std::int32_t rel = 0;
                    memcpy(&rel, bytes + local + 1, sizeof(rel));
                    const auto instruction = regionBegin + local;
                    const auto destination = instruction + 5 + static_cast<std::intptr_t>(rel);
                    if (destination != base + d.BNetSignInFirstStateGetter)
                        continue;
                    ++getterCalls;

                    const std::size_t after = local + 5;
                    const std::size_t available = after < regionSize ? (std::min)(static_cast<std::size_t>(96), regionSize - after) : 0;
                    bool localInteresting = false;
                    std::uintptr_t forwardedCalleeRva = 0;
                    const char* writeKind = nullptr;
                    int writeImmediate = 0;
                    bool writeHasImmediate = false;

                    for (std::size_t j = 0; j < available; ++j)
                    {
                        // mov rcx,rax; call rel32
                        if (j + 8 <= available &&
                            ((bytes[after + j] == 0x48 && bytes[after + j + 1] == 0x8B && bytes[after + j + 2] == 0xC8) ||
                             (bytes[after + j] == 0x48 && bytes[after + j + 1] == 0x89 && bytes[after + j + 2] == 0xC1)) &&
                            bytes[after + j + 3] == 0xE8)
                        {
                            std::int32_t callRel = 0;
                            memcpy(&callRel, bytes + after + j + 4, sizeof(callRel));
                            const auto callInstruction = regionBegin + after + j + 3;
                            const auto callee = callInstruction + 5 + static_cast<std::intptr_t>(callRel);
                            if (callee >= base && callee < base + size)
                            {
                                forwardedCalleeRva = callee - base;
                                localInteresting = true;
                            }
                            break;
                        }

                        if (j + 6 <= available && bytes[after + j] == 0xC7 && bytes[after + j + 1] == 0x00)
                        {
                            std::int32_t imm = 0;
                            memcpy(&imm, bytes + after + j + 2, sizeof(imm));
                            writeKind = "MOV_DWORD_[RAX]_IMM";
                            writeImmediate = imm;
                            writeHasImmediate = true;
                            localInteresting = true;
                            break;
                        }
                        if (j + 2 <= available && bytes[after + j] == 0x89 && (bytes[after + j + 1] & 0xC7u) == 0x00u)
                        {
                            writeKind = "MOV_DWORD_[RAX]_REG";
                            localInteresting = true;
                            break;
                        }
                    }

                    const auto callerRva = instruction - base;
                    const bool localAuthCluster = callerRva >= 0x4600000 && callerRva <= 0x4660000;
                    if (!localInteresting && !localAuthCluster)
                        continue;

                    if (forwardedCalleeRva)
                        ++forwardedCalls;
                    if (writeKind)
                        ++directWriteCandidates;

                    char context[768]{};
                    std::size_t used = 0;
                    const std::size_t begin = local >= 16 ? local - 16 : 0;
                    const std::size_t count = (std::min)(static_cast<std::size_t>(112), regionSize - begin);
                    for (std::size_t b = 0; b < count && used + 4 < ArrayCount(context); ++b)
                        used += static_cast<std::size_t>(_snprintf_s(context + used, ArrayCount(context) - used, _TRUNCATE, "%02X ", bytes[begin + b]));

                    InternalLog("[AUTH-GATE-STATE-PUMP144] getterCaller callerRva=0x%llX forwardedCalleeRva=0x%llX writeKind=%s immediate=%s%d\r\n",
                        static_cast<unsigned long long>(callerRva),
                        static_cast<unsigned long long>(forwardedCalleeRva),
                        writeKind ? writeKind : "none",
                        writeHasImmediate ? "" : "n/a/", writeHasImmediate ? writeImmediate : 0);
                    ServerEmuAppend(L"auth_gate_state_pump.log",
                        "[AUTH-GATE-STATE-PUMP144] getterCaller callerRva=0x%llX forwardedCalleeRva=0x%llX writeKind=%s immediate=%s%d code[-16..+]=%s\r\n",
                        static_cast<unsigned long long>(callerRva),
                        static_cast<unsigned long long>(forwardedCalleeRva),
                        writeKind ? writeKind : "none",
                        writeHasImmediate ? "" : "n/a/", writeHasImmediate ? writeImmediate : 0,
                        context);
                }
            }
            cursor = regionEnd > cursor ? regionEnd : cursor + 0x1000;
        }

        InternalLog("[AUTH-GATE-STATE-PUMP144] COMPLETE getterCalls=%u forwardedPointerCalls=%u directWriteCandidates=%u output=auth_gate_state_pump.log no_state_modified\r\n",
            getterCalls, forwardedCalls, directWriteCandidates);
        ServerEmuAppend(L"auth_gate_state_pump.log",
            "[AUTH-GATE-STATE-PUMP144] COMPLETE getterCalls=%u forwardedPointerCalls=%u directWriteCandidates=%u no_state_modified\r\n",
            getterCalls, forwardedCalls, directWriteCandidates);
    }

    void DumpAuthGateTopology144() noexcept
    {
        // Run once as soon as ACCOUNT_STATE has been consumed. The WEB_TOKEN read can
        // happen noticeably later on some launches (especially while the heavyweight
        // read-only auth scan is still running), but this topology scan does not depend
        // on WEB_TOKEN contents. Starting here guarantees we capture the stock BNet
        // gate call sites even if the test is stopped before WEB_TOKEN is requested.
        // No detours, state writes, or return-value replacement are performed.
        if (!g_bnetAccountStateTemplateSeen.load(std::memory_order_acquire))
            return;

        static std::atomic_bool dumped{ false };
        bool expected = false;
        if (!dumped.compare_exchange_strong(expected, true))
            return;

        HMODULE game = GetModuleHandleW(nullptr);
        const auto base = reinterpret_cast<std::uintptr_t>(game);
        ImageSectionView text{};
        if (!game || !base || !GetImageSection(game, ".text", text))
        {
            InternalLog("[AUTH-GATE-XREF144] unable to read .text; topology pass skipped\r\n");
            return;
        }

        const auto& r = iw8_addresses::MW2019_1_44_Rvas;
        const auto& d = iw8_addresses::MW2019_1_44_Discovery;

        struct Target
        {
            const char* label;
            std::uintptr_t rva;
            unsigned hits;
        };

        Target targets[] =
        {
            { "CL_GetLocalClientSignInState", r.CL_GetLocalClientSignInState, 0 },
            { "unk_IsUserSignedInToBNet", r.unk_IsUserSignedInToBNet, 0 },
            { "Live_IsUserSignedInToDemonware", r.Live_IsUserSignedInToDemonware, 0 },
            { "dwGetLogOnStatus", r.dwGetLogOnStatus, 0 },
            { "BNet first state getter", d.BNetSignInFirstStateGetter, 0 },
            { "BNet prerequisite bool", d.BNetSignInPrereqBool, 0 },
            { "BNet post-fence bool inner", d.BNetSignInPostFenceBoolInner, 0 },
        };

        struct DataTarget
        {
            const char* label;
            std::uintptr_t rva;
            unsigned hits;
        };

        DataTarget dataTargets[] =
        {
            { "BNet first state value", d.BNetFirstStateValue, 0 },
            { "BNet first-state snapshot value", d.BNetFirstStateSnapshotValue, 0 },
            { "BNet first-state snapshot object", d.BNetFirstStateSnapshotObject, 0 },
            { "BNet first-state snapshot init", d.BNetFirstStateSnapshotInit, 0 },
            { "BNet prerequisite bool value", d.BNetPrereqBoolValue, 0 },
            { "BNet prerequisite init flag", d.BNetPrereqInitFlag, 0 },
            { "BNet fence object", d.BNetFenceObject, 0 },
            { "BNet post-fence object pointer", d.BNetPostFenceObjectPtr, 0 },
        };

        InternalLog("[AUTH-GATE-XREF144] BEGIN trigger=ACCOUNT_STATE read-only direct CALL/JMP scan; WEB_TOKEN is not required for topology capture; enum meaning intentionally not guessed\r\n");
        ServerEmuAppend(L"auth_gate_topology.log",
            "[AUTH-GATE-XREF144] BEGIN trigger=ACCOUNT_STATE mode=READ_ONLY textRva=0x%llX textSize=0x%llX\r\n",
            static_cast<unsigned long long>(text.rva),
            static_cast<unsigned long long>(text.size));

        DumpBNetSignInDependencies144();
        DumpBNetFirstStateWriterCandidates144();
        DumpAuthGateCodeWindow144("CL_GetLocalClientSignInState", r.CL_GetLocalClientSignInState);
        DumpAuthGateCodeWindow144("unk_IsUserSignedInToBNet", r.unk_IsUserSignedInToBNet);
        DumpAuthGateCodeWindow144("Live_IsUserSignedInToDemonware", r.Live_IsUserSignedInToDemonware);
        DumpAuthGateCodeWindow144("dwGetLogOnStatus", r.dwGetLogOnStatus);
        DumpAuthGateCodeWindow144("ACCOUNT_STATE consumer #1", d.AccountStateConsumerFrame1);
        DumpAuthGateCodeWindow144("ACCOUNT_STATE consumer #2", d.AccountStateConsumerFrame2);
        DumpAuthGateCodeWindow144("WEB_TOKEN consumer #1", d.WebTokenConsumerFrame1);
        DumpAuthGateCodeWindow144("WEB_TOKEN consumer #2", d.WebTokenConsumerFrame2);
        DumpAuthGateCodeWindow144("WEB_TOKEN auth-cluster frame", d.WebTokenConsumerAuthClusterFrame);

        const auto textBegin = reinterpret_cast<std::uintptr_t>(text.begin);
        const auto textEnd = textBegin + text.size;
        for (std::uintptr_t cursor = textBegin; cursor < textEnd; )
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<void*>(cursor), &mbi, sizeof(mbi)))
                break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(textEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
            if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
            {
                const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                for (std::size_t local = 0; local + 5 <= regionSize; ++local)
                {
                    const unsigned char opcode = bytes[local];
                    const auto instruction = regionBegin + local;

                    if (opcode == 0xE8 || opcode == 0xE9)
                    {
                        std::int32_t displacement = 0;
                        memcpy(&displacement, bytes + local + 1, sizeof(displacement));
                        const auto destination = instruction + 5 + static_cast<std::intptr_t>(displacement);
                        for (auto& target : targets)
                        {
                            if (destination != base + target.rva || target.hits >= 512)
                                continue;
                            ++target.hits;

                            char context[512]{};
                            std::size_t contextUsed = 0;
                            const std::size_t start = local >= 16 ? local - 16 : 0;
                            const std::size_t count = (std::min)(static_cast<std::size_t>(64), regionSize - start);
                            for (std::size_t b = 0; b < count && contextUsed + 4 < ArrayCount(context); ++b)
                                contextUsed += static_cast<std::size_t>(_snprintf_s(context + contextUsed, ArrayCount(context) - contextUsed, _TRUNCATE, "%02X ", bytes[start + b]));

                            const auto callerRva = instruction - base;
                            InternalLog("[AUTH-GATE-XREF144] target=%s op=%s callerRva=0x%llX hit=%u\r\n",
                                target.label, opcode == 0xE8 ? "CALL" : "JMP",
                                static_cast<unsigned long long>(callerRva), target.hits);
                            ServerEmuAppend(L"auth_gate_topology.log",
                                "[AUTH-GATE-XREF144] target=%s targetRva=0x%llX op=%s callerRva=0x%llX hit=%u code[-16..+47]=%s\r\n",
                                target.label,
                                static_cast<unsigned long long>(target.rva),
                                opcode == 0xE8 ? "CALL" : "JMP",
                                static_cast<unsigned long long>(callerRva), target.hits, context);
                        }
                    }

                    SimpleRipRef144 rip{};
                    if (DecodeSimpleRipRef144(bytes + local, regionSize - local, rip) &&
                        rip.instructionLength && rip.displacementOffset + sizeof(std::int32_t) <= regionSize - local)
                    {
                        std::int32_t displacement = 0;
                        memcpy(&displacement, bytes + local + rip.displacementOffset, sizeof(displacement));
                        const auto destination = instruction + rip.instructionLength + static_cast<std::intptr_t>(displacement);
                        for (auto& target : dataTargets)
                        {
                            if (destination != base + target.rva || target.hits >= 512)
                                continue;
                            ++target.hits;

                            char context[512]{};
                            std::size_t contextUsed = 0;
                            const std::size_t start = local >= 16 ? local - 16 : 0;
                            const std::size_t count = (std::min)(static_cast<std::size_t>(64), regionSize - start);
                            for (std::size_t b = 0; b < count && contextUsed + 4 < ArrayCount(context); ++b)
                                contextUsed += static_cast<std::size_t>(_snprintf_s(context + contextUsed, ArrayCount(context) - contextUsed, _TRUNCATE, "%02X ", bytes[start + b]));

                            const auto instructionRva = instruction - base;
                            InternalLog("[AUTH-GATE-DATA-XREF144] target=%s op=%s access=%s instructionRva=0x%llX hit=%u\r\n",
                                target.label,
                                rip.op ? rip.op : "<unknown>",
                                rip.access ? rip.access : "<unknown>",
                                static_cast<unsigned long long>(instructionRva),
                                target.hits);
                            ServerEmuAppend(L"auth_gate_dependencies.log",
                                "[AUTH-GATE-DATA-XREF144] target=%s targetRva=0x%llX op=%s access=%s instructionRva=0x%llX hit=%u code[-16..+47]=%s\r\n",
                                target.label,
                                static_cast<unsigned long long>(target.rva),
                                rip.op ? rip.op : "<unknown>",
                                rip.access ? rip.access : "<unknown>",
                                static_cast<unsigned long long>(instructionRva),
                                target.hits,
                                context);
                        }
                    }
                }
            }
            cursor = regionEnd > cursor ? regionEnd : cursor + 0x1000;
        }

        for (const auto& target : targets)
        {
            InternalLog("[AUTH-GATE-XREF144] COMPLETE target=%s rva=0x%llX directHits=%u\r\n",
                target.label, static_cast<unsigned long long>(target.rva), target.hits);
            ServerEmuAppend(L"auth_gate_topology.log",
                "[AUTH-GATE-XREF144] COMPLETE target=%s rva=0x%llX directHits=%u\r\n",
                target.label, static_cast<unsigned long long>(target.rva), target.hits);
        }
        for (const auto& target : dataTargets)
        {
            InternalLog("[AUTH-GATE-DATA-XREF144] COMPLETE target=%s rva=0x%llX hits=%u\r\n",
                target.label, static_cast<unsigned long long>(target.rva), target.hits);
            ServerEmuAppend(L"auth_gate_dependencies.log",
                "[AUTH-GATE-DATA-XREF144] COMPLETE target=%s rva=0x%llX hits=%u\r\n",
                target.label, static_cast<unsigned long long>(target.rva), target.hits);
        }
        InternalLog("[AUTH-GATE-XREF144] topology output=CodRevamped\\MW2019\\server_emu\\auth_gate_topology.log; dependency data xrefs=auth_gate_dependencies.log; no client state modified\r\n");
    }

