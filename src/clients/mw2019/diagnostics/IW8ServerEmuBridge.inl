                    static_cast<std::uintptr_t>(kChunk), textEnd - chunkVa));
                unsigned char bytes[kChunk]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(chunkVa), bytes, bytesToRead))
                    continue;
