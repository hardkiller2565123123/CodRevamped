            if (m.kind == BNetFenceField80MutationKindV54::SetImmediate &&
                m.hasImmediate && m.immediate != 0)
                ++nonZeroImmediate;

            std::uintptr_t fnBegin = 0, fnEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(p, fnBegin, fnEnd);
            InternalLog("[BNET-FENCE-STATE1-V54] FIELD80_MUTATION index=%u rva=0x%llX function=%s0x%llX..%s0x%llX kind=%s baseRm=%u sourceReg=%u immediate=%s%d nonZeroProducer=%s\r\n",
                familyMutations, static_cast<unsigned long long>(p - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnEnd - base : 0u),
                BNetFenceField80MutationNameV54(m.kind), m.baseRm, m.sourceReg,
                m.hasImmediate ? "" : "n/a/", m.hasImmediate ? m.immediate : 0,
                (m.kind == BNetFenceField80MutationKindV54::SetImmediate && m.hasImmediate && m.immediate != 0) ||
                m.kind == BNetFenceField80MutationKindV54::Inc ||
                m.kind == BNetFenceField80MutationKindV54::AddImmediate ? "POSSIBLE" : "no");
            ServerEmuAppend(L"bnet_fence_state1_v54.log",
                "[BNET-FENCE-STATE1-V54] FIELD80_MUTATION index=%u rva=0x%llX function=%s0x%llX..%s0x%llX kind=%s baseRm=%u sourceReg=%u immediate=%s%d nonZeroProducer=%s\r\n",
                familyMutations, static_cast<unsigned long long>(p - base),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? fnEnd - base : 0u),
                BNetFenceField80MutationNameV54(m.kind), m.baseRm, m.sourceReg,
                m.hasImmediate ? "" : "n/a/", m.hasImmediate ? m.immediate : 0,
                (m.kind == BNetFenceField80MutationKindV54::SetImmediate && m.hasImmediate && m.immediate != 0) ||
                m.kind == BNetFenceField80MutationKindV54::Inc ||
                m.kind == BNetFenceField80MutationKindV54::AddImmediate ? "POSSIBLE" : "no");

            if (familyMutations <= 24u ||
                m.kind == BNetFenceField80MutationKindV54::Inc ||
