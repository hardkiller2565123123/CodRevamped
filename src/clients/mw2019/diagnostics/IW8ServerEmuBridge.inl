                "[DW-GRAPH-V50] TOP rank=%zu rva=0x%llX score=%d flags=0x%X depth=%u expanded=%s\r\n",
                rank + 1u, static_cast<unsigned long long>(n.beginRva), n.score, n.flags, n.depth, n.expanded ? "YES" : "no");
