    void AgentResearchFindString144(const char* query) noexcept
    {
        if (!query)
            return;
        char needle[96]{};
        strncpy_s(needle, query, _TRUNCATE);
        const std::size_t needleLen = strlen(needle);
        if (needleLen < 2u || needleLen >= ArrayCount(needle))
        {
            ServerEmuAppend(L"ai_research.log", "[AI-STRING144] invalid query length=%llu read_only=yes\r\n",
                static_cast<unsigned long long>(needleLen));
            return;
        }
        for (std::size_t i = 0; i < needleLen; ++i)
            needle[i] = static_cast<char>(tolower(static_cast<unsigned char>(needle[i])));

        const auto base = MainImageBase();
        HMODULE module = reinterpret_cast<HMODULE>(base);
        if (!base || !module)
            return;
        const char* sectionNames[] = { ".rdata", ".data" };
        unsigned hits = 0;
        ServerEmuAppend(L"ai_research.log",
            "\r\n[AI-STRING144] BEGIN query='%s' sections=.rdata,.data mode=STATIC_READ_ONLY stateWrites=off\r\n", query);
        for (const char* sectionName : sectionNames)
        {
            ImageSectionView section{};
            if (!GetImageSection(module, sectionName, section) || !section.begin || section.size < needleLen)
                continue;
            constexpr std::size_t kChunk = 0x4000u;
            for (std::size_t offset = 0; offset < section.size && hits < 64u; offset += kChunk)
            {
                const std::size_t wanted = (std::min)(kChunk + needleLen, section.size - offset);
                std::vector<unsigned char> bytes(wanted);
                if (!ServerEmuSafeReadBytes(section.begin + offset, bytes.data(), wanted))
                    continue;
                const std::size_t scan = (std::min)(kChunk, wanted);
                for (std::size_t i = 0; i + needleLen <= wanted && i < scan && hits < 64u; ++i)
                {
                    bool match = true;
                    for (std::size_t j = 0; j < needleLen; ++j)
                    {
                        const unsigned char c = bytes[i + j];
                        if (static_cast<char>(tolower(c)) != needle[j])
                        {
                            match = false;
                            break;
                        }
                    }
                    if (!match)
                        continue;
                    ++hits;
                    const std::uintptr_t hitRva = section.rva + offset + i;
                    ServerEmuAppend(L"ai_research.log",
                        "[AI-STRING144-HIT] index=%u section=%s rva=0x%llX query='%s'\r\n",
                        hits, sectionName, static_cast<unsigned long long>(hitRva), query);
                }
                Sleep(0);
            }
        }
        ServerEmuAppend(L"ai_research.log",
            "[AI-STRING144] COMPLETE query='%s' hits=%u truncated=%s next=xref_selected_string_rva stateWrites=off\r\n",
            query, hits, hits >= 64u ? "yes" : "no");
    }

    void AgentResearchFindXrefs144(std::uintptr_t targetRva, const char* accessFilter = nullptr) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        HMODULE module = reinterpret_cast<HMODULE>(base);
        ImageSectionView text{};
        if (!base || !size || !targetRva || targetRva >= size ||
