        const bool postPtrOk = d.BNetPostFenceObjectPtr < size &&
            ServerEmuSafeReadPointer(reinterpret_cast<const void*>(base + d.BNetPostFenceObjectPtr), postFencePtr);
        const bool post10Ok = postPtrOk && postFencePtr &&
            ServerEmuSafeReadU32(reinterpret_cast<const void*>(postFencePtr + 0x10u), postFence10);

        InternalLog("[FRONTEND-BACKTRACE144] BEGIN direction=FRONTEND->FENCE->DW_AUTH->LOGIN_FLOW->SERVER mode=STATIC_READ_ONLY no_raw_E8_scan=yes stateWrites=off\r\n");
        InternalLog("[FRONTEND-BACKTRACE144] SNAPSHOT firstState=%s%u prereq=%s%u postFencePtr=%p postFence+0x10=%s0x%08X diagnosticExpected=1 consumerTrace=V62_EVENT_PATH_ANCESTRY\r\n",
            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
            prereqOk ? "" : "UNREADABLE/", prereqOk ? static_cast<unsigned>(prereq) : 0u,
            reinterpret_cast<void*>(postPtrOk ? postFencePtr : 0),
            post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);
        ServerEmuAppend(L"frontend_backtrace.log",
            "[FRONTEND-BACKTRACE144] BEGIN direction=FRONTEND->FENCE->DW_AUTH->LOGIN_FLOW->SERVER mode=STATIC_READ_ONLY no_raw_E8_scan=yes stateWrites=off\r\n"
            "[FRONTEND-BACKTRACE144] SNAPSHOT firstState=%s%u prereq=%s%u postFencePtr=%p postFenceState10=%s0x%08X diagnosticExpected=1 consumerTrace=V62_EVENT_PATH_ANCESTRY\r\n",
            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
            prereqOk ? "" : "UNREADABLE/", prereqOk ? static_cast<unsigned>(prereq) : 0u,
            reinterpret_cast<void*>(postPtrOk ? postFencePtr : 0),
            post10Ok ? "" : "UNREADABLE/", post10Ok ? postFence10 : 0u);

        for (const auto& node : nodes)
        {
            if (!node.rva || node.rva >= size)
