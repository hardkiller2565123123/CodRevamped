                "mode=CALL_ORIGINAL_UNCHANGED stateWrites=off\r\n",
                static_cast<unsigned long long>(kDwGetLogOnStatusRva144), v35StatusReady ? "YES" : "NO");
        }

        bool source3SetterReady = false;
        if (kDwSource3StateSetterRva144 < size)
        {
