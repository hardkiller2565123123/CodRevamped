    static int DwRankBaseScoreV41(std::uintptr_t rva) noexcept
    {
        if (rva >= 0x4520000u && rva < 0x4540000u) return 18;
        if (rva >= 0x3480000u && rva < 0x3F10000u) return 18;
        if (rva >= 0x5D00000u && rva < 0x5E00000u) return 18;
        if (rva >= 0x6100000u && rva < 0x6200000u) return 20;
        if (rva >= 0x6D00000u && rva < 0x6F00000u) return 16;
        if (rva >= 0x2B00000u && rva < 0x2E50000u) return 14;
        if (rva >= 0x4600000u && rva < 0x4700000u) return 8;
        if (rva >= 0x1800000u && rva < 0x2200000u) return 6;
        return 0;
    }

    static int DwRankFindNodeV41(const std::vector<DwRankNodeV41>& nodes, std::uintptr_t rva) noexcept
    {
        for (std::size_t i = 0; i < nodes.size(); ++i)
        {
            const auto& n = nodes[i];
            if (rva == n.rva || (n.beginRva && rva >= n.beginRva && rva < n.endRva))
                return static_cast<int>(i);
        }
        return -1;
    }

    static int DwRankAddNodeV41(std::vector<DwRankNodeV41>& nodes, std::uintptr_t rva,
        unsigned depth, unsigned origin, int score, unsigned flags,
        const ImageSectionView& text) noexcept
    {
        if (!DwGraphLooksLikeImageCodeV40(rva, text)) return -1;
        const int existing = DwRankFindNodeV41(nodes, rva);
        if (existing >= 0)
        {
            auto& n = nodes[static_cast<std::size_t>(existing)];
            if (depth < n.depth) n.depth = depth;
            if (score > n.score) n.score = score;
            n.flags |= flags;
            return existing;
        }
        if (nodes.size() >= 6500u) return -1;

        DwRankNodeV41 n{};
        n.rva = rva;
        n.beginRva = rva;
        n.depth = depth;
        n.origin = origin;
        n.score = score + DwRankBaseScoreV41(rva);
        n.flags = flags;
        const auto base = MainImageBase();
        std::uintptr_t beginAbs = 0, endAbs = 0;
        if (base && RuntimeFunctionBounds144(base + rva, beginAbs, endAbs) &&
            beginAbs >= base && endAbs > beginAbs && endAbs - beginAbs <= 0x2000u)
        {
            n.beginRva = beginAbs - base;
            n.endRva = endAbs - base;
            n.rva = n.beginRva;
        }
        else
        {
            n.endRva = (std::min)(rva + static_cast<std::uintptr_t>(0x180u),
                text.rva + static_cast<std::uintptr_t>(text.size));
        }
        nodes.push_back(n);
        return static_cast<int>(nodes.size() - 1u);
    }

    static bool DwRankNearestEdxImmV41(std::uintptr_t callRva, std::uintptr_t beginRva,
        const unsigned char* code, std::size_t codeSize, std::uint32_t& value,
        std::uintptr_t& siteRva) noexcept
    {
        value = 0; siteRva = 0;
        if (!code || callRva < beginRva) return false;
        const std::size_t off = static_cast<std::size_t>(callRva - beginRva);
        if (off > codeSize) return false;
        const std::size_t start = off > 0x60u ? off - 0x60u : 0u;
        for (std::size_t pos = off; pos > start; --pos)
        {
            const std::size_t i = pos - 1u;
            if (i + 5u <= off && code[i] == 0xBAu)
            {
                memcpy(&value, code + i + 1u, sizeof(value));
                siteRva = beginRva + i;
                return true;
            }
            if (i + 2u <= off && code[i] == 0x8Bu && ((code[i + 1u] >> 3) & 7u) == 2u)
                return false; // EDX overwritten dynamically after any older immediate.
        }
        return false;
    }

    static void DwRankBuildReverseIndexV41(std::vector<DwReverseEdgeV41>& reverse,
        const ImageSectionView& text, ULONGLONG deadlineMs) noexcept
    {
        // V42: keep the one-shot brain responsive.  Build only a cheap raw
        // rel32 edge index here; resolving the containing caller function via
        // unwind metadata is deferred until a hot target actually consumes an
        // edge.  V41 did RuntimeFunctionBounds144 for every E8/E9 candidate and
        // could spend minutes in this setup phase before expanding one node.
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size) return;
        reverse.reserve(64000u);
        constexpr std::size_t kChunk = 0x20000u;
        constexpr std::size_t kEdgeCap = 90000u;
        std::size_t scanned = 0;
        unsigned rangesDone = 0;
        for (const auto& range : kDwGraphRangesV40)
        {
            const std::uintptr_t endRva = (std::min)(range.endRva, static_cast<std::uintptr_t>(size));
            if (endRva <= range.beginRva + 5u) continue;
            std::uintptr_t cursor = range.beginRva;
            while (cursor + 5u <= endRva && reverse.size() < kEdgeCap)
            {
                if (GetTickCount64() >= deadlineMs)
                {
                    InternalLog("[DW-GRAPH-V50] REVERSE_INDEX_CAPPED reason=time scannedBytes=%zu edges=%zu rangesDone=%u\r\n", scanned, reverse.size(), rangesDone);
                    return;
                }
                const std::size_t span = static_cast<std::size_t>((std::min)(endRva - cursor, static_cast<std::uintptr_t>(kChunk)));
                if (span < 5u) break;
                std::vector<unsigned char> raw(span);
                if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + cursor), raw.data(), span))
                {
                    for (std::size_t off = 0; off + 5u <= span && reverse.size() < kEdgeCap; ++off)
                    {
                        const unsigned char op = raw[off];
                        if (op != 0xE8u && op != 0xE9u) continue;
                        std::int32_t rel = 0; memcpy(&rel, raw.data() + off + 1u, sizeof(rel));
                        const std::uintptr_t siteRva = cursor + off;
                        const std::uintptr_t targetRva = siteRva + 5u + static_cast<std::intptr_t>(rel);
                        if (!DwGraphLooksLikeImageCodeV40(targetRva, text)) continue;
                        if (!DwGraphInKnownRangeV40(targetRva)) continue;
                        reverse.push_back({0u, siteRva, targetRva, op == 0xE8u ? "CALL" : "JMP"});
                    }
                }
                scanned += span;
                if (span <= 4u) break;
                cursor += static_cast<std::uintptr_t>(span - 4u); // preserve rel32 boundary overlap
            }
            ++rangesDone;
            InternalLog("[DW-GRAPH-V50] REVERSE_INDEX_PROGRESS range=%s rangesDone=%u scannedBytes=%zu edges=%zu\r\n",
                range.label, rangesDone, scanned, reverse.size());
            if (reverse.size() >= kEdgeCap) break;
        }
    }

    static void DwRankScanPointerTableV41(std::uintptr_t tableRva, const DwRankNodeV41& owner,
        std::vector<DwRankNodeV41>& nodes, std::vector<DwRankEdgeV41>& edges,
        const ImageSectionView& text) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || tableRva >= size) return;
        unsigned char raw[0x100]{};
        const std::size_t span = (std::min)(static_cast<std::size_t>(sizeof(raw)), size - static_cast<std::size_t>(tableRva));
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + tableRva), raw, span)) return;
        for (std::size_t off = 0; off + 8u <= span; off += 8u)
        {
            std::uintptr_t ptr = 0; memcpy(&ptr, raw + off, sizeof(ptr));
            if (ptr < base || ptr >= base + size) continue;
            const std::uintptr_t rva = ptr - base;
            if (!DwGraphLooksLikeImageCodeV40(rva, text)) continue;
            DwRankAddNodeV41(nodes, rva, owner.depth + 1u, owner.origin,
                owner.score - 8, 0, text);
            edges.push_back({owner.beginRva, tableRva + off, rva, "TABLE_PTR"});
        }
    }

    static bool DwV49DecodeDirectCall(std::uintptr_t base, std::uintptr_t siteRva, std::uintptr_t& targetRva) noexcept
    {
        targetRva = 0;
        unsigned char raw[5]{};
        if (!base || !siteRva || !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + siteRva), raw, sizeof(raw)) || raw[0] != 0xE8u)
            return false;
        std::int32_t rel = 0; memcpy(&rel, raw + 1u, sizeof(rel));
        targetRva = siteRva + 5u + static_cast<std::intptr_t>(rel);
        return true;
    }

    static void DwV49LogGateCallsitePair(const char* owner, std::uintptr_t firstCallRva, std::uintptr_t secondCallRva,
        std::uintptr_t testRva, std::uintptr_t branchRva) noexcept
    {
        const auto base = MainImageBase();
        if (!base || !owner) return;
        std::uintptr_t firstTarget = 0, secondTarget = 0;
        const bool firstOk = DwV49DecodeDirectCall(base, firstCallRva, firstTarget);
        const bool secondOk = DwV49DecodeDirectCall(base, secondCallRva, secondTarget);
        unsigned char test[2]{}, branch[6]{};
        const bool testOk = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + testRva), test, sizeof(test));
        const bool branchOk = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + branchRva), branch, sizeof(branch));
        std::uintptr_t branchTarget = 0; unsigned branchBytes = 0;
        if (branchOk && branch[0] >= 0x70u && branch[0] <= 0x7Fu)
        {
            branchTarget = branchRva + 2u + static_cast<std::int8_t>(branch[1]); branchBytes = 2u;
        }
        else if (branchOk && branch[0] == 0x0Fu && branch[1] >= 0x80u && branch[1] <= 0x8Fu)
        {
            std::int32_t rel = 0; memcpy(&rel, branch + 2u, sizeof(rel));
            branchTarget = branchRva + 6u + static_cast<std::intptr_t>(rel); branchBytes = 6u;
        }
        const bool pairExact = firstOk && secondOk && firstTarget == 0x2E02E40u && secondTarget == 0x2E02F00u;
        const bool testAl = testOk && test[0] == 0x84u && test[1] == 0xC0u;
        const char* branchSense = "UNKNOWN";
        if (branchOk && branch[0] == 0x74u) branchSense = "GATE_FALSE_TAKES_BRANCH_GATE_TRUE_FALLTHROUGH";
        else if (branchOk && branch[0] == 0x75u) branchSense = "GATE_TRUE_TAKES_BRANCH_GATE_FALSE_FALLTHROUGH";
        InternalLog("[DW-GATE-V50] CALLSITE owner=%s firstCall=0x%llX firstTarget=%s0x%llX secondCall=0x%llX secondTarget=%s0x%llX pairExact=%s testAl=%s branchRva=0x%llX branchOpcode=0x%02X branchBytes=%u branchTarget=%s0x%llX semantics=%s read_only=yes\r\n",
            owner, static_cast<unsigned long long>(firstCallRva), firstOk ? "" : "n/a-", static_cast<unsigned long long>(firstTarget),
            static_cast<unsigned long long>(secondCallRva), secondOk ? "" : "n/a-", static_cast<unsigned long long>(secondTarget),
            pairExact ? "YES" : "no", testAl ? "YES" : "no", static_cast<unsigned long long>(branchRva), branchOk ? branch[0] : 0u,
            branchBytes, branchTarget ? "" : "n/a-", static_cast<unsigned long long>(branchTarget), branchSense);
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GATE-V50] CALLSITE owner=%s firstCall=0x%llX firstTarget=%s0x%llX secondCall=0x%llX secondTarget=%s0x%llX pairExact=%s testAl=%s branchRva=0x%llX branchOpcode=0x%02X branchBytes=%u branchTarget=%s0x%llX semantics=%s read_only=yes\r\n",
            owner, static_cast<unsigned long long>(firstCallRva), firstOk ? "" : "n/a-", static_cast<unsigned long long>(firstTarget),
            static_cast<unsigned long long>(secondCallRva), secondOk ? "" : "n/a-", static_cast<unsigned long long>(secondTarget),
            pairExact ? "YES" : "no", testAl ? "YES" : "no", static_cast<unsigned long long>(branchRva), branchOk ? branch[0] : 0u,
            branchBytes, branchTarget ? "" : "n/a-", static_cast<unsigned long long>(branchTarget), branchSense);
    }

    static bool DwV50DecodeRipLeaTarget(std::uintptr_t base, std::uintptr_t siteRva, std::uintptr_t& targetRva) noexcept
    {
        targetRva = 0;
        unsigned char raw[7]{};
        if (!base || !siteRva ||
            !ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + siteRva), raw, sizeof(raw)))
            return false;
        if (raw[0] != 0x48u || raw[1] != 0x8Du || (raw[2] != 0x05u && raw[2] != 0x0Du))
            return false;
        std::int32_t disp = 0;
        memcpy(&disp, raw + 3u, sizeof(disp));
        targetRva = siteRva + 7u + static_cast<std::intptr_t>(disp);
        return true;
    }

    static void DwV50LogExactGlobalGateTable() noexcept
    {
        const auto base = MainImageBase();
        if (!base) return;

        unsigned char getter[8]{};
        unsigned char gate[0x29]{};
        const bool getterReadable = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + 0x2E02E40u), getter, sizeof(getter));
        const bool gateReadable = ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + 0x2E02F00u), gate, sizeof(gate));
        const bool getterExact = getterReadable && getter[0] == 0x48u && getter[1] == 0x8Du && getter[2] == 0x05u && getter[7] == 0xC3u;
        const bool gateShape = gateReadable &&
            gate[0] == 0x48u && gate[1] == 0x8Du && gate[2] == 0x05u &&
            gate[7] == 0x48u && gate[8] == 0x8Du && gate[9] == 0x0Du &&
            gate[0x10] == 0x83u && gate[0x11] == 0x78u && gate[0x12] == 0xF3u && gate[0x13] == 0x03u;

        std::uintptr_t getterGlobal = 0, fieldBegin = 0, fieldEnd = 0;
        const bool getterLea = DwV50DecodeRipLeaTarget(base, 0x2E02E40u, getterGlobal);
        const bool beginLea = DwV50DecodeRipLeaTarget(base, 0x2E02F00u, fieldBegin);
        const bool endLea = DwV50DecodeRipLeaTarget(base, 0x2E02F07u, fieldEnd);

        const bool rcxOverwritten = gateReadable && gate[7] == 0x48u && gate[8] == 0x8Du && gate[9] == 0x0Du;
        const std::uintptr_t recordBase = fieldBegin >= 0xDu ? fieldBegin - 0xDu : 0u;
        const std::uintptr_t span = (fieldEnd > fieldBegin) ? (fieldEnd - fieldBegin) : 0u;
        const unsigned recordCount = (span && (span % 0x10u) == 0u) ? static_cast<unsigned>(span / 0x10u) : 0u;

        InternalLog("[DW-GATE-V50] EXACT_DECODE getterRva=0x2E02E40 getterExact=%s getterGlobal=%s0x%llX gateRva=0x2E02F00 gateShape=%s rcxArgumentConsumed=%s reason=%s fieldBegin=%s0x%llX fieldEnd=%s0x%llX recordBase=%s0x%llX stride=0x10 records=%u read_only=yes stateWrites=off\r\n",
            getterExact ? "YES" : "no", getterLea ? "" : "n/a-", static_cast<unsigned long long>(getterGlobal),
            gateShape ? "YES" : "no", rcxOverwritten ? "no" : "unknown",
            rcxOverwritten ? "RCX_overwritten_by_LEA_at_0x2E02F07_before_any_use" : "shape_not_proven",
            beginLea ? "" : "n/a-", static_cast<unsigned long long>(fieldBegin),
            endLea ? "" : "n/a-", static_cast<unsigned long long>(fieldEnd),
            recordBase ? "" : "n/a-", static_cast<unsigned long long>(recordBase), recordCount);
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GATE-V50] EXACT_DECODE getterRva=0x2E02E40 getterExact=%s getterGlobal=%s0x%llX gateRva=0x2E02F00 gateShape=%s rcxArgumentConsumed=%s reason=%s fieldBegin=%s0x%llX fieldEnd=%s0x%llX recordBase=%s0x%llX stride=0x10 records=%u read_only=yes stateWrites=off\r\n",
            getterExact ? "YES" : "no", getterLea ? "" : "n/a-", static_cast<unsigned long long>(getterGlobal),
            gateShape ? "YES" : "no", rcxOverwritten ? "no" : "unknown",
            rcxOverwritten ? "RCX_overwritten_by_LEA_at_0x2E02F07_before_any_use" : "shape_not_proven",
            beginLea ? "" : "n/a-", static_cast<unsigned long long>(fieldBegin),
            endLea ? "" : "n/a-", static_cast<unsigned long long>(fieldEnd),
            recordBase ? "" : "n/a-", static_cast<unsigned long long>(recordBase), recordCount);

        if (getterLea)
        {
            unsigned char raw[0x20]{};
            if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + getterGlobal), raw, sizeof(raw)))
            {
                char hex[0x20u * 3u + 1u]{};
                std::size_t used = 0;
                for (std::size_t i = 0; i < sizeof(raw) && used + 4u < ArrayCount(hex); ++i)
                {
                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                        "%02X%s", raw[i], (i + 1u) == sizeof(raw) ? "" : " ");
                    if (wrote > 0) used += static_cast<std::size_t>(wrote);
                }
                InternalLog("[DW-GATE-V50] GETTER_GLOBAL rva=0x%llX raw32={%s} semantics=address_return_only_no_side_effect_seen\r\n",
                    static_cast<unsigned long long>(getterGlobal), hex);
            }
        }

        bool allRecordsSatisfyCandidate = recordCount > 0u;
        unsigned state3Count = 0, nonzeroFlagCount = 0, blockingCandidateCount = 0;
        if (recordBase && recordCount && recordCount <= 32u)
        {
            for (unsigned i = 0; i < recordCount; ++i)
            {
                unsigned char raw[0x10]{};
                const std::uintptr_t recRva = recordBase + static_cast<std::uintptr_t>(i) * 0x10u;
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + recRva), raw, sizeof(raw)))
                {
                    allRecordsSatisfyCandidate = false;
                    InternalLog("[DW-GATE-V50] TABLE_RECORD index=%u rva=0x%llX readable=no\r\n",
                        i, static_cast<unsigned long long>(recRva));
                    continue;
                }
                std::uint32_t state = 0; memcpy(&state, raw, sizeof(state));
                const unsigned flag = raw[0x0Du];
                const bool state3 = state == 3u;
                const bool flagNonzero = flag != 0u;
                const bool satisfyCandidate = state3 || flagNonzero;
                if (state3) ++state3Count;
                if (flagNonzero) ++nonzeroFlagCount;
                if (!satisfyCandidate) { ++blockingCandidateCount; allRecordsSatisfyCandidate = false; }
                char hex[0x10u * 3u + 1u]{};
                std::size_t used = 0;
                for (std::size_t b = 0; b < sizeof(raw) && used + 4u < ArrayCount(hex); ++b)
                {
                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                        "%02X%s", raw[b], (b + 1u) == sizeof(raw) ? "" : " ");
                    if (wrote > 0) used += static_cast<std::size_t>(wrote);
                }
                InternalLog("[DW-GATE-V50] TABLE_RECORD index=%u rva=0x%llX state=0x%08X flag13=0x%02X candidateSatisfied=%s raw={%s}\r\n",
                    i, static_cast<unsigned long long>(recRva), state, flag, satisfyCandidate ? "YES" : "no", hex);
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GATE-V50] TABLE_RECORD index=%u rva=0x%llX state=0x%08X flag13=0x%02X candidateSatisfied=%s raw={%s}\r\n",
                    i, static_cast<unsigned long long>(recRva), state, flag, satisfyCandidate ? "YES" : "no", hex);
            }
        }

        InternalLog("[DW-GATE-V50] TABLE_SUMMARY records=%u state3=%u flag13Nonzero=%u blockingCandidates=%u allCandidateSatisfied=%s resetOwnerFalseBranch=SKIPS_RESET interpretation=%s next=trace_missing_source3_state_writer stateWrites=off\r\n",
            recordCount, state3Count, nonzeroFlagCount, blockingCandidateCount,
            allRecordsSatisfyCandidate ? "YES" : "no",
            gateShape ? "GLOBAL_TABLE_SIDE_GATE_RULED_OUT_AS_LIVE_RESET_CAUSE" : "GATE_SHAPE_UNPROVEN");
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GATE-V50] TABLE_SUMMARY records=%u state3=%u flag13Nonzero=%u blockingCandidates=%u allCandidateSatisfied=%s resetOwnerFalseBranch=SKIPS_RESET interpretation=%s next=trace_missing_source3_state_writer stateWrites=off\r\n",
            recordCount, state3Count, nonzeroFlagCount, blockingCandidateCount,
            allRecordsSatisfyCandidate ? "YES" : "no",
            gateShape ? "GLOBAL_TABLE_SIDE_GATE_RULED_OUT_AS_LIVE_RESET_CAUSE" : "GATE_SHAPE_UNPROVEN");
    }

    static void DwV49RunFocusedGateProof(const std::vector<DwRankNodeV41>& nodes, const std::vector<DwRankEdgeV41>& edges) noexcept
    {
        InternalLog("[DW-GATE-V50] BEGIN gatePair={getter:0x2E02E40,predicate:0x2E02F00} contexts={LIVE_RESET_OWNER:0x2D1F9EF,A_RESULT_FETCH:0x3D5E090} mode=STATIC_READ_ONLY stateWrites=off\r\n");
        DwV49LogGateCallsitePair("LIVE_RESET_OWNER", 0x2D21276u, 0x2D2127Eu, 0x2D21283u, 0x2D21285u);
        DwV49LogGateCallsitePair("A_RESULT_FETCH", 0x3D5E0E6u, 0x3D5E0EEu, 0x3D5E0F3u, 0x3D5E0F5u);
        // V50: these two RVAs have tiny exact bodies; do not use the old +0x180 fallback
        // because it merged several adjacent functions and generated false edges.
        DwV50LogExactGlobalGateTable();

        unsigned resetToGetter = 0, resetToGate = 0, fetchToGetter = 0, fetchToGate = 0, otherGateCallers = 0;
        for (const auto& e : edges)
        {
            if (!e.kind || strcmp(e.kind, "CALL") != 0) continue;
            const bool getter = e.toRva >= 0x2E02E40u && e.toRva < 0x2E02E80u;
            const bool gate = e.toRva >= 0x2E02F00u && e.toRva < 0x2E02F80u;
            if (!getter && !gate) continue;
            if (e.fromRva >= 0x2D1F9EFu && e.fromRva < 0x2D212DAu)
            {
                if (getter) ++resetToGetter; if (gate) ++resetToGate;
            }
            else if (e.fromRva >= 0x3D5E090u && e.fromRva < 0x3D5E1C2u)
            {
                if (getter) ++fetchToGetter; if (gate) ++fetchToGate;
            }
            else
            {
                ++otherGateCallers;
                if (otherGateCallers <= 24u)
                    InternalLog("[DW-GATE-V50] OTHER_CALLER fromRva=0x%llX siteRva=0x%llX targetRva=0x%llX kind=%s\r\n",
                        static_cast<unsigned long long>(e.fromRva), static_cast<unsigned long long>(e.siteRva),
                        static_cast<unsigned long long>(e.toRva), e.kind);
            }
        }
        std::uintptr_t a=0,b=0,c=0,d=0;
        const auto base = MainImageBase();
        const bool resetPairByteProof = base && DwV49DecodeDirectCall(base, 0x2D21276u, a) && a == 0x2E02E40u &&
            DwV49DecodeDirectCall(base, 0x2D2127Eu, b) && b == 0x2E02F00u;
        const bool fetchPairByteProof = base && DwV49DecodeDirectCall(base, 0x3D5E0E6u, c) && c == 0x2E02E40u &&
            DwV49DecodeDirectCall(base, 0x3D5E0EEu, d) && d == 0x2E02F00u;
        const bool sharedExact = resetPairByteProof && fetchPairByteProof;
        InternalLog("[DW-GATE-V50] SHARED_GATE_PROOF resetPairByteProof=%s resultFetchPairByteProof=%s graphCounters={resetGetter:%u,resetGate:%u,fetchGetter:%u,fetchGate:%u} graphCounterMiss=%s sharedExact=%s interpretation=%s stateWrites=off\r\n",
            resetPairByteProof ? "YES" : "no", fetchPairByteProof ? "YES" : "no",
            resetToGetter, resetToGate, fetchToGetter, fetchToGate,
            (sharedExact && (!fetchToGetter || !fetchToGate)) ? "YES" : "no", sharedExact ? "YES" : "no",
            sharedExact ? "SAME_CALL_PAIR_BYTE_PROVEN_BUT_GATE_USES_GLOBAL_TABLE_NOT_GETTER_ARGUMENT" : "PAIR_NOT_BYTE_PROVEN");
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GATE-V50] SHARED_GATE_PROOF resetPairByteProof=%s resultFetchPairByteProof=%s graphCounters={resetGetter:%u,resetGate:%u,fetchGetter:%u,fetchGate:%u} graphCounterMiss=%s sharedExact=%s interpretation=%s stateWrites=off\r\n",
            resetPairByteProof ? "YES" : "no", fetchPairByteProof ? "YES" : "no",
            resetToGetter, resetToGate, fetchToGetter, fetchToGate,
            (sharedExact && (!fetchToGetter || !fetchToGate)) ? "YES" : "no", sharedExact ? "YES" : "no",
            sharedExact ? "SAME_CALL_PAIR_BYTE_PROVEN_BUT_GATE_USES_GLOBAL_TABLE_NOT_GETTER_ARGUMENT" : "PAIR_NOT_BYTE_PROVEN");
    }

    static void DwRankLogBridgeAnalysisV45(const std::vector<DwRankNodeV41>& nodes,
        const std::vector<DwRankEdgeV41>& edges) noexcept
    {
        if (nodes.empty()) return;

        // V45: the graph can contain separate failure and protocol components even
        // when no literal STATUS1->LSG path exists.  Build one adjacency map after
        // exploration, then search for the nearest node reached from both sides.
        // A second pass uses only synthetic REVERSE_CALLER edges to identify a
        // genuine shared caller/ancestor rather than an arbitrary undirected join.
        InternalLog("[DW-GRAPH-V50] BRIDGE_BEGIN nodes=%zu edges=%zu lookup=BINARY_INDEX stateWrites=off\r\n",
            nodes.size(), edges.size());
        InternalLog("[DW-GRAPH-V50] SEED_CORRECTION aResultGate=0x3D61170 class=RESULT_GATE protocolFlagRemoved=YES protocolRoots={0x618B718,0x619EE0A,0x2C17A60} proofEdges={CALL,JMP,REVERSE_CALLER} tableEdges=REJECTED resetSetterExact=0x3C1DF30..0x3C1DF38 stateWrites=off\r\n");
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] SEED_CORRECTION aResultGate=0x3D61170 class=RESULT_GATE protocolFlagRemoved=YES protocolRoots={0x618B718,0x619EE0A,0x2C17A60} proofEdges={CALL,JMP,REVERSE_CALLER} tableEdges=REJECTED resetSetterExact=0x3C1DF30..0x3C1DF38 stateWrites=off\r\n");

        // V45: V44 stalled here because DwRankFindNodeV41 is linear and was called
        // twice for every graph edge. Build a compact sorted RVA -> node index once,
        // then resolve edge endpoints with binary search. This keeps the final bridge
        // phase bounded even when the graph reaches several thousand nodes.
        std::vector<std::pair<std::uintptr_t, int>> nodeIndex;
        nodeIndex.reserve(nodes.size());
        for (std::size_t i = 0; i < nodes.size(); ++i)
            nodeIndex.emplace_back(nodes[i].beginRva, static_cast<int>(i));
        std::sort(nodeIndex.begin(), nodeIndex.end(),
            [](const std::pair<std::uintptr_t, int>& a, const std::pair<std::uintptr_t, int>& b) {
                if (a.first != b.first) return a.first < b.first;
                return a.second < b.second;
            });
        nodeIndex.erase(std::unique(nodeIndex.begin(), nodeIndex.end(),
            [](const std::pair<std::uintptr_t, int>& a, const std::pair<std::uintptr_t, int>& b) {
                return a.first == b.first;
            }), nodeIndex.end());

        auto fastFindNode = [&](std::uintptr_t rva) noexcept -> int {
            // Match the original DwRankFindNodeV41 semantics: an edge target may
            // land anywhere inside a function, not only at its begin RVA.
            auto it = std::upper_bound(nodeIndex.begin(), nodeIndex.end(), rva,
                [](std::uintptr_t value, const std::pair<std::uintptr_t, int>& item) {
                    return value < item.first;
                });
            if (it == nodeIndex.begin()) return -1;
            --it;
            const int index = it->second;
            if (index < 0 || static_cast<std::size_t>(index) >= nodes.size()) return -1;
            const auto& n = nodes[static_cast<std::size_t>(index)];
            if (rva == n.rva || (n.beginRva && rva >= n.beginRva && rva < n.endRva))
                return index;
            return -1;
        };

        std::vector<std::vector<int>> adj(nodes.size());
        std::vector<std::vector<int>> forwardAdj(nodes.size());
        std::vector<std::vector<int>> reverseAdj(nodes.size());
        std::size_t resolvedEdges = 0;
        std::size_t rejectedWeakEdges = 0;
        std::size_t rejectedOwnerEdges = 0;
        unsigned rejectedLogged = 0;
        auto isStrongKind = [](const char* kind) noexcept {
            return kind && (strcmp(kind, "CALL") == 0 || strcmp(kind, "JMP") == 0 || strcmp(kind, "REVERSE_CALLER") == 0);
        };
        auto siteBelongsToOwner = [&](int ownerIndex, const DwRankEdgeV41& e) noexcept {
            if (ownerIndex < 0 || static_cast<std::size_t>(ownerIndex) >= nodes.size()) return false;
            const auto& owner = nodes[static_cast<std::size_t>(ownerIndex)];
            // 0x3C1DF30 is a proven tiny setter: C6 05 <disp32> 01 ; C3.
            // The old +0x180 fallback incorrectly merged the following function and
            // manufactured a setter -> A_RESULT_GATE edge at 0x3C1DF99.
            if (owner.beginRva == 0x3C1DF30u)
                return e.siteRva >= 0x3C1DF30u && e.siteRva < 0x3C1DF38u;
            return owner.beginRva && e.siteRva >= owner.beginRva && e.siteRva < owner.endRva;
        };
        for (const auto& e : edges)
        {
            const int a = fastFindNode(e.fromRva);
            const int b = fastFindNode(e.toRva);
            if (a < 0 || b < 0 || a == b) continue;
            if (!isStrongKind(e.kind))
            {
                ++rejectedWeakEdges;
                if (rejectedLogged < 12u && e.kind && strstr(e.kind, "TABLE") != nullptr)
                {
                    ++rejectedLogged;
                    InternalLog("[DW-GRAPH-V50] STRICT_EDGE_REJECT reason=weak_table kind=%s fromRva=0x%llX siteRva=0x%llX toRva=0x%llX\r\n",
                        e.kind, static_cast<unsigned long long>(e.fromRva), static_cast<unsigned long long>(e.siteRva),
                        static_cast<unsigned long long>(e.toRva));
                }
                continue;
            }
            if (strcmp(e.kind, "REVERSE_CALLER") != 0 && !siteBelongsToOwner(a, e))
            {
                ++rejectedOwnerEdges;
                if (rejectedLogged < 20u)
                {
                    ++rejectedLogged;
                    InternalLog("[DW-GRAPH-V50] STRICT_EDGE_REJECT reason=site_outside_owner kind=%s ownerRva=0x%llX siteRva=0x%llX toRva=0x%llX\r\n",
                        e.kind ? e.kind : "?", static_cast<unsigned long long>(nodes[static_cast<std::size_t>(a)].beginRva),
                        static_cast<unsigned long long>(e.siteRva), static_cast<unsigned long long>(e.toRva));
                }
                continue;
            }
            ++resolvedEdges;
            adj[static_cast<std::size_t>(a)].push_back(b);
            adj[static_cast<std::size_t>(b)].push_back(a);
            if (e.kind && (strcmp(e.kind, "CALL") == 0 || strcmp(e.kind, "JMP") == 0))
                forwardAdj[static_cast<std::size_t>(a)].push_back(b); // actual execution direction only
            if (e.kind && strcmp(e.kind, "REVERSE_CALLER") == 0)
                reverseAdj[static_cast<std::size_t>(a)].push_back(b); // target -> caller
        }
        InternalLog("[DW-GRAPH-V50] BRIDGE_GRAPH_READY indexed=%zu strongEdges=%zu rejectedWeak=%zu rejectedOwner=%zu unresolvedOrRejected=%zu\r\n",
            nodeIndex.size(), resolvedEdges, rejectedWeakEdges, rejectedOwnerEdges,
            edges.size() >= resolvedEdges ? edges.size() - resolvedEdges : 0u);

        InternalLog("[DW-GRAPH-V50] LIVE_RESET_CHAIN provenRuntime={0x2D212B5->0x3C1DF30, return0x2D212BA, callerL1=0x3D21540, callerL2=0x3D21754, callerL3Return=0x3A21725} goal=trace_exact_condition_not_graph_fallback stateWrites=off\r\n");

        static constexpr std::uintptr_t kFailureRoots[] = {
            0x4530A57u, // direct status-1 operation
            0x2D1F9EFu, // live SOURCE3/reset owner
            0x3D59CD0u  // DW disconnect/error dispatcher
        };
        static constexpr std::uintptr_t kProtocolRoots[] = {
            0x618B718u, // account_token owner
            0x619EE0Au, // connecting-LSG anchor
            0x2C17A60u  // cod-iw8-bnet-pc owner
        };

        auto seedIndices = [&](const std::uintptr_t* roots, std::size_t count) {
            std::vector<int> out;
            for (std::size_t i = 0; i < count; ++i)
            {
                const int n = fastFindNode(roots[i]);
                if (n >= 0 && std::find(out.begin(), out.end(), n) == out.end()) out.push_back(n);
            }
            return out;
        };

        const auto failSeeds = seedIndices(kFailureRoots, ArrayCount(kFailureRoots));
        const auto protoSeeds = seedIndices(kProtocolRoots, ArrayCount(kProtocolRoots));

        auto bfs = [&](const std::vector<std::vector<int>>& graph, const std::vector<int>& seeds,
            std::vector<int>& dist, std::vector<int>& prev) {
            dist.assign(nodes.size(), -1);
            prev.assign(nodes.size(), -1);
            std::vector<int> q;
            q.reserve(nodes.size());
            for (int sidx : seeds)
            {
                dist[static_cast<std::size_t>(sidx)] = 0;
                prev[static_cast<std::size_t>(sidx)] = sidx;
                q.push_back(sidx);
            }
            std::size_t head = 0;
            while (head < q.size())
            {
                const int cur = q[head++];
                for (int next : graph[static_cast<std::size_t>(cur)])
                {
                    if (next < 0 || dist[static_cast<std::size_t>(next)] >= 0) continue;
                    dist[static_cast<std::size_t>(next)] = dist[static_cast<std::size_t>(cur)] + 1;
                    prev[static_cast<std::size_t>(next)] = cur;
                    q.push_back(next);
                }
            }
        };


        auto emitDirectedAny = [&](const char* label, const std::vector<int>& starts, const std::vector<int>& goals) {
            std::vector<int> dist, prev;
            bfs(forwardAdj, starts, dist, prev);
            int bestGoal = -1;
            for (int g : goals)
            {
                if (g < 0 || static_cast<std::size_t>(g) >= dist.size() || dist[static_cast<std::size_t>(g)] < 0) continue;
                if (bestGoal < 0 || dist[static_cast<std::size_t>(g)] < dist[static_cast<std::size_t>(bestGoal)]) bestGoal = g;
            }
            if (bestGoal < 0)
            {
                InternalLog("[DW-GRAPH-V50] DIRECTED_PATH label=%s found=no semantics=NO_FORWARD_CALL_JMP_CAUSAL_PATH_IN_GRAPH\r\n", label);
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GRAPH-V50] DIRECTED_PATH label=%s found=no semantics=NO_FORWARD_CALL_JMP_CAUSAL_PATH_IN_GRAPH\r\n", label);
                return;
            }
            std::vector<int> chain;
            int cur = bestGoal;
            while (cur >= 0)
            {
                chain.push_back(cur);
                const int p = prev[static_cast<std::size_t>(cur)];
                if (p < 0 || p == cur) break;
                cur = p;
            }
            std::reverse(chain.begin(), chain.end());
            InternalLog("[DW-GRAPH-V50] DIRECTED_PATH label=%s found=YES hops=%zu semantics=FORWARD_CALL_JMP_ONLY\r\n",
                label, chain.size() ? chain.size() - 1u : 0u);
            for (std::size_t i = 0; i < chain.size(); ++i)
                InternalLog("[DW-GRAPH-V50] DIRECTED_NODE label=%s step=%zu rva=0x%llX\r\n",
                    label, i, static_cast<unsigned long long>(nodes[static_cast<std::size_t>(chain[i])].beginRva));
        };
        emitDirectedAny("PROTOCOL_TO_FAILURE", protoSeeds, failSeeds);
        emitDirectedAny("FAILURE_TO_PROTOCOL", failSeeds, protoSeeds);

        std::vector<int> failDist, failPrev, protoDist, protoPrev;
        bfs(adj, failSeeds, failDist, failPrev);
        bfs(adj, protoSeeds, protoDist, protoPrev);

        struct BridgeCandidateV45 { int index; int failDist; int protoDist; int total; int score; };
        std::vector<BridgeCandidateV45> candidates;
        for (std::size_t i = 0; i < nodes.size(); ++i)
        {
            if (failDist[i] < 0 || protoDist[i] < 0) continue;
            candidates.push_back({static_cast<int>(i), failDist[i], protoDist[i], failDist[i] + protoDist[i], nodes[i].score});
        }
        std::sort(candidates.begin(), candidates.end(), [](const BridgeCandidateV45& a, const BridgeCandidateV45& b) {
            if (a.total != b.total) return a.total < b.total;
            if (a.failDist != b.failDist) return a.failDist < b.failDist;
            return a.score > b.score;
        });

        auto emitEdgeDetail = [&](const char* side, std::size_t step, int aIndex, int bIndex) {
            if (aIndex < 0 || bIndex < 0) return;
            unsigned matches = 0;
            for (const auto& e : edges)
            {
                const int ea = fastFindNode(e.fromRva);
                const int eb = fastFindNode(e.toRva);
                if (!((ea == aIndex && eb == bIndex) || (ea == bIndex && eb == aIndex))) continue;
                ++matches;
                InternalLog("[DW-GRAPH-V50] BRIDGE_EDGE side=%s step=%zu match=%u fromRva=0x%llX siteRva=0x%llX toRva=0x%llX kind=%s direction=%s\r\n",
                    side, step, matches, static_cast<unsigned long long>(e.fromRva),
                    static_cast<unsigned long long>(e.siteRva), static_cast<unsigned long long>(e.toRva),
                    e.kind ? e.kind : "?", ea == aIndex ? "PATH_FORWARD" : "PATH_REVERSED");
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GRAPH-V50] BRIDGE_EDGE side=%s step=%zu match=%u fromRva=0x%llX siteRva=0x%llX toRva=0x%llX kind=%s direction=%s\r\n",
                    side, step, matches, static_cast<unsigned long long>(e.fromRva),
                    static_cast<unsigned long long>(e.siteRva), static_cast<unsigned long long>(e.toRva),
                    e.kind ? e.kind : "?", ea == aIndex ? "PATH_FORWARD" : "PATH_REVERSED");
                if (matches >= 8u) break;
            }
            if (!matches)
                InternalLog("[DW-GRAPH-V50] BRIDGE_EDGE side=%s step=%zu match=0 reason=no_resolved_direct_edge\r\n", side, step);
        };

        if (candidates.empty())
        {
            InternalLog("[DW-GRAPH-V50] BRIDGE found=no failureSeeds=%zu protocolSeeds=%zu reason=components_still_disconnected\r\n",
                failSeeds.size(), protoSeeds.size());
            ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                "[DW-GRAPH-V50] BRIDGE found=no failureSeeds=%zu protocolSeeds=%zu reason=components_still_disconnected\r\n",
                failSeeds.size(), protoSeeds.size());
        }
        else
        {
            const std::size_t emit = (std::min)(static_cast<std::size_t>(16u), candidates.size());
            for (std::size_t rank = 0; rank < emit; ++rank)
            {
                const auto& c = candidates[rank];
                const auto& n = nodes[static_cast<std::size_t>(c.index)];
                InternalLog("[DW-GRAPH-V50] BRIDGE_CANDIDATE rank=%zu rva=0x%llX failDist=%d protocolDist=%d total=%d score=%d flags=0x%X depth=%u\r\n",
                    rank + 1u, static_cast<unsigned long long>(n.beginRva), c.failDist, c.protoDist, c.total, n.score, n.flags, n.depth);
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GRAPH-V50] BRIDGE_CANDIDATE rank=%zu rva=0x%llX failDist=%d protocolDist=%d total=%d score=%d flags=0x%X depth=%u\r\n",
                    rank + 1u, static_cast<unsigned long long>(n.beginRva), c.failDist, c.protoDist, c.total, n.score, n.flags, n.depth);
            }

            const int bridge = candidates.front().index;
            InternalLog("[DW-GRAPH-V50] BRIDGE_BEST rva=0x%llX failDist=%d protocolDist=%d total=%d\r\n",
                static_cast<unsigned long long>(nodes[static_cast<std::size_t>(bridge)].beginRva),
                candidates.front().failDist, candidates.front().protoDist, candidates.front().total);

            auto emitChain = [&](const char* side, int nodeIndex, const std::vector<int>& prev) {
                std::vector<int> chain;
                int cur = nodeIndex;
                while (cur >= 0)
                {
                    chain.push_back(cur);
                    const int p = prev[static_cast<std::size_t>(cur)];
                    if (p < 0 || p == cur) break;
                    cur = p;
                }
                std::reverse(chain.begin(), chain.end());
                for (std::size_t step = 0; step < chain.size(); ++step)
                {
                    const auto& n = nodes[static_cast<std::size_t>(chain[step])];
                    InternalLog("[DW-GRAPH-V50] BRIDGE_PATH side=%s step=%zu rva=0x%llX score=%d flags=0x%X\r\n",
                        side, step, static_cast<unsigned long long>(n.beginRva), n.score, n.flags);
                    ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                        "[DW-GRAPH-V50] BRIDGE_PATH side=%s step=%zu rva=0x%llX score=%d flags=0x%X\r\n",
                        side, step, static_cast<unsigned long long>(n.beginRva), n.score, n.flags);
                    if (step > 0) emitEdgeDetail(side, step - 1u, chain[step - 1u], chain[step]);
                }
            };
            emitChain("FAILURE", bridge, failPrev);
            emitChain("PROTOCOL", bridge, protoPrev);
        }

        // V47: keep A_RESULT_GATE visible as a separate result-side anchor without
        // pretending it is protocol/LSG evidence. failDist/failPrev were already
        // computed, so this costs no additional graph search.
        const int resultGateIndex = fastFindNode(0x3D61170u);
        if (resultGateIndex >= 0 && failDist[static_cast<std::size_t>(resultGateIndex)] >= 0)
        {
            InternalLog("[DW-GRAPH-V50] RESULT_GATE_TO_FAILURE found=YES resultGate=0x3D61170 hops=%d\r\n",
                failDist[static_cast<std::size_t>(resultGateIndex)]);
            std::vector<int> chain;
            int cur = resultGateIndex;
            while (cur >= 0)
            {
                chain.push_back(cur);
                const int p = failPrev[static_cast<std::size_t>(cur)];
                if (p < 0 || p == cur) break;
                cur = p;
            }
            std::reverse(chain.begin(), chain.end());
            for (std::size_t step = 0; step < chain.size(); ++step)
            {
                const auto& n = nodes[static_cast<std::size_t>(chain[step])];
                InternalLog("[DW-GRAPH-V50] RESULT_GATE_PATH step=%zu rva=0x%llX score=%d flags=0x%X\r\n",
                    step, static_cast<unsigned long long>(n.beginRva), n.score, n.flags);
                if (step > 0) emitEdgeDetail("RESULT_GATE", step - 1u, chain[step - 1u], chain[step]);
            }
        }
        else
        {
            InternalLog("[DW-GRAPH-V50] RESULT_GATE_TO_FAILURE found=no resultGatePresent=%s\r\n",
                resultGateIndex >= 0 ? "YES" : "no");
        }

        // Directed reverse-caller ancestry.  A hit here is stronger than the
        // undirected bridge because the same function/caller is an ancestor of
        // both the failure cluster and the protocol/LSG cluster.
        std::vector<int> failAncDist, failAncPrev, protoAncDist, protoAncPrev;
        bfs(reverseAdj, failSeeds, failAncDist, failAncPrev);
        bfs(reverseAdj, protoSeeds, protoAncDist, protoAncPrev);
        std::vector<BridgeCandidateV45> ancestors;
        for (std::size_t i = 0; i < nodes.size(); ++i)
        {
            if (failAncDist[i] < 0 || protoAncDist[i] < 0) continue;
            ancestors.push_back({static_cast<int>(i), failAncDist[i], protoAncDist[i], failAncDist[i] + protoAncDist[i], nodes[i].score});
        }
        std::sort(ancestors.begin(), ancestors.end(), [](const BridgeCandidateV45& a, const BridgeCandidateV45& b) {
            if (a.total != b.total) return a.total < b.total;
            return a.score > b.score;
        });
        if (ancestors.empty())
        {
            InternalLog("[DW-GRAPH-V50] COMMON_ANCESTOR found=no failureSeeds=%zu protocolSeeds=%zu\r\n",
                failSeeds.size(), protoSeeds.size());
            ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                "[DW-GRAPH-V50] COMMON_ANCESTOR found=no failureSeeds=%zu protocolSeeds=%zu\r\n",
                failSeeds.size(), protoSeeds.size());
        }
        else
        {
            const std::size_t emit = (std::min)(static_cast<std::size_t>(12u), ancestors.size());
            for (std::size_t rank = 0; rank < emit; ++rank)
            {
                const auto& c = ancestors[rank];
                const auto& n = nodes[static_cast<std::size_t>(c.index)];
                InternalLog("[DW-GRAPH-V50] COMMON_ANCESTOR rank=%zu rva=0x%llX failDepth=%d protocolDepth=%d total=%d score=%d flags=0x%X\r\n",
                    rank + 1u, static_cast<unsigned long long>(n.beginRva), c.failDist, c.protoDist, c.total, n.score, n.flags);
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GRAPH-V50] COMMON_ANCESTOR rank=%zu rva=0x%llX failDepth=%d protocolDepth=%d total=%d score=%d flags=0x%X\r\n",
                    rank + 1u, static_cast<unsigned long long>(n.beginRva), c.failDist, c.protoDist, c.total, n.score, n.flags);
            }
            const int best = ancestors.front().index;
            auto emitAnc = [&](const char* side, const std::vector<int>& prev) {
                std::vector<int> chain;
                int cur = best;
                while (cur >= 0)
                {
                    chain.push_back(cur);
                    const int p = prev[static_cast<std::size_t>(cur)];
                    if (p < 0 || p == cur) break;
                    cur = p;
                }
                std::reverse(chain.begin(), chain.end());
                for (std::size_t step = 0; step < chain.size(); ++step)
                    InternalLog("[DW-GRAPH-V50] ANCESTRY_PATH side=%s step=%zu rva=0x%llX\r\n",
                        side, step, static_cast<unsigned long long>(nodes[static_cast<std::size_t>(chain[step])].beginRva));
            };
            emitAnc("FAILURE", failAncPrev);
            emitAnc("PROTOCOL", protoAncPrev);
        }

        InternalLog("[DW-GRAPH-V50] BRIDGE_DONE bridgeCandidates=%zu commonAncestors=%zu failureSeeds=%zu protocolSeeds=%zu stateWrites=off\r\n",
            candidates.size(), ancestors.size(), failSeeds.size(), protoSeeds.size());
    }

    DWORD WINAPI DwSource3RankedGraphExplorerWorkerV41(LPVOID) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        const auto module = GetModuleHandleW(nullptr);
        ImageSectionView text{}, rdata{}, data{};
        if (!base || !size || !module || !GetImageSection(module, ".text", text))
        {
            InternalLog("[DW-GRAPH-V50] ERROR invalid_context stateWrites=off\r\n");
            return 0;
        }
        GetImageSection(module, ".rdata", rdata);
        GetImageSection(module, ".data", data);

        std::vector<DwRankNodeV41> nodes;
        std::vector<DwRankEdgeV41> edges;
        std::vector<DwReverseEdgeV41> reverse;
        nodes.reserve(6500u); edges.reserve(42000u);
        unsigned seedOrigin = 0;
        for (const auto& seed : kDwRankSeedsV41)
        {
            ++seedOrigin;
            const int n = DwRankAddNodeV41(nodes, seed.rva, 0u, seedOrigin, seed.score, seed.flags, text);
            if (n >= 0)
                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                    "[DW-GRAPH-V50] SEED label=%s requestedRva=0x%llX nodeRva=0x%llX score=%d flags=0x%X\r\n",
                    seed.label, static_cast<unsigned long long>(seed.rva),
                    static_cast<unsigned long long>(nodes[static_cast<std::size_t>(n)].beginRva),
                    nodes[static_cast<std::size_t>(n)].score, nodes[static_cast<std::size_t>(n)].flags);
        }

        InternalLog("[DW-GRAPH-V50] BEGIN seeds=%zu maxNodes=6500 maxExpanded=1800 maxDepth=14 timeBudgetMs=16000 reverseIndexBudgetMs=3500 strategy=FOCUSED_GATE_DIRECTED_PROOF stateWrites=off\r\n",
            ArrayCount(kDwRankSeedsV41));
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] BEGIN seeds=%zu maxNodes=6500 maxExpanded=1800 maxDepth=14 timeBudgetMs=16000 reverseIndexBudgetMs=3500 strategy=FOCUSED_GATE_DIRECTED_PROOF stateWrites=off\r\n",
            ArrayCount(kDwRankSeedsV41));

        const ULONGLONG startMs = GetTickCount64();
        DwRankBuildReverseIndexV41(reverse, text, startMs + 3500u);
        ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
            "[DW-GRAPH-V50] REVERSE_INDEX edges=%zu builtOnce=YES\r\n", reverse.size());

        unsigned expanded = 0, hotNodes = 0, protocolNodes = 0, reverseAdds = 0;
        while (nodes.size() < 6500u && expanded < 1800u && GetTickCount64() - startMs < 16000u)
        {
            int best = -1;
            int bestPriority = -1000000;
            for (std::size_t i = 0; i < nodes.size(); ++i)
            {
                const auto& n = nodes[i];
                if (n.expanded || n.depth > 14u) continue;
                const int priority = n.score - static_cast<int>(n.depth) * 4 +
                    ((n.flags & kV41HotEdx1) ? 45 : 0) +
                    ((n.flags & kV41Protocol) ? 35 : 0) +
                    ((n.flags & kV41Anchor) ? 20 : 0);
                if (priority > bestPriority) { bestPriority = priority; best = static_cast<int>(i); }
            }
            if (best < 0) break;
            auto& node = nodes[static_cast<std::size_t>(best)];
            node.expanded = true; ++expanded;
            if (node.endRva <= node.beginRva || node.endRva - node.beginRva > 0x2000u) continue;
            const std::size_t fnSize = static_cast<std::size_t>(node.endRva - node.beginRva);
            std::vector<unsigned char> code(fnSize);
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(base + node.beginRva), code.data(), fnSize)) continue;

            const char* rangeLabel = "other"; DwGraphInKnownRangeV40(node.beginRva, &rangeLabel);
            ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                "[DW-GRAPH-V50] EXPAND index=%d rva=0x%llX end=0x%llX score=%d priority=%d flags=0x%X depth=%u range=%s\r\n",
                best, static_cast<unsigned long long>(node.beginRva), static_cast<unsigned long long>(node.endRva),
                node.score, bestPriority, node.flags, node.depth, rangeLabel ? rangeLabel : "other");

            bool becameHot = (node.flags & kV41HotEdx1) != 0;
            bool becameProtocol = (node.flags & kV41Protocol) != 0;
            for (std::size_t i = 0; i < fnSize; ++i)
            {
                const std::uintptr_t siteRva = node.beginRva + i;
                if (i + 5u <= fnSize && (code[i] == 0xE8u || code[i] == 0xE9u))
                {
                    std::int32_t rel = 0; memcpy(&rel, code.data() + i + 1u, sizeof(rel));
                    const std::uintptr_t targetRva = siteRva + 5u + static_cast<std::intptr_t>(rel);
                    if (DwGraphLooksLikeImageCodeV40(targetRva, text) && DwGraphInKnownRangeV40(targetRva))
                    {
                        int childScore = node.score - (code[i] == 0xE8u ? 7 : 9);
                        unsigned childFlags = 0;
                        if (targetRva == 0x4531C20u || targetRva == 0x5D6ACA0u || targetRva == 0x3D1E300u)
                            childFlags |= kV41Anchor;
                        DwRankAddNodeV41(nodes, targetRva, node.depth + 1u, node.origin, childScore, childFlags, text);
                        edges.push_back({node.beginRva, siteRva, targetRva, code[i] == 0xE8u ? "CALL" : "JMP"});

                        std::uint32_t edx = 0; std::uintptr_t edxSite = 0;
                        if (DwRankNearestEdxImmV41(siteRva, node.beginRva, code.data(), fnSize, edx, edxSite))
                        {
                            if (edx == 1u)
                            {
                                if (!becameHot) { becameHot = true; ++hotNodes; }
                                node.flags |= kV41HotEdx1; node.score += 55;
                                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                                    "[DW-GRAPH-V50] HOT_EDX1 ownerRva=0x%llX callRva=0x%llX edxSiteRva=0x%llX targetRva=0x%llX exactNearest=YES\r\n",
                                    static_cast<unsigned long long>(node.beginRva), static_cast<unsigned long long>(siteRva),
                                    static_cast<unsigned long long>(edxSite), static_cast<unsigned long long>(targetRva));
                                InternalLog("[DW-GRAPH-V50] HOT_EDX1 ownerRva=0x%llX callRva=0x%llX edxSiteRva=0x%llX targetRva=0x%llX exactNearest=YES\r\n",
                                    static_cast<unsigned long long>(node.beginRva), static_cast<unsigned long long>(siteRva),
                                    static_cast<unsigned long long>(edxSite), static_cast<unsigned long long>(targetRva));
                            }
                            else if (edx == 0x21u || edx == 1000u || edx == 2u || edx == 3u)
                            {
                                ServerEmuAppend(L"dw_source3_v50_global_gate_table_proof.log",
                                    "[DW-GRAPH-V50] HOT_ARG ownerRva=0x%llX callRva=0x%llX edx=0x%X targetRva=0x%llX\r\n",
                                    static_cast<unsigned long long>(node.beginRva), static_cast<unsigned long long>(siteRva), edx,
                                    static_cast<unsigned long long>(targetRva));
                            }
                        }
                    }
                }

                if (i + 7u <= fnSize && (code[i] == 0x48u || code[i] == 0x4Cu) &&
