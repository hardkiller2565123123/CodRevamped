        const unsigned setterCalls = g_dwSource3StateSetterCalls144.load(std::memory_order_acquire);
        const bool proof = writerToFetch && fetchToStatus && branchExact &&
            branchTargetRva == 0x3D5E1B0u && falseReturnExact &&
