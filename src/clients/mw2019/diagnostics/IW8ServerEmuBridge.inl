    std::uint32_t BNetWriterSourceValue144(const CONTEXT* context, BYTE modrm) noexcept
    {
        if (!context)
            return 0;
        switch ((modrm >> 3u) & 7u)
        {
        case 0: return static_cast<std::uint32_t>(context->Rax);
        case 1: return static_cast<std::uint32_t>(context->Rcx);
        case 2: return static_cast<std::uint32_t>(context->Rdx);
        case 3: return static_cast<std::uint32_t>(context->Rbx);
        case 4: return static_cast<std::uint32_t>(context->Rsp);
        case 5: return static_cast<std::uint32_t>(context->Rbp);
        case 6: return static_cast<std::uint32_t>(context->Rsi);
        case 7: return static_cast<std::uint32_t>(context->Rdi);
        default: return 0;
        }
    }

    bool SetBNetFirstStateDataWatchGuard144(bool enable) noexcept
    {
        if (!g_bnetFirstStateDataWatchPage144 || !g_bnetFirstStateDataWatchPageSize144 ||
            !g_bnetFirstStateDataWatchBaseProtect144)
            return false;

        DWORD oldProtect = 0;
        DWORD protect = g_bnetFirstStateDataWatchBaseProtect144 & ~PAGE_GUARD;
        if (enable)
            protect |= PAGE_GUARD;
        return VirtualProtect(reinterpret_cast<void*>(g_bnetFirstStateDataWatchPage144),
            g_bnetFirstStateDataWatchPageSize144, protect, &oldProtect) != FALSE;
    }

    LONG CALLBACK BNetFirstStateDataWatchVeh144(EXCEPTION_POINTERS* info) noexcept
    {
        if (!info || !info->ExceptionRecord || !info->ContextRecord ||
            !g_bnetFirstStateDataWatchArmed144.load(std::memory_order_acquire))
            return EXCEPTION_CONTINUE_SEARCH;

        constexpr DWORD kGuardPageViolation144 = 0x80000001u;
        const DWORD code = info->ExceptionRecord->ExceptionCode;
        CONTEXT* context = info->ContextRecord;

        if (code == kGuardPageViolation144)
        {
            const ULONG_PTR accessType = info->ExceptionRecord->NumberParameters >= 1u
                ? info->ExceptionRecord->ExceptionInformation[0] : static_cast<ULONG_PTR>(~0ull);
            const std::uintptr_t accessAddress = info->ExceptionRecord->NumberParameters >= 2u
                ? static_cast<std::uintptr_t>(info->ExceptionRecord->ExceptionInformation[1]) : 0ull;
            const std::uintptr_t pageEnd = g_bnetFirstStateDataWatchPage144 + g_bnetFirstStateDataWatchPageSize144;
            if (accessAddress < g_bnetFirstStateDataWatchPage144 || accessAddress >= pageEnd)
                return EXCEPTION_CONTINUE_SEARCH;

            std::uint32_t before = 0;
            ServerEmuSafeReadU32(reinterpret_cast<const void*>(g_bnetFirstStateDataWatchAddress144), before);
            g_bnetFirstStateDataWatchPendingStep144 = true;
            g_bnetFirstStateDataWatchPendingWrite144 = accessType == 1u;
            g_bnetFirstStateDataWatchPendingRip144 = static_cast<std::uintptr_t>(context->Rip);
            g_bnetFirstStateDataWatchPendingAccess144 = accessAddress;
            g_bnetFirstStateDataWatchPendingBefore144 = before;

            // PAGE_GUARD is cleared by Windows for this access. Single-step the
            // untouched stock instruction, inspect the resulting state, then
            // re-arm the page only if state is still 1.
            context->EFlags |= 0x100u;
            return EXCEPTION_CONTINUE_EXECUTION;
        }

        if (code == EXCEPTION_SINGLE_STEP && g_bnetFirstStateDataWatchPendingStep144)
        {
            const bool wasWrite = g_bnetFirstStateDataWatchPendingWrite144;
            const auto writerRip = g_bnetFirstStateDataWatchPendingRip144;
            const auto accessAddress = g_bnetFirstStateDataWatchPendingAccess144;
            const std::uint32_t before = g_bnetFirstStateDataWatchPendingBefore144;
            g_bnetFirstStateDataWatchPendingStep144 = false;
            g_bnetFirstStateDataWatchPendingWrite144 = false;

            std::uint32_t after = 0;
            const bool afterOk = ServerEmuSafeReadU32(
                reinterpret_cast<const void*>(g_bnetFirstStateDataWatchAddress144), after);
            const unsigned fault = ++g_bnetFirstStateDataWatchFaults144;
            HMODULE game = GetModuleHandleW(nullptr);
            const auto base = reinterpret_cast<std::uintptr_t>(game);
            const auto writerRva = base && writerRip >= base ? writerRip - base : writerRip;

            if (wasWrite)
            {
                BYTE codeBytes[24]{};
                bool codeReadable = false;
                __try
                {
                    memcpy(codeBytes, reinterpret_cast<const void*>(writerRip), sizeof(codeBytes));
                    codeReadable = true;
                }
                __except (EXCEPTION_EXECUTE_HANDLER)
                {
                    codeReadable = false;
                }

                char hex[24 * 3 + 1]{};
                if (codeReadable)
                {
                    std::size_t pos = 0;
                    for (unsigned i = 0; i < sizeof(codeBytes) && pos + 4u < sizeof(hex); ++i)
                        pos += static_cast<std::size_t>(_snprintf_s(hex + pos, sizeof(hex) - pos, _TRUNCATE,
                            "%02X%s", static_cast<unsigned>(codeBytes[i]), i + 1u == sizeof(codeBytes) ? "" : " "));
                }
                else
                {
                    strcpy_s(hex, "<unreadable>");
                }

                InternalLog("[AUTH-GATE-DATAWATCH144] WRITE fault=%u writerRva=0x%llX rip=%p access=%p stateAddress=%p before=%u after=%s%u nextRip=0x%llX code=%s regs={rax=%llX rcx=%llX rdx=%llX rbx=%llX rsi=%llX rdi=%llX rsp=%llX rbp=%llX}; stock write unchanged\r\n",
                    fault, static_cast<unsigned long long>(writerRva), reinterpret_cast<void*>(writerRip),
                    reinterpret_cast<void*>(accessAddress), reinterpret_cast<void*>(g_bnetFirstStateDataWatchAddress144),
                    before, afterOk ? "" : "UNREADABLE/", afterOk ? after : 0u,
                    static_cast<unsigned long long>(context->Rip), hex,
                    static_cast<unsigned long long>(context->Rax), static_cast<unsigned long long>(context->Rcx),
                    static_cast<unsigned long long>(context->Rdx), static_cast<unsigned long long>(context->Rbx),
                    static_cast<unsigned long long>(context->Rsi), static_cast<unsigned long long>(context->Rdi),
                    static_cast<unsigned long long>(context->Rsp), static_cast<unsigned long long>(context->Rbp));
                ServerEmuAppend(L"auth_gate_datawatch.log",
                    "[AUTH-GATE-DATAWATCH144] WRITE fault=%u writerRva=0x%llX rip=%p access=%p stateAddress=%p before=%u after=%s%u nextRip=0x%llX code=%s mode=ORIGINAL_WRITE_UNCHANGED\r\n",
                    fault, static_cast<unsigned long long>(writerRva), reinterpret_cast<void*>(writerRip),
                    reinterpret_cast<void*>(accessAddress), reinterpret_cast<void*>(g_bnetFirstStateDataWatchAddress144),
                    before, afterOk ? "" : "UNREADABLE/", afterOk ? after : 0u,
                    static_cast<unsigned long long>(context->Rip), hex);

                if (afterOk && before == 1u && after != 1u)
                {
                    g_bnetFirstStateDataWatchArmed144.store(false, std::memory_order_release);
                    InternalLog("[AUTH-GATE-DATAWATCH144] TARGET CAPTURED writerRva=0x%llX transition=1->%u access=%p; data watch disarmed\r\n",
                        static_cast<unsigned long long>(writerRva), after, reinterpret_cast<void*>(accessAddress));
                    ServerEmuAppend(L"auth_gate_datawatch.log",
                        "[AUTH-GATE-DATAWATCH144] TARGET_CAPTURED writerRva=0x%llX transition=1->%u access=%p\r\n",
                        static_cast<unsigned long long>(writerRva), after, reinterpret_cast<void*>(accessAddress));
                    return EXCEPTION_CONTINUE_EXECUTION;
                }
            }

            const ULONGLONG elapsed = GetTickCount64() - g_bnetFirstStateDataWatchArmTick144;
            if (!afterOk || after != 1u || elapsed >= 5000ull)
            {
                g_bnetFirstStateDataWatchArmed144.store(false, std::memory_order_release);
                if (afterOk && after != 1u && !wasWrite)
                {
                    InternalLog("[AUTH-GATE-DATAWATCH144] transition observed during non-write single-step before=%u after=%u priorRip=%p; writer may have raced on another thread; watch disarmed\r\n",
                        before, after, reinterpret_cast<void*>(writerRip));
                    ServerEmuAppend(L"auth_gate_datawatch.log",
                        "[AUTH-GATE-DATAWATCH144] RACE_TRANSITION before=%u after=%u priorRip=%p access=%p\r\n",
                        before, after, reinterpret_cast<void*>(writerRip), reinterpret_cast<void*>(accessAddress));
                }
                else if (elapsed >= 5000ull)
                {
                    InternalLog("[AUTH-GATE-DATAWATCH144] timeout elapsedMs=%llu state=%s%u; watch disarmed\r\n",
                        static_cast<unsigned long long>(elapsed), afterOk ? "" : "UNREADABLE/", afterOk ? after : 0u);
                }
                return EXCEPTION_CONTINUE_EXECUTION;
            }

            if (!SetBNetFirstStateDataWatchGuard144(true))
            {
                g_bnetFirstStateDataWatchArmed144.store(false, std::memory_order_release);
                InternalLog("[AUTH-GATE-DATAWATCH144] rearm failed after fault=%u; watch disabled\r\n", fault);
            }
            return EXCEPTION_CONTINUE_EXECUTION;
        }

        return EXCEPTION_CONTINUE_SEARCH;
    }

