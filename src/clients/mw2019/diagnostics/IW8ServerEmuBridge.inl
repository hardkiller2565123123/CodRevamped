                reinterpret_cast<void**>(&g_dwIngressMaskTestOriginal144), "mask_test"},
            {kDwIngressCode40Rva144, reinterpret_cast<void*>(&DwIngressCode40Observer144),
                reinterpret_cast<void**>(&g_dwIngressCode40Original144), "code40"},
            {kDwIngressMask80Rva144, reinterpret_cast<void*>(&DwIngressMask80Observer144),
                reinterpret_cast<void**>(&g_dwIngressMask80Original144), "mask80_pre"},
            {kDwIngressStateMapRva144, reinterpret_cast<void*>(&DwIngressStateMapObserver144),
                reinterpret_cast<void**>(&g_dwIngressStateMapOriginal144), "state_map"},
            {kDwIngressOutCodeRva144, reinterpret_cast<void*>(&DwIngressOutCodeObserver144),
                reinterpret_cast<void**>(&g_dwIngressOutCodeOriginal144), "out_code"},
            {kDwIngressGateByteRva144, reinterpret_cast<void*>(&DwIngressGateByteObserver144),
                reinterpret_cast<void**>(&g_dwIngressGateByteOriginal144), "gate_byte"},
