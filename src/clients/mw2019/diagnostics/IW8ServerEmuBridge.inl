                cmpKind = "EAX_IMM32";
            }
            else if (b[0] == 0x83u && b[1] == 0x79u)
            {
                fieldOffset = static_cast<int>(static_cast<std::int8_t>(b[2]));
                imm = b[3];
                cmpKind = "RCX_FIELD_IMM8";
            }
            else if (b[0] == 0x83u && b[1] == 0xB9u)
            {
                std::int32_t disp = 0;
                memcpy(&disp, b + 2, sizeof(disp));
                fieldOffset = static_cast<int>(disp);
                imm = b[6];
                cmpKind = "RCX_FIELD32_IMM8";
            }
            if (cmpKind && imm <= 0x40u && statusCompares < 64u)
            {
                ++statusCompares;
                ServerEmuAppend(L"dw_native_login_v50.log",
                    "[DW-NATIVE-PATH-V50] STATUS_CMP index=%u label=%s rva=0x%llX kind=%s fieldOffset=%s0x%X imm=%u%s delta=%lld\r\n",
                    statusCompares, anchorLabel ? anchorLabel : "?",
                    static_cast<unsigned long long>(cursor - base), cmpKind,
                    fieldOffset >= 0 ? "+" : "n/a-", fieldOffset >= 0 ? static_cast<unsigned>(fieldOffset) : 0u,
                    imm, imm == 1u ? "(FETCHING_FIRST_PARTY_TOKEN?)" : (imm == 2u ? "(FIRST_PARTY_AUTHED?)" : (imm == 27u ? "(COMPLETED?)" : "")),
                    static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
            }

            if (b[0] == 0x48u && (b[1] == 0x8Du || b[1] == 0x8Bu) && b[2] == 0x0Du && rcxLoads < 32u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 3, sizeof(rel));
                const std::uintptr_t target = cursor + 7u + static_cast<std::intptr_t>(rel);
                ++rcxLoads;
                ServerEmuAppend(L"dw_native_login_v50.log",
                    "[DW-NATIVE-PATH-V50] RCX_SOURCE index=%u label=%s rva=0x%llX op=%s targetRva=0x%llX delta=%lld\r\n",
                    rcxLoads, anchorLabel ? anchorLabel : "?",
                    static_cast<unsigned long long>(cursor - base), b[1] == 0x8Du ? "LEA" : "MOV",
                    static_cast<unsigned long long>(target >= base ? target - base : 0),
                    static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
            }
        }

        TraceDwNativeDecisionV50(anchorLabel, xref, begin, end);

        InternalLog("[DW-NATIVE-PATH-V50] SUMMARY label=%s calls=%u branches=%u statusCompares=%u rcxSources=%u output=dw_native_login_v50.log no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel ? anchorLabel : "?", calls, branches, statusCompares, rcxLoads);
        ServerEmuAppend(L"dw_native_login_v50.log",
            "[DW-NATIVE-PATH-V50] SUMMARY label=%s calls=%u branches=%u statusCompares=%u rcxSources=%u no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel ? anchorLabel : "?", calls, branches, statusCompares, rcxLoads);
    }

    void AnalyzeDwFirstPartyStatusAnchorV48(const char* anchorLabel, std::uintptr_t xref) noexcept
    {
