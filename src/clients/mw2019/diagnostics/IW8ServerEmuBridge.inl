            static_cast<unsigned long long>((cellAOk && writerCellA >= base && writerCellA < base + size) ? writerCellA - base : 0u),
            cellAMatch ? "YES" : "no",
            (cellBOk && writerCellB >= base && writerCellB < base + size) ? "" : "n/a-",
            static_cast<unsigned long long>((cellBOk && writerCellB >= base && writerCellB < base + size) ? writerCellB - base : 0u),
            cellBMatch ? "YES" : "no");

