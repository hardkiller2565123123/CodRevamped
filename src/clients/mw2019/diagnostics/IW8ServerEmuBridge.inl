        unsigned char a1Store[4]{};
        const bool a1StoreExact = readBytes(0x2B59C6Eu, a1Store, sizeof(a1Store)) &&
            a1Store[0] == 0xC6u && a1Store[1] == 0x43u && a1Store[2] == 0x0Eu && a1Store[3] == 0x01u;

        // A_RESULT_FETCH return: TEST AL,AL; JZ 0x2B59CA8, otherwise E=1 at C97.
        bool fetchJzExact = false;
        std::uintptr_t fetchJzTarget = 0;
        for (unsigned i = 0; fetchPathReadable && i + 2u <= sizeof(fetchPath); ++i)
        {
            if (fetchPath[i] == 0x74u)
            {
                fetchJzTarget = static_cast<std::uintptr_t>(
                    static_cast<std::intptr_t>(0x2B59C91u + i + 2u) +
                    static_cast<std::int8_t>(fetchPath[i + 1u]));
                if (fetchJzTarget == 0x2B59CA8u)
                {
                    fetchJzExact = true;
                    break;
                }
            }
        }
        unsigned char a2Store[4]{};
        const bool a2StoreExact = readBytes(0x2B59C97u, a2Store, sizeof(a2Store)) &&
            a2Store[0] == 0xC6u && a2Store[1] == 0x43u && a2Store[2] == 0x0Eu && a2Store[3] == 0x01u;

        // A_RESULT_FETCH: CALL dwGetLogOnStatus at 0x3D5E151, TEST EAX,EAX;
        // JNZ 0x3D5E1B0, whose epilogue zeroes EAX.  Therefore status=1 means
        // the helper returns false to Writer A.
        const bool fetchToStatus = VerifyDwIngressDirectCall144(0x3D5E151u, kDwGetLogOnStatusRva144);
