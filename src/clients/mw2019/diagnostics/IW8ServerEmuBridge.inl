    // Autonomous research bridge helpers. These operations are intentionally
    // read-only: they inspect code/data relationships and reuse the existing
    // passive research passes without changing client authentication, fence,
    // LUI, content, or frontend truth.
    void AgentResearchInspectRva144(std::uintptr_t rva) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !rva || rva >= size)
        {
            ServerEmuAppend(L"ai_research.log",
                "[AI-INSPECT144] invalid rva=0x%llX imageSize=0x%llX read_only=yes\r\n",
                static_cast<unsigned long long>(rva), static_cast<unsigned long long>(size));
            return;
        }

        const std::uintptr_t address = base + rva;
        std::uintptr_t begin = 0, end = 0;
        const bool bounded = RuntimeFunctionBounds144(address, begin, end);
        if (!bounded)
        {
            begin = address > base + 0x80u ? address - 0x80u : base;
            end = (std::min)(base + size, address + static_cast<std::uintptr_t>(0x380u));
        }
        const std::uintptr_t scanEnd = (std::min)(end, begin + static_cast<std::uintptr_t>(0x3000u));

        ServerEmuAppend(L"ai_research.log",
            "\r\n[AI-INSPECT144] BEGIN rva=0x%llX bounded=%s functionBeginRva=0x%llX functionEndRva=0x%llX scanBytes=0x%llX mode=STATIC_READ_ONLY stateWrites=off\r\n",
            static_cast<unsigned long long>(rva), bounded ? "yes" : "no",
            static_cast<unsigned long long>(begin - base), static_cast<unsigned long long>(end - base),
            static_cast<unsigned long long>(scanEnd > begin ? scanEnd - begin : 0u));
        AppendCodeBytes144(L"ai_research.log", "[AI-INSPECT144-CODE]", address, 0x80u, 0x180u);

        unsigned directCalls = 0, branches = 0, ripRefs = 0, printableRefs = 0;
        __try
        {
            for (std::uintptr_t cursor = begin; cursor + 7u <= scanEnd; ++cursor)
            {
                const auto* b = reinterpret_cast<const unsigned char*>(cursor);
                if ((b[0] == 0xE8u || b[0] == 0xE9u) && directCalls < 128u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, b + 1u, sizeof(rel));
                    const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                    if (target >= base && target < base + size)
                    {
                        ++directCalls;
                        ServerEmuAppend(L"ai_research.log",
                            "[AI-INSPECT144-EDGE] kind=%s sourceRva=0x%llX targetRva=0x%llX\r\n",
                            b[0] == 0xE8u ? "CALL_REL32" : "JMP_REL32",
                            static_cast<unsigned long long>(cursor - base),
                            static_cast<unsigned long long>(target - base));
                    }
                }
                else if (b[0] == 0x0Fu && (b[1] & 0xF0u) == 0x80u && branches < 96u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, b + 2u, sizeof(rel));
                    const std::uintptr_t target = cursor + 6u + static_cast<std::intptr_t>(rel);
                    if (target >= base && target < base + size)
                    {
                        ++branches;
                        ServerEmuAppend(L"ai_research.log",
                            "[AI-INSPECT144-EDGE] kind=JCC_REL32 opcode=%02X sourceRva=0x%llX targetRva=0x%llX\r\n",
                            b[1], static_cast<unsigned long long>(cursor - base),
                            static_cast<unsigned long long>(target - base));
                    }
                }

                SimpleRipRef144 decoded{};
                if (ripRefs < 160u && DecodeSimpleRipRef144(b, static_cast<std::size_t>(scanEnd - cursor), decoded))
                {
                    std::int32_t displacement = 0;
                    memcpy(&displacement, b + decoded.displacementOffset, sizeof(displacement));
                    const std::uintptr_t target = cursor + decoded.instructionLength + static_cast<std::intptr_t>(displacement);
                    if (target >= base && target < base + size)
                    {
                        ++ripRefs;
                        char printable[192]{};
                        const char* encoding = "?";
                        const bool textRef = printableRefs < 32u && TryReadDwTlsPrintable144(target, printable, ArrayCount(printable), encoding);
                        if (textRef) ++printableRefs;
                        ServerEmuAppend(L"ai_research.log",
                            "[AI-INSPECT144-RIP] sourceRva=0x%llX targetRva=0x%llX op=%s access=%s text=%s'%s' encoding=%s\r\n",
                            static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                            decoded.op ? decoded.op : "?", decoded.access ? decoded.access : "?",
                            textRef ? "" : "n/a-", textRef ? printable : "", textRef ? encoding : "?");
                    }
                }
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            ServerEmuAppend(L"ai_research.log", "[AI-INSPECT144] scan_exception rva=0x%llX\r\n",
                static_cast<unsigned long long>(rva));
        }

        ServerEmuAppend(L"ai_research.log",
            "[AI-INSPECT144] COMPLETE rva=0x%llX calls=%u branches=%u ripRefs=%u printableRefs=%u read_only=yes stateWrites=off\r\n",
            static_cast<unsigned long long>(rva), directCalls, branches, ripRefs, printableRefs);
    }

