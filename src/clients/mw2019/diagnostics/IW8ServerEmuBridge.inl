                            incomingOwnerEdges, bytes[i] == 0xE8u ? "CALL" : "JMP",
                            static_cast<unsigned long long>(sourceVa - base),
                            static_cast<unsigned long long>(owners[oi].begin - base),
                            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerBegin - base : 0u),
                            bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? callerEnd - base : 0u),
