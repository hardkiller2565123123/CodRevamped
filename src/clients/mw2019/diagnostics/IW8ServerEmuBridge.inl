        // rel32/rel8 jump stub. Follow a couple of those before classifying the
        // actual leaf getter. This does not execute game code.
        std::uintptr_t decoded = target;
        for (unsigned depth = 0; depth < 3u; ++depth)
        {
            unsigned char j[8]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(decoded), j, sizeof(j)))
                return false;
            std::uintptr_t next = 0;
            if (j[0] == 0xE9u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, j + 1, sizeof(rel));
                next = decoded + 5u + static_cast<std::intptr_t>(rel);
            }
            else if (j[0] == 0xEBu)
            {
                next = decoded + 2u + static_cast<std::int8_t>(j[1]);
            }
            else
            {
                break;
            }
            if (next < base || next >= base + size || next == decoded)
                break;
            decoded = next;
        }

        unsigned char b[32]{};
        if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(decoded), b, sizeof(b)))
            return false;

        // Skip harmless alignment/hotpatch bytes before tiny leaf accessors.
        unsigned start = 0;
        while (start < 8u && (b[start] == 0x90u || b[start] == 0xCCu))
            ++start;

        auto hasRetSoon = [&](unsigned after) noexcept -> bool
        {
            for (unsigned i = after; i < (std::min)(after + 8u, 32u); ++i)
            {
                if (b[i] == 0xC3u)
                    return true;
                if (b[i] == 0xE8u || b[i] == 0xE9u)
                    return false;
            }
            return false;
        };

        // Common leaf accessors emitted for: return ptr->m_loginStatusCode;
        if (start + 2u < 32u && b[start] == 0x8Bu && b[start + 1] == 0x01u && hasRetSoon(start + 2u))
            fieldOffset = 0;
        else if (start + 3u < 32u && b[start] == 0x8Bu && b[start + 1] == 0x41u && hasRetSoon(start + 3u))
            fieldOffset = static_cast<int>(static_cast<std::int8_t>(b[start + 2]));
        else if (start + 6u < 32u && b[start] == 0x8Bu && b[start + 1] == 0x81u && hasRetSoon(start + 6u))
        {
            std::int32_t disp = 0;
            memcpy(&disp, b + start + 2, sizeof(disp));
            fieldOffset = static_cast<int>(disp);
        }
        else if (start + 3u < 32u && b[start] == 0x48u && b[start + 1] == 0x63u && b[start + 2] == 0x01u && hasRetSoon(start + 3u))
            fieldOffset = 0;
        else if (start + 4u < 32u && b[start] == 0x48u && b[start + 1] == 0x63u && b[start + 2] == 0x41u && hasRetSoon(start + 4u))
            fieldOffset = static_cast<int>(static_cast<std::int8_t>(b[start + 3]));
        else if (start + 7u < 32u && b[start] == 0x48u && b[start + 1] == 0x63u && b[start + 2] == 0x81u && hasRetSoon(start + 7u))
        {
            std::int32_t disp = 0;
            memcpy(&disp, b + start + 3, sizeof(disp));
            fieldOffset = static_cast<int>(disp);
        }

        if (fieldOffset < 0 || fieldOffset >= 0x4000)
            return false;
        if (resolvedTarget)
            *resolvedTarget = decoded;
        return true;
    }

    bool FindDwStatusCallerRcxSourceV47(std::uintptr_t callRvaAddress,
        std::uintptr_t& directObject, std::uintptr_t& pointerSlot) noexcept
    {
        directObject = 0;
        pointerSlot = 0;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || callRvaAddress < base + 40u)
            return false;

        const std::uintptr_t begin = callRvaAddress - 40u;
        for (std::uintptr_t cursor = begin; cursor + 7u <= callRvaAddress; ++cursor)
        {
            unsigned char b[7]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;
            if (b[0] != 0x48 || (b[1] != 0x8D && b[1] != 0x8B) || b[2] != 0x0D)
                continue;
            std::int32_t rel = 0;
            memcpy(&rel, b + 3, sizeof(rel));
            const std::uintptr_t target = cursor + 7u + static_cast<std::intptr_t>(rel);
            if (!target)
                continue;
            // Prefer the closest RCX setup before the call.
            if (b[1] == 0x8D)
            {
                directObject = target;
                pointerSlot = 0;
            }
            else
            {
                pointerSlot = target;
                directObject = 0;
            }
        }
        return directObject != 0 || pointerSlot != 0;
    }

    std::uintptr_t ResolveDwFirstPartyStatusObjectV47() noexcept
    {
        const std::uintptr_t direct = g_dwFirstPartyStatusObjectV47.load(std::memory_order_acquire);
        if (direct)
            return direct;
        const std::uintptr_t slot = g_dwFirstPartyStatusPointerSlotV47.load(std::memory_order_acquire);
        if (!slot)
            return 0;
        std::uintptr_t object = 0;
        if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(slot), object))
            return 0;
        return object;
    }

    DWORD WINAPI DwFirstPartyStatusWorkerV47(LPVOID) noexcept
    {
        int lastStatus = -1;
        unsigned changes = 0;
        for (unsigned iteration = 0; iteration < 7500u; ++iteration)
        {
            const int fieldOffset = g_dwFirstPartyStatusFieldOffsetV47.load(std::memory_order_acquire);
            const std::uintptr_t object = ResolveDwFirstPartyStatusObjectV47();
            if (fieldOffset >= 0 && object)
            {
                const std::uintptr_t field = object + static_cast<std::uintptr_t>(fieldOffset);
                std::uint32_t status = 0;
                if (ServerEmuSafeReadU32(reinterpret_cast<const void*>(field), status) && status <= 0x40u)
                {
                    if (static_cast<int>(status) != lastStatus && changes < 64u)
                    {
                        ++changes;
                        lastStatus = static_cast<int>(status);
                        InternalLog("[DW-NATIVE-LOGIN-V50] STATE change=%u object=%p fieldOffset=+0x%X status=%u source=%s mode=READ_ONLY no_state_writes=yes\r\n",
                            changes, reinterpret_cast<void*>(object), static_cast<unsigned>(fieldOffset), status,
                            g_dwFirstPartyStatusObjectV47.load() ? "direct_global" : "pointer_slot");
                        ServerEmuAppend(L"dw_native_login_v50.log",
                            "[DW-NATIVE-LOGIN-V50] STATE change=%u object=%p fieldOffset=+0x%X status=%u source=%s mode=READ_ONLY\r\n",
                            changes, reinterpret_cast<void*>(object), static_cast<unsigned>(fieldOffset), status,
                            g_dwFirstPartyStatusObjectV47.load() ? "direct_global" : "pointer_slot");
                    }
                    if (status == 27u)
                    {
                        InternalLog("[DW-NATIVE-LOGIN-V50] stock bdLogin status reached 27(COMPLETED); observer stops with no override\r\n");
                        return 0;
                    }
                }
            }
            Sleep(10);
        }
        InternalLog("[DW-NATIVE-LOGIN-V50] monitor finished changes=%u object=%p slot=%p fieldOffset=%d mode=READ_ONLY\r\n",
            changes, reinterpret_cast<void*>(g_dwFirstPartyStatusObjectV47.load()),
            reinterpret_cast<void*>(g_dwFirstPartyStatusPointerSlotV47.load()),
            g_dwFirstPartyStatusFieldOffsetV47.load());
        return 0;
    }

    void QueueDwFirstPartyStatusWorkerV47() noexcept
    {
        if (g_dwFirstPartyStatusWorkerQueuedV47.exchange(true))
            return;
        HANDLE thread = CreateThread(nullptr, 0, &DwFirstPartyStatusWorkerV47, nullptr, 0, nullptr);
        if (thread)
            CloseHandle(thread);
        else
            g_dwFirstPartyStatusWorkerQueuedV47.store(false, std::memory_order_release);
    }

    const char* DwNativeRegNameV50(unsigned reg) noexcept
    {
        static const char* names[] = {
            "RAX", "RCX", "RDX", "RBX", "RSP", "RBP", "RSI", "RDI",
            "R8", "R9", "R10", "R11", "R12", "R13", "R14", "R15"
        };
        return reg < ArrayCount(names) ? names[reg] : "?";
    }

    void TraceDwNativeDecisionV50(const char* anchorLabel, std::uintptr_t xref,
        std::uintptr_t begin, std::uintptr_t end) noexcept
    {
        if (!anchorLabel)
            return;
        const bool authDelay = strcmp(anchorLabel, "DW_AUTH_DELAY") == 0;
        const bool firstPartyReady = strcmp(anchorLabel, "DW_FIRST_PARTY_READY") == 0;
        const bool startLegacy = strcmp(anchorLabel, "DW_LOGIN_FLOW_START_LEGACY") == 0;
        const bool connectingLsg = strcmp(anchorLabel, "DW_LOGIN_FLOW_CONNECTING_LSG") == 0;
        const bool connectedLsg = strcmp(anchorLabel, "DW_LOGIN_FLOW_CONNECTED_LSG") == 0;
        const bool extendedAuth = strcmp(anchorLabel, "DW_LOGIN_FLOW_EXTENDED_AUTH") == 0;
        const bool loginComplete = strcmp(anchorLabel, "DW_LOGIN_FLOW_LOGIN_COMPLETE") == 0;
        if (!authDelay && !firstPartyReady && !startLegacy && !connectingLsg && !connectedLsg && !extendedAuth && !loginComplete)
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || xref < base || xref >= base + size || end <= begin)
            return;

        const std::uintptr_t focusBegin = (std::max)(begin, xref > base + 0xA0u ? xref - 0xA0u : base);
        const std::uintptr_t focusEnd = (std::min)(end, xref + static_cast<std::uintptr_t>(0xA0u));
        InternalLog("[DW-NATIVE-DECISION-V50] BEGIN label=%s anchorRva=0x%llX focus=0x%llX..0x%llX goal=trace_native_branch_and_object_source mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel, static_cast<unsigned long long>(xref - base),
            static_cast<unsigned long long>(focusBegin - base), static_cast<unsigned long long>(focusEnd - base));
        ServerEmuAppend(L"dw_native_login_v50.log",
            "\r\n[DW-NATIVE-DECISION-V50] BEGIN label=%s anchorRva=0x%llX focus=0x%llX..0x%llX mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel, static_cast<unsigned long long>(xref - base),
            static_cast<unsigned long long>(focusBegin - base), static_cast<unsigned long long>(focusEnd - base));

        // Put the exact bytes around the decision in the normal log too. V49
        // only wrote them to the side log, which made the main test log
        // insufficient to decode the native branch on its own.
        for (std::uintptr_t line = focusBegin; line < focusEnd; line += 0x20u)
        {
            const std::size_t count = static_cast<std::size_t>((std::min)(focusEnd - line, static_cast<std::uintptr_t>(0x20u)));
            unsigned char bytes[0x20]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(line), bytes, count))
                continue;
            char hex[0x20u * 3u + 8u]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < count && used + 4u < ArrayCount(hex); ++i)
            {
                const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                    "%02X%s", bytes[i], (i + 1u) == count ? "" : " ");
                if (wrote > 0)
                    used += static_cast<std::size_t>(wrote);
            }
            InternalLog("[DW-NATIVE-DECISION-V50] CODE label=%s rva=0x%llX bytes={%s}\r\n",
                anchorLabel, static_cast<unsigned long long>(line - base), hex);
            ServerEmuAppend(L"dw_native_login_v50.log",
                "[DW-NATIVE-DECISION-V50] CODE label=%s rva=0x%llX bytes={%s}\r\n",
                anchorLabel, static_cast<unsigned long long>(line - base), hex);
        }

        unsigned calls = 0;
        unsigned ripRefs = 0;
        unsigned cmpCandidates = 0;
        for (std::uintptr_t cursor = begin; cursor + 10u <= end; ++cursor)
        {
            unsigned char b[16]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && calls < 16u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size)
                {
                    ++calls;
                    std::uintptr_t cb = 0, ce = 0;
                    const bool bounded = RuntimeFunctionBounds144(target, cb, ce);
                    InternalLog("[DW-NATIVE-DECISION-V50] CALL index=%u label=%s callRva=0x%llX targetRva=0x%llX calleeRva=%s0x%llX calleeEndRva=%s0x%llX delta=%lld\r\n",
                        calls, anchorLabel, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base), bounded ? "" : "n/a-",
                        static_cast<unsigned long long>(bounded ? cb - base : 0), bounded ? "" : "n/a-",
                        static_cast<unsigned long long>(bounded ? ce - base : 0),
                        static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
                    ServerEmuAppend(L"dw_native_login_v50.log",
                        "[DW-NATIVE-DECISION-V50] CALL index=%u label=%s callRva=0x%llX targetRva=0x%llX calleeRva=%s0x%llX calleeEndRva=%s0x%llX delta=%lld\r\n",
                        calls, anchorLabel, static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base), bounded ? "" : "n/a-",
                        static_cast<unsigned long long>(bounded ? cb - base : 0), bounded ? "" : "n/a-",
                        static_cast<unsigned long long>(bounded ? ce - base : 0),
                        static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
                    if (authDelay && calls <= 4u)
                    {
                        unsigned char callee[0x40]{};
                        if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(target), callee, sizeof(callee)))
                        {
                            for (unsigned off = 0; off < sizeof(callee); off += 0x20u)
                            {
                                char hex[0x20u * 3u + 8u]{};
                                std::size_t used = 0;
                                for (unsigned i = 0; i < 0x20u && used + 4u < ArrayCount(hex); ++i)
                                {
                                    const int wrote = _snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE,
                                        "%02X%s", callee[off + i], i == 0x1Fu ? "" : " ");
                                    if (wrote > 0) used += static_cast<std::size_t>(wrote);
                                }
                                InternalLog("[DW-NATIVE-DECISION-V50] CALLEE_CODE call=%u rva=0x%llX bytes={%s}\r\n",
                                    calls, static_cast<unsigned long long>(target - base + off), hex);
                            }
                        }
                    }
                }
            }

            // RIP-relative MOV/LEA to any destination register, not just RCX.
            unsigned prefix = 0;
            unsigned opcodeIndex = 0;
            unsigned rex = 0;
            if (b[0] >= 0x40u && b[0] <= 0x4Fu)
            {
                rex = b[0];
                prefix = 1u;
                opcodeIndex = 1u;
            }
            if ((b[opcodeIndex] == 0x8Bu || b[opcodeIndex] == 0x8Du) &&
                ((b[opcodeIndex + 1u] & 0xC7u) == 0x05u) && ripRefs < 40u)
            {
                std::int32_t disp = 0;
                memcpy(&disp, b + opcodeIndex + 2u, sizeof(disp));
                const unsigned insnLen = prefix + 6u;
                const std::uintptr_t target = cursor + insnLen + static_cast<std::intptr_t>(disp);
                if (target >= base && target < base + size)
                {
                    const unsigned dst = ((b[opcodeIndex + 1u] >> 3u) & 7u) + ((rex & 0x04u) ? 8u : 0u);
                    ++ripRefs;
                    InternalLog("[DW-NATIVE-DECISION-V50] RIP_REF index=%u label=%s rva=0x%llX op=%s dst=%s targetRva=0x%llX delta=%lld\r\n",
                        ripRefs, anchorLabel, static_cast<unsigned long long>(cursor - base),
                        b[opcodeIndex] == 0x8Du ? "LEA" : "MOV", DwNativeRegNameV50(dst),
                        static_cast<unsigned long long>(target - base),
                        static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
                }
            }

            // Generic CMP r/m32, imm8/imm32 (/7) for states 1, 2, and 27.
            // V49 only recognized EAX and [RCX+disp], which can miss an inlined
            // bdLoginStatus field held through RSI/RDI/RBX/etc.
            unsigned ci = 0;
            unsigned crex = 0;
            if (b[0] >= 0x40u && b[0] <= 0x4Fu && (b[1] == 0x83u || b[1] == 0x81u))
            {
                crex = b[0];
                ci = 1u;
            }
            if (b[ci] == 0x83u || b[ci] == 0x81u)
            {
                const unsigned modrm = b[ci + 1u];
                if (((modrm >> 3u) & 7u) == 7u)
                {
                    const unsigned mod = (modrm >> 6u) & 3u;
                    const unsigned rm = modrm & 7u;
                    unsigned pos = ci + 2u;
                    int dispValue = 0;
                    bool haveDisp = false;
                    unsigned baseReg = rm + ((crex & 0x01u) ? 8u : 0u);
                    bool memoryOperand = mod != 3u;
                    if (memoryOperand && rm == 4u)
                    {
                        const unsigned sib = b[pos++];
                        const unsigned sibBase = sib & 7u;
                        baseReg = sibBase + ((crex & 0x01u) ? 8u : 0u);
                        if (mod == 0u && sibBase == 5u)
                        {
                            std::int32_t d = 0; memcpy(&d, b + pos, sizeof(d)); pos += 4u;
                            dispValue = static_cast<int>(d); haveDisp = true; baseReg = 0xFFFFFFFFu;
                        }
                    }
                    if (memoryOperand && rm != 4u && mod == 0u && rm == 5u)
                    {
                        std::int32_t d = 0; memcpy(&d, b + pos, sizeof(d)); pos += 4u;
                        dispValue = static_cast<int>(d); haveDisp = true; baseReg = 0xFFFFFFFFu;
                    }
                    else if (memoryOperand && mod == 1u)
                    {
                        dispValue = static_cast<int>(static_cast<std::int8_t>(b[pos++])); haveDisp = true;
                    }
                    else if (memoryOperand && mod == 2u)
                    {
                        std::int32_t d = 0; memcpy(&d, b + pos, sizeof(d)); pos += 4u;
                        dispValue = static_cast<int>(d); haveDisp = true;
                    }
                    unsigned imm = 0xFFFFFFFFu;
                    if (b[ci] == 0x83u)
                        imm = b[pos];
                    else
                        memcpy(&imm, b + pos, sizeof(imm));
                    if ((imm == 1u || imm == 2u || imm == 27u) && cmpCandidates < 64u)
                    {
                        ++cmpCandidates;
                        InternalLog("[DW-NATIVE-DECISION-V50] CMP_STATE index=%u label=%s rva=0x%llX operand=%s base=%s disp=%s%d imm=%u delta=%lld heuristic=yes\r\n",
                            cmpCandidates, anchorLabel, static_cast<unsigned long long>(cursor - base),
                            memoryOperand ? "memory" : "register",
                            baseReg == 0xFFFFFFFFu ? "none/rip" : DwNativeRegNameV50(baseReg),
                            haveDisp ? "" : "n/a-", haveDisp ? dispValue : 0, imm,
                            static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
                    }
                }
            }
        }

        InternalLog("[DW-NATIVE-DECISION-V50] SUMMARY label=%s calls=%u ripRefs=%u stateCmpCandidates=%u next=decode_exact_native_guard_or_object_source no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel, calls, ripRefs, cmpCandidates);
        ServerEmuAppend(L"dw_native_login_v50.log",
            "[DW-NATIVE-DECISION-V50] SUMMARY label=%s calls=%u ripRefs=%u stateCmpCandidates=%u next=decode_exact_native_guard_or_object_source no_hooks=yes no_state_writes=yes\r\n",
            anchorLabel, calls, ripRefs, cmpCandidates);
    }

    void TraceDwNativeLoginPathV49(const char* anchorLabel, std::uintptr_t xref,
        bool ownerBounded, std::uintptr_t ownerBegin, std::uintptr_t ownerEnd) noexcept
    {
        const unsigned traceIndex = ++g_dwNativeLoginTraceCountV49;
        if (traceIndex > 16u)
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || xref < base || xref >= base + size)
            return;

        std::uintptr_t begin = xref > base + 0x300u ? xref - 0x300u : base;
        std::uintptr_t end = (std::min)(base + size, xref + static_cast<std::uintptr_t>(0x300u));
        if (ownerBounded && ownerEnd > ownerBegin)
        {
            begin = (std::max)(ownerBegin, begin);
            end = (std::min)(ownerEnd, end);
        }

        InternalLog("[DW-NATIVE-PATH-V50] BEGIN index=%u label=%s anchorRva=0x%llX ownerRva=%s0x%llX ownerEndRva=%s0x%llX window=0x%llX..0x%llX mode=STATIC_READ_ONLY\r\n",
            traceIndex, anchorLabel ? anchorLabel : "?", static_cast<unsigned long long>(xref - base),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerBegin - base : 0),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerEnd - base : 0),
            static_cast<unsigned long long>(begin - base), static_cast<unsigned long long>(end - base));
        ServerEmuAppend(L"dw_native_login_v50.log",
            "\r\n[DW-NATIVE-PATH-V50] BEGIN index=%u label=%s anchorRva=0x%llX ownerRva=%s0x%llX ownerEndRva=%s0x%llX window=0x%llX..0x%llX mode=STATIC_READ_ONLY\r\n",
            traceIndex, anchorLabel ? anchorLabel : "?", static_cast<unsigned long long>(xref - base),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerBegin - base : 0),
            ownerBounded ? "" : "n/a-", static_cast<unsigned long long>(ownerBounded ? ownerEnd - base : 0),
            static_cast<unsigned long long>(begin - base), static_cast<unsigned long long>(end - base));

        AppendCodeBytes144(L"dw_native_login_v50.log", "[DW-NATIVE-PATH-V50-CODE]", begin,
            static_cast<std::size_t>(end - begin), static_cast<std::size_t>(end - begin));

        unsigned calls = 0;
        unsigned branches = 0;
        unsigned statusCompares = 0;
        unsigned rcxLoads = 0;

        for (std::uintptr_t cursor = begin; cursor < end; ++cursor)
        {
            unsigned char b[10]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                continue;

            if (b[0] == 0xE8u && cursor + 5u <= end && calls < 64u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 1, sizeof(rel));
                const std::uintptr_t target = cursor + 5u + static_cast<std::intptr_t>(rel);
                if (target >= base && target < base + size)
                {
                    ++calls;
                    std::uintptr_t calleeBegin = 0, calleeEnd = 0;
                    const bool calleeBounded = RuntimeFunctionBounds144(target, calleeBegin, calleeEnd);
                    ServerEmuAppend(L"dw_native_login_v50.log",
                        "[DW-NATIVE-PATH-V50] CALL index=%u label=%s callRva=0x%llX targetRva=0x%llX calleeRva=%s0x%llX delta=%lld\r\n",
                        calls, anchorLabel ? anchorLabel : "?",
                        static_cast<unsigned long long>(cursor - base),
                        static_cast<unsigned long long>(target - base),
                        calleeBounded ? "" : "n/a-",
                        static_cast<unsigned long long>(calleeBounded ? calleeBegin - base : 0),
                        static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
                }
            }

            if (b[0] >= 0x70u && b[0] <= 0x7Fu && branches < 96u)
            {
                const std::uintptr_t target = cursor + 2u + static_cast<std::int8_t>(b[1]);
                ++branches;
                ServerEmuAppend(L"dw_native_login_v50.log",
                    "[DW-NATIVE-PATH-V50] BRANCH index=%u label=%s kind=JCC8 rva=0x%llX opcode=0x%02X targetRva=0x%llX delta=%lld\r\n",
                    branches, anchorLabel ? anchorLabel : "?",
                    static_cast<unsigned long long>(cursor - base), static_cast<unsigned>(b[0]),
                    static_cast<unsigned long long>(target >= base ? target - base : 0),
                    static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
            }
            else if (b[0] == 0x0Fu && b[1] >= 0x80u && b[1] <= 0x8Fu && cursor + 6u <= end && branches < 96u)
            {
                std::int32_t rel = 0;
                memcpy(&rel, b + 2, sizeof(rel));
                const std::uintptr_t target = cursor + 6u + static_cast<std::intptr_t>(rel);
                ++branches;
                ServerEmuAppend(L"dw_native_login_v50.log",
                    "[DW-NATIVE-PATH-V50] BRANCH index=%u label=%s kind=JCC32 rva=0x%llX opcode=0F%02X targetRva=0x%llX delta=%lld\r\n",
                    branches, anchorLabel ? anchorLabel : "?",
                    static_cast<unsigned long long>(cursor - base), static_cast<unsigned>(b[1]),
                    static_cast<unsigned long long>(target >= base ? target - base : 0),
                    static_cast<long long>(static_cast<std::intptr_t>(cursor) - static_cast<std::intptr_t>(xref)));
            }

            unsigned imm = 0xFFFFFFFFu;
            int fieldOffset = -1;
