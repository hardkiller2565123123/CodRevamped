                InternalLog("[AUTH-GATE-LIVE144] change=%u t=%llums firstState=%s%u snapshot=%s%u snapshotInit=%d prereq=%d prereqInit=%d fenceId1Found=%d fenceId1State=%d postFencePtr=%p postFence+0x10=%s0x%08X pumpCalls=%u guardCalls=%u; raw read-only\r\n",
                    changes, static_cast<unsigned long long>(elapsed),
                    firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                    snapshotOk ? "" : "UNREADABLE/", snapshotOk ? snapshotState : 0u,
                    snapshotInitOk ? static_cast<int>(snapshotInit) : -1,
                    prereqOk ? static_cast<int>(prereq) : -1,
                    prereqInitOk ? static_cast<int>(prereqInit) : -1,
                    fenceFound, fenceState, reinterpret_cast<void*>(postFenceValue),
                    postFenceState10Ok ? "" : "UNREADABLE/", postFenceState10Ok ? postFenceState10 : 0u,
                    g_bnetFirstStatePumpCalls.load(std::memory_order_relaxed),
                    g_bnetFirstStateGuardCalls.load(std::memory_order_relaxed));
                ServerEmuAppend(L"auth_gate_live.log",
                    "[AUTH-GATE-LIVE144] change=%u t=%llums firstState=%s%u snapshot=%s%u snapshotInit=%d prereq=%d prereqInit=%d fenceId1Found=%d fenceId1State=%d postFencePtr=%p postFenceState10=%s0x%08X pumpCalls=%u guardCalls=%u mode=RAW_MEMORY_READ_ONLY\r\n",
                    changes, static_cast<unsigned long long>(elapsed),
                    firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                    snapshotOk ? "" : "UNREADABLE/", snapshotOk ? snapshotState : 0u,
                    snapshotInitOk ? static_cast<int>(snapshotInit) : -1,
                    prereqOk ? static_cast<int>(prereq) : -1,
                    prereqInitOk ? static_cast<int>(prereqInit) : -1,
                    fenceFound, fenceState, reinterpret_cast<void*>(postFenceValue),
                    postFenceState10Ok ? "" : "UNREADABLE/", postFenceState10Ok ? postFenceState10 : 0u,
                    g_bnetFirstStatePumpCalls.load(std::memory_order_relaxed),
                    g_bnetFirstStateGuardCalls.load(std::memory_order_relaxed));

                if (postFenceOk && postFencePtr)
                {
                    for (unsigned i = 0; i < ArrayCount(postFenceDwords); ++i)
                    {
                        if (!postFenceDwordReadable[i])
                            continue;
                        const bool fieldChanged = !lastPostFenceSnapshotValid || postFencePointerChanged || postFenceDwords[i] != lastPostFenceDwords[i];
                        if (!fieldChanged)
                            continue;
                        // On a fresh object, retain a compact baseline: always include
                        // the required +0x10 gate plus any nonzero field. After that,
                        // log every changed dword in the +0x00..+0x80 window.
                        if ((!lastPostFenceSnapshotValid || postFencePointerChanged) && i != (0x10u / 4u) && postFenceDwords[i] == 0u)
                            continue;
                        ++postFenceChanges;
                        const std::uint32_t oldValue = (lastPostFenceSnapshotValid && !postFencePointerChanged) ? lastPostFenceDwords[i] : 0u;
                        InternalLog("[POSTFENCE144] change=%u t=%llums object=%p offset=+0x%02X old=0x%08X new=0x%08X%s firstState=%s%u prereq=%d fenceId1State=%d mode=RAW_MEMORY_READ_ONLY\r\n",
                            postFenceChanges, static_cast<unsigned long long>(elapsed), reinterpret_cast<void*>(postFencePtr),
                            i * 4u, oldValue, postFenceDwords[i], i == (0x10u / 4u) ? " DIAGNOSTIC_EXPECTED_1_UNPROVEN" : "",
                            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                            prereqOk ? static_cast<int>(prereq) : -1, fenceState);
                        ServerEmuAppend(L"post_fence_live.log",
                            "[POSTFENCE144] change=%u t=%llums object=%p offset=+0x%02X old=0x%08X new=0x%08X requiredEq1=%s firstState=%s%u prereq=%d fenceId1State=%d mode=RAW_MEMORY_READ_ONLY\r\n",
                            postFenceChanges, static_cast<unsigned long long>(elapsed), reinterpret_cast<void*>(postFencePtr),
                            i * 4u, oldValue, postFenceDwords[i], i == (0x10u / 4u) ? "yes" : "no",
                            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
                            prereqOk ? static_cast<int>(prereq) : -1, fenceState);
                    }
                    for (unsigned i = 0; i < ArrayCount(postFenceDwords); ++i)
                        if (postFenceDwordReadable[i]) lastPostFenceDwords[i] = postFenceDwords[i];
                    lastPostFenceSnapshotValid = true;
                }
                else if (postFencePointerChanged)
                {
                    lastPostFenceSnapshotValid = false;
                }

                lastFirst = firstValue;
                lastSnapshot = snapshotValue;
                lastSnapshotInit = snapshotInitValue;
                lastPrereq = prereqValue;
                lastPrereqInit = prereqInitValue;
                lastFenceFound = fenceFound;
                lastFenceState = fenceState;
                lastPostFencePtr = postFenceValue;
                firstSample = false;
            }

            Sleep(20);
        }

        InternalLog("[AUTH-GATE-LIVE144] sampler COMPLETE changes=%u postFenceChanges=%u elapsedMs=%llu mode=RAW_MEMORY_READ_ONLY\r\n",
            changes, postFenceChanges, static_cast<unsigned long long>(GetTickCount64() - started));
        ServerEmuAppend(L"auth_gate_live.log",
            "[AUTH-GATE-LIVE144] COMPLETE changes=%u postFenceChanges=%u elapsedMs=%llu mode=RAW_MEMORY_READ_ONLY\r\n",
            changes, postFenceChanges, static_cast<unsigned long long>(GetTickCount64() - started));
        ServerEmuAppend(L"post_fence_live.log",
            "[POSTFENCE144] COMPLETE changes=%u elapsedMs=%llu mode=RAW_MEMORY_READ_ONLY\r\n",
            postFenceChanges, static_cast<unsigned long long>(GetTickCount64() - started));
        return 0;
    }

    void StartBNetLiveStateSampler144() noexcept
    {
        if (kServerEmuProductionRuntimeV92)
            return;
        bool expected = false;
        if (!g_bnetLiveStateSamplerStarted.compare_exchange_strong(expected, true, std::memory_order_acq_rel))
            return;

        HANDLE thread = CreateThread(nullptr, 0, &BNetLiveStateSamplerThread144, nullptr, 0, nullptr);
        if (!thread)
        {
            const DWORD error = GetLastError();
            g_bnetLiveStateSamplerStarted.store(false, std::memory_order_release);
            InternalLog("[AUTH-GATE-LIVE144] CreateThread failed error=%lu; sampler not started\r\n", static_cast<unsigned long>(error));
            return;
        }
        CloseHandle(thread);
    }

