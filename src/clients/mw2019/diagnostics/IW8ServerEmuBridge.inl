    static void V104LiveCompletionTick144(ULONGLONG uptimeMs) noexcept;

    void V97Source3TraceTick144(ULONGLONG uptimeMs) noexcept
    {
        // V111/V112.1/V113 are idempotent. V113 waits for V111 to restore DR0-DR2 and V103 to be ready, then uses a low-frequency connected-return watch; the hot result-fetch breakpoint remains disabled.
        ObserveSessionCompletion144();
        ObserveSource3Dispatch112144();
        ObserveSource3Dispatch113144();
        const auto socket = g_dwLsgCandidateSocketV61.load(std::memory_order_acquire);
        if (!socket)
            return;
        static ULONGLONG lastV103InstallAttempt = 0;
        if (!g_v103ConnectedDispatchHooksReady.load(std::memory_order_acquire) &&
            g_v103ConnectedDispatchHookAttempts.load(std::memory_order_acquire) < 5u &&
            (!lastV103InstallAttempt || uptimeMs - lastV103InstallAttempt >= 1000u))
        {
            lastV103InstallAttempt = uptimeMs;
            V103InstallConnectedDispatchTrace144();
        }
        static ULONGLONG lastInstallAttempt = 0;
        if (!g_v97Source3HooksReady.load(std::memory_order_acquire) &&
            (lastInstallAttempt == 0 || uptimeMs - lastInstallAttempt >= 1000u))
        {
            lastInstallAttempt = uptimeMs;
            V97InstallSource3CompletionTrace144();
        }

        // V104 is a bounded pointer walk only (task -> four vtables -> slot 7).
        // It performs no image scan and no state write.
        V104LiveCompletionTick144(uptimeMs);

        static std::uintptr_t lastTask = 0;
        static DwV58TaskFlags lastFlags{};
        static bool haveFlags = false;
        static std::uint32_t lastSource3 = 0xFFFFFFFFu;
        static int lastDerived = -999;
        const std::uintptr_t task = V97ReadSlot7Task144();
        const DwV58TaskFlags flags = SnapshotDwV58TaskFlags(task);
        std::uint32_t source3 = 0xFFFFFFFFu;
        V97ReadSource3Value144(source3);
        const int derived = DwV58DerivedStatus();
        bool changed = task != lastTask || source3 != lastSource3 || derived != lastDerived || !haveFlags;
        if (flags.readable && haveFlags)
            changed = changed || memcmp(&flags.d[0], &lastFlags.d[0], sizeof(flags.d)) != 0 ||
                memcmp(&flags.e[0], &lastFlags.e[0], sizeof(flags.e)) != 0;
        if (!changed)
            return;
        lastTask = task;
        lastFlags = flags;
        haveFlags = flags.readable;
        lastSource3 = source3;
        lastDerived = derived;
        V97LogTaskState144("CHANGE_TICK");
