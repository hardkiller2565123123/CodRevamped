            "\r\n[DW-AUTH-RESET-PATH144] BEGIN gameFrames=%u setterRva=0x%llX scope=LIVE_STACK_PLUS_LOCAL_CALLSITE no_full_image_scan=yes mode=READ_ONLY\r\n",
            gameCount, static_cast<unsigned long long>(kDwAuthResetWriterRva144));

        for (unsigned i = 0; i < gameCount; ++i)
        {
            const auto returnRva = game[i].address - base;
            std::uintptr_t directCallSite = 0;
            std::uintptr_t directTarget = 0;
            bool direct = false;
            if (game[i].address >= base + 5u)
            {
                unsigned char call[5]{};
                const auto candidate = game[i].address - 5u;
                if (ServerEmuSafeReadBytes(reinterpret_cast<const void*>(candidate), call, sizeof(call)) && call[0] == 0xE8u)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, call + 1u, sizeof(rel));
