            d.BNetSignInPostFenceObjectGetter, getterCallRva);

        const std::uintptr_t globalVa = base + d.BNetPostFenceObjectPtr;
        for (std::uintptr_t p = begin; p + 7u <= end; ++p)
        {
            unsigned char b[7]{};
            if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(p), b, sizeof(b)))
                continue;

            std::uintptr_t target = 0;
            if (b[0] >= 0x40u && b[0] <= 0x4Fu &&
                (b[1] == 0x8Bu || b[1] == 0x8Du) && (b[2] & 0xC7u) == 0x05u)
            {
