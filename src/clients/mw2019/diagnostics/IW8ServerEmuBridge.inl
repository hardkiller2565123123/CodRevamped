    struct V78TrafficSigningKeyCandidate
    {
        unsigned long long fileOffset = 0;
        unsigned char der[294]{};
    };

    bool V78LooksLikeRsaSpki294(const unsigned char* p, std::size_t available) noexcept
    {
        if (!p || available < 294u)
            return false;

        // DER SubjectPublicKeyInfo for a 2048-bit RSA key using rsaEncryption:
        // SEQUENCE(0x122) + AlgorithmIdentifier + BIT STRING + RSAPublicKey.
        static const unsigned char prefix[] =
        {
            0x30,0x82,0x01,0x22,0x30,0x0D,0x06,0x09,
            0x2A,0x86,0x48,0x86,0xF7,0x0D,0x01,0x01,
            0x01,0x05,0x00,0x03,0x82,0x01,0x0F,0x00,
            0x30,0x82,0x01,0x0A,0x02,0x82,0x01,0x01
        };
        if (memcmp(p, prefix, sizeof(prefix)) != 0)
            return false;

        // 294-byte form has a leading zero before the 256-byte modulus and
        // the usual public exponent 65537 at the end.
        return p[32] == 0x00u &&
            p[289] == 0x02u && p[290] == 0x03u &&
            p[291] == 0x01u && p[292] == 0x00u && p[293] == 0x01u;
    }

    bool V78WriteTrafficSigningKeyCandidatePack(const wchar_t* path,
        const std::vector<V78TrafficSigningKeyCandidate>& candidates) noexcept
    {
        if (!path || !*path)
            return false;

        // File format:
        //   8 bytes  magic "IW8K3V78"
        //   u32 LE   version = 1
        //   u32 LE   candidate count
        //   repeated { u64 LE fileOffset; u8 der[294]; }
        std::vector<unsigned char> bytes;
        bytes.reserve(16u + candidates.size() * (8u + 294u));
        static const unsigned char magic[8] = {'I','W','8','K','3','V','7','8'};
        bytes.insert(bytes.end(), magic, magic + sizeof(magic));
        const auto append32 = [&bytes](unsigned long value)
        {
            bytes.push_back(static_cast<unsigned char>(value));
            bytes.push_back(static_cast<unsigned char>(value >> 8));
            bytes.push_back(static_cast<unsigned char>(value >> 16));
            bytes.push_back(static_cast<unsigned char>(value >> 24));
        };
        const auto append64 = [&bytes](unsigned long long value)
        {
            for (unsigned shift = 0; shift < 64u; shift += 8u)
                bytes.push_back(static_cast<unsigned char>(value >> shift));
        };
        append32(1u);
        append32(static_cast<unsigned long>(candidates.size()));
        for (const auto& candidate : candidates)
        {
            append64(candidate.fileOffset);
            bytes.insert(bytes.end(), candidate.der, candidate.der + sizeof(candidate.der));
        }

        HANDLE file = CreateFileW(path, GENERIC_WRITE,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE)
            return false;
        DWORD written = 0;
        const BOOL ok = bytes.size() <= 0xFFFFFFFFu &&
            WriteFile(file, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr);
        CloseHandle(file);
        return ok && written == static_cast<DWORD>(bytes.size());
    }

    DWORD WINAPI AuthTrafficSigningKeyDiskScanWorkerV78(LPVOID) noexcept
    {
        if (kServerEmuProductionRuntimeV92) return 0;

        wchar_t exePath[32768]{};
        const DWORD chars = GetModuleFileNameW(nullptr, exePath, static_cast<DWORD>(ArrayCount(exePath)));
        if (!chars || chars >= ArrayCount(exePath))
        {
            InternalLog("[DW-LSG-V78] KEY3_DISK_SCAN failed stage=module-path win32=%lu runtimeMemoryScan=off stateWrites=off\r\n", GetLastError());
            return 0;
        }

        HANDLE file = CreateFileW(exePath, GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
            nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
        if (file == INVALID_HANDLE_VALUE)
        {
            InternalLog("[DW-LSG-V78] KEY3_DISK_SCAN failed stage=open-exe win32=%lu runtimeMemoryScan=off stateWrites=off\r\n", GetLastError());
            return 0;
        }

        LARGE_INTEGER fileSize{};
        if (!GetFileSizeEx(file, &fileSize) || fileSize.QuadPart < 294 ||
            static_cast<unsigned long long>(fileSize.QuadPart) > static_cast<unsigned long long>(static_cast<std::size_t>(-1)))
        {
            const DWORD error = GetLastError();
            CloseHandle(file);
            InternalLog("[DW-LSG-V78] KEY3_DISK_SCAN failed stage=file-size win32=%lu runtimeMemoryScan=off stateWrites=off\r\n", error);
            return 0;
        }

        HANDLE mapping = CreateFileMappingW(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
        if (!mapping)
        {
            const DWORD error = GetLastError();
            CloseHandle(file);
            InternalLog("[DW-LSG-V78] KEY3_DISK_SCAN failed stage=file-map win32=%lu runtimeMemoryScan=off stateWrites=off\r\n", error);
            return 0;
        }
        const auto* view = static_cast<const unsigned char*>(MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0));
        if (!view)
        {
            const DWORD error = GetLastError();
