            fetchStatusAtE1, a2Eliminated ? "YES" : "no", knownHits, writerAHits, writerBHits, writerCHits,
            cellAMatch ? "YES" : "no", cellBMatch ? "YES" : "no", interpretation, next);
    }


    struct DwSource3WriterCellTraceV55
