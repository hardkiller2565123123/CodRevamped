                const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
                const auto regionEnd = (std::min)(rdataEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
                if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin && regionEnd - regionBegin >= length)
