            else if (distance <= 0x800u) score += 4u;

            ++candidateCount;
            InternalLog("[DW-NATIVE-LOGIN-V50] GETTER_CANDIDATE index=%u callRva=0x%llX targetRva=0x%llX resolvedRva=0x%llX fieldOffset=+0x%X compareImm=%s%u rcxDirectRva=%s0x%llX rcxPointerSlotRva=%s0x%llX score=%u\r\n",
                candidateCount,
                static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                static_cast<unsigned long long>(resolvedTarget - base), static_cast<unsigned>(fieldOffset), compareImm == 0xFFFFFFFFu ? "n/a-" : "", compareImm == 0xFFFFFFFFu ? 0u : compareImm,
                directObject ? "" : "n/a-", static_cast<unsigned long long>(directObject ? directObject - base : 0),
                pointerSlot ? "" : "n/a-", static_cast<unsigned long long>(pointerSlot ? pointerSlot - base : 0), score);
            ServerEmuAppend(L"dw_native_login_v50.log",
                "[DW-NATIVE-LOGIN-V50] GETTER_CANDIDATE index=%u callRva=0x%llX targetRva=0x%llX resolvedRva=0x%llX fieldOffset=+0x%X compareImm=%s%u directObjectRva=%s0x%llX pointerSlotRva=%s0x%llX score=%u\r\n",
                candidateCount,
                static_cast<unsigned long long>(cursor - base), static_cast<unsigned long long>(target - base),
                static_cast<unsigned long long>(resolvedTarget - base), static_cast<unsigned>(fieldOffset), compareImm == 0xFFFFFFFFu ? "n/a-" : "", compareImm == 0xFFFFFFFFu ? 0u : compareImm,
                directObject ? "" : "n/a-", static_cast<unsigned long long>(directObject ? directObject - base : 0),
                pointerSlot ? "" : "n/a-", static_cast<unsigned long long>(pointerSlot ? pointerSlot - base : 0), score);

            if (score > best.score)
            {
                best.call = cursor;
                best.target = resolvedTarget;
                best.directObject = directObject;
                best.pointerSlot = pointerSlot;
                best.fieldOffset = fieldOffset;
                best.score = score;
                best.compareImm = compareImm;
            }
        }

        if (!best.target || best.score < 32u)
        {
            unsigned inlineCandidates = 0;
            for (std::uintptr_t cursor = begin; cursor + 10u <= end; ++cursor)
            {
                unsigned char b[10]{};
                if (!ServerEmuSafeReadBytes(reinterpret_cast<const void*>(cursor), b, sizeof(b)))
                    continue;
                int fieldOffset = -1;
                unsigned imm = 0xFFFFFFFFu;
                unsigned insnBytes = 0;
                if (b[0] == 0x83u && b[1] == 0x79u)
                {
                    fieldOffset = static_cast<int>(static_cast<std::int8_t>(b[2]));
                    imm = b[3];
                    insnBytes = 4u;
                }
                else if (b[0] == 0x83u && b[1] == 0xB9u)
                {
                    std::int32_t disp = 0; memcpy(&disp, b + 2, sizeof(disp));
                    fieldOffset = static_cast<int>(disp); imm = b[6]; insnBytes = 7u;
                }
                else if (b[0] == 0x81u && b[1] == 0x79u)
                {
                    fieldOffset = static_cast<int>(static_cast<std::int8_t>(b[2]));
                    std::uint32_t value = 0; memcpy(&value, b + 3, sizeof(value));
                    imm = value; insnBytes = 7u;
                }
                else if (b[0] == 0x81u && b[1] == 0xB9u)
                {
                    std::int32_t disp = 0; std::uint32_t value = 0;
                    memcpy(&disp, b + 2, sizeof(disp)); memcpy(&value, b + 6, sizeof(value));
                    fieldOffset = static_cast<int>(disp); imm = value; insnBytes = 10u;
                }
                if (fieldOffset < 0 || fieldOffset >= 0x4000 || (imm != 1u && imm != 2u && imm != 27u))
                    continue;

                std::uintptr_t directObject = 0, pointerSlot = 0;
                const bool haveSource = FindDwStatusCallerRcxSourceV47(cursor, directObject, pointerSlot);
                std::uintptr_t object = directObject;
                if (!object && pointerSlot)
                    ServerEmuSafeReadPointer(reinterpret_cast<const void*>(pointerSlot), object);
                std::uint32_t current = 0xFFFFFFFFu;
                const bool sane = object && ServerEmuSafeReadU32(reinterpret_cast<const void*>(object + static_cast<std::uintptr_t>(fieldOffset)), current) && current <= 0x40u;
                ++inlineCandidates;
                InternalLog("[DW-NATIVE-LOGIN-V50] INLINE_CMP index=%u label=%s rva=0x%llX bytes=%u fieldOffset=+0x%X imm=%u rcxSource=%s object=%p current=%s%u sane=%s\r\n",
                    inlineCandidates, anchorLabel ? anchorLabel : "?", static_cast<unsigned long long>(cursor - base), insnBytes,
                    static_cast<unsigned>(fieldOffset), imm, haveSource ? "global" : "runtime", reinterpret_cast<void*>(object),
                    current == 0xFFFFFFFFu ? "n/a-" : "", current == 0xFFFFFFFFu ? 0u : current, sane ? "yes" : "no");

                // Native-only monitor: when a state-style compare has a stable
                // object source, remember the field and watch stock transitions.
                // No value is modified.
                if (haveSource && sane && (imm == 1u || imm == 2u))
                {
                    g_dwFirstPartyStatusFieldOffsetV47.store(fieldOffset, std::memory_order_release);
                    if (directObject) g_dwFirstPartyStatusObjectV47.store(directObject, std::memory_order_release);
                    if (pointerSlot) g_dwFirstPartyStatusPointerSlotV47.store(pointerSlot, std::memory_order_release);
                    InternalLog("[DW-NATIVE-LOGIN-V50] INLINE_SELECTED label=%s fieldOffset=+0x%X object=%p current=%u method=DATA_ONLY_READ_OBSERVER native_only=yes\r\n",
