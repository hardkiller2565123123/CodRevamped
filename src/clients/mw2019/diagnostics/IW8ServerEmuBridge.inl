    void BuildAuthTags(const std::string& lower, char* out, std::size_t outCount) noexcept
    {
        if (!out || !outCount)
            return;
        out[0] = '\0';
        const auto add = [&](const char* tag)
        {
            if (!tag || !*tag)
                return;
            if (out[0])
                strncat_s(out, outCount, "+", _TRUNCATE);
            strncat_s(out, outCount, tag, _TRUNCATE);
        };
        if (lower.find("battle.net") != std::string::npos || lower.find("bnet") != std::string::npos || lower.find("blizzard") != std::string::npos) add("BNET");
        if (lower.find("bgs") != std::string::npos || lower.find("rpc.battle.net") != std::string::npos) add("BGS");
        if (lower.find("demonware") != std::string::npos) add("DW");
        if (lower.find("auth3") != std::string::npos) add("AUTH3");
        if (lower.find("uno") != std::string::npos) add("UNO");
        if (lower.find("umbrella") != std::string::npos) add("UMBRELLA");
        if (lower.find("login") != std::string::npos) add("LOGIN");
        if (lower.find("token") != std::string::npos) add("TOKEN");
        if (lower.find("session") != std::string::npos) add("SESSION");
        if (lower.find("account") != std::string::npos) add("ACCOUNT");
        if (lower.find("crossplay") != std::string::npos) add("CROSSPLAY");
        if (lower.find("lobbyservice") != std::string::npos) add("LOBBY");
        if (!out[0])
            strncpy_s(out, outCount, "AUTH", _TRUNCATE);
    }

    void TracePayload(const char* direction, SOCKET socket, const void* data, std::size_t length, std::uintptr_t caller) noexcept
    {
        if (!ServerEmuSettings().tracePayloads || !data || !length)
            return;

        const std::size_t capped = (std::min)(length, static_cast<std::size_t>(64));
        char hex[64 * 3 + 1]{};
        char ascii[65]{};
        std::size_t used = 0;
        bool tls = false;
        __try
        {
            const auto* bytes = reinterpret_cast<const unsigned char*>(data);
            tls = capped >= 3 && bytes[0] == 0x16 && bytes[1] == 0x03;
            for (std::size_t i = 0; i < capped; ++i)
            {
                if (used + 4 < ArrayCount(hex))
                    used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used, _TRUNCATE, "%02X ", bytes[i]));
                ascii[i] = bytes[i] >= 32 && bytes[i] <= 126 ? static_cast<char>(bytes[i]) : '.';
            }
            ascii[capped] = '\0';
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            strncpy_s(hex, "<unreadable>", _TRUNCATE);
            strncpy_s(ascii, "<unreadable>", _TRUNCATE);
        }

        char where[96]{};
        FormatCaller(caller, where, ArrayCount(where));
        char local[128]{};
        char peer[128]{};
        SocketEndpointsToText(socket, local, ArrayCount(local), peer, ArrayCount(peer));
        ServerEmuAppend(L"network_payloads.log", "[%s] socket=%llu local=%s peer=%s len=%llu caller=%s%s hex=%s ascii=%s\r\n",
            direction ? direction : "?",
            static_cast<unsigned long long>(socket),
            local,
            peer,
            static_cast<unsigned long long>(length),
            where,
            tls ? " TLS" : "",
            hex,
            ascii);
    }

    template <typename T>
    bool PatchImport(HMODULE module, const char* importModule, const char* functionName, void* replacement, T& original) noexcept
    {
        if (!module || !importModule || !functionName || !replacement)
            return false;
        const auto base = reinterpret_cast<std::uintptr_t>(module);
        __try
        {
            const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
            if (dos->e_magic != IMAGE_DOS_SIGNATURE) return false;
            const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + static_cast<std::uintptr_t>(dos->e_lfanew));
            if (nt->Signature != IMAGE_NT_SIGNATURE) return false;
            const auto& dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
            if (!dir.VirtualAddress || !dir.Size) return false;
            auto* desc = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base + dir.VirtualAddress);
            for (; desc->Name; ++desc)
            {
                const char* dllName = reinterpret_cast<const char*>(base + desc->Name);
                if (!dllName || _stricmp(dllName, importModule) != 0)
                    continue;

                auto* first = reinterpret_cast<IMAGE_THUNK_DATA64*>(base + desc->FirstThunk);
                auto* originalThunk = desc->OriginalFirstThunk
                    ? reinterpret_cast<IMAGE_THUNK_DATA64*>(base + desc->OriginalFirstThunk)
                    : first;
                for (; originalThunk->u1.AddressOfData; ++originalThunk, ++first)
                {
                    if (IMAGE_SNAP_BY_ORDINAL64(originalThunk->u1.Ordinal))
                        continue;
                    const auto* byName = reinterpret_cast<const IMAGE_IMPORT_BY_NAME*>(base + originalThunk->u1.AddressOfData);
                    if (!byName || strcmp(reinterpret_cast<const char*>(byName->Name), functionName) != 0)
                        continue;

                    void** slot = reinterpret_cast<void**>(&first->u1.Function);
                    DWORD oldProtect = 0;
                    if (!VirtualProtect(slot, sizeof(void*), PAGE_READWRITE, &oldProtect))
                        return false;
                    if (!original)
                        original = reinterpret_cast<T>(*slot);
                    *slot = replacement;
                    DWORD ignored = 0;
                    VirtualProtect(slot, sizeof(void*), oldProtect, &ignored);
                    FlushInstructionCache(GetCurrentProcess(), slot, sizeof(void*));
                    return true;
                }
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER) {}
        return false;
    }

