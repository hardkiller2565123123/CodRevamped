    void ScanServerEmuProtocolSurface(HMODULE module, unsigned pass) noexcept
    {
        if (kServerEmuProductionRuntimeV92)
        {
            InternalLog("[V94-PRODUCTION] auth/protocol memory scan request ignored; production runtime keeps all research scans OFF\r\n");
            return;
        }
        ImageSectionView text{};
        ImageSectionView rdata{};
        if (!GetImageSection(module, ".text", text) || !GetImageSection(module, ".rdata", rdata))
        {
            InternalLog("[AUTH-SCAN] pass=%u ERROR missing .text/.rdata sections\r\n", pass);
            ServerEmuAppend(L"protocol_surface.log", "[SCAN pass=%u] missing .text/.rdata sections\r\n", pass);
            return;
        }

        const auto base = reinterpret_cast<std::uintptr_t>(module);
        InternalLog("\r\n[AUTH-SCAN] ============================================================\r\n");
        InternalLog("[AUTH-SCAN] pass=%u BEGIN read-only login/auth discovery\r\n", pass);
        InternalLog("[AUTH-SCAN] imageBase=%p .rdata RVA=0x%llX size=0x%llX .text RVA=0x%llX size=0x%llX\r\n",
            module,
            static_cast<unsigned long long>(rdata.rva), static_cast<unsigned long long>(rdata.size),
            static_cast<unsigned long long>(text.rva), static_cast<unsigned long long>(text.size));
        InternalLog("[AUTH-SCAN] stage 1/3 scanning .rdata for Battle.net/BGS/Demonware/UNO/login/token strings...\r\n");

        std::vector<ProtocolStringHit> hits;
        hits.reserve(512);
        const auto rdataBegin = reinterpret_cast<std::uintptr_t>(rdata.begin);
        const auto rdataEnd = rdataBegin + rdata.size;
        std::size_t nextRdataProgress = 1024 * 1024;
        for (std::uintptr_t cursor = rdataBegin; cursor < rdataEnd && hits.size() < 512; )
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<void*>(cursor), &mbi, sizeof(mbi))) break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(rdataEnd, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
            if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
            {
                const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                for (std::size_t i = 0; i + 5 < regionSize && hits.size() < 512; )
                {
                    const std::size_t scanned = static_cast<std::size_t>((regionBegin + i) - rdataBegin);
                    if (scanned >= nextRdataProgress)
                    {
                        const unsigned pct = rdata.size ? static_cast<unsigned>((scanned * 100ull) / rdata.size) : 100u;
                        InternalLog("[AUTH-SCAN] .rdata progress=%u%% scanned=0x%llX/0x%llX candidates=%llu\r\n",
                            pct,
                            static_cast<unsigned long long>(scanned),
                            static_cast<unsigned long long>(rdata.size),
                            static_cast<unsigned long long>(hits.size()));
                        nextRdataProgress += 1024 * 1024;
                    }

                    const unsigned char c = bytes[i];
                    if (c < 32 || c > 126)
                    {
                        ++i;
                        continue;
                    }
                    std::size_t stringEnd = i;
                    while (stringEnd < regionSize && stringEnd - i < 300 && bytes[stringEnd] >= 32 && bytes[stringEnd] <= 126)
                        ++stringEnd;
                    const std::size_t length = stringEnd - i;
                    if (length >= 5)
                    {
                        std::string value(reinterpret_cast<const char*>(bytes + i), length);
                        const std::string lower = LowerAscii(value.c_str());
                        if (ProtocolInteresting(lower))
                        {
                            ProtocolStringHit hit{};
                            hit.address = regionBegin + i;
                            hit.text = value;
                            hits.push_back(std::move(hit));
                        }
                    }
                    i = stringEnd > i ? stringEnd + 1 : i + 1;
                }
            }
            if (regionEnd <= cursor) break;
            cursor = regionEnd;
        }

        std::sort(hits.begin(), hits.end(), [](const ProtocolStringHit& a, const ProtocolStringHit& b) { return a.address < b.address; });
        ServerEmuAppend(L"protocol_surface.log", "\r\n[SCAN pass=%u] textRva=0x%llX textSize=0x%llX rdataRva=0x%llX rdataSize=0x%llX strings=%llu\r\n",
            pass,
            static_cast<unsigned long long>(text.rva), static_cast<unsigned long long>(text.size),
            static_cast<unsigned long long>(rdata.rva), static_cast<unsigned long long>(rdata.size),
            static_cast<unsigned long long>(hits.size()));
        ServerEmuAppend(L"auth_surface.log", "\r\n[AUTH-SCAN pass=%u] focused Battle.net/Demonware/UNO login surface\r\n", pass);

        InternalLog("[AUTH-SCAN] stage 1/3 complete protocolCandidates=%llu\r\n", static_cast<unsigned long long>(hits.size()));
        InternalLog("[AUTH-SCAN] stage 2/3 printing every auth/login string candidate...\r\n");

        unsigned authStrings = 0;
        bool sawBattleNet = false;
        bool sawDemonware = false;
        bool sawUno = false;
        bool sawTokenOrSession = false;

        for (const auto& hit : hits)
        {
            ServerEmuAppend(L"protocol_surface.log", "[STRING] rva=0x%llX value='%s'\r\n",
                static_cast<unsigned long long>(hit.address - base), hit.text.c_str());
            const std::string lower = LowerAscii(hit.text.c_str());
            if (AuthInteresting(lower))
            {
                ++authStrings;
                sawBattleNet = sawBattleNet || lower.find("battle.net") != std::string::npos ||
                    lower.find("bnet") != std::string::npos || lower.find("blizzard") != std::string::npos;
                sawDemonware = sawDemonware || lower.find("demonware") != std::string::npos ||
                    lower.find("auth3") != std::string::npos;
                sawUno = sawUno || lower.find("uno") != std::string::npos ||
                    lower.find("umbrella") != std::string::npos;
                sawTokenOrSession = sawTokenOrSession || lower.find("token") != std::string::npos ||
                    lower.find("session") != std::string::npos;

                char tags[128]{};
                BuildAuthTags(lower, tags, ArrayCount(tags));
                InternalLog("[AUTH-STRING %03u] rva=0x%llX tags=%s value='%s'\r\n",
                    authStrings, static_cast<unsigned long long>(hit.address - base), tags, hit.text.c_str());
                ServerEmuAppend(L"auth_surface.log", "[AUTH-STRING] rva=0x%llX tags=%s value='%s'\r\n",
                    static_cast<unsigned long long>(hit.address - base), tags, hit.text.c_str());
            }
        }

        InternalLog("[AUTH-SCAN] stage 2/3 complete authStrings=%u\r\n", authStrings);
        if (hits.empty())
        {
            InternalLog("[AUTH-SCAN] pass=%u complete: no protocol strings found\r\n", pass);
            return;
        }

        auto findHit = [&](std::uintptr_t target) -> ProtocolStringHit* {
            auto it = std::lower_bound(hits.begin(), hits.end(), target,
                [](const ProtocolStringHit& h, std::uintptr_t value) { return h.address < value; });
            if (it != hits.end() && it->address == target)
                return &*it;
            return nullptr;
        };

        InternalLog("[AUTH-SCAN] stage 3/3 scanning .text for RIP-relative xrefs to auth strings...\r\n");
        const auto textBeginAddress = reinterpret_cast<std::uintptr_t>(text.begin);
        const auto textEndAddress = textBeginAddress + text.size;
        std::size_t nextTextProgress = 8 * 1024 * 1024;
        unsigned liveAuthXrefs = 0;
        unsigned authenticationListenerHashHits = 0;
        unsigned authenticationServiceHashHits = 0;
        for (std::uintptr_t cursor = textBeginAddress; cursor < textEndAddress; )
        {
            MEMORY_BASIC_INFORMATION mbi{};
            if (!VirtualQuery(reinterpret_cast<void*>(cursor), &mbi, sizeof(mbi))) break;
            const auto regionBegin = (std::max)(cursor, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress));
            const auto regionEnd = (std::min)(textEndAddress, reinterpret_cast<std::uintptr_t>(mbi.BaseAddress) + mbi.RegionSize);
            if (ServerEmuReadableRegion(mbi) && regionEnd > regionBegin)
            {
                const auto* bytes = reinterpret_cast<const unsigned char*>(regionBegin);
                const std::size_t regionSize = static_cast<std::size_t>(regionEnd - regionBegin);
                for (std::size_t local = 0; local + 7 < regionSize; ++local)
                {
                    const std::size_t scanned = static_cast<std::size_t>((regionBegin + local) - textBeginAddress);
                    if (scanned >= nextTextProgress)
                    {
                        const unsigned pct = text.size ? static_cast<unsigned>((scanned * 100ull) / text.size) : 100u;
                        InternalLog("[AUTH-SCAN] .text progress=%u%% scanned=0x%llX/0x%llX authXrefs=%u\r\n",
                            pct,
                            static_cast<unsigned long long>(scanned),
                            static_cast<unsigned long long>(text.size),
                            liveAuthXrefs);
                        nextTextProgress += 8 * 1024 * 1024;
                    }

                    // Piggyback exact BGS service-hash discovery onto this existing
                    // .text sweep rather than performing another 100+ MB scan. These
                    // are raw constant hits only; they do not patch or execute code.
                    // AuthenticationListener = 0x71240E35, AuthenticationService = 0x0DECFC01.
                    std::uint32_t rawConstant = 0;
                    memcpy(&rawConstant, bytes + local, sizeof(rawConstant));
                    if (pass == 1u && (rawConstant == 0x71240E35u || rawConstant == 0x0DECFC01u))
                    {
                        unsigned* hitCounter = rawConstant == 0x71240E35u
                            ? &authenticationListenerHashHits : &authenticationServiceHashHits;
                        if (*hitCounter < 32u)
                        {
                            ++(*hitCounter);
                            char hashContext[320]{};
                            std::size_t hashUsed = 0;
                            const std::size_t hashStart = local >= 24 ? local - 24 : 0;
                            const std::size_t hashAvailable = (std::min)(static_cast<std::size_t>(64), regionSize - hashStart);
                            for (std::size_t b = 0; b < hashAvailable && hashUsed + 4 < ArrayCount(hashContext); ++b)
                                hashUsed += static_cast<std::size_t>(_snprintf_s(hashContext + hashUsed, ArrayCount(hashContext) - hashUsed, _TRUNCATE, "%02X ", bytes[hashStart + b]));

                            const char* hashLabel = rawConstant == 0x71240E35u ? "AuthenticationListener" : "AuthenticationService";
                            InternalLog("[BGS-AUTH-DISPATCH144] service=%s hash=0x%08X hit=%u codeRva=0x%llX contextStartRva=0x%llX bytes=%s\r\n",
                                hashLabel, rawConstant, *hitCounter,
                                static_cast<unsigned long long>((regionBegin + local) - base),
                                static_cast<unsigned long long>((regionBegin + hashStart) - base), hashContext);
                            ServerEmuAppend(L"auth_bgs_dispatch.log",
                                "[BGS-AUTH-DISPATCH144] mode=READ_ONLY service=%s hash=0x%08X hit=%u codeRva=0x%llX contextStartRva=0x%llX bytes=%s\r\n",
                                hashLabel, rawConstant, *hitCounter,
                                static_cast<unsigned long long>((regionBegin + local) - base),
                                static_cast<unsigned long long>((regionBegin + hashStart) - base), hashContext);
                        }
                    }

                    if ((bytes[local] & 0xF0) != 0x40 || (bytes[local + 1] != 0x8D && bytes[local + 1] != 0x8B) || (bytes[local + 2] & 0xC7) != 0x05)
                        continue;
                    std::int32_t displacement = 0;
                    memcpy(&displacement, bytes + local + 3, sizeof(displacement));
                    const auto instruction = regionBegin + local;
                    const auto target = instruction + 7 + static_cast<std::intptr_t>(displacement);
                    ProtocolStringHit* hit = findHit(target);
                    if (!hit || hit->xrefs >= 12)
                        continue;
                    ++hit->xrefs;

                    char context[256]{};
                    std::size_t used = 0;
                    const std::size_t contextStart = local >= 12 ? local - 12 : 0;
                    const std::size_t available = (std::min)(static_cast<std::size_t>(40), regionSize - contextStart);
                    for (std::size_t b = 0; b < available && used + 4 < ArrayCount(context); ++b)
                        used += static_cast<std::size_t>(_snprintf_s(context + used, ArrayCount(context) - used, _TRUNCATE, "%02X ", bytes[contextStart + b]));

                    const char* op = bytes[local + 1] == 0x8D ? "LEA" : "MOV";
                    ServerEmuAppend(L"protocol_surface.log", "[XREF] stringRva=0x%llX codeRva=0x%llX op=%s context=%s value='%s'\r\n",
                        static_cast<unsigned long long>(hit->address - base),
                        static_cast<unsigned long long>(instruction - base),
                        op, context, hit->text.c_str());
                    const std::string lower = LowerAscii(hit->text.c_str());
                    if (AuthInteresting(lower))
                    {
                        ++liveAuthXrefs;
                        char tags[128]{};
                        BuildAuthTags(lower, tags, ArrayCount(tags));
                        InternalLog("[AUTH-XREF %03u] codeRva=0x%llX -> stringRva=0x%llX op=%s tags=%s\r\n",
                            liveAuthXrefs,
                            static_cast<unsigned long long>(instruction - base),
                            static_cast<unsigned long long>(hit->address - base),
                            op, tags);
                        InternalLog("[AUTH-XREF %03u] value='%s'\r\n", liveAuthXrefs, hit->text.c_str());
                        InternalLog("[AUTH-XREF %03u] bytes=%s\r\n", liveAuthXrefs, context);
                        ServerEmuAppend(L"auth_surface.log", "[AUTH-XREF] stringRva=0x%llX codeRva=0x%llX op=%s tags=%s context=%s value='%s'\r\n",
                            static_cast<unsigned long long>(hit->address - base),
                            static_cast<unsigned long long>(instruction - base),
                            op, tags, context, hit->text.c_str());
                    }
                }
            }
            if (regionEnd <= cursor) break;
            cursor = regionEnd;
        }

        if (pass == 1u)
        {
            InternalLog("[BGS-AUTH-DISPATCH144] hash scan COMPLETE AuthenticationListener=0x71240E35 hits=%u AuthenticationService=0x0DECFC01 hits=%u; read-only\r\n",
                authenticationListenerHashHits, authenticationServiceHashHits);
            ServerEmuAppend(L"auth_bgs_dispatch.log",
                "[BGS-AUTH-DISPATCH144] COMPLETE listenerHash=0x71240E35 hits=%u authServiceHash=0x0DECFC01 hits=%u mode=READ_ONLY\r\n",
                authenticationListenerHashHits, authenticationServiceHashHits);
        }

        // Focused Battle.net bootstrap-gate summary.
        //
        // Do NOT perform a second full .text sweep here. The live auth scanner
        // already scanned .text and populated hit.xrefs. Re-scanning the entire
        // executable was redundant and coincided with the 1.44 fatal error in
        // the latest run. Reuse the existing results only.
        struct BootstrapTarget
        {
            const char* text;
            const char* label;
        };
        static const BootstrapTarget bootstrapTargets[] = {
            { "Need to fetch a session token from Battle.net", "BNET_SESSION_TOKEN_GATE" },
            { "Need to fetch a acccount token from Battle.net", "BNET_ACCOUNT_TOKEN_GATE" },
            { "Got First Party token(s), ready to authenticate with Demonware", "FIRST_PARTY_TOKENS_READY" },
            { "Applying initial login delay, before authenticating with Demonware", "DW_AUTH_DELAY" },
            { "Ready to execute auth to Demonware", "DW_AUTH_READY" }
        };

        InternalLog("[BGS-BOOT] focused bootstrap-gate summary BEGIN (read-only, no second .text scan)\r\n");
        ServerEmuAppend(L"auth_surface.log",
            "[BGS-BOOT] focused bootstrap-gate summary BEGIN (read-only, no second .text scan)\r\n");

        for (const auto& target : bootstrapTargets)
        {
            const ProtocolStringHit* targetHit = nullptr;
            for (const auto& hit : hits)
            {
                if (hit.text == target.text)
                {
                    targetHit = &hit;
                    break;
                }
            }

            if (!targetHit)
            {
                InternalLog("[BGS-BOOT] %-24s string NOT FOUND\r\n", target.label);
                ServerEmuAppend(L"auth_surface.log",
                    "[BGS-BOOT] label=%s string NOT FOUND\r\n", target.label);
                continue;
            }

            InternalLog("[BGS-BOOT] %-24s stringRva=0x%llX generalXrefs=%u\r\n",
                target.label,
                static_cast<unsigned long long>(targetHit->address - base),
                targetHit->xrefs);
            ServerEmuAppend(L"auth_surface.log",
                "[BGS-BOOT] label=%s stringRva=0x%llX generalXrefs=%u source=existing-auth-scan\r\n",
                target.label,
                static_cast<unsigned long long>(targetHit->address - base),
                targetHit->xrefs);

            if (!targetHit->xrefs)
                InternalLog("[BGS-BOOT]   no direct RIP-relative xref in the completed general scan\r\n");
            else
                InternalLog("[BGS-BOOT]   matching [AUTH-XREF] line(s) above already contain code RVA + bytes\r\n");
        }

        // Tiny bounded window around the observed BGS TLS send caller only.
        const std::uintptr_t kObservedBgsTlsSendCallerRva = iw8_addresses::MW2019_1_44_Discovery.BgsTlsSendCaller;
        if (kObservedBgsTlsSendCallerRva < text.rva + text.size && kObservedBgsTlsSendCallerRva >= text.rva)
        {
            const std::size_t off = static_cast<std::size_t>(kObservedBgsTlsSendCallerRva - text.rva);
            const std::size_t contextStart = off >= 32 ? off - 32 : 0;
            const std::size_t count = (std::min)(static_cast<std::size_t>(96), text.size - contextStart);
            char context[768]{};
            std::size_t used = 0;
            for (std::size_t i = 0; i < count && used + 4 < ArrayCount(context); ++i)
                used += static_cast<std::size_t>(_snprintf_s(
                    context + used, ArrayCount(context) - used, _TRUNCATE, "%02X ", text.begin[contextStart + i]));
            InternalLog("[BGS-BOOT] TLS-send callerRva=0x%llX contextStartRva=0x%llX bytes=%s\r\n",
                static_cast<unsigned long long>(kObservedBgsTlsSendCallerRva),
                static_cast<unsigned long long>(text.rva + contextStart), context);
            ServerEmuAppend(L"auth_surface.log",
                "[BGS-BOOT] tlsSendCallerRva=0x%llX contextStartRva=0x%llX context=%s\r\n",
                static_cast<unsigned long long>(kObservedBgsTlsSendCallerRva),
                static_cast<unsigned long long>(text.rva + contextStart), context);
        }

        InternalLog("[BGS-BOOT] focused bootstrap-gate summary COMPLETE; no client state modified\r\n");
        ServerEmuAppend(L"auth_surface.log",
            "[BGS-BOOT] focused bootstrap-gate summary COMPLETE; no client state modified\r\n");

        unsigned withXrefs = 0;
        unsigned totalXrefs = 0;
        unsigned authWithXrefs = 0;
        unsigned authXrefs = 0;
        for (const auto& hit : hits)
        {
            if (hit.xrefs) ++withXrefs;
            totalXrefs += hit.xrefs;
            if (hit.xrefs && AuthInteresting(LowerAscii(hit.text.c_str())))
            {
                ++authWithXrefs;
                authXrefs += hit.xrefs;
            }
        }
        ServerEmuAppend(L"protocol_surface.log", "[SCAN pass=%u] complete strings=%llu withXrefs=%u xrefs=%u\r\n",
            pass, static_cast<unsigned long long>(hits.size()), withXrefs, totalXrefs);
        ServerEmuAppend(L"auth_surface.log",
            "[AUTH-SCAN pass=%u] complete authStrings=%u authWithXrefs=%u authXrefs=%u; no client auth/fence state was modified\r\n",
            pass, authStrings, authWithXrefs, authXrefs);

        InternalLog("[AUTH-SCAN] stage 3/3 complete authXrefs=%u xrefStrings=%u\r\n", authXrefs, authWithXrefs);
        InternalLog("[AUTH-SCAN] pass=%u COMPLETE strings=%u xrefStrings=%u xrefs=%u surfaces={bnet:%s dw:%s uno:%s token/session:%s}\r\n",
            pass, authStrings, authWithXrefs, authXrefs,
            sawBattleNet ? "yes" : "no",
            sawDemonware ? "yes" : "no",
            sawUno ? "yes" : "no",
            sawTokenOrSession ? "yes" : "no");
        InternalLog("[AUTH-SCAN] output=CodRevamped\\MW2019\\server_emu\\auth_surface.log; client auth/fence state untouched\r\n");
        InternalLog("[AUTH-SCAN] ============================================================\r\n\r\n");
    }

    static void ObserveSessionCompletion144() noexcept;
    static void ObserveSource3Dispatch112144() noexcept;
    static void ObserveSource3Dispatch113144() noexcept;

    void InstallServerEmuNetworkHooks(HMODULE game) noexcept
    {
        if (g_serverEmuHooksInstalled.exchange(true))
            return;

        const auto& startupCfg = ServerEmuSettings();
        InternalLog("[V96.1-TARGETED] BUILD=2026-09-19-V96.1 EXIT_CRASH_TRACE LSG_ZERO_LENGTH_NOOP TARGETED_GATE_TRACE CHANGE_ONLY NO_STACK_WALKS NO_BROAD_SCANS NO_STATE_WRITES stateForcing=OFF\r\n");
        InternalLog("[V98-TARGETED] BUILD=2026-09-19-V98 POSTFENCE_PREDICATE_PLUS_SLOT7_LIFECYCLE V97_SOURCE3_TRACE_RETAINED manualTestCommand=/source3_1 normalStateForcing=OFF output=CMD_ONLY\r\n");
        InternalLog("[V99-TARGETED] BUILD=2026-09-19-V99 MENU_BACKTRACE_AND_TEST_OPEN commands={/menustatus,/menuxrefs,/menutrace,/menuopen,/frontend} automaticMenuForcing=OFF output=CMD_ONLY\r\n");
        InternalLog("[V111.1-TARGETED] BUILD=2026-09-23-V111.1 DEFERRED_HARDWARE_EXECUTION_WATCH inherited={V97,V98,V103,V106,V108} watch={gate:0x4642C90,installerCall:0x4642CE8,successWriter:0x46417FF} functionDetours=OFF int3=OFF instructionBytesModified=NO V109BroadAncestry=DISABLED stateWrites=OFF\r\n");
        InternalLog("[V112.1-TARGETED] BUILD=2026-09-23-V112.1 PASSIVE_POST_CONNECTED_SOURCE3_CORRELATION inherited={V97,V98,V103,V106,V108,V111.1} observers={resultFetch:V98,statusCommit:V103,altRoute:V103,primary:V97,setter:V97} hardwareBreakpoints=0 debugRegistersTouchedByV112=NO waitForV111Restore=yes functionDetoursAddedByV112=0 int3=OFF stateWrites=OFF\r\n");
        InternalLog("[V113-TARGETED] BUILD=2026-09-23-V113 CONNECTED_OWNER_CONTINUATION_TRACE inherited={V97,V98,V103,V106,V108,V111.1,V112.1} preCommitWatch={0x4531538} postCommitWatch={slot50:0x2B59C00,firstLocalJcc,firstLocalCall} hotResultFetchBreakpoint=OFF functionDetoursAddedByV113=0 int3=OFF codeWrites=OFF vtableWrites=OFF stateWrites=OFF\r\n");
        ObserveSessionCompletion144();
        ObserveSource3Dispatch112144();
        ObserveSource3Dispatch113144();
        InternalLog("[V96.1-TARGETED] functional bootstrap remains unchanged; bounded 250ms read-only gate snapshots remain enabled; server now preserves secure LSG stage across zero-length no-op records\r\n");
        InternalLog("[TRUST-BOOT] OPTION2 local certificate-bundle trust bootstrap enabled; functional redirect/trust/bootstrap only; bdLogin/BNet/fence/LUI/menu state forcing=OFF\r\n");
        // Do NOT write the BGS verifier modulus during the earliest DLL/network-hook
        // initialization. On this IW8 build that can happen before the image/protection
        // state is stable enough for a safe .rdata write and can terminate the game.
        // The connect/WSAConnect preflight below is the single write point: it runs
        // immediately before the first :80/:1119 bootstrap socket is allowed through.
        InternalLog("[TRUST-BOOT] verifier write deferred until first :80/:1119 network preflight\r\n");
        DumpEmbeddedBgsCertificateBundle(game);

        // MW2019 PC's BGS 2.2.0 client does not expose the generic embedded
        // ChallengeListener web-login callback used by some other Battle.net
        // games. Trace the launcher-provided context instead: this is read-only
        // and deliberately redacts registry/environment/command-line values.
        // V93 does not enumerate launcher context or dump caller code/stacks.
        // Registry hooks remain only for ACCOUNT_STATE/WEB_TOKEN detection used
        // by the local DPAPI bootstrap.
        InstallBNetLauncherTraceHooks();
        // The server already proved the stock login path.  V93 deliberately does
        // not install Schannel/LSG crypto observers or queue static decision scans.
        // Keep the on-disk KEY3 candidate preparation only when its cached pack is
        // absent, because it is functional input to the local LSG oracle.
        QueueAuthTrafficSigningKeyDiskScanV78();

        const auto& cfg = ServerEmuSettings();
        ServerEmuAppend(L"network_trace.log", "\r\n[SERVER-EMU] start host=%s redirectDW=%s redirectBNet=%s payloads=%s nativeLoginTrace=ON bdLoginForce=off bnetGuardForce=off_V52\r\n",
            cfg.host, cfg.redirectDemonware ? "on" : "off", cfg.redirectBattleNet ? "on" : "off", cfg.tracePayloads ? "on" : "off");

        unsigned iatInstalled = 0;
        unsigned globalInstalled = 0;

        // V93: IW8 does not keep the whole online bootstrap inside the main EXE.
        // AUTH3/OptIn can run through the game IAT while the later Umbrella LSG
        // token exchange is issued by a curl/helper module. V92's game-IAT-only
        // cleanup therefore allowed that handoff to bypass the local backend.
        //
        // Restore ONLY the low-frequency bootstrap surface process-wide:
        //   DNS: getaddrinfo / GetAddrInfoW / gethostbyname
        //   connect establishment: connect / WSAConnect / WSAIoctl(ConnectEx)
        // send/recv, WSASend/WSARecv, IOCP, closesocket, UDP, TLS observers and
        // all research scanners remain disabled.
        HMODULE ws2 = GetModuleHandleW(L"WS2_32.dll");
        if (!ws2) ws2 = LoadLibraryW(L"WS2_32.dll");

        const auto installWs2 = [&](const char* name, void* detour, auto& original) noexcept
        {
            if (InstallProcessWideHook(ws2, name, detour, original))
            {
                ++globalInstalled;
                InternalLog("[NET-HOOK] bootstrap-global %s active\r\n", name);
                return true;
            }
            return false;
        };

        const auto installBootstrap = [&](const char* name, void* detour, auto& original) noexcept
        {
            if (!installWs2(name, detour, original))
                iatInstalled += PatchImport(game, "WS2_32.dll", name, detour, original) ? 1u : 0u;
        };

        installBootstrap("getaddrinfo", reinterpret_cast<void*>(&ServerEmuGetAddrInfoA), g_getAddrInfoAOriginal);
        installBootstrap("GetAddrInfoW", reinterpret_cast<void*>(&ServerEmuGetAddrInfoW), g_getAddrInfoWOriginal);
        installBootstrap("gethostbyname", reinterpret_cast<void*>(&ServerEmuGetHostByName), g_getHostByNameOriginal);
