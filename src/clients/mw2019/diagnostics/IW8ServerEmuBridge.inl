        {0x4520000u, 0x4540000u, "dw_status"},
        {0x4600000u, 0x4700000u, "bnet_transition"},
        {0x5D00000u, 0x5E00000u, "dw_status_api"},
        {0x6100000u, 0x6200000u, "lsg_transition"},
        {0x6D00000u, 0x6F00000u, "curl_transport"}
