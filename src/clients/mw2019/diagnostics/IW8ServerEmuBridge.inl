    LONG CALLBACK BNetFirstStateWriterVeh144(EXCEPTION_POINTERS* info) noexcept
    {
        if (!info || !info->ExceptionRecord || !info->ContextRecord)
            return EXCEPTION_CONTINUE_SEARCH;

        const DWORD code = info->ExceptionRecord->ExceptionCode;
        CONTEXT* context = info->ContextRecord;

        if (code == EXCEPTION_BREAKPOINT)
        {
            const auto exceptionAddress = reinterpret_cast<std::uintptr_t>(info->ExceptionRecord->ExceptionAddress);
            for (int i = 0; i < 2; ++i)
            {
                auto& bp = g_bnetFirstStateWriterBreakpoints144[i];
                if (!bp.prepared || !bp.armed || exceptionAddress != bp.instruction)
                    continue;

                if (!ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.instruction), bp.originalByte))
                    return EXCEPTION_CONTINUE_SEARCH;
                bp.armed = false;

                std::uint32_t stateBefore = 0;
                const auto statePtr = reinterpret_cast<void*>(context->Rax);
                const bool stateBeforeOk = ServerEmuSafeReadU32(statePtr, stateBefore);
                const std::uint32_t writeValue = bp.hasImmediate ? bp.immediate : BNetWriterSourceValue144(context, bp.modrm);
                const unsigned hit = ++g_bnetFirstStateWriterHits144;
                HMODULE game = GetModuleHandleW(nullptr);
                const auto& d = iw8_addresses::MW2019_1_44_Discovery;
                const auto expectedStatePtr = game ? reinterpret_cast<std::uintptr_t>(game) + d.BNetFirstStateValue : 0ull;

                InternalLog("[AUTH-GATE-WRITER144] BREAK hit=%u index=%d callerRva=0x%llX writerRva=0x%llX rax=%p expectedStatePtr=%p targetMatch=%s stateBefore=%s%u writeValue=%u opcode=%02X modrm=%02X; executing original unchanged\r\n",
                    hit, i,
                    static_cast<unsigned long long>(bp.callerRva),
                    static_cast<unsigned long long>(bp.instructionRva),
                    statePtr, reinterpret_cast<void*>(expectedStatePtr),
                    reinterpret_cast<std::uintptr_t>(statePtr) == expectedStatePtr ? "yes" : "no",
                    stateBeforeOk ? "" : "UNREADABLE/", stateBeforeOk ? stateBefore : 0u,
                    writeValue, static_cast<unsigned>(bp.opcode), static_cast<unsigned>(bp.modrm));
                ServerEmuAppend(L"auth_gate_writer.log",
                    "[AUTH-GATE-WRITER144] BREAK hit=%u index=%d callerRva=0x%llX writerRva=0x%llX rax=%p expectedStatePtr=%p targetMatch=%s stateBefore=%s%u writeValue=%u opcode=%02X modrm=%02X mode=EXECUTE_ORIGINAL_UNCHANGED\r\n",
                    hit, i,
                    static_cast<unsigned long long>(bp.callerRva),
                    static_cast<unsigned long long>(bp.instructionRva),
                    statePtr, reinterpret_cast<void*>(expectedStatePtr),
                    reinterpret_cast<std::uintptr_t>(statePtr) == expectedStatePtr ? "yes" : "no",
                    stateBeforeOk ? "" : "UNREADABLE/", stateBeforeOk ? stateBefore : 0u,
                    writeValue, static_cast<unsigned>(bp.opcode), static_cast<unsigned>(bp.modrm));

                g_bnetFirstStateWriterPendingStep144 = i;
                context->Rip = bp.instruction;
                context->EFlags |= 0x100u;
                return EXCEPTION_CONTINUE_EXECUTION;
            }
        }
        else if (code == EXCEPTION_SINGLE_STEP && g_bnetFirstStateWriterPendingStep144 >= 0)
        {
            const int i = g_bnetFirstStateWriterPendingStep144;
            g_bnetFirstStateWriterPendingStep144 = -1;
            if (i >= 0 && i < 2)
            {
                auto& bp = g_bnetFirstStateWriterBreakpoints144[i];
                std::uint32_t stateAfter = 0;
                HMODULE game = GetModuleHandleW(nullptr);
                const auto& d = iw8_addresses::MW2019_1_44_Discovery;
                void* expectedStatePtr = game ? reinterpret_cast<void*>(reinterpret_cast<std::uintptr_t>(game) + d.BNetFirstStateValue) : nullptr;
                const bool stateAfterOk = ServerEmuSafeReadU32(expectedStatePtr, stateAfter);

                InternalLog("[AUTH-GATE-WRITER144] STEP index=%d writerRva=0x%llX stateAfter=%s%u nextRip=0x%llX; original write completed\r\n",
                    i, static_cast<unsigned long long>(bp.instructionRva),
                    stateAfterOk ? "" : "UNREADABLE/", stateAfterOk ? stateAfter : 0u,
                    static_cast<unsigned long long>(context->Rip));
                ServerEmuAppend(L"auth_gate_writer.log",
                    "[AUTH-GATE-WRITER144] STEP index=%d writerRva=0x%llX stateAfter=%s%u nextRip=0x%llX original_write_completed=yes\r\n",
                    i, static_cast<unsigned long long>(bp.instructionRva),
                    stateAfterOk ? "" : "UNREADABLE/", stateAfterOk ? stateAfter : 0u,
                    static_cast<unsigned long long>(context->Rip));

                if (!(stateAfterOk && stateAfter == 3u))
                {
                    if (ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.instruction), 0xCC))
                        bp.armed = true;
                }
                else
                {
                    InternalLog("[AUTH-GATE-WRITER144] TARGET CAPTURED writerRva=0x%llX produced state=3; breakpoint left disarmed\r\n",
                        static_cast<unsigned long long>(bp.instructionRva));
                    ServerEmuAppend(L"auth_gate_writer.log",
                        "[AUTH-GATE-WRITER144] TARGET_CAPTURED writerRva=0x%llX producedState=3\r\n",
                        static_cast<unsigned long long>(bp.instructionRva));
                }
            }
            context->EFlags &= ~0x100u;
            return EXCEPTION_CONTINUE_EXECUTION;
        }

        return EXCEPTION_CONTINUE_SEARCH;
    }

    void PrepareBNetFirstStateWriterExecutionProbe144() noexcept
    {
        bool expected = false;
        if (!g_bnetFirstStateWriterProbePrepared144.compare_exchange_strong(expected, true))
            return;

        HMODULE game = GetModuleHandleW(nullptr);
        if (!game)
        {
            g_bnetFirstStateWriterProbePrepared144.store(false);
            return;
        }
        const auto base = reinterpret_cast<std::uintptr_t>(game);
        const std::uintptr_t callers[2] = { 0x2AD9513ull, 0x3DAA9A6ull };
        unsigned prepared = 0;

        for (unsigned index = 0; index < 2u; ++index)
        {
            auto& bp = g_bnetFirstStateWriterBreakpoints144[index];
            bp.callerRva = callers[index];
            const auto* call = reinterpret_cast<const BYTE*>(base + callers[index]);
            __try
            {
                if (call[0] != 0xE8)
                {
                    InternalLog("[AUTH-GATE-WRITER144] PREP index=%u callerRva=0x%llX rejected reason=not_CALL opcode=%02X\r\n",
                        index, static_cast<unsigned long long>(callers[index]), static_cast<unsigned>(call[0]));
                    continue;
                }

                const BYTE* after = call + 5;
                for (unsigned j = 0; j + 6u <= 96u; ++j)
                {
                    if (after[j] == 0xC7 && after[j + 1] == 0x00)
                    {
                        bp.instruction = reinterpret_cast<std::uintptr_t>(after + j);
                        bp.instructionRva = bp.instruction - base;
                        bp.originalByte = after[j];
                        bp.opcode = after[j];
                        bp.modrm = after[j + 1];
                        memcpy(&bp.immediate, after + j + 2, sizeof(bp.immediate));
                        bp.instructionLength = 6u;
                        bp.hasImmediate = true;
                        bp.prepared = true;
                        break;
                    }
                    if (j + 2u <= 96u && after[j] == 0x89 && (after[j + 1] & 0xC7u) == 0x00u)
                    {
                        bp.instruction = reinterpret_cast<std::uintptr_t>(after + j);
                        bp.instructionRva = bp.instruction - base;
                        bp.originalByte = after[j];
                        bp.opcode = after[j];
                        bp.modrm = after[j + 1];
                        bp.instructionLength = 2u;
                        bp.hasImmediate = false;
                        bp.prepared = true;
                        break;
                    }
                }
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                bp.prepared = false;
            }

            if (bp.prepared)
            {
                ++prepared;
                InternalLog("[AUTH-GATE-WRITER144] PREP index=%u callerRva=0x%llX writerRva=0x%llX opcode=%02X modrm=%02X immediate=%s%u armed=no\r\n",
                    index,
                    static_cast<unsigned long long>(bp.callerRva),
                    static_cast<unsigned long long>(bp.instructionRva),
                    static_cast<unsigned>(bp.opcode), static_cast<unsigned>(bp.modrm),
                    bp.hasImmediate ? "" : "n/a/", bp.hasImmediate ? bp.immediate : 0u);
                ServerEmuAppend(L"auth_gate_writer.log",
                    "[AUTH-GATE-WRITER144] PREP index=%u callerRva=0x%llX writerRva=0x%llX opcode=%02X modrm=%02X immediate=%s%u armed=no\r\n",
                    index,
                    static_cast<unsigned long long>(bp.callerRva),
                    static_cast<unsigned long long>(bp.instructionRva),
                    static_cast<unsigned>(bp.opcode), static_cast<unsigned>(bp.modrm),
                    bp.hasImmediate ? "" : "n/a/", bp.hasImmediate ? bp.immediate : 0u);
            }
        }

        if (prepared && !g_bnetFirstStateWriterVeh144)
            g_bnetFirstStateWriterVeh144 = AddVectoredExceptionHandler(1u, &BNetFirstStateWriterVeh144);

        InternalLog("[AUTH-GATE-WRITER144] PREP COMPLETE candidates=%u veh=%s armTrigger=natural_state_1 mode=EXECUTION_OBSERVER_ONLY\r\n",
            prepared, g_bnetFirstStateWriterVeh144 ? "ready" : "failed");
        ServerEmuAppend(L"auth_gate_writer.log",
            "[AUTH-GATE-WRITER144] PREP_COMPLETE candidates=%u veh=%s armTrigger=natural_state_1 mode=EXECUTION_OBSERVER_ONLY\r\n",
            prepared, g_bnetFirstStateWriterVeh144 ? "ready" : "failed");
    }

    void ArmBNetFirstStateWriterExecutionProbe144(const char* trigger) noexcept
    {
        if (!g_bnetFirstStateWriterProbePrepared144.load(std::memory_order_acquire))
            PrepareBNetFirstStateWriterExecutionProbe144();
        if (!g_bnetFirstStateWriterVeh144)
            return;

        bool expected = false;
        if (!g_bnetFirstStateWriterProbeArmed144.compare_exchange_strong(expected, true))
            return;

        unsigned armed = 0;
        for (auto& bp : g_bnetFirstStateWriterBreakpoints144)
        {
            if (!bp.prepared || bp.armed)
                continue;
            if (ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.instruction), 0xCC))
            {
                bp.armed = true;
                ++armed;
            }
        }
        InternalLog("[AUTH-GATE-WRITER144] ARMED trigger=%s breakpoints=%u stateWritesRemainStock=yes\r\n",
            trigger ? trigger : "<unknown>", armed);
        ServerEmuAppend(L"auth_gate_writer.log",
            "[AUTH-GATE-WRITER144] ARMED trigger=%s breakpoints=%u stateWritesRemainStock=yes\r\n",
            trigger ? trigger : "<unknown>", armed);
    }

    void __fastcall BNetFirstStatePumpObserver144(void* stateObject) noexcept
    {
        const unsigned call = ++g_bnetFirstStatePumpCalls;
        const bool outermost = (++g_bnetFirstStatePumpDepth == 1u);

        std::uint32_t beforeState = 0;
        const bool beforeOk = ServerEmuSafeReadU32(stateObject, beforeState);
        if (outermost)
        {
            g_bnetFirstStateGuardSeenInPump = false;
            g_bnetFirstStateGuardResultInPump = false;
            g_bnetFirstStateGuardArg0InPump = 0;
            g_bnetFirstStateGuardOutInPump = 0;
            g_bnetFirstStateGuardBufferInPump = 0;
            g_bnetFirstStateGuardLengthInPump = 0;
            g_bnetFirstStateGuardMetaInPump = 0;
        }

        if (g_bnetFirstStatePumpOriginal)
            g_bnetFirstStatePumpOriginal(stateObject);

        std::uint32_t afterState = 0;
        const bool afterOk = ServerEmuSafeReadU32(stateObject, afterState);

        if (outermost)
        {
            const bool guardSeen = g_bnetFirstStateGuardSeenInPump;
            const bool guardResult = g_bnetFirstStateGuardResultInPump;
            const char* branch = "NO_STATE_CHANGE";
            if (beforeOk && afterOk && beforeState != afterState)
            {
                if (afterState == 3u && guardSeen && !guardResult)
                    branch = "GUARD_FALSE_TO_STATE_3_CONFIRMED";
                else if (guardSeen && guardResult)
                    branch = "GUARD_TRUE_PATH";
                else
                    branch = "STATE_CHANGED_OUTSIDE_OBSERVED_GUARD";
            }
            else if (guardSeen && !guardResult)
            {
                branch = "GUARD_FALSE_STATE_ALREADY_NONZERO_OR_WRITE_NOT_TAKEN";
            }

            // This pump can be called continuously after initialization. Keep the
            // runtime trace event-driven so a long test does not turn into a per-frame
            // log flood: emit the first few calls, any guard invocation, or a state change.
            const bool stateChanged = beforeOk && afterOk && beforeState != afterState;
            // Exact INT3 execution observers are intentionally disabled for 1.44.
            // This build's protection/fatal-error path can react to executable-byte
            // mutation while the auth worker is active. Keep the useful MinHook
            // pump/guard observers and raw memory sampling, but never patch stock
            // auth instructions just to observe execution.
            if (g_bnetAuthFailureTraceArmed144.load(std::memory_order_acquire))
                DisarmBNetAuthFailureTraceProbe144("safe_mode_no_int3");
            const bool interesting = call <= 3u || guardSeen || stateChanged;
            if (interesting)
            {
                InternalLog("[AUTH-GATE-RUNTIME144] pump call=%u stateObject=%p state=%s%u->%s%u guardSeen=%s guardResult=%s branch=%s tokenHeader={out=%p buffer=%p lengthLike=%llu meta=0x%llX}; stock state untouched\r\n",
                    call, stateObject,
                    beforeOk ? "" : "UNREADABLE/", beforeOk ? beforeState : 0u,
                    afterOk ? "" : "UNREADABLE/", afterOk ? afterState : 0u,
                    guardSeen ? "yes" : "no", guardSeen ? (guardResult ? "TRUE" : "FALSE") : "n/a",
                    branch,
                    reinterpret_cast<void*>(g_bnetFirstStateGuardOutInPump),
                    reinterpret_cast<void*>(g_bnetFirstStateGuardBufferInPump),
                    static_cast<unsigned long long>(g_bnetFirstStateGuardLengthInPump),
                    static_cast<unsigned long long>(g_bnetFirstStateGuardMetaInPump));
                ServerEmuAppend(L"auth_gate_runtime.log",
                    "[AUTH-GATE-RUNTIME144] pump call=%u stateObject=%p before=%s%u after=%s%u guardSeen=%s guardResult=%s branch=%s guardArg0=0x%llX tokenOut=%p tokenBuffer=%p tokenLengthLike=%llu tokenMeta=0x%llX contents=REDACTED mode=CALL_ORIGINAL_UNCHANGED\r\n",
                    call, stateObject,
                    beforeOk ? "" : "UNREADABLE/", beforeOk ? beforeState : 0u,
                    afterOk ? "" : "UNREADABLE/", afterOk ? afterState : 0u,
                    guardSeen ? "yes" : "no", guardSeen ? (guardResult ? "TRUE" : "FALSE") : "n/a",
                    branch,
                    static_cast<unsigned long long>(g_bnetFirstStateGuardArg0InPump),
                    reinterpret_cast<void*>(g_bnetFirstStateGuardOutInPump),
                    reinterpret_cast<void*>(g_bnetFirstStateGuardBufferInPump),
                    static_cast<unsigned long long>(g_bnetFirstStateGuardLengthInPump),
                    static_cast<unsigned long long>(g_bnetFirstStateGuardMetaInPump));
            }
        }

        if (g_bnetFirstStatePumpDepth)
            --g_bnetFirstStatePumpDepth;
    }

    void InstallBNetFirstStateRuntimeObservers144() noexcept
    {
        if (g_bnetRuntimeObserversInstalled.load(std::memory_order_acquire))
            return;

        // Do not prepare/arm the exact auth-failure INT3 observer. The previous
        // probe caused a stock fatal-error path while its breakpoints were live.
        // All runtime auth observation below remains read-only / MinHook based.

        const unsigned attempt = ++g_bnetRuntimeObserverInstallAttempts;
        if (attempt > 12u)
            return;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        const bool dpapiReady = InstallBNetCryptUnprotectObserver144();

        if (kServerEmuProductionRuntimeV92)
        {
            g_bnetRuntimeObserversInstalled.store(dpapiReady, std::memory_order_release);
            InternalLog("[V94-PRODUCTION] BNet minimal bootstrap dpapi=%s syntheticLocalWebToken=%s guard/pump/fence observers=off stateForcing=OFF\r\n",
                dpapiReady ? "ready" : "not-ready", BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled");
            return;
        }

        // Hook the guard first. ACCOUNT_STATE has already been consumed but the
        // WEB_TOKEN guard has not normally executed yet, so this ordering catches
        // the first meaningful decision even if the pump hook takes longer to arm.
        const bool guardReady = InstallBNetGameObserverHook144(
            d.BNetFirstStatePumpGuard,
            reinterpret_cast<void*>(&BNetFirstStatePumpGuardObserver144),
            g_bnetFirstStatePumpGuardOriginal,
            "BNet first-state WEB_TOKEN guard");
        const bool pumpReady = InstallBNetGameObserverHook144(
            d.BNetFirstStatePumpCandidate,
            reinterpret_cast<void*>(&BNetFirstStatePumpObserver144),
            g_bnetFirstStatePumpOriginal,
            "BNet first-state pump");

        if (guardReady && pumpReady)
            g_bnetRuntimeObserversInstalled.store(true, std::memory_order_release);

        InternalLog("[AUTH-GATE-RUNTIME144] install attempt=%u guard=%s pump=%s dpapi=%s ready=%s bnetGuardForce=OFF_V62 dwBdLoginStatusForce=OFF nativeLoginTrace=ON failtrace=DISABLED_SAFE_MODE_NO_INT3 localSyntheticDPAPI=%s; fences/LUI untouched\r\n",
            attempt, guardReady ? "yes" : "no", pumpReady ? "yes" : "no", dpapiReady ? "yes" : "no",
            (guardReady && pumpReady) ? "YES" : "NO", BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled");
        ServerEmuAppend(L"auth_gate_runtime.log",
            "[AUTH-GATE-RUNTIME144] install attempt=%u guard=%s pump=%s dpapi=%s ready=%s bnetMode=STOCK_V62 dwBdLoginStatusForce=OFF nativeLoginTrace=ON synthetic=%s scope=NATIVE_TRACE_ONLY\r\n",
            attempt, guardReady ? "yes" : "no", pumpReady ? "yes" : "no", dpapiReady ? "yes" : "no",
            (guardReady && pumpReady) ? "YES" : "NO", BNetSyntheticWebTokenLocalOnly144() ? "enabled" : "disabled");

        // Arm V59 here, during ACCOUNT_STATE/WEB_TOKEN setup, so the registration
        // owner is observed before BGS authentication advances firstState to 2.
        // Installing only from the later prerequisite sampler could miss the one-time
        // callback-registration pass entirely.
        InstallBNetFenceRegistrationOwnerObserverV59();
        InstallBNetFenceEventRegistrationObserversV60();
        // V62 static ancestry is queued only after stock firstState reaches 2 so
        // the V60 exact event-key/registration proof is already materialized.
    }


    void LogBNetNativePrereqBytesV51(const char* label, std::uintptr_t rva,
        std::size_t before, std::size_t after) noexcept
    {
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!label || !base || !size || !rva || rva >= size)
            return;

        const std::uintptr_t startRva = rva > before ? rva - before : 0u;
        const std::uintptr_t endRva = (std::min)(static_cast<std::uintptr_t>(size), rva + after);
        char hex[1536]{};
        std::size_t used = 0;
        bool readable = true;
        for (std::uintptr_t cur = startRva; cur < endRva && used + 5u < ArrayCount(hex); ++cur)
        {
            unsigned char byte = 0;
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + cur), byte))
            {
                readable = false;
                used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used,
                    _TRUNCATE, "?? "));
                continue;
            }
            used += static_cast<std::size_t>(_snprintf_s(hex + used, ArrayCount(hex) - used,
                _TRUNCATE, "%02X ", static_cast<unsigned>(byte)));
        }

        InternalLog("[BNET-NATIVE-PREREQ-V51] CODE label=%s rva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label, static_cast<unsigned long long>(rva), static_cast<unsigned long long>(startRva),
            readable ? "yes" : "partial", hex);
        ServerEmuAppend(L"bnet_native_prereq_v51.log",
            "[BNET-NATIVE-PREREQ-V51] CODE label=%s rva=0x%llX startRva=0x%llX readable=%s bytes={%s}\r\n",
            label, static_cast<unsigned long long>(rva), static_cast<unsigned long long>(startRva),
            readable ? "yes" : "partial", hex);
    }

    bool DecodeDirectCallTargetV51(std::uintptr_t callRva, std::uintptr_t& targetRva) noexcept
    {
        targetRva = 0;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size || !callRva || callRva + 5u > size)
            return false;

        unsigned char opcode = 0;
        if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + callRva), opcode) || opcode != 0xE8u)
            return false;
        std::uint32_t rawRel = 0;
        if (!ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + callRva + 1u), rawRel))
            return false;
        const std::int32_t rel = static_cast<std::int32_t>(rawRel);
        const std::intptr_t target = static_cast<std::intptr_t>(callRva) + 5 + static_cast<std::intptr_t>(rel);
        if (target < 0 || static_cast<std::uintptr_t>(target) >= size)
            return false;
        targetRva = static_cast<std::uintptr_t>(target);
        return true;
    }

    void TraceBNetNativePrereqV51() noexcept
    {
        static std::atomic_bool traced{ false };
        bool expected = false;
        if (!traced.compare_exchange_strong(expected, true, std::memory_order_acq_rel))
            return;

        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        std::uint32_t firstState = 0;
        unsigned char prereq = 0;
        unsigned char prereqInit = 0;
        const bool firstOk = d.BNetFirstStateValue < size &&
            ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetFirstStateValue), firstState);
        const bool prereqOk = d.BNetPrereqBoolValue < size &&
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqBoolValue), prereq);
        const bool prereqInitOk = d.BNetPrereqInitFlag < size &&
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqInitFlag), prereqInit);

        InternalLog("[BNET-NATIVE-PREREQ-V51] BEGIN firstState=%s%u prereq=%s%u prereqInit=%s%u goal=work_backwards_from_first_native_gate_after_state2 mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
            prereqOk ? "" : "UNREADABLE/", prereqOk ? static_cast<unsigned>(prereq) : 0u,
            prereqInitOk ? "" : "UNREADABLE/", prereqInitOk ? static_cast<unsigned>(prereqInit) : 0u);
        ServerEmuAppend(L"bnet_native_prereq_v51.log",
            "\r\n[BNET-NATIVE-PREREQ-V51] BEGIN firstState=%s%u prereq=%s%u prereqInit=%s%u valueRva=0x%llX initRva=0x%llX goal=trace_writer_then_upstream_server_event mode=STATIC_READ_ONLY no_hooks=yes no_state_writes=yes\r\n",
            firstOk ? "" : "UNREADABLE/", firstOk ? firstState : 0u,
            prereqOk ? "" : "UNREADABLE/", prereqOk ? static_cast<unsigned>(prereq) : 0u,
            prereqInitOk ? "" : "UNREADABLE/", prereqInitOk ? static_cast<unsigned>(prereqInit) : 0u,
            static_cast<unsigned long long>(d.BNetPrereqBoolValue),
            static_cast<unsigned long long>(d.BNetPrereqInitFlag));

        struct Point
        {
            const char* label;
            std::uintptr_t rva;
            std::size_t before;
            std::size_t after;
        };

        const Point points[] =
        {
            { "prereq_getter", d.BNetSignInPrereqBool, 8u, 48u },
            { "prereq_init_getter", d.BNetSignInPrereqInit, 8u, 48u },
            { "prereq_pump_1", d.BNetPrereqPumpCandidate, 16u, 128u },
            { "prereq_value_writer", d.BNetPrereqValueWriteXref1, 32u, 64u },
            { "prereq_pump_2", d.BNetPrereqPumpCandidate2, 16u, 128u },
            { "prereq_init_writer_1", d.BNetPrereqInitWriteXref1, 32u, 64u },
            { "prereq_init_writer_2", d.BNetPrereqInitWriteXref2, 32u, 64u },
            { "auth_cluster_call_prereq_pump_1", d.BNetAuthClusterCallPrereqPump, 40u, 64u },
            { "auth_cluster_call_prereq_pump_2", d.BNetAuthClusterCallPrereqPump2, 40u, 64u },
            { "auth_result_handler", d.BNetAuthResultHandlerEntry, 0u, 160u },
            { "auth_flag7_load", d.BNetAuthFlag7Load, 48u, 112u },
            { "auth_flag7_test", d.BNetAuthFlag7Test, 24u, 64u },
            { "auth_flag7_absent_branch", d.BNetAuthFlag7AbsentBranch, 24u, 80u },
            { "auth_flag7_absent_helper_call", d.BNetAuthFlag7AbsentHelperCall, 48u, 80u },
            { "auth_success_state2_writer", d.BNetAuthSuccessState2Writer, 32u, 64u },
        };

        for (const auto& point : points)
        {
            if (!point.rva || point.rva >= size)
                continue;
            std::uintptr_t functionBegin = 0;
            std::uintptr_t functionEnd = 0;
            const bool bounded = RuntimeFunctionBounds144(base + point.rva, functionBegin, functionEnd);
            InternalLog("[BNET-NATIVE-PREREQ-V51] POINT label=%s rva=0x%llX function=%s0x%llX..%s0x%llX unwind=%s\r\n",
                point.label, static_cast<unsigned long long>(point.rva),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0u),
                bounded ? "yes" : "no");
            ServerEmuAppend(L"bnet_native_prereq_v51.log",
                "[BNET-NATIVE-PREREQ-V51] POINT label=%s rva=0x%llX functionBeginRva=%s0x%llX functionEndRva=%s0x%llX unwind=%s\r\n",
                point.label, static_cast<unsigned long long>(point.rva),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionBegin - base : 0u),
                bounded ? "" : "n/a-", static_cast<unsigned long long>(bounded ? functionEnd - base : 0u),
                bounded ? "yes" : "no");
            LogBNetNativePrereqBytesV51(point.label, point.rva, point.before, point.after);
        }

        const std::uintptr_t callsites[] =
        {
            d.BNetAuthClusterCallPrereqPump,
            d.BNetAuthClusterCallPrereqPump2,
            d.BNetAuthFlag7AbsentHelperCall,
        };
        const char* callLabels[] =
        {
            "auth_cluster_to_prereq_pump_1",
            "auth_cluster_to_prereq_pump_2",
            "flag7_absent_to_helper",
        };
        for (unsigned i = 0; i < ArrayCount(callsites); ++i)
        {
            std::uintptr_t targetRva = 0;
            const bool decoded = DecodeDirectCallTargetV51(callsites[i], targetRva);
            InternalLog("[BNET-NATIVE-PREREQ-V51] CALL label=%s callRva=0x%llX target=%s0x%llX expected=%s0x%llX match=%s\r\n",
                callLabels[i], static_cast<unsigned long long>(callsites[i]),
                decoded ? "" : "n/a-", static_cast<unsigned long long>(decoded ? targetRva : 0u),
                "", static_cast<unsigned long long>(i == 0 ? d.BNetPrereqPumpCandidate :
                    (i == 1 ? d.BNetPrereqPumpCandidate2 : d.BNetAuthFlag7AbsentHelperTarget)),
                decoded && targetRva == (i == 0 ? d.BNetPrereqPumpCandidate :
                    (i == 1 ? d.BNetPrereqPumpCandidate2 : d.BNetAuthFlag7AbsentHelperTarget)) ? "YES" : "NO");
        }

        // Decode the known prereq value writer just enough to identify whether
        // it is an immediate or register-backed RIP-relative store. This does
        // not execute or alter the writer.
        if (d.BNetPrereqValueWriteXref1 && d.BNetPrereqValueWriteXref1 + 10u < size)
        {
            unsigned char b0 = 0, b1 = 0;
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqValueWriteXref1), b0);
            ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqValueWriteXref1 + 1u), b1);
            const char* form = "unknown";
            std::size_t dispOff = 0;
            std::size_t length = 0;
            int immediate = -1;
            if (b0 == 0x88u && (b1 & 0xC7u) == 0x05u)
            {
                form = "MOV_BYTE_RIP_REG";
                dispOff = 2u;
                length = 6u;
            }
            else if (b0 == 0xC6u && (b1 & 0xC7u) == 0x05u)
            {
                form = "MOV_BYTE_RIP_IMM";
                dispOff = 2u;
                length = 7u;
                unsigned char imm = 0;
                if (ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetPrereqValueWriteXref1 + 6u), imm))
                    immediate = static_cast<int>(imm);
            }
            else if (b0 == 0x89u && (b1 & 0xC7u) == 0x05u)
            {
                form = "MOV_DWORD_RIP_REG";
                dispOff = 2u;
                length = 6u;
            }

            std::uintptr_t targetRva = 0;
            if (length && dispOff)
            {
                std::uint32_t rawDisp = 0;
                if (ServerEmuSafeReadU32(reinterpret_cast<const void*>(base + d.BNetPrereqValueWriteXref1 + dispOff), rawDisp))
                {
                    const std::int32_t disp = static_cast<std::int32_t>(rawDisp);
                    const std::intptr_t target = static_cast<std::intptr_t>(d.BNetPrereqValueWriteXref1) +
                        static_cast<std::intptr_t>(length) + static_cast<std::intptr_t>(disp);
                    if (target >= 0 && static_cast<std::uintptr_t>(target) < size)
                        targetRva = static_cast<std::uintptr_t>(target);
                }
            }
            InternalLog("[BNET-NATIVE-PREREQ-V51] WRITER_DECODE rva=0x%llX form=%s targetRva=%s0x%llX expectedValueRva=0x%llX targetMatch=%s immediate=%d\r\n",
                static_cast<unsigned long long>(d.BNetPrereqValueWriteXref1), form,
                targetRva ? "" : "n/a-", static_cast<unsigned long long>(targetRva),
                static_cast<unsigned long long>(d.BNetPrereqBoolValue),
                targetRva && targetRva == d.BNetPrereqBoolValue ? "YES" : "NO", immediate);
            ServerEmuAppend(L"bnet_native_prereq_v51.log",
                "[BNET-NATIVE-PREREQ-V51] WRITER_DECODE rva=0x%llX form=%s targetRva=%s0x%llX expectedValueRva=0x%llX targetMatch=%s immediate=%d\r\n",
                static_cast<unsigned long long>(d.BNetPrereqValueWriteXref1), form,
                targetRva ? "" : "n/a-", static_cast<unsigned long long>(targetRva),
                static_cast<unsigned long long>(d.BNetPrereqBoolValue),
                targetRva && targetRva == d.BNetPrereqBoolValue ? "YES" : "NO", immediate);
        }

        // The materialized AuthenticationListener result callback has a proven
        // presence-bit gate: MOV EAX,[RSI+0x10] -> SHR EAX,7 -> TEST AL,1.
        // Record whether the bytes are still present in this run so the next
        // step can map that native presence bit back to the exact backend field.
        unsigned char flagBytes[12]{};
        bool flagReadable = true;
        for (unsigned i = 0; i < ArrayCount(flagBytes); ++i)
        {
            if (!ServerEmuSafeReadU8(reinterpret_cast<const void*>(base + d.BNetAuthFlag7Load + i), flagBytes[i]))
            {
                flagReadable = false;
                break;
            }
        }
        const bool flagPattern = flagReadable &&
            flagBytes[0] == 0x8Bu && flagBytes[1] == 0x46u && flagBytes[2] == 0x10u &&
            flagBytes[3] == 0xC1u && flagBytes[4] == 0xE8u && flagBytes[5] == 0x07u &&
            (flagBytes[6] == 0xA8u || flagBytes[6] == 0xF6u);
        InternalLog("[BNET-NATIVE-PREREQ-V51] FLAG7_GATE loadRva=0x%llX testRva=0x%llX absentBranchRva=0x%llX helperCallRva=0x%llX bytesMatch=%s semantics=presence_bit7_controls_absent_helper_path no_state_writes=yes\r\n",
            static_cast<unsigned long long>(d.BNetAuthFlag7Load),
            static_cast<unsigned long long>(d.BNetAuthFlag7Test),
            static_cast<unsigned long long>(d.BNetAuthFlag7AbsentBranch),
            static_cast<unsigned long long>(d.BNetAuthFlag7AbsentHelperCall),
            flagPattern ? "YES" : "NO/PROTECTED_OR_CHANGED");
        ServerEmuAppend(L"bnet_native_prereq_v51.log",
            "[BNET-NATIVE-PREREQ-V51] FLAG7_GATE loadRva=0x%llX testRva=0x%llX absentBranchRva=0x%llX helperCallRva=0x%llX bytesMatch=%s semantics=presence_bit7_controls_absent_helper_path no_state_writes=yes\r\n",
