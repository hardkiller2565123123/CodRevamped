        InternalLog("[BNET-FENCE-REG-V58] SUMMARY targetRefs=%u adapterRefs=%u registrationOwners=%u ownerCalls=%u incomingOwnerEdges=%u incomingPostFenceRefs=%u unreadableTextChunks=%u v57AdapterCalls=%u next=%s output=bnet_fence_registration_v58.log no_state_writes=yes\r\n",
