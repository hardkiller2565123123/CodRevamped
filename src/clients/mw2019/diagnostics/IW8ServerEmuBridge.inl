        static std::uintptr_t lastTask=~std::uintptr_t(0);
        const auto task=V97ReadSlot7Task144();
        if(task!=lastTask){
            ServerEmuTargetedAppend(L"v98_frontend_completion.log","[V98-TASK] SLOT7_CHANGE old=%p new=%p tableRva=0x%llX stateWrites=off\r\n",reinterpret_cast<void*>(lastTask==~std::uintptr_t(0)?0:lastTask),reinterpret_cast<void*>(task),(unsigned long long)(kDwIngressObjectTableRva144+7ull*sizeof(std::uintptr_t)));
            lastTask=task; V98LogTaskCompact144("SLOT7_CHANGE");
