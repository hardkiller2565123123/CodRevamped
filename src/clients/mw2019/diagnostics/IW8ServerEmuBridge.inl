    void DumpBNetAuthFailureContext144(const CONTEXT* context) noexcept
    {
        if (!context)
            return;
        const auto base = MainImageBase();
        const auto size = MainImageSize();
        if (!base || !size)
            return;

        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        const auto start = d.BNetAuthFailureTraceWindowStart;
        const auto end = (std::min)(d.BNetAuthFailureTraceWindowEnd, static_cast<std::uintptr_t>(size));
        if (!start || start >= end)
            return;

        InternalLog("[AUTH-GATE-FAILTRACE144] CONTEXT_DUMP window=0x%llX..0x%llX errorWriter=0x%llX state3Writer=0x%llX expectedError=0x%08X\r\n",
            static_cast<unsigned long long>(start), static_cast<unsigned long long>(end),
            static_cast<unsigned long long>(d.BNetAuthFailureErrorWriter),
            static_cast<unsigned long long>(d.BNetAuthFailureState3Writer), d.BNetAuthFailureErrorCode);
        ServerEmuAppend(L"auth_gate_failure_trace.log",
            "[AUTH-GATE-FAILTRACE144] CONTEXT_DUMP window=0x%llX..0x%llX errorWriter=0x%llX state3Writer=0x%llX expectedError=0x%08X\r\n",
            static_cast<unsigned long long>(start), static_cast<unsigned long long>(end),
            static_cast<unsigned long long>(d.BNetAuthFailureErrorWriter),
            static_cast<unsigned long long>(d.BNetAuthFailureState3Writer), d.BNetAuthFailureErrorCode);

        // Dump the whole local auth-result block in bounded chunks. This gives the
        // next analysis pass enough bytes to recover the predecessor TEST/Jcc/CALL
        // chain without widening instrumentation to unknown code addresses.
        for (std::uintptr_t rva = start; rva < end; rva += 64u)
        {
            const std::size_t count = static_cast<std::size_t>((std::min)(static_cast<std::uintptr_t>(64u), end - rva));
            BYTE bytes[64]{};
            bool ok = false;
            __try
            {
                memcpy(bytes, reinterpret_cast<const void*>(base + rva), count);
                ok = true;
            }
            __except (EXCEPTION_EXECUTE_HANDLER)
            {
                ok = false;
            }
            char hex[64 * 3 + 1]{};
            if (ok)
            {
                std::size_t used = 0;
                for (std::size_t i = 0; i < count && used + 4u < sizeof(hex); ++i)
                    used += static_cast<std::size_t>(_snprintf_s(hex + used, sizeof(hex) - used, _TRUNCATE,
                        "%02X%s", static_cast<unsigned>(bytes[i]), i + 1u == count ? "" : " "));
            }
            else
            {
                strcpy_s(hex, "<unreadable>");
            }
            InternalLog("[AUTH-GATE-FAILTRACE144] CODE rva=0x%llX bytes=%s\r\n",
                static_cast<unsigned long long>(rva), hex);
            ServerEmuAppend(L"auth_gate_failure_trace.log",
                "[AUTH-GATE-FAILTRACE144] CODE rva=0x%llX bytes=%s\r\n",
                static_cast<unsigned long long>(rva), hex);
        }

        // Raw control-flow inventory only: no breakpoint is placed on these
        // pattern hits because this intentionally avoids treating bytes inside an
        // immediate as an instruction boundary. The wide byte dump above is the
        // authoritative source for the next decoder pass.
        unsigned cfHits = 0;
        const auto* bytes = reinterpret_cast<const BYTE*>(base + start);
        const std::size_t span = static_cast<std::size_t>(end - start);
        __try
        {
            for (std::size_t i = 0; i < span && cfHits < 96u; ++i)
            {
                const auto opRva = start + i;
                const BYTE op = bytes[i];
                const char* kind = nullptr;
                std::uintptr_t target = 0;
                unsigned length = 0;
                if ((op == 0xE8 || op == 0xE9) && i + 5u <= span)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, bytes + i + 1u, sizeof(rel));
                    length = 5u;
                    target = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(opRva + length) + rel);
                    kind = op == 0xE8 ? "CALL_REL32" : "JMP_REL32";
                }
                else if (op == 0xEB && i + 2u <= span)
                {
                    const auto rel = static_cast<std::int8_t>(bytes[i + 1u]);
                    length = 2u;
                    target = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(opRva + length) + rel);
                    kind = "JMP_REL8";
                }
                else if (op >= 0x70 && op <= 0x7F && i + 2u <= span)
                {
                    const auto rel = static_cast<std::int8_t>(bytes[i + 1u]);
                    length = 2u;
                    target = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(opRva + length) + rel);
                    kind = "JCC_REL8";
                }
                else if (op == 0x0F && i + 6u <= span && bytes[i + 1u] >= 0x80 && bytes[i + 1u] <= 0x8F)
                {
                    std::int32_t rel = 0;
                    memcpy(&rel, bytes + i + 2u, sizeof(rel));
                    length = 6u;
                    target = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(opRva + length) + rel);
                    kind = "JCC_REL32";
                }
                if (!kind || target >= size)
                    continue;
                ++cfHits;
                ServerEmuAppend(L"auth_gate_failure_trace.log",
                    "[AUTH-GATE-FAILTRACE144] RAW_CF_CANDIDATE hit=%u kind=%s instructionRva=0x%llX targetRva=0x%llX fallthroughRva=0x%llX boundary_unverified=yes\r\n",
                    cfHits, kind, static_cast<unsigned long long>(opRva),
                    static_cast<unsigned long long>(target), static_cast<unsigned long long>(opRva + length));
            }
        }
        __except (EXCEPTION_EXECUTE_HANDLER)
        {
            ServerEmuAppend(L"auth_gate_failure_trace.log",
                "[AUTH-GATE-FAILTRACE144] RAW_CF_CANDIDATE scan aborted unreadable=yes\r\n");
        }

        unsigned stackHits = 0;
        for (unsigned i = 0; i < 48u && stackHits < 20u; ++i)
        {
            std::uintptr_t value = 0;
            if (!ServerEmuSafeReadPointer(reinterpret_cast<const void*>(context->Rsp + static_cast<std::uintptr_t>(i) * sizeof(std::uintptr_t)), value))
                continue;
            if (value < base || value >= base + size)
                continue;
            ++stackHits;
            InternalLog("[AUTH-GATE-FAILTRACE144] STACK_CODEPTR slot=%u value=%p rva=0x%llX\r\n",
                i, reinterpret_cast<void*>(value), static_cast<unsigned long long>(value - base));
            ServerEmuAppend(L"auth_gate_failure_trace.log",
                "[AUTH-GATE-FAILTRACE144] STACK_CODEPTR slot=%u rva=0x%llX\r\n",
                i, static_cast<unsigned long long>(value - base));
        }
    }

    void DisarmBNetAuthFailureTraceProbe144(const char* reason) noexcept
    {
        for (auto& bp : g_bnetAuthFailureTraceBreakpoints144)
        {
            if (bp.prepared && bp.armed)
            {
                ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.instruction), bp.originalByte);
                bp.armed = false;
            }
        }
        g_bnetAuthFailureTraceArmed144.store(false, std::memory_order_release);
        InternalLog("[AUTH-GATE-FAILTRACE144] DISARM reason=%s\r\n", reason ? reason : "<unknown>");
        ServerEmuAppend(L"auth_gate_failure_trace.log",
            "[AUTH-GATE-FAILTRACE144] DISARM reason=%s\r\n", reason ? reason : "<unknown>");
    }

    LONG CALLBACK BNetAuthFailureTraceVeh144(EXCEPTION_POINTERS* info) noexcept
    {
        if (!info || !info->ExceptionRecord || !info->ContextRecord ||
            !g_bnetAuthFailureTraceArmed144.load(std::memory_order_acquire))
            return EXCEPTION_CONTINUE_SEARCH;

        CONTEXT* context = info->ContextRecord;
        const DWORD code = info->ExceptionRecord->ExceptionCode;
        if (code == EXCEPTION_BREAKPOINT)
        {
            const auto exceptionAddress = reinterpret_cast<std::uintptr_t>(info->ExceptionRecord->ExceptionAddress);
            for (int i = 0; i < static_cast<int>(ArrayCount(g_bnetAuthFailureTraceBreakpoints144)); ++i)
            {
                auto& bp = g_bnetAuthFailureTraceBreakpoints144[i];
                if (!bp.prepared || !bp.armed || exceptionAddress != bp.instruction)
                    continue;

                if (!ServerEmuPatchCodeByte144(reinterpret_cast<void*>(bp.instruction), bp.originalByte))
                    return EXCEPTION_CONTINUE_SEARCH;
                bp.armed = false;

                const unsigned hit = ++g_bnetAuthFailureTraceHits144;
                const auto snap = CaptureBNetAuthFailureSnapshot144();
                InternalLog("[AUTH-GATE-FAILTRACE144] BREAK hit=%u index=%d label=%s rva=0x%llX elapsedMs=%llu\r\n",
                    hit, i, bp.label ? bp.label : "<unknown>", static_cast<unsigned long long>(bp.instructionRva),
                    static_cast<unsigned long long>(GetTickCount64() - g_bnetAuthFailureTraceArmTick144));
                LogBNetAuthFailureSnapshot144("BEFORE", bp.label, bp.instructionRva, context, snap);

                const auto& d = iw8_addresses::MW2019_1_44_Discovery;
                if (bp.instructionRva == d.BNetAuthFailureErrorWriter)
                {
                    InternalLog("[AUTH-GATE-FAILTRACE144] FAILURE_ENTRY exactErrorWriter=0x%llX expectedError=0x%08X; dumping predecessor window + stack\r\n",
                        static_cast<unsigned long long>(d.BNetAuthFailureErrorWriter), d.BNetAuthFailureErrorCode);
                    ServerEmuAppend(L"auth_gate_failure_trace.log",
                        "[AUTH-GATE-FAILTRACE144] FAILURE_ENTRY exactErrorWriter=0x%llX expectedError=0x%08X\r\n",
                        static_cast<unsigned long long>(d.BNetAuthFailureErrorWriter), d.BNetAuthFailureErrorCode);
                    DumpBNetAuthFailureContext144(context);
                }

                g_bnetAuthFailureTracePendingStep144 = i;
                context->Rip = bp.instruction;
                context->EFlags |= 0x100u;
                return EXCEPTION_CONTINUE_EXECUTION;
            }
        }
        else if (code == EXCEPTION_SINGLE_STEP && g_bnetAuthFailureTracePendingStep144 >= 0)
        {
            const int i = g_bnetAuthFailureTracePendingStep144;
            g_bnetAuthFailureTracePendingStep144 = -1;
            if (i >= 0 && i < static_cast<int>(ArrayCount(g_bnetAuthFailureTraceBreakpoints144)))
            {
                auto& bp = g_bnetAuthFailureTraceBreakpoints144[i];
                const auto snap = CaptureBNetAuthFailureSnapshot144();
                LogBNetAuthFailureSnapshot144("AFTER", bp.label, bp.instructionRva, context, snap);

                const auto& d = iw8_addresses::MW2019_1_44_Discovery;
                if (bp.instructionRva == d.BNetAuthFailureErrorWriter && snap.errorOk)
                {
                    InternalLog("[AUTH-GATE-FAILTRACE144] ERROR_WRITE_COMPLETE stored=0x%08X expected=0x%08X match=%s nextRip=0x%llX\r\n",
                        snap.errorCode, d.BNetAuthFailureErrorCode,
                        snap.errorCode == d.BNetAuthFailureErrorCode ? "yes" : "no",
                        static_cast<unsigned long long>(context->Rip));
                    ServerEmuAppend(L"auth_gate_failure_trace.log",
                        "[AUTH-GATE-FAILTRACE144] ERROR_WRITE_COMPLETE stored=0x%08X expected=0x%08X match=%s nextRip=0x%llX\r\n",
                        snap.errorCode, d.BNetAuthFailureErrorCode,
                        snap.errorCode == d.BNetAuthFailureErrorCode ? "yes" : "no",
                        static_cast<unsigned long long>(context->Rip));
                }
                if (bp.instructionRva == d.BNetAuthFailureState3Writer)
                {
                    const bool target = snap.stateOk && snap.state == 3u;
                    InternalLog("[AUTH-GATE-FAILTRACE144] STATE3_WRITE_COMPLETE state=%s%u target=%s\r\n",
                        snap.stateOk ? "" : "UNREADABLE/", snap.stateOk ? snap.state : 0u, target ? "yes" : "no");
                    ServerEmuAppend(L"auth_gate_failure_trace.log",
                        "[AUTH-GATE-FAILTRACE144] STATE3_WRITE_COMPLETE state=%s%u target=%s\r\n",
                        snap.stateOk ? "" : "UNREADABLE/", snap.stateOk ? snap.state : 0u, target ? "yes" : "no");
                    DisarmBNetAuthFailureTraceProbe144(target ? "captured_stock_1_to_3_failure" : "state3_writer_completed_unexpected_value");
                }
            }
            context->EFlags &= ~0x100u;
            return EXCEPTION_CONTINUE_EXECUTION;
        }
        return EXCEPTION_CONTINUE_SEARCH;
    }

    void PrepareBNetAuthFailureTraceProbe144() noexcept
    {
        bool expected = false;
        if (!g_bnetAuthFailureTracePrepared144.compare_exchange_strong(expected, true))
            return;

        HMODULE game = GetModuleHandleW(nullptr);
        if (!game)
        {
            g_bnetAuthFailureTracePrepared144.store(false, std::memory_order_release);
            return;
        }
        const auto base = reinterpret_cast<std::uintptr_t>(game);
        const auto size = MainImageSize();
        const auto& d = iw8_addresses::MW2019_1_44_Discovery;
        struct Candidate { const char* label; std::uintptr_t rva; BYTE expected; };
        const Candidate candidates[] = {
            { "result_init_1B8", d.BNetAuthResultInitByteWriter, 0xC6 },
            { "result_init_1BC", d.BNetAuthResultInitDwordWriter, 0x89 },
            { "result_init_1C0", d.BNetAuthResultInitQwordWriter, 0x48 },
            { "failure_error_7FFFFF03", d.BNetAuthFailureErrorWriter, 0xC7 },
            { "failure_state_3", d.BNetAuthFailureState3Writer, 0xC7 },
        };

        unsigned prepared = 0;
        for (unsigned i = 0; i < ArrayCount(candidates); ++i)
        {
