<Window x:Class="CodRevamped.IW8Tools.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodRevamped.IW8Tools"
 Title="CodRevamped | IW8 Radiant Map Tools" Width="1660" Height="960" MinWidth="1100" MinHeight="680"
 Background="#11151D" Foreground="White" AllowDrop="True" Drop="Window_Drop">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#35444E"/>
   <Setter Property="Foreground" Value="#E6ECEF"/>
   <Setter Property="BorderBrush" Value="#536470"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#526E80"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#131D27"/>
   <Setter Property="Foreground" Value="#F0F4F6"/>
   <Setter Property="CaretBrush" Value="#F4CF7B"/>
   <Setter Property="BorderBrush" Value="#465B66"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,4"/>
   <Setter Property="Margin" Value="1,2"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top" Margin="4,0,4,5">
   <TextBlock Text="CODREVAMPED  /  IW8 TOOLS" FontWeight="Bold" FontSize="20" Foreground="#5ABCEC"/>
   <TextBlock Text="Replay 1.20 • authoring workspace • asset validation • native ZoneTool bridge" Foreground="#91A3B9" FontSize="13"/>
   <DockPanel Margin="0,6,0,0"><TextBlock Text="Unified native tools:" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="Browse" DockPanel.Dock="Right" Click="BrowseNativeTools_Click"/><TextBox Name="NativeToolsPath" MinWidth="500" ToolTip="Built alongside IW8Tools into artifacts/tools/&lt;Config&gt;/IW8Tools/IW8Tools.Native.exe"/></DockPanel>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#1F2631" CornerRadius="8" Margin="0,4,0,0" Padding="6">
   <StackPanel>
    <TextBlock Text="ACTIVITY / VALIDATION" FontWeight="Bold" Foreground="#9CACBE" Margin="0,0,0,5"/>
    <TextBox Name="Output" FontFamily="Consolas" Height="87" IsReadOnly="True"
       Background="#151D28" BorderThickness="0" VerticalScrollBarVisibility="Auto"
       HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
   </StackPanel>
  </Border>
  <TabControl Background="#202633" BorderThickness="0" Foreground="White">
   <TabItem Header="Map editor" Name="MapEditorTab" PreviewKeyDown="MapEditor_PreviewKeyDown">
    <DockPanel Margin="3" LastChildFill="True">
      <Border DockPanel.Dock="Top" Background="#222A31" BorderBrush="#394651" BorderThickness="0,0,0,1" Padding="5" Margin="0,0,0,6">
       <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="IW8 RADIANT" FontWeight="Bold" Foreground="#F2C264" VerticalAlignment="Center" Margin="6,0,14,0"/>
        <Button Content="New" Click="NewMap_Click" ToolTip="Create map"/>
        <Button Content="Open" Click="OpenMap_Click" ToolTip="Open map project"/>
        <Button Content="Save" Click="SaveScene_Click" ToolTip="Ctrl+S"/>
        <Separator Margin="7,0" Width="1"/>
        <Button Content="Box" Click="AddBox_Click"/>
        <Button Content="Floor" Click="AddFloor_Click"/>
        <Button Content="Ramp" Click="AddRamp_Click"/>
        <Button Content="Cylinder" Click="AddCylinder_Click"/>
        <Button Content="Stairs" Click="AddStairs_Click"/>
        <Separator Margin="7,0" Width="1"/>
        <Button Content="Undo" Click="Undo_Click" ToolTip="Ctrl+Z"/>
        <Button Content="Redo" Click="Redo_Click" ToolTip="Ctrl+Y"/>
        <Button Content="Frame All" Click="FrameScene_Click" ToolTip="F"/>
        <Button Content="Snap" Click="SnapSelected_Click" ToolTip="Snap selected brush to grid"/>
        <Button Content="Export" Click="ExportGraybox_Click" ToolTip="Export native map source and collision"/>
        <TextBlock Text="  |  Left: select / drag  ·  Middle: pan or orbit  ·  Wheel: zoom" VerticalAlignment="Center" Foreground="#A9B6BC"/>
        <TextBlock Name="MapEditorCoordinates" Text="XY 0, 0, 0" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#F2C264" FontFamily="Consolas"/>
       </WrapPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" MinWidth="210"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="290"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="320" MinWidth="250"/>
       </Grid.ColumnDefinitions>
       <Grid Grid.Column="0" Background="#14191D">
        <Grid.RowDefinitions>
         <RowDefinition Height="*" MinHeight="110"/>
         <RowDefinition Height="5"/>
         <RowDefinition Height="*" MinHeight="100"/>
         <RowDefinition Height="5"/>
         <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#42505A" BorderThickness="1" Background="#10171B">
         <DockPanel>
          <Border DockPanel.Dock="Top" Background="#273039" Padding="6"><TextBlock Text="TOP  /  X Y" FontFamily="Consolas" FontWeight="Bold" Foreground="#DDE5E8"/></Border>
          <local:Radiant2DViewport x:Name="TopView" Plane="XY"/>
         </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#39444C"/>
        <Border Grid.Row="2" BorderBrush="#42505A" BorderThickness="1" Background="#10171B">
         <DockPanel>
          <Border DockPanel.Dock="Top" Background="#273039" Padding="6"><TextBlock Text="FRONT  /  X Z" FontFamily="Consolas" FontWeight="Bold" Foreground="#DDE5E8"/></Border>
          <local:Radiant2DViewport x:Name="FrontView" Plane="XZ"/>
         </DockPanel>
        </Border>
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#39444C"/>
        <Border Grid.Row="4" BorderBrush="#42505A" BorderThickness="1" Background="#10171B">
         <DockPanel>
          <Border DockPanel.Dock="Top" Background="#273039" Padding="6"><TextBlock Text="SIDE  /  Y Z" FontFamily="Consolas" FontWeight="Bold" Foreground="#DDE5E8"/></Border>
          <local:Radiant2DViewport x:Name="SideView" Plane="YZ"/>
         </DockPanel>
        </Border>
       </Grid>
       <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#39444C"/>
       <Border Grid.Column="2" Margin="4,0" Background="#212D36" BorderBrush="#46535E" BorderThickness="1">
        <Grid>
         <Viewport3D Name="SceneView" ClipToBounds="True" MouseWheel="SceneView_MouseWheel"
             MouseDown="SceneView_MouseDown" MouseUp="SceneView_MouseUp" MouseMove="SceneView_MouseMove"/>
         <Border Background="#CC202930" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7" Margin="8">
          <TextBlock Text="CAMERA  /  PERSPECTIVE" Foreground="#E7E9E7" FontWeight="Bold" FontFamily="Consolas"/>
         </Border>
         <Border Background="#D91B2229" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="7" Margin="8">
          <TextBlock Text="LMB Select  |  MMB Orbit  |  Wheel Zoom" Foreground="#A7BDC9" FontFamily="Consolas" FontSize="11"/>
         </Border>
        </Grid>
       </Border>
       <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#39444C"/>
       <Border Grid.Column="4" Background="#222A31" BorderBrush="#45515B" BorderThickness="1">
        <TabControl Background="#222A31" BorderThickness="0">
         <TabItem Header="Entities">
          <DockPanel>
         <Border DockPanel.Dock="Top" Background="#29333A" Padding="7" BorderThickness="0,0,0,1" BorderBrush="#45515B">
          <TextBlock Text="ENTITY  /  BRUSH  /  WORLD INSPECTOR" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F2C264"/>
         </Border>
     <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6,0,0,0">
      <StackPanel Margin="0,0,4,0">
      <TextBlock Text="WORKSPACE" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock Text="Map ID (mp_..., max 15 chars)"/>
      <TextBox Name="MapId" Text="mp_custom"/>
      <TextBlock Text="Map display title (Local Play)" Margin="0,6,0,0"/>
      <TextBox Name="MapTitle" Text="mp_custom"/>
      <TextBlock Text="Description"/>
      <TextBox Name="MapDescription" Text="CodRevamped authored test map"/>
      <TextBlock Text="Workspace folder"/>
      <TextBox Name="ProjectFolder" IsReadOnly="True"/>
      <WrapPanel><Button Content="New map" Click="NewMap_Click"/><Button Content="Open map" Click="OpenMap_Click"/></WrapPanel>
      <Button Content="Create enclosed TDM test arena" Click="CreateTestArena_Click" HorizontalAlignment="Left"/>
      <Separator Margin="0,12"/>
      <TextBlock Text="BLOCKOUT GEOMETRY" FontSize="15" FontWeight="Bold"/>
      <TextBlock Text="Objects" Foreground="#98AABE" Margin="0,5,0,3"/>
      <ListBox Name="Objects" Background="#18212C" Foreground="White" Height="125" BorderThickness="0" SelectionChanged="Objects_SelectionChanged"/>
      <TextBlock Text="SELECTED OBJECT • POSITION / DIMENSIONS" FontSize="12" FontWeight="Bold" Margin="0,7,0,3"/>
      <UniformGrid Columns="3">
       <StackPanel><TextBlock Text="X"/><TextBox Name="EditX" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Y"/><TextBox Name="EditY" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Z"/><TextBox Name="EditZ" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Width"/><TextBox Name="EditWidth" Text="4"/></StackPanel>
       <StackPanel><TextBlock Text="Length"/><TextBox Name="EditLength" Text="4"/></StackPanel>
       <StackPanel><TextBlock Text="Height"/><TextBox Name="EditHeight" Text="4"/></StackPanel>
      </UniformGrid>
      <WrapPanel>
       <TextBlock Text="Yaw (degrees)" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Name="EditYaw" Width="75" Text="0"/>
       <TextBlock Text="UV tile / units" VerticalAlignment="Center" Margin="8,0,8,0"/><TextBox Name="EditUVScale" Width="75" Text="128"/>
      </WrapPanel>
      <WrapPanel><Button Content="Apply transform" Click="ApplyTransform_Click"/><Button Content="Duplicate" Click="Duplicate_Click"/></WrapPanel>
      <WrapPanel><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/><Button Content="Frame scene" Click="FrameScene_Click"/></WrapPanel>
      <WrapPanel><TextBlock Text="Grid units" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox Name="GridStep" Width="60" Text="32" TextChanged="GridStep_TextChanged"/>
       <Button Content="Snap selected" Click="SnapSelected_Click"/>
       <Button Content="Rotate 90°" Click="Rotate90_Click"/>
      </WrapPanel>
      <WrapPanel><Button Content="Add floor" Click="AddFloor_Click"/><Button Content="Add box" Click="AddBox_Click"/>
      <Button Content="Add ramp" Click="AddRamp_Click"/><Button Content="Add cylinder" Click="AddCylinder_Click"/>
      <Button Content="Add stairs" Click="AddStairs_Click"/></WrapPanel>
      <Separator Margin="0,12"/>
      <TextBlock Text="GAMEPLAY / SPAWN POINTS" FontSize="15" FontWeight="Bold"/>
      <ListBox Name="Spawns" Background="#18212C" Foreground="White" Height="115" BorderThickness="0"
          SelectionChanged="Spawns_SelectionChanged"/>
      <ComboBox Name="SpawnType" SelectedIndex="1" Background="#273548" Foreground="White">
       <ComboBoxItem Content="Player start" Tag="info_player_start"/>
       <ComboBoxItem Content="TDM spawn" Tag="mp_tdm_spawn"/>
       <ComboBoxItem Content="Allies start" Tag="mp_tdm_spawn_allies_start"/>
       <ComboBoxItem Content="Axis start" Tag="mp_tdm_spawn_axis_start"/>
      </ComboBox>
      <UniformGrid Columns="4">
       <StackPanel><TextBlock Text="X"/><TextBox Name="SpawnX" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Y"/><TextBox Name="SpawnY" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Z"/><TextBox Name="SpawnZ" Text="96"/></StackPanel>
       <StackPanel><TextBlock Text="Yaw"/><TextBox Name="SpawnYaw" Text="0"/></StackPanel>
      </UniformGrid>
      <WrapPanel><Button Content="Add spawn" Click="AddSpawn_Click"/><Button Content="Apply spawn" Click="ApplySpawn_Click"/>
       <Button Content="Remove" Click="RemoveSpawn_Click"/><Button Content="Reset TDM" Click="ResetSpawns_Click"/></WrapPanel>
      <Separator Margin="0,12"/>
      <WrapPanel><Button Content="Remove selected" Click="Remove_Click"/><Button Content="Save &amp; export OBJ" Click="SaveScene_Click"/></WrapPanel>
      <TextBlock Text="WORLD SUNLIGHT" FontSize="15" FontWeight="Bold" Margin="0,8,0,2"/>
      <TextBlock Text="Intensity and direction (X,Y,Z)"/>
      <UniformGrid Columns="4">
       <StackPanel><TextBlock Text="Power"/><TextBox Name="SunIntensity" Text="1"/></StackPanel>
       <StackPanel><TextBlock Text="Sun X"/><TextBox Name="SunX" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Sun Y"/><TextBox Name="SunY" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="Sun Z"/><TextBox Name="SunZ" Text="-1"/></StackPanel>
      </UniformGrid>
      <Button Content="Save sunlight" Click="SaveLighting_Click" HorizontalAlignment="Left"/>
      <Button Content="Export native-source graybox + collision" Click="ExportGraybox_Click" Width="290" HorizontalAlignment="Left"/>
      <TextBlock Text="Before compiling: provide your own populated Replay 1.20 material + techset shader templates." TextWrapping="Wrap" Foreground="#F3CC84" Margin="0,10,4,0"/>
      <Button Content="Attach material + shader template" Click="AttachMaterial_Click" HorizontalAlignment="Left"/>
      <Button Content="Apply imported texture to map material" Click="UseTextureForMap_Click" HorizontalAlignment="Left"/>
      <Button Content="Check map source before build" Click="PreflightMap_Click" HorizontalAlignment="Left"/>
      <TextBlock Text="Graybox export writes Replay-shaped render, lighting, bounds, resident reflection sources and MWCOLL02 box collision. ZoneTool and live game validation are still required." TextWrapping="Wrap" Foreground="#88BACD" Margin="0,8,8,0"/>
      <TextBlock Text="OBJ is an authoring source, not a native GfxWorld. Native collision and validated shader/material data are required for compilation."
        TextWrapping="Wrap" Foreground="#A8B4C3" Margin="0,18,8,0"/>
      </StackPanel>
     </ScrollViewer>

          </DockPanel>
         </TabItem>
         <TabItem Header="Textures" Loaded="TextureTab_Loaded">
          <DockPanel Margin="8">
           <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MATERIAL / TEXTURE BROWSER" FontWeight="Bold" Foreground="#F2C264" Margin="0,6,0,8"/>
            <WrapPanel>
             <Button Content="Import texture" Click="Texture_Click"/>
             <Button Content="Refresh" Click="RefreshTextures_Click"/>
            </WrapPanel>
            <Button Content="Apply selected to map" Click="ApplySelectedTexture_Click" HorizontalAlignment="Stretch" Margin="0,6,0,6"/>
            <TextBlock Name="TextureSelection" Foreground="#A6B5BB" Text="Choose an imported source texture" TextWrapping="Wrap"/>
            <TextBlock Text="Color map uses the attached native 1.20 material + shader template. This list is not a native asset browser." Foreground="#D6BE87" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8"/>
           </StackPanel>
           <ListBox Name="TextureAssets" Background="#131D23" BorderThickness="0" Foreground="White" SelectionChanged="TextureAssets_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
             <DataTemplate>
              <StackPanel Margin="6" Width="112">
               <Border BorderThickness="1" BorderBrush="#46565D" Background="#0B1014" Padding="2">
                <Image Source="{Binding Preview}" Width="100" Height="100" Stretch="Uniform"/>
               </Border>
               <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
             </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
             <ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
           </ListBox>
          </DockPanel>
         </TabItem>
        </TabControl>
       </Border>
      </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="Build / deploy">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="25" MaxWidth="850" HorizontalAlignment="Left">
     <TextBlock Text="NATIVE FASTFILE BUILD" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
     <TextBlock Text="Prepared dump path (maps/mp/...render.json, materials, shaders, lighting, collision)"/>
     <TextBox Name="DumpFolder" Width="750"/>
     <TextBlock Text="IW8 ZoneTool executable (build the external research compiler separately)"/>
     <DockPanel><TextBox Name="ZoneToolPath" Width="750"/><Button Content="Browse" Click="BrowseZoneTool_Click"/></DockPanel>
     <TextBlock Text="Optional authored collision input (.native, MWCOLL02..12)" Margin="0,12,0,0"/>
     <TextBox Name="CollisionPath" Width="750"/>
     <TextBlock Text="Optional footsteps data (.native, MWRSTEP1)" Margin="0,4,0,0"/>
     <TextBox Name="FootstepsPath" Width="750"/>
     <TextBlock Text="Output package path (workspace/maps/&lt;map-id&gt;)"/>
     <TextBox Name="PackageFolder" Width="750"/>
     <WrapPanel><Button Content="Validate source" Click="ValidateSource_Click"/>
        <Button Content="Build native zones" Click="Build_Click"/>
        <Button Content="Validate package" Click="ValidatePackage_Click"/></WrapPanel>
     <Separator Margin="0,14,0,12"/>
     <TextBlock Text="LOAD TEST MAP IN REPLAY 1.20" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="Native map-loader code is integrated into CodRevamped MW2019 version.dll. Hook support is restricted to verified Replay 1.20 bindings; see the game log for validation failures." TextWrapping="Wrap" Margin="0,6,0,6"/>
     <DockPanel><TextBox Name="ClientDllPath" Width="675"/><Button Content="Browse version.dll" Click="BrowseClientDll_Click"/></DockPanel>
     <WrapPanel>
      <Button Content="Build + deploy test map" Click="BuildAndDeploy_Click"/>
      <Button Content="Deploy compiled map for game loading" Click="DeployReplay_Click"/>
      <Button Content="Restore previous deployed map" Click="RestoreReplay_Click"/>
     </WrapPanel>
     <TextBlock Text="Stages five native 1.20 fastfiles plus map.json to game/maps/&lt;id&gt; (safe backups). Game must be closed. Launch it yourself; use Multiplayer &gt; Local Play &gt; map selector &gt; TDM. No native game test is performed by this tool." TextWrapping="Wrap" Foreground="#F3CC84" Margin="0,8,0,0"/>
     <Separator Margin="0,14,0,12"/>
     <TextBlock Text="DIRECT CoD4 / IW3 → REPLAY 1.20" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="Compiled original IW3 multiplayer fastfile (.ff)" Margin="0,8,0,0"/>
     <DockPanel><TextBox Name="IW3Fastfile" Width="675"/><Button Content="Browse" Click="BrowseIW3_Click"/></DockPanel>
     <TextBlock Text="OpenAssetTools Unlinker.exe for the same IW3 build" Margin="0,7,0,0"/>
     <DockPanel><TextBox Name="UnlinkerPath" Width="675"/><Button Content="Browse" Click="BrowseUnlinker_Click"/></DockPanel>
     <Button Content="Build IW3 map into Replay native zones" Width="320" HorizontalAlignment="Left" Click="ConvertIW3_Click"/>
     <Separator Margin="0,14,0,12"/>
     <TextBlock Text="SAFE STAGING" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="Game directory (must contain the exact Replay 1.20 game_dx12_ship_replay.exe)" Margin="0,7,0,0"/>
     <TextBox Name="GameFolder" Width="750"/>
     <TextBlock Text="Map staging uses the unified IW8Tools.Native.exe shown above." Margin="0,9,0,0"/>
     <WrapPanel><Button Content="Choose game folder" Click="BrowseGame_Click"/>
         <Button Content="Stage map with backups" Click="Stage_Click"/>
         <Button Content="Verify staged files" Click="VerifyStage_Click"/>
         <Button Content="Restore latest backup" Click="Restore_Click"/></WrapPanel>
     <TextBlock Foreground="#F3CC84" TextWrapping="Wrap" Margin="0,14,0,0"
       Text="Staging is transactional with checksum verification and rollback. The CodRevamped version.dll has an integrated experimental map runtime. Check exact-build diagnostics before live testing."/>
    </StackPanel>
   </ScrollViewer>
   </TabItem>
   <TabItem Header="GFX / weapons">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="25" HorizontalAlignment="Left" Width="850">
     <TextBlock Text="GRAPHICS SOURCE PREP" FontWeight="Bold" FontSize="18"/>
     <TextBlock Text="Decode your PNG/TGA/DDS images through WPF where supported; export a raw RGBA8 source and a dimensions descriptor. No game GfxImage is generated."
         TextWrapping="Wrap" Margin="0,8,0,12"/>
     <Button Content="Import texture → RGBA8 source" Width="300" HorizontalAlignment="Left" Click="Texture_Click"/>
     <Separator Margin="0,20,0,15"/>
     <TextBlock Text="CUSTOM WEAPON PROJECT" FontWeight="Bold" FontSize="18"/>
     <TextBlock Text="Weapon ID (letters, numbers and underscores)" Margin="0,8,0,0"/>
     <TextBox Name="WeaponId" Width="500" Text="custom_rifle"/>
     <WrapPanel><Button Content="New weapon profile" Click="Weapon_Click"/><Button Content="Open profile" Click="OpenWeapon_Click"/><Button Content="Save changes" Click="SaveWeapon_Click"/></WrapPanel>
     <TextBlock Text="WEAPON DESIGN VALUES (NOT NATIVE WEAPONDEF)" FontWeight="Bold" Margin="0,14,0,6"/>
     <UniformGrid Columns="2">
      <StackPanel><TextBlock Text="Display name"/><TextBox Name="WeaponDisplayName" Text="Custom Rifle"/></StackPanel>
      <StackPanel><TextBlock Text="Category"/><ComboBox Name="WeaponCategory" SelectedIndex="0"><ComboBoxItem Content="assault_rifle"/><ComboBoxItem Content="smg"/><ComboBoxItem Content="lmg"/><ComboBoxItem Content="shotgun"/><ComboBoxItem Content="marksman_rifle"/><ComboBoxItem Content="sniper_rifle"/><ComboBoxItem Content="pistol"/></ComboBox></StackPanel>
      <StackPanel><TextBlock Text="Damage (1–1000)"/><TextBox Name="WeaponDamage" Text="30"/></StackPanel>
      <StackPanel><TextBlock Text="Range meters (0.1–1000)"/><TextBox Name="WeaponRange" Text="45"/></StackPanel>
      <StackPanel><TextBlock Text="Rounds/min (1–2000)"/><TextBox Name="WeaponRpm" Text="750"/></StackPanel>
      <StackPanel><TextBlock Text="Magazine (1–500)"/><TextBox Name="WeaponMagazine" Text="30"/></StackPanel>
      <StackPanel><TextBlock Text="Model source (relative)"/><TextBox Name="WeaponModel" Text="model.obj"/></StackPanel>
      <StackPanel><TextBlock Text="Animation profile"/><TextBox Name="WeaponAnimation" Text="unassigned"/></StackPanel>
      <StackPanel><TextBlock Text="Audio profile"/><TextBox Name="WeaponAudio" Text="unassigned"/></StackPanel>
      <StackPanel><TextBlock Text="Attachment IDs (comma separated)"/><TextBox Name="WeaponAttachments" Text=""/></StackPanel>
     </UniformGrid>
     <TextBlock TextWrapping="Wrap" Foreground="#F3CC84" Margin="0,12,0,0"
        Text="These profiles are editable design inputs. Native WeaponDef, attachment, animation, GfxImage and weapon companion-zone serialization require the matching compiler and tested engine bindings."/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Lua menu builder">
    <StackPanel Margin="28" Width="760" HorizontalAlignment="Left">
     <TextBlock Text="LUI / LUA MENU DESIGNER" FontSize="24" FontWeight="Bold" Foreground="#5ABCEC"/>
     <TextBlock Text="Design custom Gunsmith, Loadouts, Multiplayer and Warzone overlays with a draggable layout and generated Lua." TextWrapping="Wrap" Margin="0,14,0,10"/>
     <Button Content="Open visual Lua workbench" FontSize="16" Padding="12" Click="OpenLuaWorkbench_Click" Width="300" HorizontalAlignment="Left"/>
     <TextBlock Text="Gunsmith previews use a schematic reference by default. Import a screenshot from your local 1.20 game to position controls against the actual menu." TextWrapping="Wrap" Foreground="#A6BBCC" Margin="0,20,0,0"/>
     <TextBlock Text="Exports editable LUI .lua source, a JSON menu project and a manifest under lua/&lt;menu-id&gt;. Source staging is available; automatic in-game Lua execution still needs a verified Replay 1.20 VM loader." TextWrapping="Wrap" Foreground="#E8C68E" Margin="0,14,0,0"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Asset research">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="25" Width="840" HorizontalAlignment="Left">
     <TextBlock Text="VERSION COMPARISON / ASSET INVENTORY" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="Drop files onto the window or choose a folder. Inspection doesn't change input files." Margin="0,12,0,7"/>
     <TextBox Name="InputFolder" Width="740"/>

     <Button Content="Run read-only inspection" Width="260" HorizontalAlignment="Left" Click="Inspect_Click"/>
     <TextBlock Text="Optional 1.20 reference zone directory" Margin="0,8,0,0"/>
     <TextBox Name="BaselineFolder" Width="740"/>
     <Button Content="Compare against 1.20 files" Width="280" HorizontalAlignment="Left" Click="CompareAssets_Click"/>
     <Separator Margin="0,18,0,10"/>
     <Button Content="Inspect .ff / .fp / .xpak / .sabs samples" Width="360" HorizontalAlignment="Left" Click="InspectPackages_Click" Margin="0,0,0,12"/>
     <TextBlock Text="Read-only multi-file header report. Highlights duplicated archives and patches paired with their base fastfile. No automatic cross-version conversion." TextWrapping="Wrap" Foreground="#A6BBCC" Margin="0,0,0,14"/>
