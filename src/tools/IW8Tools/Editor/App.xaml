<Application x:Class="CodRevamped.IW8Tools.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Background" Color="#11151D"/>
  <SolidColorBrush x:Key="Surface" Color="#202633"/>
  <SolidColorBrush x:Key="Accent" Color="#53B5E7"/>
  <Style TargetType="Button">
    <Setter Property="Margin" Value="0,4,8,4"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="#304B61"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Margin" Value="0,4,8,4"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="#242D3A"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#516171"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#E1E8F0"/>
  </Style>
 </Application.Resources>
</Application>
